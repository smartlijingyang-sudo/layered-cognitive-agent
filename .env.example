# LCA 本地开发环境示例。复制为 .env 后按需修改（.env 不入库）。

# 单用户本地开发：关闭 LCA 入口 Bearer 校验（等价于旧的 lca-local 免配体验）。
LCA_DEV_MODE=true

# 若要保留入口校验：把上面改成 false，并配置一个部署专属值（不要用 lca-local）。
# LCA_AUTH_EXPECTED_TOKEN=dev-change-me

# 公司网关轨解密密钥，联调时向网关索取；未配置时网关轨请求返回 503。
# MANGLI_AUTH_AES_KEY=

# 权限 Code 查询默认关闭；打开后仍需注入查询客户端，否则权限为空。
# MANGLI_PERMISSIONS_ENABLED=false

# 外部图片生成服务凭据；未配置时头像插件启动失败。
# AVATAR_IMAGE_API_KEY=
