 58: from lca.layer2_runtime.hooks import HOOK_NAMES, make_event_emitting_hook
 59: from lca.layer2_runtime.runtime_loop import CognitiveRuntime
 60: from lca.layer2_runtime.strategy_registry import get_global_strategy_registry
 61: from lca.layer3_agent.base_agent import BaseAgent
 62: from lca.layer3_agent.orchestration_registry import get_global_orchestration_registry
 63: from lca.layer3_agent.orchestration_strategies import (
 64:     DebateStrategy,
 65:     GraphStrategy,
 66:     HandoffStrategy,
 67:     HierarchicalStrategy,
 68:     ParallelStrategy,
