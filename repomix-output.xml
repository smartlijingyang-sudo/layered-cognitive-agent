<file path="lca/layer3_agent/orchestration_strategies/graph/topology.py">
 1: """图算法私有细节 —— 入度计算、级联跳过等拓扑操作。"""
 2: from __future__ import annotations
 3: from collections import deque
 4: from lca.contracts.graph import ExecutionGraph
 5: def compute_in_degree_and_out_edges(
 6:     graph: ExecutionGraph,
 7: ) -> tuple[dict[str, int], dict[str, list[int]]]:
 8:     """计算每个节点的入度和出边索引。"""
 9:     in_degree: dict[str, int] = dict.fromkeys(graph.nodes, 0)
10:     out_edge_indices: dict[str, list[int]] = {nid: [] for nid in graph.nodes}
11:     for idx, edge in enumerate(graph.edges):
12:         in_degree[edge.target] += 1
13:         out_edge_indices[edge.source].append(idx)
14:     return in_degree, out_edge_indices
15: def cascade_skip(
16:     graph: ExecutionGraph,
17:     node_id: str,
18:     remaining: dict[str, int],
19:     skipped: set[str],
20:     executed: set[str],
21:     queue: deque[str],
22: ) -> None:
23:     """条件边未命中时级联跳过下游节点，防止 join 死等。"""
24:     skip_queue: deque[str] = deque([node_id])
25:     while skip_queue:
26:         nid = skip_queue.popleft()
27:         if nid in skipped or nid in executed:
28:             continue
29:         remaining[nid] -= 1
30:         if remaining[nid] > 0:
31:             continue
32:         skipped.add(nid)
33:         for edge in graph.outgoing(nid):
34:             if edge.target not in executed:
35:                 skip_queue.append(edge.target)
36: def enqueue_ready_targets(
37:     targets: list[str],
38:     remaining: dict[str, int],
39:     executed: set[str],
40:     queue: deque[str],
41: ) -> None:
42:     """将入度归零且未执行的 target 加入队列。"""
43:     for target in targets:
44:         remaining[target] -= 1
45:         if remaining[target] <= 0 and target not in executed:
46:             queue.append(target)
</file>

