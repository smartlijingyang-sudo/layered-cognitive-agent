 1: """Budget 单一事实来源工厂 —— 消除配置分叉。
 2: L0 配置层：系统中所有 Budget 构造必须经过此工厂，
 3: 禁止在别处直接 Budget(max_steps=N) 式裸构造并携带默认值。
 4: 配置合并优先级：显式传参 > 调用方传入 > 全局默认。
 5: """
 6: from __future__ import annotations
 7: from lca.contracts.state import Budget
 8: DEFAULT_MAX_STEPS: int = 10
 9: """Default maximum reasoning steps per agent run."""
10: DEFAULT_TOOL_TIMEOUT_S: int = 5
11: """Default timeout (seconds) for tool execution."""
12: DEFAULT_A2A_TIMEOUT_S: float = 30.0
13: """Default HTTP timeout (seconds) for A2A transport."""
14: DEFAULT_MAX_WALL_CLOCK_SECONDS: int = 300
15: """Default wall-clock timeout for agent / team runs (seconds)."""
16: # Minimum step budget when an agent is promoted to team supervisor.
17: SUPERVISOR_MIN_MAX_STEPS: int = 20
18: def create_budget(
19:     max_steps: int = DEFAULT_MAX_STEPS,
20:     max_wall_clock_seconds: int | None = DEFAULT_MAX_WALL_CLOCK_SECONDS,
21:     max_tokens: int | None = None,
