 1: """离线可跑的确定性 Mock LLM 实现。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import json
 5: import re
 6: from collections.abc import AsyncIterator
 7: from typing import Any
 8: from lca.contracts.protocols import LLMAdapter
 9: class MockLLMAdapter(LLMAdapter):
10:     """确定性假 LLM，用于测试与演示；接口与真实厂商适配器完全一致。"""
11:     name = "mock-llm"
12:     async def complete(self, prompt: str, **kwargs: Any) -> str:
13:         await asyncio.sleep(0)
14:         if "TOOL_RESULT:" in prompt:
15:             m = re.search(r"TOOL_RESULT:\s*([^\n]+)", prompt)
16:             tool_result = m.group(1).strip() if m else "未知"
17:             question = re.search(r"USER_TASK:\s*([^\n]+)", prompt)
18:             q = question.group(1).strip() if question else ""
19:             return json.dumps(
20:                 {
21:                     "action_type": "respond",
22:                     "response_text": f"「{q}」的答案是 {tool_result}。",
23:                     "rationale": "已从工具获得精确计算结果，直接向用户作答，无需进一步调用工具。",
24:                     "confidence": 0.98,
25:                 },
26:                 ensure_ascii=False,
27:             )
28:         expr = self._extract_arithmetic_expression(prompt)
29:         if expr:
30:             return json.dumps(
31:                 {
32:                     "action_type": "use_tool",
33:                     "tool_name": "calculator",
34:                     "arguments": {"expression": expr},
35:                     "rationale": f"用户问题是纯算术计算（{expr}），应调用 calculator 工具求精确值而非直接臆测。",
36:                     "confidence": 0.95,
37:                 },
38:                 ensure_ascii=False,
39:             )
40:         return json.dumps(
41:             {
42:                 "action_type": "respond",
43:                 "response_text": "这是一个通用问题，暂无可用工具，基于已有知识直接作答。",
44:                 "rationale": "未检测到需要调用工具的模式，直接生成回答。",
45:                 "confidence": 0.6,
46:             },
47:             ensure_ascii=False,
48:         )
49:     async def stream(self, prompt: str, **kwargs: Any) -> AsyncIterator[str]:
50:         text = await self.complete(prompt, **kwargs)
51:         for char in text:
52:             yield char
53:     @staticmethod
54:     def _extract_arithmetic_expression(prompt: str) -> str | None:
55:         m = re.search(r"USER_TASK:\s*([^\n]+)", prompt)
56:         if not m:
57:             return None
58:         text = m.group(1)
59:         text = (
60:             text.replace("乘以", "*").replace("加上", "+").replace("减去", "-").replace("除以", "/")
61:         )
62:         text = text.replace("×", "*").replace("÷", "/")
63:         nums_ops = re.findall(r"[\d.]+|[+\-*/]", text)
64:         if len(nums_ops) >= 3:
65:             return "".join(nums_ops)
66:         return None
