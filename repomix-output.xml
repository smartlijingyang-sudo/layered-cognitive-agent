 1: """第5.10节：运行结果与异常契约。"""
 2: from __future__ import annotations
 3: from dataclasses import dataclass, field
 4: from typing import Any
 5: from lca.contracts.lifecycle import TaskStatus
 6: from lca.contracts.state import Budget
 7: @dataclass
 8: class Result:
 9:     """Agent / Team 运行的最终结果契约。
10:     消费方应先检查 ``status``：非 COMPLETED 时 ``budget_used`` 为零值 Budget，
11:     ``output`` / ``trace_url`` 等可能为 None。
12:     """
13:     trace_id: str
14:     status: TaskStatus
15:     final_state_ref: str
16:     total_steps: int
17:     budget_used: Budget
18:     schema_version: str = "1.0"
19:     output: str | None = None
20:     lessons: list[str] = field(default_factory=list)
21:     trace_url: str | None = None
22:     error: str | None = None
23:     extra: dict[str, Any] = field(default_factory=dict)
24:     @classmethod
25:     def failed(cls, reason: str) -> Result:
26:         """构造失败 Result 的工厂方法，消除重复的构造代码块。"""
27:         return cls(
28:             trace_id="",
29:             status=TaskStatus.FAILED,
30:             final_state_ref="",
31:             total_steps=0,
32:             budget_used=Budget(),
33:             error=reason,
34:         )
35: class ApprovalPendingError(Exception):
36:     """Agent 需要人工审批时抛出，暂停执行等待 HITL 决策。"""
37:     def __init__(self, approval_request: Any):
38:         self.approval_request = approval_request
39:         super().__init__("waiting for human approval")
40: class BudgetExceededError(Exception):
41:     """Budget 超限（步数 / token / 费用 / 墙钟）时抛出。"""
42:     pass
43: class ToolExecutionError(Exception):
44:     """工具执行失败基类。
45:     ``retryable`` 信号供 SafeExecutor 决定是否重试：
46:     - ``True``（默认）：瞬时性错误，指数退避重试可能恢复
47:     - ``False``：确定性错误，重试不会改变结果，应 fail-fast
48:     """
49:     retryable: bool = True
50:     def __init__(self, message: str, last_observation: Any | None = None):
51:         self.last_observation = last_observation
52:         super().__init__(message)
53: class ToolInputError(ToolExecutionError):
54:     """工具输入校验失败——确定性错误，重试无意义。
55:     典型场景：必填参数缺失、类型错误、表达式语法非法。
56:     SafeExecutor 遇到此异常应立即返回失败 Observation，不进入退避循环。
57:     """
58:     retryable = False
59: class UnregisteredActionError(ToolExecutionError):
60:     """Raised when an ``action_type`` has no registered handler.
61:     This is a deterministic error — retrying will not help because the
62:     action catalog simply does not contain the requested type.
63:     """
64:     retryable = False
65:     def __init__(self, action_type: str):
66:         self.action_type = action_type
67:         super().__init__(f"未注册的 action_type: {action_type}")
</file>

