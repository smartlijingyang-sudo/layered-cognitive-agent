<file path="lca/layer3_agent/team_orchestrator.py">
 1: """TeamOrchestrator —— 管理团队的组织形态与通信信道。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import (
 4:     AgentTransport,
 5:     OrchestrationContext,
 6:     OrchestrationStrategy,
 7:     SharedMemoryStore,
 8:     TeamEntrypoint,
 9: )
10: from lca.contracts.result import Result
11: from lca.contracts.role_team import TeamConfig
12: from lca.layer1_cognitive.memory.team_shared_memory import TeamSharedMemoryStore
13: from lca.layer3_agent.base_agent import BaseAgent
14: from lca.layer3_agent.orchestration_registry import get_global_orchestration_registry
15: from lca.layer3_agent.supervisor import Supervisor
16: class TeamOrchestrator(TeamEntrypoint):
17:     """
18:     支持多种组织形态（hierarchical / sequential / parallel / graph / debate），
19:     通过 OrchestrationStrategyRegistry 解析策略，不再 if/elif 硬编码。
20:     当 TeamConfig.shared_memory_layers 非空时，自动构造 TeamSharedMemoryStore
21:     并通过 Runtime.configure(shared_memory=...) 注入每个成员。
22:     """
23:     def __init__(
24:         self,
25:         members: list[BaseAgent],
26:         config: TeamConfig,
27:         supervisor: Supervisor | None = None,
28:         transport: AgentTransport | None = None,
29:         roster_desc: str = "",
30:         strategy: OrchestrationStrategy | None = None,
31:     ):
32:         self.members = members
33:         self.config = config
34:         self.supervisor = supervisor
35:         self.transport = transport
36:         self.roster_desc = roster_desc
37:         if strategy is not None:
38:             self._strategy = strategy
39:         else:
40:             registry = get_global_orchestration_registry()
41:             self._strategy = registry.resolve(config.process)
42:         self._shared_store: SharedMemoryStore | None = None
43:         if config.shared_memory_layers:
44:             self._shared_store = TeamSharedMemoryStore(config.shared_memory_layers)
45:             self._inject_shared_memory()
46:         self._context = OrchestrationContext(
47:             members=members,
48:             config=config,
49:             supervisor=supervisor,
50:             transport=transport,
51:             roster_desc=roster_desc,
52:         )
53:     def _inject_shared_memory(self) -> None:
54:         """将共享记忆 store 通过 Runtime.configure 分发给每个成员。"""
55:         if self._shared_store is None:
56:             return
57:         for member in self.members:
58:             member.runtime.configure(shared_memory=self._shared_store)
59:     async def run(self, objective: str) -> Result:
60:         """按 TeamConfig.process 类型选择组织形态执行。"""
61:         return await self._strategy.run(self._context, objective)
