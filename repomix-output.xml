<file path="lca/layer1_cognitive/brain/modular_brain.py">
 1: """ModularBrain —— BrainStrategy 串联 Reasoner / Parser / Pipeline / Critic。"""
 2: from __future__ import annotations
 3: from lca.contracts.decision import Observation, Reflection, StructuredDecision
 4: from lca.contracts.protocols import (
 5:     BrainStrategy,
 6:     CandidateEvaluationPipeline,
 7:     CompletionPolicy,
 8:     Critic,
 9:     DecisionParser,
10:     Reasoner,
11:     SkillRouter,
12: )
13: from lca.contracts.state import TypedState
14: from lca.layer1_cognitive.brain.candidate_evaluation_pipeline import (
15:     GuardedCandidateEvaluationPipeline,
16: )
17: class ModularBrain(BrainStrategy):
18:     """Default ``BrainStrategy``: a modular MAP-style cognitive pipeline.
19:     Orchestrates five stages:
20:     1. **Skill routing** (optional) — select an active prompt template.
21:     2. **Task decomposition** — break the task into subtasks.
22:     3. **Candidate generation** — call the Reasoner (LLM) for candidate decisions.
23:     4. **Decision parsing** — parse raw LLM output into ``StructuredDecision``.
24:     5. **Candidate evaluation** — score and select the best candidate.
25:     Reflection is delegated to the ``Critic`` component.
26:     """
27:     def __init__(
28:         self,
29:         reasoner: Reasoner,
30:         decision_parser: DecisionParser,
31:         critic: Critic,
32:         evaluation_pipeline: CandidateEvaluationPipeline,
33:         skill_router: SkillRouter | None = None,
34:     ) -> None:
35:         self.reasoner = reasoner
36:         self.decision_parser = decision_parser
37:         self.critic = critic
38:         self.evaluation_pipeline = evaluation_pipeline
39:         self.skill_router = skill_router
40:     async def think(self, state: TypedState) -> StructuredDecision:
41:         if self.skill_router is not None:
42:             state.active_template = await self.skill_router.route(state)
43:         subtasks = await self.evaluation_pipeline.decompose(state)
44:         if subtasks:
45:             state.working_memory["subtasks"] = list(subtasks)
46:         n = max(1, len(subtasks)) if len(subtasks) > 1 else 1
47:         raw_candidates = await self.reasoner.generate_candidates(state, n=n)
48:         candidates = [self.decision_parser.parse(rc, state) for rc in raw_candidates]
49:         decision: StructuredDecision = await self.evaluation_pipeline.evaluate(state, candidates)
50:         return decision
51:     async def reflect(self, state: TypedState, observation: Observation) -> Reflection:
52:         return await self.critic.critique(state, observation)
53:     def set_team_roster(self, roster_desc: str) -> None:
54:         setter = getattr(self.reasoner, "set_team_roster", None)
55:         if callable(setter):
56:             setter(roster_desc)
57:         elif hasattr(self.reasoner, "team_roster"):
58:             self.reasoner.team_roster = roster_desc
59:     def install_completion_guard(self, policy: CompletionPolicy) -> None:
60:         """在内部评估管线外挂一层确定性收尾 guardrail（Brain 自管内省，外部不穿透）。
61:         装饰器的构造细节（``GuardedCandidateEvaluationPipeline``）留在 L1，
62:         调用方只需要提供 policy，不需要知道内部是用管线实现的。
63:         """
64:         self.evaluation_pipeline = GuardedCandidateEvaluationPipeline(
65:             self.evaluation_pipeline, policy
66:         )
</file>

<file path="lca/layer1_cognitive/brain/reasoner.py">
 1: """Reasoner —— 调用 LLM 生成候选思路。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import LLMAdapter, PromptManager, Reasoner
 4: from lca.contracts.role_team import RoleProfile
 5: from lca.contracts.state import TypedState
 6: from lca.layer1_cognitive.brain.prompts import load_builtin_prompt
 7: DEFAULT_REACT_TEMPLATE: str = load_builtin_prompt("react_prompt")
 8: HIERARCHICAL_DELEGATE_TEMPLATE: str = load_builtin_prompt("hierarchical_prompt")
 9: _DEFAULT_TEMPLATE = "react_prompt"
10: _HIERARCHICAL_TEMPLATE = "hierarchical_prompt"
11: def build_team_roster(profiles: list[RoleProfile]) -> str:
12:     if not profiles:
13:         return "(无可用队友)"
14:     return "\n".join(f"- role: {p.role} | goal: {p.goal}" for p in profiles)
15: class SimpleReasoner(Reasoner):
16:     """Default ``Reasoner`` — renders a prompt template and calls the LLM.
17:     Builds the prompt from role profile, tool descriptions, team roster,
18:     retrieved context, and the active template.  Supports both the
19:     single-agent ``react_prompt`` and the team-aware
20:     ``hierarchical_prompt`` templates.
21:     """
22:     def __init__(
23:         self,
24:         llm: LLMAdapter,
25:         prompt_manager: PromptManager,
26:         role_profile: RoleProfile,
27:         tools_desc: str,
28:         team_roster: str | None = None,
29:         allowed_actions_desc: str = "",
30:     ) -> None:
31:         self.llm = llm
32:         self.prompt_manager = prompt_manager
33:         self.role_profile = role_profile
34:         self.tools_desc = tools_desc
35:         self.team_roster = team_roster
36:         self.allowed_actions_desc = allowed_actions_desc
37:     def set_team_roster(self, roster_desc: str) -> None:
38:         self.team_roster = roster_desc
39:     async def generate_candidates(self, state: TypedState, n: int = 1) -> list[str]:
40:         context_lines = (
41:             "\n".join(f"- [{r.memory_type}] {r.content}" for r in state.retrieved_context)
42:             or "(无历史上下文)"
43:         )
44:         base_vars = {
45:             "role": self.role_profile.role,
46:             "goal": self.role_profile.goal,
47:             "backstory": self.role_profile.backstory,
48:             "tools": self.tools_desc,
49:             "task": state.task,
50:             "context": context_lines,
51:             "allowed_actions": self.allowed_actions_desc,
52:         }
53:         template_name = self._resolve_template(state)
54:         if self.team_roster is not None:
55:             base_vars["team_roster"] = self.team_roster
56:             base_vars["team_progress"] = state.team_progress_text or ""
57:         subtasks = state.working_memory.get("subtasks")
58:         if subtasks:
59:             base_vars["context"] = (
60:                 base_vars["context"] + "\n\nSubtasks:\n" + "\n".join(f"- {s}" for s in subtasks)
61:             )
62:         prompt = self.prompt_manager.render(template_name, base_vars)
63:         candidates = []
64:         for _ in range(max(1, n)):
65:             candidates.append(await self.llm.complete(prompt))
66:         return candidates
67:     def _resolve_template(self, state: TypedState) -> str:
68:         if state.active_template:
69:             return state.active_template
70:         if self.team_roster is not None:
71:             return _HIERARCHICAL_TEMPLATE
72:         return _DEFAULT_TEMPLATE
</file>

<file path="lca/layer1_cognitive/brain/decision_parser.py">
 1: """DecisionParser —— 将自由文本/工具调用稳健地解析为强类型 StructuredDecision。
 2: L2 防腐层：所有 LLM 原始输出必须先经过此层归一化，
 3: 才能进入系统内部。核心域模型只看到已校验/已标记的决策。
 4: """
 5: from __future__ import annotations
 6: import json
 7: import re
 8: from lca.contracts.action import ActionRegistryProtocol
 9: from lca.contracts.decision import DelegationSpec, StructuredDecision, ToolCall
10: from lca.contracts.enums import ActionType
11: from lca.contracts.ids import new_id
12: from lca.contracts.protocols import DecisionParser
13: from lca.contracts.semantic_keys import ORIGINAL_ACTION_TYPE
14: from lca.contracts.state import TypedState
15: class SimpleDecisionParser(DecisionParser):
16:     """稳健 JSON 解析器：别名归一化 + Registry 校验 + 失败兜底。
17:     当提供 ActionRegistry 时，解析器会校验 action_type 是否已注册；
18:     未注册的 action_type 不会被强行改写，而是在 extra 中标记原始值，
19:     交由韧性层（FallbackActionPolicy）决定降级策略。
20:     """
21:     def __init__(self, action_registry: ActionRegistryProtocol | None = None) -> None:
22:         self._action_registry = action_registry
23:     def parse(self, raw_output: str, state: TypedState) -> StructuredDecision:
24:         json_str = self._extract_json(raw_output)
25:         try:
26:             data = json.loads(json_str)
27:         except (json.JSONDecodeError, ValueError):
28:             return StructuredDecision(
29:                 decision_id=new_id("dec"),
30:                 action_type=ActionType.RESPOND,
31:                 response_text=raw_output,
32:                 rationale="解析失败兜底",
33:                 confidence=0.1,
34:             )
35:         raw_action = str(data.get("action_type", "respond")).lower().strip()
36:         action_type = (
37:             self._action_registry.normalize_alias(raw_action)
38:             if self._action_registry is not None
39:             else raw_action
40:         )
41:         extra: dict[str, str] = {}
42:         if self._action_registry is not None and not self._action_registry.is_registered(
43:             action_type
44:         ):
45:             extra[ORIGINAL_ACTION_TYPE] = action_type
46:         tool_calls: list[ToolCall] = []
47:         if action_type == ActionType.USE_TOOL:
48:             tool_name = data.get("tool_name") or data.get("tool")
49:             arguments = data.get("arguments") or data.get("args") or data.get("parameters") or {}
50:             if not isinstance(arguments, dict):
51:                 arguments = {"expression": str(arguments)}
52:             if tool_name:
53:                 tool_calls.append(
54:                     ToolCall(
55:                         call_id=new_id("call"),
56:                         tool_name=tool_name,
57:                         arguments=arguments,
58:                     )
59:                 )
60:             else:
61:                 action_type = ActionType.RESPOND
62:         delegate_to: DelegationSpec | None = None
63:         if action_type in (ActionType.DELEGATE, ActionType.HANDOFF):
64:             subtask = data.get("subtask", "")
65:             target_role = data.get("target_role")
66:             context_refs = data.get("context_refs") or data.get("context") or []
67:             if not isinstance(context_refs, list):
68:                 context_refs = [str(context_refs)]
69:             delegate_to = DelegationSpec(
70:                 subtask=subtask,
71:                 target_role=target_role,
72:                 context_refs=context_refs,
73:             )
74:         return StructuredDecision(
75:             decision_id=new_id("dec"),
76:             action_type=action_type,
77:             tool_calls=tool_calls,
78:             delegate_to=delegate_to,
79:             response_text=data.get("response_text") or data.get("response") or data.get("text"),
80:             rationale=data.get("rationale", ""),
81:             confidence=float(data.get("confidence", 0.5)),
82:             extra=extra,
83:         )
84:     @staticmethod
85:     def _extract_json(text: str) -> str:
86:         m = re.search(r"```(?:json)?\s*\n?(.*?)\n?\s*```", text, re.DOTALL)
87:         if m:
88:             return m.group(1).strip()
89:         m = re.search(r"\{.*\}", text, re.DOTALL)
90:         if m:
91:             return m.group(0)
92:         return text.strip()
</file>

<file path="lca/layer3_agent/orchestration_strategies/hierarchical.py">
 1: """HierarchicalStrategy —— Supervisor 单向委派、汇总。
 2: L3 层职责：
 3:     Hierarchical 是最常用的团队编排模式：
 4:     1. Supervisor 分析任务，拆解为子任务并委派给成员
 5:     2. 成员独立执行，通过 DelegationLedger 跟踪进度
 6:     3. Supervisor 汇总成员结果，生成最终输出
 7:     自动装配 CompletionPolicy guardrail（roster_coverage），
 8:     确保所有必选角色都完成委派后才结束。
 9: """
10: from __future__ import annotations
11: from typing import cast
12: from lca.contracts.enums import CompletionPolicyName, HookEvent
13: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
14: from lca.contracts.result import Result
15: from lca.contracts.team_progress import DelegationLedgerProtocol
16: from lca.layer1_cognitive.team_progress.progress_hooks import (
17:     ledger_tracking_hook,
18:     progress_injection_hook,
19: )
20: def _default_ledger_factory(roles: frozenset[str]) -> DelegationLedgerProtocol:
21:     """从全局注册表解析 DelegationLedger 并实例化。"""
22:     from lca.layer0_infra.component_registry import get_global_registry
23:     reg = get_global_registry()
24:     ledger_cls = reg.require("delegation_ledger", "default")
25:     return cast("DelegationLedgerProtocol", ledger_cls(mandatory_roles=roles))
26: class HierarchicalStrategy(OrchestrationStrategy):
27:     """Supervisor 单向委派、汇总。
28:     自动装配 CompletionPolicy guardrail：
29:     1. 通过 ledger_factory 创建 DelegationLedger（所有成员角色 → pending）
30:     2. 委托 supervisor.install_completion_guard 安装 guardrail
31:        （具体装饰器实现留在 L1，本层只表达"用哪个 policy"这一意图）
32:     3. 注册 post_act 记账 hook + pre_think 进度注入 hook
33:     """
34:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
35:         if context.supervisor is None:
36:             raise ValueError("Hierarchical 模式需要 Supervisor")
37:         # ── 装配确定性收尾 guardrail ──
38:         mandatory_roles = frozenset(m.role_profile.role for m in context.members)
39:         factory = context.ledger_factory or _default_ledger_factory
40:         ledger = factory(mandatory_roles)
41:         # 解析 CompletionPolicy（默认 roster_coverage）
42:         policy_name = CompletionPolicyName.ROSTER_COVERAGE
43:         if context.config is not None:
44:             policy_name = context.config.completion_policy
45:         if policy_name != CompletionPolicyName.NONE:
46:             from lca.layer0_infra.component_registry import get_global_registry
47:             reg = get_global_registry()
48:             policy_factory = reg.require("completion_policy", policy_name)
49:             policy = policy_factory()
50:             context.supervisor.install_completion_guard(policy)
51:             context.supervisor.register_hook(HookEvent.POST_ACT, ledger_tracking_hook)
52:             context.supervisor.register_hook(HookEvent.PRE_THINK, progress_injection_hook)
53:         return await context.supervisor.execute(objective, team_progress=ledger)
</file>

