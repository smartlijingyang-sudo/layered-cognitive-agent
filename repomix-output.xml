<file path="lca/layer3_agent/orchestration_strategies/graph/topology.py">
 1: """图算法私有细节 —— 入度计算、级联跳过等拓扑操作。
 2: 供 GraphStrategy 使用的纯函数工具集：
 3: - ``compute_in_degree_and_out_edges``: 一次遍历计算所有节点的入度和出边索引
 4: - ``cascade_skip``: 条件边未命中时级联跳过下游节点，防止 fan-in 死等
 5: - ``enqueue_ready_targets``: 将入度归零的节点加入 BFS 队列
 6: """
 7: from __future__ import annotations
 8: from collections import deque
 9: from lca.contracts.graph import ExecutionGraph
10: def compute_in_degree_and_out_edges(
11:     graph: ExecutionGraph,
12: ) -> tuple[dict[str, int], dict[str, list[int]]]:
13:     """计算每个节点的入度和出边索引。"""
14:     in_degree: dict[str, int] = dict.fromkeys(graph.nodes, 0)
15:     out_edge_indices: dict[str, list[int]] = {nid: [] for nid in graph.nodes}
16:     for idx, edge in enumerate(graph.edges):
17:         in_degree[edge.target] += 1
18:         out_edge_indices[edge.source].append(idx)
19:     return in_degree, out_edge_indices
20: def cascade_skip(
21:     graph: ExecutionGraph,
22:     node_id: str,
23:     remaining: dict[str, int],
24:     skipped: set[str],
25:     executed: set[str],
26:     queue: deque[str],
27: ) -> None:
28:     """条件边未命中时级联跳过下游节点，防止 join 死等。"""
29:     skip_queue: deque[str] = deque([node_id])
30:     while skip_queue:
31:         nid = skip_queue.popleft()
32:         if nid in skipped or nid in executed:
33:             continue
34:         remaining[nid] -= 1
35:         if remaining[nid] > 0:
36:             continue
37:         skipped.add(nid)
38:         for edge in graph.outgoing(nid):
39:             if edge.target not in executed:
40:                 skip_queue.append(edge.target)
41: def enqueue_ready_targets(
42:     targets: list[str],
43:     remaining: dict[str, int],
44:     executed: set[str],
45:     queue: deque[str],
46: ) -> None:
47:     """将入度归零且未执行的 target 加入队列。"""
48:     for target in targets:
49:         remaining[target] -= 1
50:         if remaining[target] <= 0 and target not in executed:
51:             queue.append(target)
</file>

<file path="lca/layer3_agent/member_invoke.py">
 1: """团队成员统一调用路径。
 2: L3 层职责：
 3:     提供 invoke_member 和 invoke_members_sequential 两个原子函数，
 4:     屏蔽 Transport 远程调用与直接 execute 的差异。
 5:     所有编排策略通过这两个函数调用成员，不直接依赖 BaseAgent 或 Transport。
 6: """
 7: from __future__ import annotations
 8: from typing import cast
 9: from lca.contracts.ids import new_id
10: from lca.contracts.lifecycle import TaskStatus
11: from lca.contracts.protocols import OrchestrationContext
12: from lca.contracts.result import Result
13: from lca.contracts.state import Budget
14: _DEFAULT_TIMEOUT_S = 300.0
15: async def invoke_member(
16:     context: OrchestrationContext,
17:     member: object,
18:     objective: str,
19:     *,
20:     timeout_s: float = _DEFAULT_TIMEOUT_S,
21: ) -> Result:
22:     transport = context.transport
23:     role = getattr(getattr(member, "role_profile", None), "role", None)
24:     if transport is not None and role:
25:         task_id = await transport.send_task(role, objective, [])
26:         wait = getattr(transport, "wait_result", None)
27:         if wait is not None:
28:             observation = await wait(task_id, timeout_s)
29:         else:
30:             observation = await transport.receive_result(task_id)
31:         status = TaskStatus.COMPLETED if observation.success else TaskStatus.FAILED
32:         output = (
33:             observation.payload
34:             if isinstance(observation.payload, str)
35:             else (str(observation.payload) if observation.payload is not None else None)
36:         )
37:         return Result(
38:             trace_id=new_id("trace"),
39:             status=status,
40:             final_state_ref=f"transport://{task_id}",
41:             total_steps=1,
42:             budget_used=Budget(used_steps=1),
43:             output=output,
44:             error=observation.error,
45:         )
46:     execute = getattr(member, "execute", None)
47:     if execute is None:
48:         return Result.failed("member has no execute method")
49:     return cast("Result", await execute(objective))
50: async def invoke_members_sequential(
51:     context: OrchestrationContext,
52:     objective: str,
53:     *,
54:     pass_output_as_next_task: bool = True,
55:     stop_on_first_completed: bool = False,
56: ) -> Result:
57:     if not context.members:
58:         return Result.failed("No members in team")
59:     current_task = objective
60:     last_result: Result | None = None
61:     total_steps = 0
62:     for member in context.members:
63:         last_result = await invoke_member(context, member, current_task)
64:         total_steps += last_result.total_steps
65:         if stop_on_first_completed and last_result.status == TaskStatus.COMPLETED:
66:             last_result.total_steps = total_steps
67:             return last_result
68:         if pass_output_as_next_task and last_result.output:
69:             current_task = last_result.output
70:     if last_result is None:
71:         return Result.failed("No members in team")
72:     last_result.total_steps = total_steps
73:     return last_result
</file>

