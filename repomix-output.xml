 45: from lca.layer1_cognitive.brain.modular_brain import ModularBrain
 46: from lca.layer1_cognitive.brain.prompts import load_builtin_prompt
 47: from lca.layer1_cognitive.brain.reasoner import (
 48:     SimpleReasoner,
 49:     build_team_roster,
 50: )
 51: from lca.layer1_cognitive.brain.synthesizer import ConcatSynthesizer
 52: from lca.layer1_cognitive.event_bus import SimpleEventBus
 53: from lca.layer1_cognitive.hook_registry import SimpleHookRegistry, default_logging_hook
 54: from lca.layer1_cognitive.memory.simple_memory import SimpleMemorySystem
