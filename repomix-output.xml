<file path="lca/layer1_cognitive/brain/decision_parser.py">
  1: """DecisionParser —— 将自由文本/工具调用稳健地解析为强类型 StructuredDecision。
  2: L2 防腐层：所有 LLM 原始输出必须先经过此层归一化，
  3: 才能进入系统内部。核心域模型只看到已校验/已标记的决策。
  4: """
  5: from __future__ import annotations
  6: import json
  7: import re
  8: import uuid
  9: from lca.contracts.action import ActionRegistryProtocol
 10: from lca.contracts.decision import DelegationSpec, StructuredDecision, ToolCall
 11: from lca.contracts.protocols import DecisionParser
 12: from lca.contracts.state import TypedState
 13: def _new_id(prefix: str) -> str:
 14:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
 15: _ACTION_ALIASES: dict[str, str] = {
 16:     "tool_call": "use_tool",
 17:     "call_tool": "use_tool",
 18:     "use_tool": "use_tool",
 19:     "respond": "respond",
 20:     "response": "respond",
 21:     "answer": "respond",
 22:     "reply": "respond",
 23:     "delegate": "delegate",
 24:     "delegation": "delegate",
 25:     "handoff": "handoff",
 26:     "hand_off": "handoff",
 27:     "stop": "stop",
 28:     "ask_human": "ask_human",
 29:     "hitl": "ask_human",
 30: }
 31: _UNRECOGNIZED_ACTION_KEY = "original_action_type"
 32: class SimpleDecisionParser(DecisionParser):
 33:     """稳健 JSON 解析器：别名归一化 + Registry 校验 + 失败兜底。
 34:     当提供 ActionRegistry 时，解析器会校验 action_type 是否已注册；
 35:     未注册的 action_type 不会被强行改写，而是在 extra 中标记原始值，
 36:     交由韧性层（FallbackActionHandler）决定降级策略。
 37:     """
 38:     def __init__(self, action_registry: ActionRegistryProtocol | None = None) -> None:
 39:         self._action_registry = action_registry
 40:     def parse(self, raw_output: str, state: TypedState) -> StructuredDecision:
 41:         json_str = self._extract_json(raw_output)
 42:         try:
 43:             data = json.loads(json_str)
 44:         except (json.JSONDecodeError, ValueError):
 45:             return StructuredDecision(
 46:                 decision_id=_new_id("dec"),
 47:                 action_type="respond",
 48:                 response_text=raw_output,
 49:                 rationale="解析失败兜底",
 50:                 confidence=0.1,
 51:             )
 52:         raw_action = str(data.get("action_type", "respond")).lower().strip()
 53:         action_type = _ACTION_ALIASES.get(raw_action, raw_action)
 54:         # L2 防腐层：校验 action_type 是否在 Registry 已注册集合内
 55:         extra: dict[str, str] = {}
 56:         if self._action_registry is not None and not self._action_registry.is_registered(
 57:             action_type
 58:         ):
 59:             extra[_UNRECOGNIZED_ACTION_KEY] = action_type
 60:         tool_calls: list[ToolCall] = []
 61:         if action_type == "use_tool":
 62:             tool_name = data.get("tool_name") or data.get("tool")
 63:             arguments = data.get("arguments") or data.get("args") or data.get("parameters") or {}
 64:             if not isinstance(arguments, dict):
 65:                 arguments = {"expression": str(arguments)}
 66:             if tool_name:
 67:                 tool_calls.append(
 68:                     ToolCall(
 69:                         call_id=_new_id("call"),
 70:                         tool_name=tool_name,
 71:                         arguments=arguments,
 72:                     )
 73:                 )
 74:             else:
 75:                 action_type = "respond"
 76:         delegate_to: DelegationSpec | None = None
 77:         if action_type in ("delegate", "handoff"):
 78:             subtask = data.get("subtask", "")
 79:             target_role = data.get("target_role")
 80:             context_refs = data.get("context_refs") or data.get("context") or []
 81:             if not isinstance(context_refs, list):
 82:                 context_refs = [str(context_refs)]
 83:             delegate_to = DelegationSpec(
 84:                 subtask=subtask,
 85:                 target_role=target_role,
 86:                 context_refs=context_refs,
 87:             )
 88:         return StructuredDecision(
 89:             decision_id=_new_id("dec"),
 90:             action_type=action_type,
 91:             tool_calls=tool_calls,
 92:             delegate_to=delegate_to,
 93:             response_text=data.get("response_text") or data.get("response") or data.get("text"),
 94:             rationale=data.get("rationale", ""),
 95:             confidence=float(data.get("confidence", 0.5)),
 96:             extra=extra,
 97:         )
 98:     @staticmethod
 99:     def _extract_json(text: str) -> str:
100:         m = re.search(r"```(?:json)?\s*\n?(.*?)\n?\s*```", text, re.DOTALL)
101:         if m:
102:             return m.group(1).strip()
103:         m = re.search(r"\{.*\}", text, re.DOTALL)
104:         if m:
105:             return m.group(0)
106:         return text.strip()
</file>

