<file path="lca/layer0_infra/component_registry.py">
 1: """注册表基础设施 —— ComponentRegistry + NamedRegistry 泛型基类。
 2: 语义约定（PR-5 / ADR-0019）：
 3: - ``get``：软查询，找不到返回 None
 4: - ``require`` / ``NamedRegistry.resolve``：硬查询，找不到 raise RegistryKeyError
 5: """
 6: from __future__ import annotations
 7: from typing import Any, Generic, TypeVar
 8: from lca.contracts.mechanisms import NamedRegistryProtocol
 9: _T = TypeVar("_T")
10: _StrList = list[str]  # 避免类内方法名 list 遮蔽内置 list 类型
11: class RegistryKeyError(ValueError):
12:     """按名称查找注册表条目失败。
13:     继承 ValueError 以保持向后兼容（已有测试 assertRaises(ValueError)）。
14:     """
15:     def __init__(self, key: str, registry_kind: str, available: list[str]) -> None:
16:         self.key = key
17:         self.registry_kind = registry_kind
18:         self.available = available
19:         super().__init__(f"未注册{registry_kind} {key!r}，可用: {available}")
20: class NamedRegistry(NamedRegistryProtocol, Generic[_T]):
21:     """按名称注册和解析实体的泛型基类。
22:     子类通过 ``_REGISTRY_KIND`` 声明种类名（用于错误消息），
23:     可选择覆盖 ``resolve()`` 以改变解析语义（如工厂调用、类型转换）。
24:     """
25:     _REGISTRY_KIND: str = "条目"
26:     def __init__(self) -> None:
27:         self._entries: dict[str, _T] = {}
28:     def register(self, name: str, impl: _T) -> None:
29:         self._entries[name] = impl
30:     def get(self, name: str) -> _T | None:
31:         """软查询：找不到返回 None。"""
32:         return self._entries.get(name)
33:     def resolve(self, name: str) -> _T:
34:         impl = self._entries.get(name)
35:         if impl is None:
36:             raise RegistryKeyError(name, self._REGISTRY_KIND, self.list())
37:         return impl
38:     def list(self) -> _StrList:
39:         return list(self._entries.keys())
40:     def __contains__(self, name: str) -> bool:
41:         return name in self._entries
42: class ComponentRegistry:
43:     """按 (category, name) 注册和解析组件实现（发现型注册表）。
44:     category 例如 "observability"、"memory"、"state_store" 等；
45:     name 是用户可见的实现名称，例如 "console"、"simple" 等。
46:     值可以是类（无参构造）或工厂函数（接受上下文参数）。
47:     运行时绑定型注册表（Action / Tool / Transport）应由 AgentAssembly 注入实例，
48:     不要用全局 ComponentRegistry 承载。
49:     """
50:     def __init__(self) -> None:
51:         self._registries: dict[str, dict[str, Any]] = {}
52:     def register(self, category: str, name: str, impl: Any) -> None:
53:         self._registries.setdefault(category, {})[name] = impl
54:     def get(self, category: str, name: str) -> Any | None:
55:         """软查询：找不到返回 None。"""
56:         return self._registries.get(category, {}).get(name)
57:     def require(self, category: str, name: str) -> Any:
58:         """硬查询：找不到 raise RegistryKeyError。"""
59:         impl = self.get(category, name)
60:         if impl is None:
61:             raise RegistryKeyError(name, category, self.list(category))
62:         return impl
63:     def list(self, category: str) -> _StrList:
64:         return list(self._registries.get(category, {}).keys())
65:     def list_categories(self) -> _StrList:
66:         return sorted(self._registries.keys())
67:     def get_registry(self, category: str) -> dict[str, Any]:
68:         return self._registries.get(category, {})
69: _global_registry = ComponentRegistry()
70: _defaults_registered = False
71: def get_global_registry() -> ComponentRegistry:
72:     return _global_registry
73: def defaults_registered() -> bool:
74:     return _defaults_registered
75: def mark_defaults_registered() -> None:
76:     global _defaults_registered
77:     _defaults_registered = True
</file>

