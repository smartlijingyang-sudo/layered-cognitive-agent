<file path="lca/layer3_agent/group_chat.py">
 1: """GroupChat —— 基于 ExecutionGraph 的全连接 mesh 预置模板。
 2: 不是独立的 OrchestrationStrategy，而是 Graph 的一种预置拓扑：
 3: - 全连接 mesh：每个 Agent 节点都有边到其他所有 Agent 节点
 4: - max_rounds 熔断：通过 GraphStrategy 的轮数控制防止无限循环
 5: - 条件边：每个 Agent 可以选择把话传给谁（或结束对话）
 6: 生产环境慎用：token 贵、容易 drift、难调试（ADR-0008 定位）。
 7: """
 8: from __future__ import annotations
 9: from lca.contracts.graph import ExecutionGraph, GraphEdge, GraphNode
10: def build_group_chat_graph(
11:     roles: list[str],
12:     max_rounds: int = 5,
13:     allow_all_messages: bool = True,
14: ) -> ExecutionGraph:
15:     """构建全连接 mesh 拓扑的 ExecutionGraph。
16:     拓扑结构：
17:         entry → agent_1 ⇄ agent_2 ⇄ ... ⇄ agent_n → exit
18:     每个 agent 节点都有 fixed 边到所有其他 agent 节点（全连接），
19:     以及到 exit 的边（允许任何 agent 结束对话）。
20:     Args:
21:         roles: 参与群聊的 Agent 角色列表。
22:         max_rounds: 最大轮数（信息性，实际由 GraphStrategy 控制）。
23:         allow_all_messages: 是否允许全连接（True）还是只允许顺序传递（False）。
24:     Returns:
25:         可直接传给 GraphStrategy 的 ExecutionGraph。
26:     """
27:     graph = ExecutionGraph(allow_cycle=True)
28:     graph.add_node(GraphNode(id="entry", type="entry"))
29:     graph.add_node(GraphNode(id="exit", type="exit"))
30:     for role in roles:
31:         graph.add_node(GraphNode(id=role, type="agent", config={"role": role}))
32:     # entry → 第一个 agent
33:     if roles:
34:         graph.add_edge(GraphEdge(source="entry", target=roles[0]))
35:     # 全连接 mesh：每个 agent 到其他所有 agent
36:     if allow_all_messages:
37:         for src_role in roles:
38:             for tgt_role in roles:
39:                 if src_role != tgt_role:
40:                     graph.add_edge(GraphEdge(source=src_role, target=tgt_role))
41:             # 每个 agent 也可以结束对话
42:             graph.add_edge(GraphEdge(source=src_role, target="exit"))
43:     else:
44:         # 顺序传递：agent_i → agent_{i+1}
45:         for i in range(len(roles) - 1):
46:             graph.add_edge(GraphEdge(source=roles[i], target=roles[i + 1]))
47:         if roles:
48:             graph.add_edge(GraphEdge(source=roles[-1], target="exit"))
49:     return graph
</file>

