<file path="lca/layer1_cognitive/brain/candidate_evaluation_pipeline.py">
  1: """CandidateEvaluationPipeline —— 将 MAP 四步评估收敛为一个有深度的模块。
  2: 通过构造函数注入 MAP 五模块（TaskDecomposer / StatePredictor / StateEvaluator /
  3: ConflictMonitor / TaskCoordinator），对外只暴露 decompose + evaluate。
  4: 未注入时使用 trivial 默认实现（单候选场景保持链路完整）。
  5: 当未来需要 LLM-based 实现时，只需替换注入的模块实例。
  6: """
  7: from __future__ import annotations
  8: from typing import Any
  9: import structlog
 10: from lca.contracts.decision import StructuredDecision
 11: from lca.contracts.protocols import (
 12:     CandidateEvaluationPipeline,
 13:     CompletionPolicy,
 14:     ConflictMonitor,
 15:     StateEvaluator,
 16:     StatePredictor,
 17:     TaskCoordinator,
 18:     TaskDecomposer,
 19: )
 20: from lca.contracts.state import TypedState
 21: _log = structlog.get_logger("lca.candidate_evaluation_pipeline")
 22: class SimpleCandidateEvaluationPipeline(CandidateEvaluationPipeline):
 23:     """默认评估管线：组合 MAP 模块。
 24:     所有 MAP 模块均可选注入；未注入时使用 trivial 内联默认：
 25:     - decompose: 返回原始任务（不分解）
 26:     - predict: 以候选动作描述作为预期效果
 27:     - score: 始终返回 1.0（单候选场景保持链路完整）
 28:     - conflict check: 不检测冲突
 29:     - arbitrate: 选择得分最高的候选方案
 30:     """
 31:     def __init__(
 32:         self,
 33:         decomposer: TaskDecomposer | None = None,
 34:         predictor: StatePredictor | None = None,
 35:         evaluator: StateEvaluator | None = None,
 36:         conflict_monitor: ConflictMonitor | None = None,
 37:         coordinator: TaskCoordinator | None = None,
 38:     ) -> None:
 39:         self._decomposer = decomposer
 40:         self._predictor = predictor
 41:         self._evaluator = evaluator
 42:         self._conflict_monitor = conflict_monitor
 43:         self._coordinator = coordinator
 44:     async def decompose(self, state: TypedState) -> list[str]:
 45:         if self._decomposer is not None:
 46:             return await self._decomposer.decompose(state)
 47:         return [state.task]
 48:     async def evaluate(
 49:         self,
 50:         state: TypedState,
 51:         candidates: list[StructuredDecision],
 52:     ) -> StructuredDecision:
 53:         predicted = [await self._predict(state, c.rationale) for c in candidates]
 54:         scores = [await self._score(state, p) for p in predicted]
 55:         conflicts = await self._check_conflicts(state, candidates)
 56:         if conflicts:
 57:             _log.warning("conflicts_detected", conflicts=conflicts)
 58:         return await self._arbitrate(state, candidates, scores)
 59:     async def _predict(self, state: TypedState, candidate_action: str) -> dict[str, Any]:
 60:         if self._predictor is not None:
 61:             return await self._predictor.predict(state, candidate_action)
 62:         return {"expected_effect": candidate_action}
 63:     async def _score(self, state: TypedState, predicted_state: dict[str, Any]) -> float:
 64:         if self._evaluator is not None:
 65:             return await self._evaluator.score(state, predicted_state)
 66:         return 1.0
 67:     async def _check_conflicts(
 68:         self, state: TypedState, candidates: list[StructuredDecision]
 69:     ) -> list[str]:
 70:         if self._conflict_monitor is not None:
 71:             return await self._conflict_monitor.check(state, candidates)
 72:         return []
 73:     async def _arbitrate(
 74:         self,
 75:         state: TypedState,
 76:         candidates: list[StructuredDecision],
 77:         scores: list[float],
 78:     ) -> StructuredDecision:
 79:         if self._coordinator is not None:
 80:             return await self._coordinator.arbitrate(state, candidates, scores)
 81:         best_idx = max(range(len(candidates)), key=lambda i: scores[i])
 82:         return candidates[best_idx]
 83: class GuardedCandidateEvaluationPipeline(CandidateEvaluationPipeline):
 84:     """评估管线的装饰器：在 evaluate 结果上叠加 CompletionPolicy guardrail。
 85:     开闭原则应用——不修改内层管线，只在外部包裹策略校验。
 86:     """
 87:     def __init__(
 88:         self,
 89:         inner: CandidateEvaluationPipeline,
 90:         policy: CompletionPolicy,
 91:     ) -> None:
 92:         self._inner = inner
 93:         self._policy = policy
 94:     async def decompose(self, state: TypedState) -> list[str]:
 95:         return await self._inner.decompose(state)
 96:     async def evaluate(
 97:         self,
 98:         state: TypedState,
 99:         candidates: list[StructuredDecision],
100:     ) -> StructuredDecision:
101:         decision = await self._inner.evaluate(state, candidates)
102:         return await self._policy.enforce(state, decision)
</file>

<file path="lca/layer1_cognitive/memory/team_shared_memory.py">
 1: """TeamSharedMemoryStore —— 团队级共享记忆存储。
 2: 只对 semantic / procedural 两层做跨 Agent 共享（CoALA 记忆分类的语义边界：
 3: episodic 是个体的情景经历，working 是当前会话上下文，这两层保持私有）。
 4: """
 5: from __future__ import annotations
 6: from typing import Literal
 7: from lca.contracts.memory import MemoryRecord
 8: from lca.contracts.protocols import SharedMemoryStore
 9: SharedLayerName = Literal["semantic", "procedural"]
10: _VALID_SHARED_LAYERS: frozenset[str] = frozenset({"semantic", "procedural"})
11: class TeamSharedMemoryStore(SharedMemoryStore):
12:     """跨 Agent 共享的记忆存储，按 layer 分流。
13:     每个 layer 维护独立的记录列表，多个 SimpleMemorySystem 实例
14:     持有同一 store 的引用，实现"共享即同一数据源"。
15:     """
16:     def __init__(self, shared_layers: list[str]) -> None:
17:         invalid = set(shared_layers) - _VALID_SHARED_LAYERS
18:         if invalid:
19:             raise ValueError(f"只有 semantic/procedural 层可以共享，非法层: {invalid}")
20:         self._shared_layers: list[str] = list(shared_layers)
21:         self._stores: dict[str, list[MemoryRecord]] = {layer: [] for layer in shared_layers}
22:     @property
23:     def shared_layers(self) -> list[str]:
24:         return list(self._shared_layers)
25:     def is_shared(self, layer: str) -> bool:
26:         return layer in self._stores
27:     def add_record(self, layer: str, record: MemoryRecord) -> None:
28:         if layer not in self._stores:
29:             raise KeyError(f"层 {layer!r} 不在共享范围内")
30:         self._stores[layer].append(record)
31:     def get_records(self, layer: str) -> list[MemoryRecord]:
32:         if layer not in self._stores:
33:             raise KeyError(f"层 {layer!r} 不在共享范围内")
34:         return list(self._stores[layer])
</file>

