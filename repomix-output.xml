<file path="lca/contracts/budget.py">
 1: """Budget 单一事实来源工厂 —— 消除配置分叉。
 2: L0 配置层：系统中所有 Budget 构造必须经过此工厂，
 3: 禁止在别处直接 Budget(max_steps=N) 式裸构造并携带默认值。
 4: 配置合并优先级：显式传参 > 调用方传入 > 全局默认。
 5: """
 6: from __future__ import annotations
 7: from lca.contracts.state import Budget
 8: _DEFAULT_MAX_STEPS = 10
 9: _DEFAULT_MAX_WALL_CLOCK_SECONDS = 30
10: def create_budget(
11:     max_steps: int = _DEFAULT_MAX_STEPS,
12:     max_wall_clock_seconds: int | None = _DEFAULT_MAX_WALL_CLOCK_SECONDS,
13:     max_tokens: int | None = None,
14:     max_cost_usd: float | None = None,
15: ) -> Budget:
16:     """Budget 唯一构造入口。
17:     所有运行时 Budget 必须由此函数生成，确保 max_steps 等参数
18:     从 Agent 声明处一路透传，不会出现"声明 20 实际跑 10"的分叉。
19:     ``max_wall_clock_seconds`` 传 ``None`` 表示不设墙钟超时（仅靠步数兜底）。
20:     """
21:     return Budget(
22:         max_steps=max_steps,
23:         max_wall_clock_seconds=max_wall_clock_seconds,
24:         max_tokens=max_tokens,
25:         max_cost_usd=max_cost_usd,
26:     )
