  1: """L4 极简开发者 API —— 三行创建 Agent，五行组建团队。
  2: 支持通过注册表名字字符串或自定义协议实例来选择组件实现，
  3: 无需修改框架源码即可替换任何可插拔组件。
  4: """
  5: from __future__ import annotations
  6: from typing import TypeVar, cast
  7: import lca.layer4_app.defaults  # noqa: F401 — 触发默认注册
  8: from lca.contracts.protocols import (
  9:     BrainStrategy,
 10:     EventBus,
 11:     LLMAdapter,
 12:     MemorySystem,
 13:     Observability,
 14:     StateStore,
 15:     TeamEntrypoint,
 16:     Tool,
 17: )
 18: from lca.contracts.result import Result
 19: from lca.contracts.role_team import RoleProfile, TeamConfig, ToolPermissionManifest
 20: from lca.layer0_infra.registry import ComponentRegistry, get_global_registry
 21: from lca.layer1_cognitive.body.action_handlers import build_default_action_registry
 22: from lca.layer1_cognitive.body.safe_executor import SimpleSafeExecutor
 23: from lca.layer1_cognitive.body.tool_registry import SimpleToolRegistry
 24: from lca.layer3_agent.base_agent import BaseAgent
 25: from lca.layer3_agent.supervisor import Supervisor
 26: from lca.layer3_agent.team_orchestrator import TeamOrchestrator
 27: T = TypeVar("T")
 28: class Agent:
 29:     """
 30:     三行上手的开发者入口：内部完成 L0-L3 全部对象的 DI 组装。
 31:     用法：
 32:         agent = Agent(role="研究员", goal="产出分析报告", backstory="十年经验", tools=[...], llm=llm)
 33:         result = await agent.run("分析新能源电池行业趋势")
 34:     可插拔参数（接受注册表名字字符串或满足协议的自定义实例）：
 35:         memory          — 默认 "simple"
 36:         observability   — 默认 "console"
 37:         state_store     — 默认 "memory"
 38:         brain_strategy  — 默认 "default"（ModularBrain + MAP 五模块）
 39:     """
 40:     def __init__(
 41:         self,
 42:         role: str,
 43:         goal: str,
 44:         backstory: str,
 45:         tools: list[Tool],
 46:         llm: LLMAdapter,
 47:         max_steps: int = 10,
 48:         max_wall_clock_seconds: int | None = 300,
 49:         memory: str | MemorySystem = "simple",
 50:         observability: str | Observability = "console",
 51:         state_store: str | StateStore = "memory",
 52:         brain_strategy: str | BrainStrategy = "default",
 53:     ):
 54:         reg = get_global_registry()
 55:         permission_manifest = ToolPermissionManifest(allowed_tools=[t.name for t in tools])
 56:         role_profile = RoleProfile(
 57:             role=role,
 58:             goal=goal,
 59:             backstory=backstory,
 60:             tool_permission_manifest=permission_manifest,
 61:         )
 62:         obs = self._resolve(reg, "observability", observability)
 63:         mem = self._resolve(reg, "memory", memory)
 64:         ss = self._resolve(reg, "state_store", state_store)
 65:         # 构建 ActionRegistry —— Body 和 DecisionParser 共享同一实例，
 66:         # 保证"执行器支持什么"与"解析器校验什么"永远一致
 67:         tool_reg = SimpleToolRegistry()
 68:         for t in tools:
 69:             tool_reg.register(t)
 70:         safe_exec = SimpleSafeExecutor(
 71:             ToolPermissionManifest(allowed_tools=[t.name for t in tools]), obs
 72:         )
 73:         from lca.layer4_app.defaults import build_default_transport_registry
 74:         transport_reg = build_default_transport_registry()
 75:         action_registry = build_default_action_registry(tool_reg, safe_exec, transport_reg)
 76:         # 解析 BrainStrategy：字符串走 StrategyRegistry（验证存在性），实例直接使用
 77:         brain: BrainStrategy
 78:         if isinstance(brain_strategy, str):
 79:             from lca.layer2_runtime.strategy_registry import get_global_strategy_registry
 80:             strategy_reg = get_global_strategy_registry()
 81:             if strategy_reg.resolve(brain_strategy) is None:
 82:                 raise ValueError(
 83:                     f"Unknown brain_strategy: {brain_strategy!r}. Available: {strategy_reg.list()}"
 84:                 )
 85:             tools_desc = ", ".join(t.name for t in tools) or "(无可用工具)"
 86:             from lca.layer4_app.defaults import _build_brain
 87:             brain = _build_brain(llm, role_profile, tools_desc, action_registry=action_registry)
 88:         else:
 89:             brain = brain_strategy
 90:         from lca.layer2_runtime.outcome_policies.default_outcome_policy import (
 91:             DefaultStepOutcomePolicy,
 92:         )
 93:         from lca.layer4_app.defaults import (
 94:             _build_hooks,
 95:             build_body,
 96:             build_runtime,
 97:         )
 98:         body = build_body(
 99:             tools, obs, transport_registry=transport_reg, action_registry=action_registry
100:         )
101:         event_bus: EventBus = self._resolve(reg, "event_bus", "simple")
102:         hooks = _build_hooks(obs, event_bus)
103:         runtime = build_runtime(
104:             brain, body, mem, hooks, ss, outcome_policy=DefaultStepOutcomePolicy()
105:         )
106:         self._base_agent = BaseAgent(
107:             runtime,
108:             role_profile,
109:             max_steps=max_steps,
110:             max_wall_clock_seconds=max_wall_clock_seconds,
111:         )
112:     @staticmethod
113:     def _resolve(reg: ComponentRegistry, category: str, value: str | T) -> T:
114:         if isinstance(value, str):
115:             impl = reg.resolve(category, value)
116:             if impl is None:
117:                 raise ValueError(f"Unknown {category}: {value!r}. Available: {reg.list(category)}")
118:             return cast("T", impl())
119:         return value
120:     async def run(self, task: str) -> Result:
121:         return await self._base_agent.execute(task)
122:     def _as_supervisor(self) -> Supervisor:
123:         rp = self._base_agent.role_profile
124:         ms = self._base_agent.max_steps
125:         wc = self._base_agent.max_wall_clock_seconds
126:         return Supervisor(
127:             self._base_agent.runtime,
128:             rp,
129:             max_steps=max(ms, 20),
130:             max_wall_clock_seconds=max(wc, 300) if wc else 300,
131:         )
132: class MultiAgentTeam:
133:     """
134:     五行组建团队。
135:     用法：
136:         team = MultiAgentTeam(
137:             members=[researcher, writer, critic],
138:             process="hierarchical",
139:             supervisor=supervisor_agent,
140:         )
141:         result = await team.run("产出行业研究报告")
142:     """
143:     def __init__(
144:         self,
145:         members: list[Agent],
146:         process: str = "hierarchical",
147:         supervisor: Agent | None = None,
148:         max_rounds: int | None = None,
149:     ):
150:         config = TeamConfig(
151:             process=process,  # type: ignore[arg-type]
152:             max_rounds=max_rounds,
153:         )
154:         base_members = [m._base_agent for m in members]
155:         base_supervisor = supervisor._as_supervisor() if supervisor else None
156:         from lca.layer4_app.defaults import build_team_transport
157:         transport, roster_desc = build_team_transport(base_members)
158:         self._orchestrator: TeamEntrypoint = TeamOrchestrator(
159:             base_members,
160:             config,
161:             base_supervisor,
162:             transport=transport,
163:             roster_desc=roster_desc,
164:         )
165:     async def run(self, objective: str) -> Result:
166:         return await self._orchestrator.run(objective)
