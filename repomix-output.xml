<file path="lca/layer2_runtime/fallback_handler.py">
 1: """FallbackActionHandler —— 未知 action 的链式降级（Chain of Responsibility）。
 2: L4 韧性层：当 ActionRegistry 无法解析 action_type 时，
 3: 按优先级尝试降级策略，避免"契约违反"直接升级为"业务失败"。
 4: 降级优先级：
 5:   1. 有 response_text → 语义等价于 respond
 6:   2. 有 tool_calls   → 语义等价于 use_tool
 7:   3. 都没有          → 不可恢复失败
 8: """
 9: from __future__ import annotations
10: import uuid
11: from lca.contracts.action import ActionRegistryProtocol
12: from lca.contracts.decision import Observation, StructuredDecision
13: from lca.contracts.protocols import FallbackHandler
14: from lca.contracts.state import TypedState
15: FALLBACK_DEGRADATION_KEY = "degraded_from_action_type"
16: def _new_id(prefix: str) -> str:
17:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
18: class FallbackActionHandler(FallbackHandler):
19:     """未知 action_type 的兜底处理器。
20:     本身不注册到 ActionRegistry 中（Registry 是无状态纯路由），
21:     而是由 Body 装饰器（FallbackDecoratedBody）在捕获到
22:     "未注册的 action_type" 错误时显式调用。
23:     """
24:     async def handle(
25:         self,
26:         decision: StructuredDecision,
27:         state: TypedState,
28:         action_registry: ActionRegistryProtocol | None = None,
29:     ) -> Observation:
30:         original_action_type = decision.action_type
31:         if action_registry is None:
32:             return Observation(
33:                 observation_id=_new_id("obs"),
34:                 success=False,
35:                 payload=None,
36:                 error=f"无法识别的 action_type '{original_action_type}' 且无可用的 ActionRegistry",
37:                 extra={FALLBACK_DEGRADATION_KEY: original_action_type},
38:             )
39:         # 策略 1：有 response_text → 降级为 respond
40:         if decision.response_text:
41:             respond_handler = action_registry.resolve("respond")
42:             if respond_handler is not None:
43:                 observation = await respond_handler.execute(decision, state)
44:                 observation.extra[FALLBACK_DEGRADATION_KEY] = original_action_type
45:                 return observation
46:         # 策略 2：有 tool_calls → 降级为 use_tool
47:         if decision.tool_calls:
48:             use_tool_handler = action_registry.resolve("use_tool")
49:             if use_tool_handler is not None:
50:                 observation = await use_tool_handler.execute(decision, state)
51:                 observation.extra[FALLBACK_DEGRADATION_KEY] = original_action_type
52:                 return observation
53:         # 策略 3：不可恢复失败
54:         return Observation(
55:             observation_id=_new_id("obs"),
56:             success=False,
57:             payload=None,
58:             error=f"无法识别的 action_type '{original_action_type}' 且无可用降级路径",
59:             extra={FALLBACK_DEGRADATION_KEY: original_action_type},
60:         )
</file>

<file path="lca/layer2_runtime/hooks.py">
 1: """生命周期钩子清单与默认事件发布钩子。"""
 2: from __future__ import annotations
 3: from collections.abc import Awaitable, Callable
 4: from typing import Any
 5: from lca.contracts.protocols import EventBus
 6: from lca.contracts.state import TypedState
 7: from lca.layer2_runtime.fallback_handler import FALLBACK_DEGRADATION_KEY
 8: HOOK_NAMES = [
 9:     "on_start",
10:     "pre_perceive",
11:     "post_perceive",
12:     "pre_think",
13:     "post_think",
14:     "pre_act",
15:     "post_act",
16:     "pre_reflect",
17:     "post_reflect",
18:     "on_error",
19:     "on_pause",
20:     "on_complete",
21: ]
22: def make_event_emitting_hook(
23:     event_bus: EventBus,
24: ) -> Callable[..., Awaitable[None]]:
25:     """工厂：创建将 Loop 事件桥接到 EventBus 的钩子函数。
26:     注册到 post_act（检测降级事件）和 post_reflect（发布 step_completed），
27:     使 Loop 本体不再直接调用 event_bus.emit()。
28:     """
29:     async def _event_emitting_hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
30:         if event_name == "post_act":
31:             observation = kwargs.get("observation")
32:             if (
33:                 observation is not None
34:                 and getattr(observation, "success", False)
35:                 and FALLBACK_DEGRADATION_KEY in getattr(observation, "extra", {})
36:             ):
37:                 event_bus.emit(
38:                     "action_degraded",
39:                     {
40:                         "original_action_type": observation.extra[FALLBACK_DEGRADATION_KEY],
41:                         "degraded_to": "respond",
42:                         "step": state.step,
43:                     },
44:                     state.trace_id,
45:                 )
46:         elif event_name == "post_reflect":
47:             event_bus.emit(
48:                 "step_completed",
49:                 {"step": state.step, "status": state.status},
50:                 state.trace_id,
51:             )
52:     return _event_emitting_hook
</file>

