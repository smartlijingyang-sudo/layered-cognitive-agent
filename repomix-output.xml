 9: # 跨异步链路传递当前委派者角色：A delegate → B 时，A 的 role 写入此 var，
10: # B 的 handler 读取后注入到 TypedState.delegated_by。
11: _current_delegator: ContextVar[str] = ContextVar("current_delegator", default="")
12: def _now() -> datetime:
13:     return datetime.now(timezone.utc)
14: def _new_id(prefix: str) -> str:
15:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
16: @dataclass
17: class Budget:
18:     max_tokens: int | None = None
19:     max_cost_usd: float | None = None
20:     max_steps: int | None = None
21:     max_wall_clock_seconds: int | None = None
22:     used_tokens: int = 0
23:     used_cost_usd: float = 0.0
24:     used_steps: int = 0
25:     started_at: datetime = field(default_factory=_now)
26:     extra: dict[str, Any] = field(default_factory=dict)
27:     def exceeded(self) -> bool:
28:         if self.max_steps is not None and self.used_steps > self.max_steps:
29:             return True
30:         if self.max_wall_clock_seconds is not None:
31:             elapsed = (_now() - self.started_at).total_seconds()
32:             if elapsed > self.max_wall_clock_seconds:
33:                 return True
34:         return False
35: @dataclass
