<file path="lca/contracts/action.py">
 1: """Action 能力契约 —— ActionHandler Protocol + ActionRegistry Protocol。
 2: L1 契约层：定义"什么是一个合法的 Agent 行动"以及"如何路由到对应处理器"。
 3: 全系统的唯一事实来源：Prompt 枚举、Schema 校验、执行分发均从此处派生。
 4: """
 5: from __future__ import annotations
 6: from typing import Protocol, runtime_checkable
 7: from lca.contracts.decision import Observation, StructuredDecision
 8: from lca.contracts.state import TypedState
 9: @runtime_checkable
10: class ActionHandler(Protocol):
11:     """单一行动能力的处理器接口（Strategy Pattern）。
12:     每种 action_type 对应一个独立实现，彼此零依赖、零共享可变状态。
13:     新增行动能力 = 新增一个 Handler + 一条注册，不修改任何既有代码路径。
14:     """
15:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation: ...
16: @runtime_checkable
17: class ActionRegistryProtocol(Protocol):
18:     """Action 能力注册表接口。
19:     无状态纯路由，不承载业务逻辑、不承载降级逻辑。
20:     """
21:     def register(self, action_type: str, handler: ActionHandler) -> None: ...
22:     def resolve(self, action_type: str) -> ActionHandler | None: ...
23:     def allowed_action_types(self) -> list[str]: ...
24:     def is_registered(self, action_type: str) -> bool: ...
25: class ActionRegistry:
26:     """Action 能力注册表 —— 开闭原则的标准落地。
27:     无状态纯路由，不承载业务逻辑、不承载降级逻辑。
28:     降级属于韧性层（L4）职责，由 FallbackActionHandler 独立处理。
29:     """
30:     def __init__(self) -> None:
31:         self._handlers: dict[str, ActionHandler] = {}
32:     def register(self, action_type: str, handler: ActionHandler) -> None:
33:         """注册一个 ActionHandler 到指定 action_type。"""
34:         self._handlers[action_type] = handler
35:     def resolve(self, action_type: str) -> ActionHandler | None:
36:         """解析 action_type 对应的 Handler；未注册时返回 None（交由韧性层降级）。"""
37:         return self._handlers.get(action_type)
38:     def allowed_action_types(self) -> list[str]:
39:         """返回所有已注册的 action_type 集合 —— Prompt / Schema / 测试的唯一事实来源。"""
40:         return sorted(self._handlers.keys())
41:     def is_registered(self, action_type: str) -> bool:
42:         """判断 action_type 是否已注册。"""
43:         return action_type in self._handlers
</file>

