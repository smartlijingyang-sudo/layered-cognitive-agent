 1: """Supervisor —— 本质上是 BaseAgent，专责任务拆解与路由。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import AgentTransport, Runtime
 4: from lca.contracts.role_team import RoleProfile
 5: from lca.layer3_agent.base_agent import BaseAgent
 6: class Supervisor(BaseAgent):
 7:     """
 8:     Supervisor 本身就是一个 BaseAgent（复用同一套认知闭环），
 9:     区别是其 StructuredDecision 里携带 delegate_to（DelegationSpec）。
10:     """
11:     def __init__(
12:         self,
13:         runtime: Runtime,
14:         role_profile: RoleProfile,
15:         max_steps: int = 20,
16:         max_wall_clock_seconds: int | None = 300,
17:     ):
18:         super().__init__(
19:             runtime,
20:             role_profile,
21:             max_steps=max_steps,
22:             max_wall_clock_seconds=max_wall_clock_seconds,
23:         )
24:     def bind_team(self, transport: AgentTransport, roster_desc: str) -> None:
25:         """团队组建完成后的最后一次接线。
26:         通过 Runtime.configure() 显式协议分发能力，
27:         不再越层访问 L1 组件内部状态。
28:         """
29:         self.runtime.configure(transport=transport, team_roster=roster_desc)
