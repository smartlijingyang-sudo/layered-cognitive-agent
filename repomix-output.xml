<file path="lca/layer1_cognitive/brain/synthesizer.py">
 1: """Synthesizer 默认实现 —— MoA 聚合层。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import Synthesizer
 4: from lca.contracts.result import Result
 5: from lca.contracts.state import Budget
 6: class ConcatSynthesizer(Synthesizer):
 7:     """简单拼接聚合：将所有候选结果的 output 用分隔符连接。
 8:     最基础的 Synthesizer 实现，用于打底和测试。
 9:     进阶实现（LLMSynthesizer）将调用 LLM 做 Layer-2 提炼。
10:     """
11:     def __init__(self, separator: str = "\n\n---\n\n") -> None:
12:         self._separator = separator
13:     async def synthesize(self, objective: str, candidates: list[Result]) -> Result:
14:         if not candidates:
15:             return Result.failed("No candidates to synthesize")
16:         outputs: list[str] = []
17:         total_steps = 0
18:         aggregated_budget = Budget()
19:         all_lessons: list[str] = []
20:         any_completed = False
21:         for i, candidate in enumerate(candidates):
22:             if candidate.output:
23:                 outputs.append(f"[Candidate {i + 1}]\n{candidate.output}")
24:             total_steps += candidate.total_steps
25:             if candidate.budget_used is not None:
26:                 aggregated_budget.used_tokens += candidate.budget_used.used_tokens
27:                 aggregated_budget.used_cost_usd += candidate.budget_used.used_cost_usd
28:                 aggregated_budget.used_steps += candidate.budget_used.used_steps
29:             all_lessons.extend(candidate.lessons)
30:             if candidate.status == "completed":
31:                 any_completed = True
32:         synthesized_output = self._separator.join(outputs) if outputs else None
33:         return Result(
34:             trace_id=candidates[0].trace_id,
35:             status="completed" if any_completed else "failed",
36:             final_state_ref="",
37:             total_steps=total_steps,
38:             budget_used=aggregated_budget,
39:             output=synthesized_output,
40:             lessons=all_lessons,
41:             extra={"synthesis_method": "concat", "candidate_count": len(candidates)},
42:         )
</file>

