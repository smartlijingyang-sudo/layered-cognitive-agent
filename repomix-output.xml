 1: """L0 基础设施协议 —— LLM / Tool / StateStore / Transport / Observability。"""
 2: from __future__ import annotations
 3: from collections.abc import AsyncIterator
 4: from typing import Any, Protocol, runtime_checkable
 5: from lca.contracts.decision import AgentCard, Observation
 6: from lca.contracts.observability import TraceSpan
 7: from lca.contracts.role_team import CacheConfig, RetryPolicy
 8: from lca.contracts.state import TypedState
 9: @runtime_checkable
10: class LLMAdapter(Protocol):
11:     """LLM 适配器接口：屏蔽 provider 差异。"""
12:     async def complete(self, prompt: str, **kwargs: Any) -> str: ...
13:     async def stream(self, prompt: str, **kwargs: Any) -> AsyncIterator[str]:
14:         """流式输出，逐 chunk 返回文本。子类按需覆写。"""
15:         ...
16:         yield ""  # pragma: no cover
17: @runtime_checkable
18: class Tool(Protocol):
19:     """工具能力接口：名称 + 幂等标志 + 执行 + 可选校验。"""
20:     name: str
21:     is_idempotent: bool
22:     default_timeout_s: int
23:     async def execute(self, args: dict[str, Any]) -> Observation: ...
24:     def validate(self, args: dict[str, Any]) -> str | None:
25:         """可选前置校验：返回 None 表示合法，返回错误字符串表示非法。"""
26:         return None  # pragma: no cover
27: @runtime_checkable
28: class ToolRegistry(Protocol):
29:     """工具注册表：按名称注册和查找 Tool。"""
30:     def register(self, tool: Tool) -> None: ...
31:     def get(self, name: str) -> Tool | None: ...
32: @runtime_checkable
33: class SafeExecutor(Protocol):
34:     """安全执行器：带重试 + 缓存的工具执行包装。"""
35:     async def execute(
36:         self,
37:         tool: Tool,
38:         args: dict[str, Any],
39:         retry_policy: RetryPolicy,
40:         cache_config: CacheConfig,
41:     ) -> Observation: ...
42: @runtime_checkable
43: class StateStore(Protocol):
44:     """状态持久化：save / load TypedState。"""
45:     async def save(self, state: TypedState) -> str: ...
46:     async def load(self, state_ref: str) -> TypedState: ...
47: @runtime_checkable
48: class AgentTransport(Protocol):
49:     """Agent 间通信传输抽象：send → poll → receive。"""
50:     protocol_name: str
51:     async def send_task(
52:         self, agent_card: AgentCard | str, subtask: str, context_refs: list[str]
53:     ) -> str: ...
54:     async def poll_status(self, task_id: str) -> str: ...
55:     async def receive_result(self, task_id: str) -> Observation: ...
56:     async def wait_result(self, task_id: str, timeout_s: float | None = None) -> Observation:
57:         """等待任务完成并返回结果。
58:         默认实现可用 poll 循环；进程内传输应覆写为 Future/Event。
59:         协议层声明此方法以便结构性检查；旧适配器可用 ``hasattr`` 兼容。
60:         """
61:         ...
62: @runtime_checkable
63: class TransportRegistryProtocol(Protocol):
64:     """传输注册表接口：按 protocol_name 路由 AgentTransport 实现。"""
65:     def register(self, transport: AgentTransport) -> None: ...
66:     def resolve(self, protocol_name: str) -> AgentTransport: ...
67:     def list_protocols(self) -> list[str]: ...
68: @runtime_checkable
69: class Observability(Protocol):
70:     """可观测性后端：接收 TraceSpan 并输出。"""
71:     def emit_span(self, span: TraceSpan) -> None: ...
