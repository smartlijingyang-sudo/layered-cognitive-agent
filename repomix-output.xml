<file path="lca/layer1_cognitive/team_progress/delegation_ledger.py">
 1: """DelegationLedger —— DelegationLedgerProtocol 的默认不可变实现。"""
 2: from __future__ import annotations
 3: from dataclasses import dataclass, field
 4: from lca.contracts.enums import RoleStatus
 5: @dataclass(frozen=True)
 6: class DelegationLedger:
 7:     """不可变团队委派进度台账。
 8:     ``mark()`` 返回新实例（frozen dataclass），保证状态更新显式且可追溯。
 9:     """
10:     mandatory_roles: frozenset[str]
11:     status: dict[str, RoleStatus] = field(default_factory=dict)
12:     def __post_init__(self) -> None:
13:         for role in self.mandatory_roles:
14:             if role not in self.status:
15:                 object.__setattr__(self, "status", {**self.status, role: RoleStatus.PENDING})
16:     def mark(self, role: str, new_status: RoleStatus) -> DelegationLedger:
17:         """不可变更新：返回新实例，原实例不变。"""
18:         updated = {**self.status, role: new_status}
19:         return DelegationLedger(mandatory_roles=self.mandatory_roles, status=updated)
20:     def is_covered(self) -> bool:
21:         """所有必需角色都已完成（done）。"""
22:         return all(self.status.get(r) == RoleStatus.DONE for r in self.mandatory_roles)
23:     def pending_roles(self) -> list[str]:
24:         """尚未完成的角色列表（保持 mandatory_roles 的迭代顺序）。"""
25:         return [r for r in self.mandatory_roles if self.status.get(r) != RoleStatus.DONE]
</file>

