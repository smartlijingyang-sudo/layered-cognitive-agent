<file path="lca/layer0_infra/registry.py">
 1: """注册表基础设施 —— ComponentRegistry + NamedRegistry 泛型基类。"""
 2: from __future__ import annotations
 3: from typing import Any, Generic, TypeVar
 4: from lca.contracts.protocols import RegistryProtocol
 5: _T = TypeVar("_T")
 6: class RegistryKeyError(ValueError):
 7:     """按名称查找注册表条目失败。
 8:     继承 ValueError 以保持向后兼容（已有测试 assertRaises(ValueError)）。
 9:     """
10:     def __init__(self, key: str, registry_kind: str, available: list[str]) -> None:
11:         self.key = key
12:         self.registry_kind = registry_kind
13:         self.available = available
14:         super().__init__(f"未注册{registry_kind} {key!r}，可用: {available}")
15: class NamedRegistry(RegistryProtocol, Generic[_T]):
16:     """按名称注册和解析实体的泛型基类。
17:     子类通过 ``_REGISTRY_KIND`` 声明种类名（用于错误消息），
18:     可选择覆盖 ``resolve()`` 以改变解析语义（如工厂调用、类型转换）。
19:     """
20:     _REGISTRY_KIND: str = "条目"
21:     def __init__(self) -> None:
22:         self._entries: dict[str, _T] = {}
23:     def register(self, name: str, impl: _T) -> None:
24:         self._entries[name] = impl
25:     def resolve(self, name: str) -> _T:
26:         impl = self._entries.get(name)
27:         if impl is None:
28:             raise RegistryKeyError(name, self._REGISTRY_KIND, self.list())
29:         return impl
30:     def list(self) -> list[str]:
31:         return list(self._entries.keys())
32:     def __contains__(self, name: str) -> bool:
33:         return name in self._entries
34: class ComponentRegistry:
35:     """按 (category, name) 注册和解析组件实现。
36:     category 例如 "observability"、"memory"、"state_store" 等；
37:     name 是用户可见的实现名称，例如 "console"、"simple" 等。
38:     值可以是类（无参构造）或工厂函数（接受上下文参数）。
39:     """
40:     def __init__(self) -> None:
41:         self._registries: dict[str, dict[str, Any]] = {}
42:     def register(self, category: str, name: str, impl: Any) -> None:
43:         self._registries.setdefault(category, {})[name] = impl
44:     def resolve(self, category: str, name: str) -> Any | None:
45:         return self._registries.get(category, {}).get(name)
46:     def list(self, category: str) -> list[str]:
47:         return list(self._registries.get(category, {}).keys())
48:     def get_registry(self, category: str) -> dict[str, Any]:
49:         return self._registries.get(category, {})
50: _global_registry = ComponentRegistry()
51: def get_global_registry() -> ComponentRegistry:
52:     return _global_registry
</file>

<file path="lca/layer1_cognitive/brain/critic.py">
 1: """Critic —— 事后自省与纠偏。"""
 2: from __future__ import annotations
 3: import uuid
 4: from typing import Any
 5: from lca.contracts.decision import Observation, Reflection
 6: from lca.contracts.protocols import Critic
 7: from lca.contracts.state import TypedState
 8: def _new_id(prefix: str) -> str:
 9:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
10: _FAILURE_KIND_HINT: dict[str, str] = {
11:     "validation": "参数不合法，请重复同一动作，须修正参数后重新调用",
12:     "execution": "工具执行失败",
13:     "transient": "瞬时性错误，可重试",
14: }
15: class SimpleCritic(Critic):
16:     """基于执行结果生成反思。"""
17:     async def critique(self, state: TypedState, observation: Observation) -> Reflection:
18:         if observation.success:
19:             return Reflection(
20:                 reflection_id=_new_id("refl"),
21:                 verdict="on_track",
22:                 lesson=f"步骤{state.step}成功完成" if observation.payload is not None else None,
23:             )
24:         failure_kind = self._extract_failure_kind(observation)
25:         hint = _FAILURE_KIND_HINT.get(failure_kind, "步骤失败")
26:         lesson = f"步骤{state.step}失败({hint}): {observation.error}"
27:         return Reflection(
28:             reflection_id=_new_id("refl"),
29:             verdict="needs_correction",
30:             lesson=lesson,
31:             extra={"failure_kind": failure_kind},
32:         )
33:     @staticmethod
34:     def _extract_failure_kind(observation: Observation) -> str:
35:         kind: Any = observation.extra.get("failure_kind")
36:         if isinstance(kind, str) and kind in _FAILURE_KIND_HINT:
37:             return kind
38:         return "execution"
</file>

