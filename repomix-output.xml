<file path="lca/layer3_agent/simple_agent.py">
 1: """SimpleAgent —— 单个 Agent 的运行时封装。
 2: L3 层职责：
 3:     SimpleAgent 是 AgentEntrypoint 协议的默认实现，
 4:     将 Runtime（认知闭环）+ RoleProfile（角色配置）组合为
 5:     可调度的执行单元。支持 execute / resume / cancel 三种生命周期。
 6: """
 7: from __future__ import annotations
 8: from lca.contracts.budget import DEFAULT_MAX_STEPS
 9: from lca.contracts.invocation import InvocationContext
10: from lca.contracts.mechanisms import Hook
11: from lca.contracts.message import AgentMessage, agent_message_as_text, agent_message_text
12: from lca.contracts.protocols import AgentEntrypoint, CompletionPolicy, Runtime
13: from lca.contracts.protocols.capabilities import HookRegistryHolder
14: from lca.contracts.result import Result
15: from lca.contracts.role_team import RoleProfile
16: from lca.contracts.state import StateSnapshot
17: from lca.contracts.team_progress import DelegationLedgerProtocol
18: def _task_as_text(task: str | AgentMessage) -> str:
19:     if isinstance(task, AgentMessage):
20:         return agent_message_as_text(task)
21:     return task
22: class SimpleAgent(AgentEntrypoint):
23:     """单个 Agent 的运行时封装。
24:     持有 Runtime（认知闭环）和 RoleProfile（角色配置），
25:     提供 execute / resume / cancel 三种生命周期方法。
26:     """
27:     def __init__(
28:         self,
29:         runtime: Runtime,
30:         role_profile: RoleProfile,
31:         max_steps: int = DEFAULT_MAX_STEPS,
32:         max_wall_clock_seconds: int | None = None,
33:     ) -> None:
34:         self.runtime = runtime
35:         self.role_profile = role_profile
36:         self.max_steps = max_steps
37:         self.max_wall_clock_seconds = max_wall_clock_seconds
38:     async def execute(
39:         self,
40:         task: str | AgentMessage,
41:         ctx: InvocationContext | None = None,
42:         team_progress: DelegationLedgerProtocol | None = None,
43:         **context: str,
44:     ) -> Result:
45:         text = _task_as_text(task)
46:         if ctx is not None:
47:             if ctx.delegated_by:
48:                 context.setdefault("delegated_by", ctx.delegated_by)
49:             if ctx.trace_id:
50:                 context.setdefault("trace_id", ctx.trace_id)
51:         return await self.runtime.run(
52:             text,
53:             max_steps=self.max_steps,
54:             max_wall_clock_seconds=self.max_wall_clock_seconds,
55:             team_progress=team_progress,
56:             agent_role=self.role_profile.role,
57:             **context,
58:         )
59:     async def resume(
60:         self,
61:         snapshot: StateSnapshot,
62:         input: str | AgentMessage | None = None,
63:     ) -> Result:
64:         msg = None
65:         if isinstance(input, AgentMessage):
66:             msg = input
67:         elif isinstance(input, str):
68:             msg = agent_message_text(input)
69:         return await self.runtime.resume(snapshot, input=msg, max_steps=self.max_steps)
70:     async def cancel(self) -> None:
71:         """尽力取消；默认 Runtime 无全局 cancel 时为 no-op。"""
72:         return None
73:     def register_hook(self, hook_name: str, hook_fn: Hook) -> None:
74:         """注册 Hook 到 Runtime 的 HookRegistry。"""
75:         runtime = self.runtime
76:         if isinstance(runtime, HookRegistryHolder):
77:             runtime.hooks.register(hook_name, hook_fn)
78:     def install_completion_guard(self, policy: CompletionPolicy) -> None:
79:         """通过 Runtime 协议安装确定性收尾 guardrail。"""
80:         self.runtime.install_completion_guard(policy)
81: # Transitional alias — remove after one release cycle (ADR-0021).
82: BaseAgent = SimpleAgent
</file>

