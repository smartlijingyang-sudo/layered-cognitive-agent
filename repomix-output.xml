<file path="lca/layer2_runtime/default_loop_judge.py">
 1: """DefaultLoopJudge —— 组合 StepOutcomePolicy + Budget 的默认终止裁判。
 2: L2 层职责：
 3:     将原先散落在 CognitiveRuntime._loop 中的三种终止判定
 4:     （budget 超限 / outcome 策略 / 异常状态）收敛为单一内聚类。
 5:     判定流程：
 6:     1. 调用 StepOutcomePolicy.resolve() 获取业务判定
 7:     2. 检查 budget 是否超限（资源约束）
 8:     3. 综合输出 TerminationSignal
 9: """
10: from __future__ import annotations
11: from lca.contracts.decision import Observation, Reflection, StructuredDecision
12: from lca.contracts.lifecycle import TaskStatus
13: from lca.contracts.loop_judge import LoopJudge, TerminationReason, TerminationSignal
14: from lca.contracts.protocols import StepOutcomePolicy
15: from lca.contracts.state import TypedState
16: class DefaultLoopJudge(LoopJudge):
17:     """默认循环终止裁判。
18:     组合 StepOutcomePolicy（业务判定）与 Budget 检查（资源约束），
19:     输出统一的 TerminationSignal。
20:     """
21:     def __init__(self, outcome_policy: StepOutcomePolicy) -> None:
22:         self._outcome_policy = outcome_policy
23:     def judge(
24:         self,
25:         state: TypedState,
26:         decision: StructuredDecision | None,
27:         observation: Observation | None,
28:         reflection: Reflection | None,
29:     ) -> TerminationSignal:
30:         outcome = self._outcome_policy.resolve(state, decision, observation, reflection)
31:         if outcome.final_output is not None:
32:             state.final_output = outcome.final_output
33:         if state.budget.exceeded():
34:             return self._on_budget_exceeded(observation, state)
35:         if outcome.should_stop:
36:             return TerminationSignal(
37:                 should_stop=True,
38:                 reason=TerminationReason.TASK_COMPLETED,
39:                 final_output=state.final_output if isinstance(state.final_output, str) else None,
40:                 status=_coerce_status(outcome.status) or TaskStatus.COMPLETED,
41:             )
42:         return TerminationSignal()
43:     def _on_budget_exceeded(
44:         self,
45:         observation: Observation | None,
46:         state: TypedState,
47:     ) -> TerminationSignal:
48:         budget_outcome = self._outcome_policy.resolve_budget_exceeded(observation, state)
49:         if budget_outcome.final_output is not None:
50:             state.final_output = budget_outcome.final_output
51:         return TerminationSignal(
52:             should_stop=True,
53:             reason=TerminationReason.BUDGET_EXCEEDED,
54:             final_output=state.final_output if isinstance(state.final_output, str) else None,
55:             status=_coerce_status(budget_outcome.status) or TaskStatus.FAILED,
56:         )
57: _STATUS_MAP: dict[str, TaskStatus] = {
58:     "completed": TaskStatus.COMPLETED,
59:     "failed": TaskStatus.FAILED,
60:     "working": TaskStatus.WORKING,
61:     "running": TaskStatus.WORKING,
62:     "waiting_human": TaskStatus.INPUT_REQUIRED,
63:     "input_required": TaskStatus.INPUT_REQUIRED,
64:     "input-required": TaskStatus.INPUT_REQUIRED,
65:     "canceled": TaskStatus.CANCELED,
66:     "cancelled": TaskStatus.CANCELED,
67: }
68: def _coerce_status(value: str | TaskStatus | None) -> TaskStatus | None:
69:     if value is None:
70:         return None
71:     if isinstance(value, TaskStatus):
72:         return value
73:     return _STATUS_MAP.get(str(value), TaskStatus.COMPLETED)
74: __all__ = ["DefaultLoopJudge"]
</file>

<file path="lca/layer2_runtime/event_emission.py">
 1: """认知循环生命周期 Hook 定义与事件发射工厂。
 2: L2 层职责：
 3:     定义所有合法的 Hook 事件名（HOOK_NAMES），
 4:     并提供 make_event_emitting_hook 工厂函数，
 5:     将认知循环的关键事件（action_degraded、step_completed）
 6:     发射到 EventBus，实现横切可观测性。
 7: """
 8: from __future__ import annotations
 9: from collections.abc import Awaitable, Callable
10: from typing import Any
11: from lca.contracts.enums import HookEvent
12: from lca.contracts.protocols import EventBus
13: from lca.contracts.state import TypedState
14: HOOK_NAMES = [
15:     "on_start",
16:     "pre_perceive",
17:     "post_perceive",
18:     "pre_think",
19:     "post_think",
20:     "pre_act",
21:     "post_act",
22:     "pre_reflect",
23:     "post_reflect",
24:     "on_error",
25:     "on_pause",
26:     "on_complete",
27: ]
28: def make_event_emitting_hook(event_bus: EventBus) -> Callable[..., Awaitable[None]]:
29:     async def _hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
30:         if event_name == HookEvent.POST_ACT:
31:             observation = kwargs.get("observation")
32:             if (
33:                 observation is not None
34:                 and getattr(observation, "success", False)
35:                 and getattr(observation, "degraded_from", None)
36:             ):
37:                 event_bus.emit(
38:                     "action_degraded",
39:                     {
40:                         "original_action_type": observation.degraded_from,
41:                         "degraded_to": "respond",
42:                         "step": state.step,
43:                     },
44:                     state.trace_id,
45:                 )
46:         elif event_name == HookEvent.POST_REFLECT:
47:             event_bus.emit(
48:                 "step_completed", {"step": state.step, "status": state.status}, state.trace_id
49:             )
50:     return _hook
</file>

