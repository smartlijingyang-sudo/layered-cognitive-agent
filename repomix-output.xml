21:     """
22:     def register(self, action_type: str, handler: ActionOperation) -> None: ...
23:     def get(self, action_type: str) -> ActionOperation | None: ...
24:     def resolve(self, action_type: str) -> ActionOperation: ...
25:     def allowed_action_types(self) -> list[str]: ...
26:     def is_registered(self, action_type: str) -> bool: ...
27:     def normalize_alias(self, name: str) -> str:
28:         """将 LLM 输出的别名归一化为规范 action_type。
29:         未识别的名称原样返回，交由 FallbackActionPolicy 降级。
30:         """
31:         ...
