<file path="lca/layer0_infra/observability/jsonl_file_observability.py">
 1: """JSONL 文件可观测性 —— 每条 TraceSpan 序列化为 JSON 追加写入文件。
 2: 用于真实 LLM 链路的离线回放排障：
 3:   - 每行一个 JSON 对象，可用 ``jq`` 按 ``trace_id`` 过滤
 4:   - 文件不存在时自动创建
 5:   - 线程安全（文件追加模式，OS 级别原子写入保证行完整性）
 6: 用法：
 7:     obs = JSONLFileObservability(output_path="traces/run.jsonl")
 8:     agent = Agent(..., observability=obs)
 9: """
10: from __future__ import annotations
11: import json
12: from dataclasses import asdict
13: from datetime import datetime
14: from pathlib import Path
15: from typing import Any
16: import structlog
17: from lca.contracts.observability import TraceSpan
18: from lca.contracts.protocols import Observability
19: _log = structlog.get_logger("lca.jsonl_observability")
20: class JSONLFileObservability(Observability):
21:     """实现 Observability 协议。将 TraceSpan 以 JSONL 格式落盘。"""
22:     name = "jsonl_file"
23:     def __init__(self, output_path: str | Path = "traces/lca_trace.jsonl") -> None:
24:         self._path = Path(output_path)
25:         self._path.parent.mkdir(parents=True, exist_ok=True)
26:     def emit_span(self, span: TraceSpan) -> None:
27:         """将 TraceSpan 序列化为一行 JSON 追加写入文件。"""
28:         try:
29:             record = self._serialize_span(span)
30:             line = json.dumps(record, ensure_ascii=False, default=str)
31:             with open(self._path, "a", encoding="utf-8") as f:
32:                 f.write(line + "\n")
33:         except (TypeError, ValueError, OSError) as exc:
34:             _log.error("trace_write_failed", path=str(self._path), error=str(exc))
35:     def _serialize_span(self, span: TraceSpan) -> dict[str, Any]:
36:         """将 TraceSpan 转为可 JSON 序列化的 dict。"""
37:         if hasattr(span, "__dataclass_fields__"):
38:             record = asdict(span)
39:         elif hasattr(span, "to_dict"):
40:             record = span.to_dict()
41:         elif isinstance(span, dict):
42:             record = dict(span)
43:         else:
44:             record = {"span_data": str(span)}
45:         # 确保 datetime 字段可序列化
46:         for key, value in record.items():
47:             if isinstance(value, datetime):
48:                 record[key] = value.isoformat()
49:         return record
50:     @property
51:     def output_path(self) -> Path:
52:         """返回输出文件路径。"""
53:         return self._path
</file>

<file path="lca/layer0_infra/tools/weather_tool.py">
 1: """WeatherTool —— 查询城市天气（内置假数据，无需外部网络）。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import time
 5: from typing import Any, ClassVar
 6: from lca.contracts.budget import DEFAULT_TOOL_TIMEOUT_S
 7: from lca.contracts.decision import Observation
 8: from lca.contracts.ids import new_id
 9: from lca.contracts.protocols import Tool
10: _SIMULATED_LATENCY_S = 0.05
11: class WeatherTool(Tool):
12:     """实现 Tool 的天气查询工具。
13:     内置假数据，避免依赖外部网络，专注测试 tool 调度本身。
14:     """
15:     name = "get_weather"
16:     is_idempotent = True
17:     default_timeout_s = DEFAULT_TOOL_TIMEOUT_S
18:     _FAKE_DB: ClassVar[dict[str, dict[str, Any]]] = {
19:         "tokyo": {"temp_c": 27, "condition": "cloudy"},
20:         "beijing": {"temp_c": 31, "condition": "sunny"},
21:         "san francisco": {"temp_c": 18, "condition": "foggy"},
22:         "new york": {"temp_c": 24, "condition": "clear"},
23:         "london": {"temp_c": 19, "condition": "rainy"},
24:     }
25:     _CITY_ALIASES: ClassVar[dict[str, str]] = {
26:         "东京": "tokyo",
27:         "東京": "tokyo",
28:         "北京": "beijing",
29:         "旧金山": "san francisco",
30:         "纽约": "new york",
31:         "伦敦": "london",
32:     }
33:     async def execute(self, args: dict[str, Any]) -> Observation:
34:         start = time.monotonic()
35:         raw_city = (
36:             str(args.get("city") or args.get("location") or args.get("name") or "").strip().lower()
37:         )
38:         city = self._CITY_ALIASES.get(raw_city, raw_city)
39:         if not city:
40:             latency_ms = int((time.monotonic() - start) * 1000)
41:             return Observation(
42:                 observation_id=new_id("obs"),
43:                 success=False,
44:                 payload=None,
45:                 error="missing required arg: city",
46:                 latency_ms=latency_ms,
47:             )
48:         await asyncio.sleep(_SIMULATED_LATENCY_S)  # 模拟网络 IO
49:         data = self._FAKE_DB.get(city)
50:         if data is None:
51:             latency_ms = int((time.monotonic() - start) * 1000)
52:             return Observation(
53:                 observation_id=new_id("obs"),
54:                 success=False,
55:                 payload=None,
56:                 error=f"unknown city: {city}",
57:                 latency_ms=latency_ms,
58:             )
59:         unit = str(args.get("unit", "celsius")).lower()
60:         temp_c = data["temp_c"]
61:         temp = temp_c if unit == "celsius" else temp_c * 9 / 5 + 32
62:         result = {
63:             "city": city,
64:             "temperature": round(temp, 1),
65:             "unit": unit,
66:             "condition": data["condition"],
67:         }
68:         latency_ms = int((time.monotonic() - start) * 1000)
69:         return Observation(
70:             observation_id=new_id("obs"),
71:             success=True,
72:             payload=result,
73:             latency_ms=latency_ms,
74:         )
75: # Backward compatibility alias
76: GetWeatherTool = WeatherTool
</file>

