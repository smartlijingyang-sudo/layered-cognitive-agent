  9: @runtime_checkable
 10: class Reasoner(Protocol):
 11:     """候选方案生成器：基于当前状态产出 n 个候选 prompt。"""
 12:     async def generate_candidates(self, state: TypedState, n: int = 1) -> list[str]: ...
 13: @runtime_checkable
 14: class DecisionParser(Protocol):
 15:     """LLM 原始输出 → StructuredDecision 解析器。"""
 16:     def parse(self, raw_output: str, state: TypedState) -> StructuredDecision: ...
 17: @runtime_checkable
 18: class Critic(Protocol):
 19:     """自省评估器：根据 Observation 产出 Reflection。"""
 20:     async def critique(self, state: TypedState, observation: Observation) -> Reflection: ...
 21: @runtime_checkable
 22: class TaskDecomposer(Protocol):
 23:     """任务分解器：将当前状态拆分为子任务列表。"""
 24:     async def decompose(self, state: TypedState) -> list[str]: ...
 25: @runtime_checkable
 26: class StatePredictor(Protocol):
 27:     """状态预测器：预估执行某候选后的状态变化。"""
 28:     async def predict(self, state: TypedState, candidate_action: str) -> dict[str, Any]: ...
 29: @runtime_checkable
 30: class StateEvaluator(Protocol):
 31:     """状态评估器：对预测状态打分。"""
 32:     async def score(self, state: TypedState, predicted_state: dict[str, Any]) -> float: ...
 33: @runtime_checkable
 34: class ConflictMonitor(Protocol):
 35:     """冲突检测器：检查候选决策之间的矛盾。"""
 36:     async def check(self, state: TypedState, candidates: list[StructuredDecision]) -> list[str]: ...
 37: @runtime_checkable
 38: class TaskCoordinator(Protocol):
 39:     """任务协调器：在多候选中仲裁选出最终决策。"""
 40:     async def arbitrate(
 41:         self,
 42:         state: TypedState,
 43:         candidates: list[StructuredDecision],
 44:         scores: list[float],
 45:     ) -> StructuredDecision: ...
 46: @runtime_checkable
 47: class BrainStrategy(Protocol):
 48:     """Brain 顶层策略：think + reflect + 花名册设置。"""
 49:     async def think(self, state: TypedState) -> StructuredDecision: ...
 50:     async def reflect(self, state: TypedState, observation: Observation) -> Reflection: ...
 51:     def set_team_roster(self, roster_desc: str) -> None: ...
 52: @runtime_checkable
 53: class CandidateEvaluationPipeline(Protocol):
 54:     """候选方案评估管线：封装 decompose → predict → score → conflict check → arbitrate。
 55:     将原本分散在 TaskDecomposer / StatePredictor / StateEvaluator /
 56:     ConflictMonitor / TaskCoordinator 五个浅模块中的认知评估步骤
 57:     收敛为一个有深度的模块（ADR-0003 的深化）。
 58:     """
 59:     async def decompose(self, state: TypedState) -> list[str]: ...
 60:     async def evaluate(
 61:         self,
 62:         state: TypedState,
 63:         candidates: list[StructuredDecision],
 64:     ) -> StructuredDecision: ...
