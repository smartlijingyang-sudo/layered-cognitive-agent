 6: from lca.contracts.decision import StructuredDecision
 7: from lca.contracts.protocols import CompletionPolicy, TaskCoordinator
 8: from lca.contracts.state import TypedState
 9: class GuardedTaskCoordinator(TaskCoordinator):
10:     """在 inner coordinator 的仲裁结果上叠加 CompletionPolicy guardrail。"""
11:     def __init__(
12:         self,
13:         inner: TaskCoordinator,
14:         policy: CompletionPolicy,
15:     ) -> None:
16:         self._inner = inner
17:         self._policy = policy
18:     async def arbitrate(
19:         self,
20:         state: TypedState,
21:         candidates: list[StructuredDecision],
22:         scores: list[float],
23:     ) -> StructuredDecision:
24:         decision = await self._inner.arbitrate(state, candidates, scores)
25:         return await self._policy.enforce(state, decision)
