 1: """Reasoner —— 调用 LLM 生成候选思路。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import LLMAdapter, PromptManager, Reasoner
 4: from lca.contracts.role_team import RoleProfile
 5: from lca.contracts.state import TypedState
 6: from lca.layer1_cognitive.brain.prompts import load_builtin_prompt
 7: # Backward-compatible re-exports: templates are now loaded from external .md files
 8: # so that prompt iteration does not require touching core code paths.
 9: DEFAULT_REACT_TEMPLATE: str = load_builtin_prompt("react_prompt")
10: HIERARCHICAL_DELEGATE_TEMPLATE: str = load_builtin_prompt("hierarchical_prompt")
11: def build_team_roster(profiles: list[RoleProfile]) -> str:
12:     """从 RoleProfile 列表拼接团队花名册文本，渲染进 Supervisor prompt。"""
13:     if not profiles:
14:         return "(无可用队友)"
15:     return "\n".join(f"- role: {p.role} | goal: {p.goal}" for p in profiles)
16: class SimpleReasoner(Reasoner):
17:     """调用 LLM 生成候选行动思路。"""
18:     def __init__(
19:         self,
20:         llm: LLMAdapter,
21:         prompt_manager: PromptManager,
22:         role_profile: RoleProfile,
23:         tools_desc: str,
24:         team_roster: str | None = None,
25:         allowed_actions_desc: str = "",
26:     ):
27:         self.llm = llm
28:         self.prompt_manager = prompt_manager
29:         self.role_profile = role_profile
30:         self.tools_desc = tools_desc
31:         self.team_roster = team_roster
32:         self.allowed_actions_desc = allowed_actions_desc
33:     def set_team_roster(self, roster_desc: str) -> None:
34:         self.team_roster = roster_desc
35:     async def generate_candidates(self, state: TypedState, n: int = 1) -> list[str]:
36:         context_lines = (
37:             "\n".join(f"- [{r.memory_type}] {r.content}" for r in state.retrieved_context)
38:             or "(无历史上下文)"
39:         )
40:         base_vars: dict[str, str] = {
41:             "role": self.role_profile.role,
42:             "goal": self.role_profile.goal,
43:             "backstory": self.role_profile.backstory,
44:             "tools": self.tools_desc,
45:             "task": state.task,
46:             "context": context_lines,
47:             "allowed_actions": self.allowed_actions_desc,
48:         }
49:         if self.team_roster is not None:
50:             template_name = "hierarchical_prompt"
51:             base_vars["team_roster"] = self.team_roster
52:             base_vars["team_progress"] = state.working_memory.get("team_progress_text", "")
53:         else:
54:             template_name = "react_prompt"
55:         prompt = self.prompt_manager.render(template_name, base_vars)
56:         raw = await self.llm.complete(prompt)
57:         return [raw]
