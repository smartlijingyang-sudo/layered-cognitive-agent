<file path="lca/layer0_infra/transport/agent_transport.py">
 1: """Agent 传输层 —— 进程内传输实现（对齐 A2A 异步任务模型）。"""
 2: from __future__ import annotations
 3: import asyncio
 4: from collections.abc import Awaitable, Callable
 5: from lca.contracts.decision import AgentCard, Observation
 6: from lca.contracts.ids import new_id
 7: from lca.contracts.lifecycle import TaskStatus
 8: from lca.contracts.protocols import AgentTransport
 9: AgentHandler = Callable[[str], Awaitable[Observation]]
10: def _fail_observation(error: str) -> Observation:
11:     return Observation(
12:         observation_id=new_id("obs"),
13:         success=False,
14:         payload=None,
15:         error=error,
16:     )
17: class InternalTransport(AgentTransport):
18:     """进程内 Agent 间通信传输实现。
19:     维护 ``agent_directory``（key → async handler），``send_task`` 通过
20:     ``asyncio.create_task`` 异步调度 handler。调用方优先用 ``wait_result``
21:     await Future；``poll_status`` / ``receive_result`` 保留以兼容统一协议。
22:     """
23:     protocol_name: str = "internal"
24:     def __init__(
25:         self,
26:         agent_directory: dict[str, AgentHandler] | None = None,
27:     ) -> None:
28:         self._directory: dict[str, AgentHandler] = dict(agent_directory or {})
29:         self._results: dict[str, Observation] = {}
30:         self._statuses: dict[str, str] = {}
31:         self._futures: dict[str, asyncio.Future[Observation]] = {}
32:         self._bg_tasks: dict[str, asyncio.Task[None]] = {}
33:     def register_agent(self, key: str, handler: AgentHandler) -> None:
34:         """将一个 async handler 注册到 directory，key 通常为 agent_id 或 role。"""
35:         self._directory[key] = handler
36:     def _resolve_handler(self, agent_card: AgentCard | str) -> AgentHandler | None:
37:         if isinstance(agent_card, str):
38:             return self._directory.get(agent_card)
39:         if hasattr(agent_card, "agent_id"):
40:             handler = self._directory.get(agent_card.agent_id)
41:             if handler is not None:
42:                 return handler
43:         if hasattr(agent_card, "role"):
44:             return self._directory.get(agent_card.role)
45:         return None
46:     async def send_task(
47:         self, agent_card: AgentCard | str, subtask: str, context_refs: list[str]
48:     ) -> str:
49:         task_id = new_id("task")
50:         handler = self._resolve_handler(agent_card)
51:         loop = asyncio.get_running_loop()
52:         fut: asyncio.Future[Observation] = loop.create_future()
53:         self._futures[task_id] = fut
54:         if handler is None:
55:             obs = _fail_observation("agent not found in directory")
56:             self._statuses[task_id] = TaskStatus.FAILED
57:             self._results[task_id] = obs
58:             fut.set_result(obs)
59:             return task_id
60:         async def _run() -> None:
61:             try:
62:                 obs = await handler(subtask)
63:             except Exception as exc:
64:                 # Broad catch: handler is user-supplied agent code that may
65:                 # raise any exception; convert to failed Observation so the
66:                 # transport layer never crashes the caller's event loop.
67:                 obs = _fail_observation(str(exc))
68:             self._results[task_id] = obs
69:             self._statuses[task_id] = TaskStatus.COMPLETED if obs.success else TaskStatus.FAILED
70:             if not fut.done():
71:                 fut.set_result(obs)
72:         self._statuses[task_id] = TaskStatus.WORKING
73:         self._bg_tasks[task_id] = asyncio.create_task(_run(), name=f"transport-{task_id}")
74:         return task_id
75:     async def poll_status(self, task_id: str) -> str:
76:         return self._statuses.get(task_id, TaskStatus.WORKING)
77:     async def receive_result(self, task_id: str) -> Observation:
78:         if task_id in self._results:
79:             return self._results[task_id]
80:         fut = self._futures.get(task_id)
81:         if fut is not None and fut.done():
82:             return fut.result()
83:         return _fail_observation("task not found")
84:     async def wait_result(self, task_id: str, timeout_s: float | None = None) -> Observation:
85:         fut = self._futures.get(task_id)
86:         if fut is None:
87:             if task_id in self._results:
88:                 return self._results[task_id]
89:             return _fail_observation("task not found")
90:         if timeout_s is None:
91:             return await fut
92:         return await asyncio.wait_for(asyncio.shield(fut), timeout=timeout_s)
</file>

<file path="lca/layer2_runtime/fallback_handler.py">
 1: """FallbackActionPolicy —— 未识别 action_type 的降级策略。
 2: L2 层职责：
 3:     当 Brain 输出的 action_type 无法被 ActionRegistry 识别时，
 4:     按优先级尝试降级路径：RESPOND → USE_TOOL → 失败。
 5:     降级后的 Observation 携带 degraded_from 标记，供 hook 观测。
 6: """
 7: from __future__ import annotations
 8: from lca.contracts.action import ActionRegistryProtocol
 9: from lca.contracts.decision import Observation, StructuredDecision
10: from lca.contracts.enums import ActionType
11: from lca.contracts.ids import new_id
12: from lca.contracts.protocols import FallbackPolicy
13: from lca.contracts.semantic_keys import FALLBACK_DEGRADED_FROM
14: from lca.contracts.state import TypedState
15: FALLBACK_DEGRADATION_KEY = FALLBACK_DEGRADED_FROM
16: class FallbackActionPolicy(FallbackPolicy):
17:     """未识别 action_type 的降级策略。
18:     降级优先级：
19:     1. 有 response_text → 降级为 RESPOND
20:     2. 有 tool_calls → 降级为 USE_TOOL
21:     3. 均无 → 返回失败 Observation
22:     """
23:     async def handle(
24:         self,
25:         decision: StructuredDecision,
26:         state: TypedState,
27:         action_registry: ActionRegistryProtocol | None = None,
28:     ) -> Observation:
29:         original = decision.action_type
30:         if action_registry is None:
31:             return Observation(
32:                 observation_id=new_id("obs"),
33:                 success=False,
34:                 payload=None,
35:                 error=f"无法识别的 action_type '{original}' 且无可用的 ActionRegistry",
36:                 degraded_from=original,
37:                 extra={FALLBACK_DEGRADED_FROM: original},
38:             )
39:         if decision.response_text:
40:             op = action_registry.get(ActionType.RESPOND)
41:             if op is not None:
42:                 obs = await op.execute(decision, state)
43:                 obs.degraded_from = original
44:                 obs.extra[FALLBACK_DEGRADED_FROM] = original
45:                 return obs
46:         if decision.tool_calls:
47:             op = action_registry.get(ActionType.USE_TOOL)
48:             if op is not None:
49:                 obs = await op.execute(decision, state)
50:                 obs.degraded_from = original
51:                 obs.extra[FALLBACK_DEGRADED_FROM] = original
52:                 return obs
53:         return Observation(
54:             observation_id=new_id("obs"),
55:             success=False,
56:             payload=None,
57:             error=f"无法识别的 action_type '{original}' 且无可用降级路径",
58:             degraded_from=original,
59:             extra={FALLBACK_DEGRADED_FROM: original},
60:         )
</file>

<file path="lca/layer4_app/assembly.py">
  1: """Composition root — wires all layers into a working object graph.
  2: This is the **only** module that assembles the full Agent / Team object
  3: graphs.  It guarantees that the shared pipeline components (ToolRegistry,
  4: SafeExecutor, ActionRegistry, TransportRegistry) are created once and
  5: injected into both Brain and Body, so they always operate on the same
  6: instances.
  7: High-level entry points:
  8: * ``assemble_base_agent`` — builds a single ``SimpleAgent``.
  9: * ``assemble_team`` — builds a ``TeamEntrypoint`` from a list of members.
 10: Lower-level builders (``build_body_from_shared``, ``build_hooks``) are
 11: exposed for advanced / test scenarios.
 12: Known limitation: when the same ``SimpleAgent`` instance is reused as
 13: supervisor for multiple teams, those teams share one ``Runtime`` (including
 14: hooks).  Each team assembly does not clone the runtime.
 15: """
 16: from __future__ import annotations
 17: from typing import cast
 18: from lca.contracts.action import ActionRegistryProtocol
 19: from lca.contracts.budget import (
 20:     DEFAULT_MAX_STEPS,
 21:     DEFAULT_MAX_WALL_CLOCK_SECONDS,
 22:     SUPERVISOR_MIN_MAX_STEPS,
 23: )
 24: from lca.contracts.decision import Observation
 25: from lca.contracts.enums import TeamProcess
 26: from lca.contracts.lifecycle import TaskStatus
 27: from lca.contracts.protocols import (
 28:     AgentTransport,
 29:     Body,
 30:     BrainStrategy,
 31:     EventBus,
 32:     LLMAdapter,
 33:     MemorySystem,
 34:     Observability,
 35:     OrchestrationStrategy,
 36:     StateStore,
 37:     TeamEntrypoint,
 38:     Tool,
 39:     TransportRegistryProtocol,
 40: )
 41: from lca.contracts.role_team import RoleProfile, TeamConfig, ToolPermissionManifest
 42: from lca.layer0_infra.component_registry import ComponentRegistry, get_global_registry
 43: from lca.layer0_infra.transport.a2a_transport import A2ATransport
 44: from lca.layer0_infra.transport.agent_transport import InternalTransport
 45: from lca.layer0_infra.transport.mcp_transport import MCPTransport
 46: from lca.layer0_infra.transport.transport_registry import TransportRegistry
 47: from lca.layer1_cognitive.body.action_catalog import build_default_action_registry
 48: from lca.layer1_cognitive.body.fallback_decorated_body import FallbackDecoratedBody
 49: from lca.layer1_cognitive.body.safe_executor import SimpleSafeExecutor
 50: from lca.layer1_cognitive.body.simple_body import SimpleBody
 51: from lca.layer1_cognitive.body.tool_registry import SimpleToolRegistry
 52: from lca.layer1_cognitive.brain.reasoner import build_team_roster
 53: from lca.layer1_cognitive.hook_registry import SimpleHookRegistry, default_logging_hook
 54: from lca.layer2_runtime.default_loop_judge import DefaultLoopJudge
 55: from lca.layer2_runtime.event_emission import HOOK_NAMES, make_event_emitting_hook
 56: from lca.layer2_runtime.fallback_handler import FallbackActionPolicy
 57: from lca.layer2_runtime.outcome_policies.default_outcome_policy import DefaultStepOutcomePolicy
 58: from lca.layer2_runtime.runtime_loop import CognitiveRuntime
 59: from lca.layer2_runtime.strategy_registry import get_global_strategy_registry
 60: from lca.layer3_agent.simple_agent import SimpleAgent
 61: from lca.layer4_app.defaults import ensure_defaults
 62: def _resolve_component(reg: ComponentRegistry, category: str, value: str | object) -> object:
 63:     """Resolve *value* from *reg* if it is a string key, otherwise return as-is."""
 64:     if isinstance(value, str):
 65:         return reg.require(category, value)()
 66:     return value
 67: def build_default_transport_registry() -> TransportRegistry:
 68:     """Build the default TransportRegistry with internal / a2a / mcp transports."""
 69:     registry = TransportRegistry()
 70:     registry.register(InternalTransport())
 71:     registry.register(A2ATransport())
 72:     registry.register(MCPTransport())
 73:     return registry
 74: def build_team_transport(
 75:     members: list[SimpleAgent],
 76: ) -> tuple[AgentTransport, str]:
 77:     """Build an in-process transport and roster description for a team."""
 78:     from lca.contracts.delegation_context import get_current_delegator
 79:     transport = InternalTransport()
 80:     for member in members:
 81:         async def _handler(subtask: str, _m: SimpleAgent = member) -> Observation:
 82:             delegated_by = get_current_delegator()
 83:             result = await _m.execute(subtask, delegated_by=delegated_by)
 84:             return Observation(
 85:                 observation_id=f"obs_{result.trace_id}",
 86:                 success=result.status == TaskStatus.COMPLETED,
 87:                 payload=result.output,
 88:                 error=result.error,
 89:             )
 90:         transport.register_agent(member.role_profile.role, _handler)
 91:     roster_desc = build_team_roster([m.role_profile for m in members])
 92:     return transport, roster_desc
 93: def build_body_from_shared(
 94:     tool_registry: SimpleToolRegistry,
 95:     safe_executor: SimpleSafeExecutor,
 96:     transport_registry: object,
 97:     action_registry: ActionRegistryProtocol,
 98:     *,
 99:     enable_fallback: bool = True,
100: ) -> Body:
101:     """Build Body from *already-shared* pipeline components.
102:     The caller must pass the **same** ToolRegistry / SafeExecutor /
103:     TransportRegistry / ActionRegistry instances that are shared with the
104:     Brain — never let Body create its own copies.
105:     """
106:     simple_body = SimpleBody(
107:         tool_registry=tool_registry,
108:         safe_executor=safe_executor,
109:         transport_registry=cast("TransportRegistryProtocol", transport_registry),
110:         action_registry=action_registry,
111:     )
112:     if enable_fallback:
113:         return FallbackDecoratedBody(inner=simple_body, fallback_handler=FallbackActionPolicy())
114:     return simple_body
115: def build_hooks(observability: Observability, event_bus: EventBus) -> SimpleHookRegistry:
116:     """Build the default HookRegistry with logging + event-emitting hooks."""
117:     hooks = SimpleHookRegistry(observability)
118:     event_hook = make_event_emitting_hook(event_bus)
119:     for event_name in HOOK_NAMES:
120:         hooks.register(event_name, default_logging_hook)
121:         hooks.register(event_name, event_hook)
122:     return hooks
123: def assemble_base_agent(
124:     *,
125:     role: str,
126:     goal: str,
127:     backstory: str,
128:     tools: list[Tool],
129:     llm: LLMAdapter,
130:     max_steps: int = DEFAULT_MAX_STEPS,
131:     max_wall_clock_seconds: int | None = DEFAULT_MAX_WALL_CLOCK_SECONDS,
132:     memory: str | MemorySystem = "simple",
133:     observability: str | Observability = "console",
134:     state_store: str | StateStore = "memory",
135:     brain_strategy: str | BrainStrategy = "default",
136: ) -> SimpleAgent:
137:     """Assemble a complete SimpleAgent with a single shared pipeline.
138:     Creates one set of ToolRegistry / SafeExecutor / TransportRegistry /
139:     ActionRegistry and injects them into both Brain and Body, guaranteeing
140:     they operate on the same instances.  All string-keyed components
141:     (*memory*, *observability*, *state_store*) are resolved via the global
142:     ComponentRegistry.
143:     """
144:     ensure_defaults()
145:     reg = get_global_registry()
146:     permission_manifest = ToolPermissionManifest(allowed_tools=[t.name for t in tools])
147:     role_profile = RoleProfile(
148:         role=role,
149:         goal=goal,
150:         backstory=backstory,
151:         tool_permission_manifest=permission_manifest,
152:     )
153:     obs = cast("Observability", _resolve_component(reg, "observability", observability))
154:     mem = cast("MemorySystem", _resolve_component(reg, "memory", memory))
155:     ss = cast("StateStore", _resolve_component(reg, "state_store", state_store))
156:     tool_registry = SimpleToolRegistry()
157:     for t in tools:
158:         tool_registry.register(t)
159:     safe_executor = SimpleSafeExecutor(permission_manifest, obs)
160:     transport_registry = build_default_transport_registry()
161:     action_registry = build_default_action_registry(
162:         tool_registry, safe_executor, transport_registry
163:     )
164:     brain: BrainStrategy
165:     if isinstance(brain_strategy, str):
166:         strategy_reg = get_global_strategy_registry()
167:         if brain_strategy not in strategy_reg:
168:             raise ValueError(
169:                 f"Unknown brain_strategy: {brain_strategy!r}. Available: {strategy_reg.list()}"
170:             )
171:         tools_desc = ", ".join(t.name for t in tools) or "(no tools available)"
172:         factory = strategy_reg.resolve(brain_strategy)
173:         brain = factory(llm, role_profile, tools_desc, action_registry=action_registry)
174:     else:
175:         brain = brain_strategy
176:     body = build_body_from_shared(
177:         tool_registry,
178:         safe_executor,
179:         transport_registry,
180:         action_registry,
181:     )
182:     event_bus = cast("EventBus", _resolve_component(reg, "event_bus", "simple"))
183:     hooks = build_hooks(obs, event_bus)
184:     runtime = CognitiveRuntime(
185:         brain,
186:         body,
187:         mem,
188:         hooks,
189:         ss,
190:         judge=DefaultLoopJudge(outcome_policy=DefaultStepOutcomePolicy()),
191:     )
192:     return SimpleAgent(
193:         runtime,
194:         role_profile,
195:         max_steps=max_steps,
196:         max_wall_clock_seconds=max_wall_clock_seconds,
197:     )
198: def _promote_supervisor(supervisor: SimpleAgent) -> SimpleAgent:
199:     """Apply supervisor budget floors — sole composition decision for team leads."""
200:     wc = supervisor.max_wall_clock_seconds
201:     effective_wc = (
202:         max(wc, DEFAULT_MAX_WALL_CLOCK_SECONDS)
203:         if wc is not None
204:         else DEFAULT_MAX_WALL_CLOCK_SECONDS
205:     )
206:     return SimpleAgent(
207:         supervisor.runtime,
208:         supervisor.role_profile,
209:         max_steps=max(supervisor.max_steps, SUPERVISOR_MIN_MAX_STEPS),
210:         max_wall_clock_seconds=effective_wc,
211:     )
212: def assemble_team(
213:     *,
214:     members: list[SimpleAgent],
215:     process: TeamProcess | None = None,
216:     supervisor: SimpleAgent | None = None,
217:     max_rounds: int | None = None,
218:     shared_memory_layers: list[str] | None = None,
219:     graph_definition_ref: str | None = None,
220:     strategy: OrchestrationStrategy | None = None,
221: ) -> TeamEntrypoint:
222:     """Assemble a team object graph from *members* with the given *process*."""
223:     from lca.layer3_agent.team_orchestrator import TeamOrchestrator
224:     ensure_defaults()
225:     process_val = process if process is not None else TeamProcess.HIERARCHICAL
226:     config = TeamConfig(
227:         process=process_val,
228:         max_rounds=max_rounds,
229:         shared_memory_layers=list(shared_memory_layers or []),
230:         graph_definition_ref=graph_definition_ref,
231:     )
232:     base_supervisor = _promote_supervisor(supervisor) if supervisor is not None else None
233:     transport, roster_desc = build_team_transport(members)
234:     return TeamOrchestrator(
235:         members,
236:         config,
237:         base_supervisor,
238:         transport=transport,
239:         roster_desc=roster_desc,
240:         strategy=strategy,
241:     )
</file>

