<file path="lca/layer0_infra/llm_adapter/mock_llm.py">
 1: """离线可跑的确定性 Mock LLM 实现。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import json
 5: import re
 6: from collections.abc import AsyncIterator
 7: from typing import Any
 8: from lca.contracts.protocols import LLMAdapter
 9: # Minimum token count (numbers + operators) to qualify as an arithmetic expression.
10: _MIN_ARITHMETIC_TOKENS = 3
11: class MockLLMAdapter(LLMAdapter):
12:     """确定性假 LLM，用于测试与演示；接口与真实厂商适配器完全一致。"""
13:     name = "mock-llm"
14:     async def complete(self, prompt: str, **kwargs: Any) -> str:
15:         await asyncio.sleep(0)
16:         if "TOOL_RESULT:" in prompt:
17:             m = re.search(r"TOOL_RESULT:\s*([^\n]+)", prompt)
18:             tool_result = m.group(1).strip() if m else "未知"
19:             question = re.search(r"USER_TASK:\s*([^\n]+)", prompt)
20:             q = question.group(1).strip() if question else ""
21:             return json.dumps(
22:                 {
23:                     "action_type": "respond",
24:                     "response_text": f"「{q}」的答案是 {tool_result}。",
25:                     "rationale": "已从工具获得精确计算结果，直接向用户作答，无需进一步调用工具。",
26:                     "confidence": 0.98,
27:                 },
28:                 ensure_ascii=False,
29:             )
30:         expr = self._extract_arithmetic_expression(prompt)
31:         if expr:
32:             return json.dumps(
33:                 {
34:                     "action_type": "use_tool",
35:                     "tool_name": "calculator",
36:                     "arguments": {"expression": expr},
37:                     "rationale": f"用户问题是纯算术计算（{expr}），应调用 calculator 工具求精确值而非直接臆测。",
38:                     "confidence": 0.95,
39:                 },
40:                 ensure_ascii=False,
41:             )
42:         return json.dumps(
43:             {
44:                 "action_type": "respond",
45:                 "response_text": "这是一个通用问题，暂无可用工具，基于已有知识直接作答。",
46:                 "rationale": "未检测到需要调用工具的模式，直接生成回答。",
47:                 "confidence": 0.6,
48:             },
49:             ensure_ascii=False,
50:         )
51:     async def stream(self, prompt: str, **kwargs: Any) -> AsyncIterator[str]:
52:         text = await self.complete(prompt, **kwargs)
53:         for char in text:
54:             yield char
55:     @staticmethod
56:     def _extract_arithmetic_expression(prompt: str) -> str | None:
57:         m = re.search(r"USER_TASK:\s*([^\n]+)", prompt)
58:         if not m:
59:             return None
60:         text = m.group(1)
61:         text = (
62:             text.replace("乘以", "*").replace("加上", "+").replace("减去", "-").replace("除以", "/")
63:         )
64:         text = text.replace("×", "*").replace("÷", "/")
65:         nums_ops = re.findall(r"[\d.]+|[+\-*/]", text)
66:         if len(nums_ops) >= _MIN_ARITHMETIC_TOKENS:
67:             return "".join(nums_ops)
68:         return None
</file>

<file path="lca/layer0_infra/transport/a2a_transport.py">
  1: """A2ATransport —— Google A2A 协议传输实现。
  2: 通过 HTTP 调用远程 A2A Agent 端点，实现跨框架 Agent 互操作。
  3: 依赖 httpx（已加入项目依赖）。
  4: A2A 协议核心流程：
  5: 1. 解析 AgentCard 获取端点 URL
  6: 2. send_task: POST 到 /tasks/send 创建异步任务
  7: 3. poll_status: GET /tasks/{task_id} 查询状态
  8: 4. receive_result: 从任务结果中提取 Observation
  9: """
 10: from __future__ import annotations
 11: from typing import Any
 12: import httpx
 13: from lca.contracts.budget import DEFAULT_A2A_TIMEOUT_S
 14: from lca.contracts.decision import AgentCard, Observation
 15: from lca.contracts.ids import new_id
 16: from lca.contracts.lifecycle import TaskStatus
 17: from lca.contracts.protocols import AgentTransport
 18: _DEFAULT_POLL_INTERVAL_S = 0.1
 19: class A2ATransport(AgentTransport):
 20:     """Google A2A 协议传输实现。
 21:     通过 HTTP 与远程 A2A Agent 通信。AgentCard 可以是：
 22:     - 字符串：直接作为 endpoint URL
 23:     - 包含 url/endpoint 属性的对象：提取 URL
 24:     """
 25:     protocol_name: str = "a2a"
 26:     def __init__(
 27:         self,
 28:         timeout_s: float = DEFAULT_A2A_TIMEOUT_S,
 29:         default_endpoint: str | None = None,
 30:     ) -> None:
 31:         self._timeout = timeout_s
 32:         self._default_endpoint = default_endpoint
 33:         self._task_endpoints: dict[str, str] = {}
 34:         self._client: httpx.AsyncClient | None = None
 35:     async def _get_client(self) -> httpx.AsyncClient:
 36:         if self._client is None:
 37:             self._client = httpx.AsyncClient(timeout=self._timeout)
 38:         return self._client
 39:     def _resolve_endpoint(self, agent_card: AgentCard | str) -> str:
 40:         if isinstance(agent_card, str):
 41:             return agent_card
 42:         if hasattr(agent_card, "url"):
 43:             return str(agent_card.url)
 44:         if hasattr(agent_card, "endpoint"):
 45:             return str(agent_card.endpoint)
 46:         if self._default_endpoint:
 47:             return self._default_endpoint
 48:         raise ValueError(f"无法从 AgentCard 解析 A2A 端点 URL: {agent_card!r}")
 49:     async def send_task(
 50:         self, agent_card: AgentCard | str, subtask: str, context_refs: list[str]
 51:     ) -> str:
 52:         endpoint = self._resolve_endpoint(agent_card)
 53:         task_id = new_id("a2a_task")
 54:         self._task_endpoints[task_id] = endpoint
 55:         client = await self._get_client()
 56:         payload: dict[str, Any] = {
 57:             "task_id": task_id,
 58:             "message": {
 59:                 "role": "user",
 60:                 "parts": [{"kind": "text", "text": subtask}],
 61:             },
 62:         }
 63:         if context_refs:
 64:             parts = payload["message"]["parts"]
 65:             parts.extend({"kind": "reference", "ref": ref} for ref in context_refs)
 66:         try:
 67:             response = await client.post(f"{endpoint}/tasks/send", json=payload)
 68:             response.raise_for_status()
 69:         except httpx.HTTPError as exc:
 70:             self._task_endpoints[task_id] = f"error:{exc}"
 71:         return task_id
 72:     async def wait_result(self, task_id: str, timeout_s: float | None = None) -> Observation:
 73:         """HTTP 轮询等待任务完成。"""
 74:         import asyncio
 75:         elapsed = 0.0
 76:         while True:
 77:             status = await self.poll_status(task_id)
 78:             if status != TaskStatus.WORKING:
 79:                 return await self.receive_result(task_id)
 80:             if timeout_s is not None and elapsed >= timeout_s:
 81:                 raise TimeoutError(f"a2a wait_result 超时: {task_id}")
 82:             await asyncio.sleep(_DEFAULT_POLL_INTERVAL_S)
 83:             elapsed += _DEFAULT_POLL_INTERVAL_S
 84:     async def poll_status(self, task_id: str) -> str:
 85:         endpoint_info = self._task_endpoints.get(task_id, "")
 86:         if endpoint_info.startswith("error:"):
 87:             return "failed"
 88:         client = await self._get_client()
 89:         try:
 90:             response = await client.get(f"{endpoint_info}/tasks/{task_id}")
 91:             response.raise_for_status()
 92:             data = response.json()
 93:             status = data.get("status", {}).get("state", "working")
 94:             return str(status)
 95:         except httpx.HTTPError:
 96:             return "working"
 97:     async def receive_result(self, task_id: str) -> Observation:
 98:         endpoint_info = self._task_endpoints.get(task_id, "")
 99:         if endpoint_info.startswith("error:"):
100:             return Observation(
101:                 observation_id=new_id("obs"),
102:                 success=False,
103:                 payload=None,
104:                 error=endpoint_info[6:],
105:             )
106:         client = await self._get_client()
107:         try:
108:             response = await client.get(f"{endpoint_info}/tasks/{task_id}")
109:             response.raise_for_status()
110:             data = response.json()
111:             status = data.get("status", {})
112:             if status.get("state") != TaskStatus.COMPLETED:
113:                 return Observation(
114:                     observation_id=new_id("obs"),
115:                     success=False,
116:                     payload=None,
117:                     error=f"Task not completed: state={status.get('state')}",
118:                 )
119:             artifacts = data.get("artifacts", [])
120:             output_parts: list[str] = []
121:             for artifact in artifacts:
122:                 for part in artifact.get("parts", []):
123:                     if part.get("kind") == "text":
124:                         output_parts.append(part.get("text", ""))
125:             return Observation(
126:                 observation_id=new_id("obs"),
127:                 success=True,
128:                 payload="\n".join(output_parts) if output_parts else None,
129:                 extra={"a2a_task_id": task_id, "raw_response": data},
130:             )
131:         except httpx.HTTPError as exc:
132:             return Observation(
133:                 observation_id=new_id("obs"),
134:                 success=False,
135:                 payload=None,
136:                 error=f"A2A receive_result failed: {exc}",
137:             )
138:     async def close(self) -> None:
139:         if self._client is not None:
140:             await self._client.aclose()
141:             self._client = None
</file>

<file path="lca/layer0_infra/transport/mcp_transport.py">
  1: """MCPTransport —— Model Context Protocol 传输实现。
  2: 通过 MCP client SDK 与远程 MCP Server 通信，实现跨框架 Agent 互操作。
  3: MCP 主要用于工具调用场景，此处将 Agent 任务映射为 MCP 工具调用。
  4: 依赖 mcp Python SDK（可选依赖，未安装时给出明确报错）。
  5: """
  6: from __future__ import annotations
  7: import contextlib
  8: from typing import Any
  9: from lca.contracts.decision import AgentCard, Observation
 10: from lca.contracts.ids import new_id
 11: from lca.contracts.lifecycle import TaskStatus
 12: from lca.contracts.protocols import AgentTransport
 13: _MCP_SDK_MISSING_MSG = "MCP Python SDK 未安装。请运行: pip install mcp 或 uv add mcp"
 14: class MCPTransport(AgentTransport):
 15:     """MCP 协议传输实现。
 16:     将 Agent 任务映射为 MCP 工具调用。agent_card 可以是：
 17:     - 字符串：作为 MCP server URL 或 server name
 18:     - 包含 server_url/tool_name 属性的对象
 19:     注意：MCP SDK 是可选依赖，未安装时 send_task 会抛出明确错误。
 20:     """
 21:     protocol_name: str = "mcp"
 22:     def __init__(
 23:         self,
 24:         default_server_url: str | None = None,
 25:         default_tool_name: str = "execute_task",
 26:     ) -> None:
 27:         self._default_server_url = default_server_url
 28:         self._default_tool_name = default_tool_name
 29:         self._task_results: dict[str, Observation] = {}
 30:         self._task_statuses: dict[str, str] = {}
 31:         self._sessions: dict[str, Any] = {}
 32:     def _resolve_config(self, agent_card: AgentCard | str) -> tuple[str, str]:
 33:         """从 agent_card 解析 server_url 和 tool_name。"""
 34:         if isinstance(agent_card, str):
 35:             return agent_card, self._default_tool_name
 36:         server_url = (
 37:             getattr(agent_card, "server_url", None)
 38:             or getattr(agent_card, "url", None)
 39:             or self._default_server_url
 40:         )
 41:         tool_name = getattr(agent_card, "tool_name", self._default_tool_name)
 42:         if server_url is None:
 43:             raise ValueError(f"无法从 AgentCard 解析 MCP server URL: {agent_card!r}")
 44:         return str(server_url), str(tool_name)
 45:     async def _get_mcp_session(self, server_url: str) -> Any:
 46:         """获取或创建 MCP client session。"""
 47:         if server_url in self._sessions:
 48:             return self._sessions[server_url]
 49:         try:
 50:             # mcp 是可选依赖，未安装时由 except ImportError 处理
 51:             from mcp import ClientSession  # type: ignore[import-not-found]  # optional dep
 52:             from mcp.client.streamable_http import (  # type: ignore[import-not-found]  # optional dep
 53:                 streamablehttp_client,
 54:             )
 55:         except ImportError as exc:
 56:             raise NotImplementedError(_MCP_SDK_MISSING_MSG) from exc
 57:         read_stream, write_stream, _ = await streamablehttp_client(server_url).__aenter__()
 58:         session = ClientSession(read_stream, write_stream)
 59:         await session.__aenter__()
 60:         await session.initialize()
 61:         self._sessions[server_url] = session
 62:         return session
 63:     async def send_task(
 64:         self, agent_card: AgentCard | str, subtask: str, context_refs: list[str]
 65:     ) -> str:
 66:         task_id = new_id("mcp_task")
 67:         server_url, tool_name = self._resolve_config(agent_card)
 68:         try:
 69:             session = await self._get_mcp_session(server_url)
 70:             arguments: dict[str, Any] = {"task": subtask}
 71:             if context_refs:
 72:                 arguments["context_refs"] = context_refs
 73:             result = await session.call_tool(tool_name, arguments=arguments)
 74:             output_text = ""
 75:             for content in result.content:
 76:                 if hasattr(content, "text"):
 77:                     output_text += content.text
 78:             is_error = getattr(result, "isError", False)
 79:             self._task_results[task_id] = Observation(
 80:                 observation_id=new_id("obs"),
 81:                 success=not is_error,
 82:                 payload=output_text or None,
 83:                 error=output_text if is_error else None,
 84:                 extra={"mcp_tool": tool_name, "mcp_server": server_url},
 85:             )
 86:             self._task_statuses[task_id] = TaskStatus.COMPLETED
 87:         except NotImplementedError:
 88:             raise
 89:         except Exception as exc:
 90:             # Broad catch: MCP SDK may raise arbitrary transport errors;
 91:             # convert to a failed Observation to avoid crashing the agent loop.
 92:             self._task_results[task_id] = Observation(
 93:                 observation_id=new_id("obs"),
 94:                 success=False,
 95:                 payload=None,
 96:                 error=f"MCP send_task failed: {exc}",
 97:             )
 98:             self._task_statuses[task_id] = TaskStatus.FAILED
 99:         return task_id
100:     async def poll_status(self, task_id: str) -> str:
101:         return self._task_statuses.get(task_id, "completed")
102:     async def receive_result(self, task_id: str) -> Observation:
103:         return self._task_results.get(
104:             task_id,
105:             Observation(
106:                 observation_id=new_id("obs"),
107:                 success=False,
108:                 payload=None,
109:                 error=f"MCP task not found: {task_id}",
110:             ),
111:         )
112:     async def wait_result(self, task_id: str, timeout_s: float | None = None) -> Observation:
113:         """MCP 任务在 send_task 阶段通常已同步完成，直接取结果。"""
114:         return await self.receive_result(task_id)
115:     async def close(self) -> None:
116:         for session in self._sessions.values():
117:             with contextlib.suppress(Exception):
118:                 await session.__aexit__(None, None, None)
119:         self._sessions.clear()
</file>

<file path="lca/layer1_cognitive/body/fallback_decorated_body.py">
 1: """FallbackDecoratedBody."""
 2: from __future__ import annotations
 3: from lca.contracts.decision import Observation, StructuredDecision
 4: from lca.contracts.protocols import AgentTransport, Body, FallbackPolicy
 5: from lca.contracts.result import UnregisteredActionError
 6: from lca.contracts.state import TypedState
 7: class FallbackDecoratedBody(Body):
 8:     """Decorator that catches ``UnregisteredActionError`` and delegates to a fallback policy.
 9:     Wraps an inner ``Body`` implementation.  When the inner body raises
10:     ``UnregisteredActionError`` (action_type not found in the registry),
11:     this decorator invokes the ``FallbackPolicy`` instead of propagating
12:     the error, enabling graceful degradation for unknown actions.
13:     """
14:     def __init__(self, inner: Body, fallback_handler: FallbackPolicy) -> None:
15:         self._inner = inner
16:         self._fallback_handler = fallback_handler
17:     async def act(self, decision: StructuredDecision, state: TypedState) -> Observation:
18:         try:
19:             return await self._inner.act(decision, state)
20:         except UnregisteredActionError:
21:             registry = getattr(self._inner, "action_registry", None)
22:             return await self._fallback_handler.handle(decision, state, registry)
23:     def bind_transport(self, transport: AgentTransport) -> None:
24:         self._inner.bind_transport(transport)
</file>

<file path="lca/layer1_cognitive/brain/map_modules/conflict_monitor.py">
 1: """ConflictMonitor content-aware default."""
 2: from __future__ import annotations
 3: from lca.contracts.decision import StructuredDecision
 4: from lca.contracts.protocols import ConflictMonitor
 5: from lca.contracts.state import TypedState
 6: class SimpleConflictMonitor(ConflictMonitor):
 7:     """Content-aware conflict monitor for multi-candidate evaluation.
 8:     Detects disagreements among candidate decisions by comparing response
 9:     text, rationale, and action types.  Returns a list of conflict labels
10:     (e.g. ``content_disagreement``, ``action_type_disagreement``) that
11:     downstream strategies can use to decide whether further debate is needed.
12:     """
13:     async def check(self, state: TypedState, candidates: list[StructuredDecision]) -> list[str]:
14:         del state
15:         if len(candidates) < 2:
16:             return []
17:         texts = {
18:             (c.response_text or c.rationale or "").strip().lower()
19:             for c in candidates
20:             if (c.response_text or c.rationale)
21:         }
22:         if len(texts) > 1:
23:             return ["content_disagreement"]
24:         if len({c.action_type for c in candidates}) > 1:
25:             return ["action_type_disagreement"]
26:         return []
</file>

<file path="lca/layer2_runtime/outcome_policies/default_outcome_policy.py">
 1: """DefaultStepOutcomePolicy —— 默认单步结果判定策略。
 2: L2 层职责：
 3:     根据当前 step 的 decision / observation / reflection 判定：
 4:     - 是否应停止循环（should_stop）
 5:     - 最终输出（final_output）
 6:     - 任务状态（status）
 7:     与 LoopJudge 组合使用：LoopJudge 负责 budget 检查 + 调用本策略，
 8:     本策略只负责业务语义的判定（action_type、reflection_verdict）。
 9: """
10: from __future__ import annotations
11: from lca.contracts.decision import Observation, Reflection, StructuredDecision
12: from lca.contracts.enums import ActionType, ReflectionVerdict
13: from lca.contracts.lifecycle import TaskStatus
14: from lca.contracts.protocols import StepOutcome, StepOutcomePolicy
15: from lca.contracts.state import TypedState
16: class DefaultStepOutcomePolicy(StepOutcomePolicy):
17:     """默认单步结果判定策略。
18:     判定规则：
19:     - HANDOFF 动作 → 立即停止（COMPLETED）
20:     - RESPOND 动作或降级成功 → 提取 final_output，
21:       除非 reflection 判定 NEEDS_CORRECTION 则继续循环
22:     - 其他 → 继续循环
23:     """
24:     def resolve(
25:         self,
26:         state: TypedState,
27:         decision: StructuredDecision | None,
28:         observation: Observation | None,
29:         reflection: Reflection | None,
30:     ) -> StepOutcome:
31:         if decision is None or reflection is None:
32:             return StepOutcome()
33:         degraded_ok = bool(
34:             observation is not None and observation.success and observation.degraded_from
35:         )
36:         if decision.action_type == ActionType.HANDOFF:
37:             return StepOutcome(should_stop=True, status=TaskStatus.COMPLETED)
38:         if decision.action_type == ActionType.RESPOND or degraded_ok:
39:             final_output = decision.response_text if decision.response_text else None
40:             if (
41:                 final_output is None
42:                 and degraded_ok
43:                 and observation is not None
44:                 and isinstance(observation.payload, str)
45:             ):
46:                 final_output = observation.payload
47:             should_stop = reflection.verdict != ReflectionVerdict.NEEDS_CORRECTION
48:             return StepOutcome(
49:                 should_stop=should_stop,
50:                 final_output=final_output,
51:                 status=TaskStatus.COMPLETED if should_stop else None,
52:             )
53:         return StepOutcome()
54:     def resolve_budget_exceeded(
55:         self, observation: Observation | None, state: TypedState
56:     ) -> StepOutcome:
57:         last_ok = observation is not None and observation.success
58:         final_output = None
59:         if (
60:             last_ok
61:             and state.final_output is None
62:             and observation is not None
63:             and isinstance(observation.payload, str)
64:         ):
65:             final_output = observation.payload
66:         return StepOutcome(
67:             should_stop=True,
68:             final_output=final_output,
69:             status=TaskStatus.COMPLETED if last_ok else TaskStatus.FAILED,
70:         )
</file>

