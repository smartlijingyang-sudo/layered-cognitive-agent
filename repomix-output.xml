<file path="lca/layer1_cognitive/memory/team_shared_memory.py">
 1: """TeamSharedMemoryStore —— 团队级共享记忆存储。
 2: 只对 semantic / procedural 两层做跨 Agent 共享（CoALA 记忆分类的语义边界：
 3: episodic 是个体的情景经历，working 是当前会话上下文，这两层保持私有）。
 4: """
 5: from __future__ import annotations
 6: from typing import Literal
 7: from lca.contracts.memory import MemoryRecord
 8: from lca.contracts.protocols import SharedMemoryStore
 9: SharedLayerName = Literal["semantic", "procedural"]
10: _VALID_SHARED_LAYERS: frozenset[str] = frozenset({"semantic", "procedural"})
11: class TeamSharedMemoryStore(SharedMemoryStore):
12:     """跨 Agent 共享的记忆存储，按 layer 分流。
13:     每个 layer 维护独立的记录列表，多个 SimpleMemorySystem 实例
14:     持有同一 store 的引用，实现"共享即同一数据源"。
15:     """
16:     def __init__(self, shared_layers: list[SharedLayerName]) -> None:
17:         invalid = set(shared_layers) - _VALID_SHARED_LAYERS
18:         if invalid:
19:             raise ValueError(f"只有 semantic/procedural 层可以共享，非法层: {invalid}")
20:         self._shared_layers: list[str] = list(shared_layers)
21:         self._stores: dict[str, list[MemoryRecord]] = {layer: [] for layer in shared_layers}
22:     @property
23:     def shared_layers(self) -> list[str]:
24:         return list(self._shared_layers)
25:     def is_shared(self, layer: str) -> bool:
26:         return layer in self._stores
27:     def add_record(self, layer: str, record: MemoryRecord) -> None:
28:         if layer not in self._stores:
29:             raise KeyError(f"层 {layer!r} 不在共享范围内")
30:         self._stores[layer].append(record)
31:     def get_records(self, layer: str) -> list[MemoryRecord]:
32:         if layer not in self._stores:
33:             raise KeyError(f"层 {layer!r} 不在共享范围内")
34:         return list(self._stores[layer])
</file>

<file path="lca/layer3_agent/orchestration_strategies/debate.py">
 1: """DebateStrategy —— 多 Agent 辩论达成共识。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import uuid
 5: from lca.contracts.decision import StructuredDecision
 6: from lca.contracts.protocols import (
 7:     ConflictMonitor,
 8:     OrchestrationContext,
 9:     OrchestrationStrategy,
10:     StateEvaluator,
11:     TaskCoordinator,
12: )
13: from lca.contracts.result import Result
14: from lca.contracts.state import Budget, TypedState
15: _DEFAULT_MAX_ROUNDS = 3
16: class DebateStrategy(OrchestrationStrategy):
17:     """多 Agent 辩论达成共识。
18:     每轮用 asyncio.gather 并行收集各 Agent 对当前 objective 的表态，
19:     轮间通过 ConflictMonitor.check 判断是否仍有分歧（无分歧则提前退出），
20:     最终由 StateEvaluator.score + TaskCoordinator.arbitrate 选出最优方案。
21:     复用 L1 MAP 五模块中的 ConflictMonitor / StateEvaluator / TaskCoordinator，
22:     验证"单 Agent 内部积木可直接复用为跨 Agent 编排能力"这一架构假设。
23:     """
24:     def __init__(
25:         self,
26:         conflict_monitor: ConflictMonitor | None = None,
27:         task_coordinator: TaskCoordinator | None = None,
28:         state_evaluator: StateEvaluator | None = None,
29:     ) -> None:
30:         self._conflict_monitor = conflict_monitor
31:         self._task_coordinator = task_coordinator
32:         self._state_evaluator = state_evaluator
33:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
34:         if not context.members:
35:             return Result.failed("No members in team")
36:         max_rounds = (
37:             context.config.max_rounds
38:             if context.config and context.config.max_rounds
39:             else _DEFAULT_MAX_ROUNDS
40:         )
41:         current_objective = objective
42:         all_round_results: list[list[Result]] = []
43:         for _round in range(max_rounds):
44:             tasks = [member.execute(current_objective) for member in context.members]
45:             round_results: list[Result] = await asyncio.gather(*tasks)
46:             all_round_results.append(round_results)
47:             conflicts = await self._check_conflicts(objective, round_results)
48:             if not conflicts:
49:                 return await self._arbitrate(objective, round_results)
50:             proposals = "\n".join(
51:                 f"Agent {i}: {r.output or ''}" for i, r in enumerate(round_results)
52:             )
53:             current_objective = f"{objective}\n\nPrevious proposals:\n{proposals}"
54:         final_round = all_round_results[-1]
55:         return await self._arbitrate(objective, final_round)
56:     async def _check_conflicts(self, objective: str, results: list[Result]) -> list[str]:
57:         if self._conflict_monitor is None:
58:             return ["no_monitor"]
59:         state = TypedState(trace_id="debate", task=objective, budget=Budget())
60:         decisions = [_result_to_decision(r, i) for i, r in enumerate(results)]
61:         return await self._conflict_monitor.check(state, decisions)
62:     async def _arbitrate(self, objective: str, results: list[Result]) -> Result:
63:         if self._task_coordinator is None or self._state_evaluator is None:
64:             return results[0] if results else Result.failed("No results to arbitrate")
65:         state = TypedState(trace_id="debate", task=objective, budget=Budget())
66:         decisions = [_result_to_decision(r, i) for i, r in enumerate(results)]
67:         scores = [
68:             await self._state_evaluator.score(state, {"decision": d.rationale}) for d in decisions
69:         ]
70:         await self._task_coordinator.arbitrate(state, decisions, scores)
71:         best_idx = max(range(len(scores)), key=lambda i: scores[i])
72:         return results[best_idx]
73: def _result_to_decision(result: Result, index: int) -> StructuredDecision:
74:     return StructuredDecision(
75:         decision_id=f"debate_{index}_{uuid.uuid4().hex[:8]}",
76:         action_type="respond",
77:         rationale=result.output or "",
78:         confidence=0.5,
79:         response_text=result.output,
80:     )
</file>

<file path="lca/layer3_agent/orchestration_strategies/handoff.py">
 1: """HandoffStrategy —— 动态控制权移交，首个完成者胜出。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
 4: from lca.contracts.result import Result
 5: class HandoffStrategy(OrchestrationStrategy):
 6:     """动态控制权移交：按顺序将任务交给各 Agent，任一 Agent 完成即终止。
 7:     与 SequentialStrategy 的区别：
 8:     - Sequential：每个 Agent 都必须执行，像流水线一样传递
 9:     - Handoff：第一个能完成任务的 Agent 执行后，后续 Agent 不再执行
10:     典型场景：客服分诊（分诊 Agent → 专家 Agent），不需要分诊 Agent 等结果。
11:     """
12:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
13:         if not context.members:
14:             return Result.failed("No members in team")
15:         last_result: Result | None = None
16:         for member in context.members:
17:             result: Result = await member.execute(objective)
18:             last_result = result
19:             if result.status == "completed":
20:                 return result
21:         return last_result or Result.failed("All members failed")
</file>

