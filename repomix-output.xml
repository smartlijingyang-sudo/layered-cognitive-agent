<file path="lca/layer1_cognitive/body/fallback_decorated_body.py">
 1: """FallbackDecoratedBody —— Body 的降级装饰器。
 2: 将"未知 action_type 时降级"从 Runtime Loop 下沉到 Body 层，
 3: 符合装饰器模式：Loop 只调用 body.act()，不感知降级逻辑。
 4: 降级发生与否通过 Observation.extra[FALLBACK_DEGRADATION_KEY] 传递，
 5: 由 StepOutcomePolicy 在 Loop 外层解读，Loop 本身不认识这个 key。
 6: """
 7: from __future__ import annotations
 8: from lca.contracts.action import ActionRegistryProtocol
 9: from lca.contracts.decision import Observation, StructuredDecision
10: from lca.contracts.protocols import AgentTransport, Body, FallbackHandler
11: from lca.contracts.result import ToolExecutionError
12: from lca.contracts.state import TypedState
13: class FallbackDecoratedBody(Body):
14:     """Body 装饰器：捕获"未注册的 action_type"错误并委托给 FallbackHandler。
15:     Loop 里只剩 ``await self.body.act(decision, state)``，
16:     不再出现 _act_with_fallback、局部 import、字符串前缀判断。
17:     """
18:     def __init__(self, inner: Body, fallback_handler: FallbackHandler) -> None:
19:         self._inner = inner
20:         self._fallback_handler = fallback_handler
21:     async def act(self, decision: StructuredDecision, state: TypedState) -> Observation:
22:         try:
23:             return await self._inner.act(decision, state)
24:         except ToolExecutionError as err:
25:             if not str(err).startswith("未注册的 action_type:"):
26:                 raise
27:             registry: ActionRegistryProtocol | None = getattr(self._inner, "action_registry", None)
28:             return await self._fallback_handler.handle(decision, state, registry)
29:     def bind_transport(self, transport: AgentTransport) -> None:
30:         self._inner.bind_transport(transport)
</file>

