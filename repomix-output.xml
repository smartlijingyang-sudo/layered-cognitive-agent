 71: def _build_brain(
 72:     llm: LLMAdapter,
 73:     role_profile: RoleProfile,
 74:     tools_desc: str,
 75:     team_roster: str | None = None,
 76:     action_registry: ActionRegistryProtocol | None = None,
 77: ) -> ModularBrain:
 78:     """默认 Brain 工厂：ModularBrain + MAP 五模块。"""
 79:     prompt_manager = SimplePromptManager()
 80:     prompt_manager.register_template("react_prompt", load_builtin_prompt("react_prompt"))
 81:     prompt_manager.register_template(
 82:         "hierarchical_prompt", load_builtin_prompt("hierarchical_prompt")
 83:     )
 84:     # 从 ActionRegistry 动态生成 Prompt 中的 action 枚举说明
 85:     allowed_actions_desc = ""
 86:     if action_registry is not None:
 87:         action_descs: dict[str, str] = {
 88:             "respond": "respond — 直接回复用户（需附带 response_text）",
 89:             "use_tool": "use_tool — 调用工具（需附带 tool_name / arguments）",
 90:             "delegate": "delegate — 将子任务委派给队友（需附带 target_role / subtask）",
 91:             "handoff": "handoff — 非阻塞移交控制权给其他 Agent",
 92:             "stop": "stop — 任务已完成",
 93:             "ask_human": "ask_human — 请求人工介入",
 94:         }
 95:         allowed_actions_desc = "\n".join(
 96:             f"{i + 1}. {action_descs.get(at, f'{at} — (自定义)')}"
 97:             for i, at in enumerate(action_registry.allowed_action_types())
 98:         )
 99:     reasoner = SimpleReasoner(
100:         llm,
101:         prompt_manager,
102:         role_profile,
103:         tools_desc,
104:         team_roster=team_roster,
105:         allowed_actions_desc=allowed_actions_desc,
106:     )
107:     return ModularBrain(
108:         reasoner=reasoner,
109:         decision_parser=SimpleDecisionParser(action_registry=action_registry),
110:         critic=SimpleCritic(),
111:         task_decomposer=SimpleTaskDecomposer(),
112:         state_predictor=SimpleStatePredictor(),
113:         state_evaluator=SimpleStateEvaluator(),
114:         conflict_monitor=SimpleConflictMonitor(),
115:         task_coordinator=SimpleTaskCoordinator(),
116:     )
117: def build_default_transport_registry() -> TransportRegistry:
118:     """构建默认 TransportRegistry：internal→InternalTransport, a2a→A2ATransport, mcp→MCPTransport。"""
119:     registry = TransportRegistry()
120:     registry.register(InternalTransport())
121:     registry.register(A2ATransport())
122:     registry.register(MCPTransport())
123:     return registry
124: def build_body(
125:     tools: list[Tool],
126:     observability: Observability,
127:     transport_registry: TransportRegistryProtocol | None = None,
128:     action_registry: ActionRegistryProtocol | None = None,
129:     enable_fallback: bool = True,
130: ) -> Body:
131:     """默认 Body 构建器。
132:     enable_fallback=True 时用 FallbackDecoratedBody 包裹 SimpleBody，
133:     使未知 action_type 自动降级，Loop 不感知降级逻辑。
134:     """
135:     permission_manifest = ToolPermissionManifest(allowed_tools=[t.name for t in tools])
136:     tool_registry = SimpleToolRegistry()
137:     for t in tools:
138:         tool_registry.register(t)
139:     safe_executor = SimpleSafeExecutor(permission_manifest, observability)
140:     registry = transport_registry or build_default_transport_registry()
141:     simple_body = SimpleBody(
142:         tool_registry=tool_registry,
143:         safe_executor=safe_executor,
144:         transport_registry=registry,
145:         action_registry=action_registry,
146:     )
147:     if enable_fallback:
148:         return FallbackDecoratedBody(inner=simple_body, fallback_handler=FallbackActionHandler())
149:     return simple_body
150: def _build_hooks(observability: Observability, event_bus: EventBus) -> SimpleHookRegistry:
151:     hooks = SimpleHookRegistry(observability)
152:     event_hook = make_event_emitting_hook(event_bus)
153:     for event_name in HOOK_NAMES:
154:         hooks.register(event_name, default_logging_hook)
155:         hooks.register(event_name, event_hook)
156:     return hooks
157: def build_runtime(
158:     brain: BrainStrategy,
159:     body: Body,
160:     memory: MemorySystem,
161:     hooks: HookRegistry,
162:     state_store: StateStore,
163:     outcome_policy: StepOutcomePolicy | None = None,
164: ) -> CognitiveRuntime:
165:     """默认 Runtime 构建器。"""
166:     return CognitiveRuntime(brain, body, memory, hooks, state_store, outcome_policy=outcome_policy)
167: def build_team_transport(
168:     members: list[BaseAgent],
169: ) -> tuple[AgentTransport, str]:
170:     """为 hierarchical 团队构建进程内传输层和花名册。
171:     把每个 member 的 execute 包装为 async handler（key = role），
172:     Result → Observation 的适配在此完成；
173:     同时拼接 roster_desc 供 Supervisor 的 Reasoner 感知队友。
174:     """
175:     from lca.contracts.state import _current_delegator
176:     transport = InternalTransport()
177:     for member in members:
178:         async def _handler(subtask: str, _m: BaseAgent = member) -> Observation:
179:             delegated_by = _current_delegator.get()
180:             result = await _m.execute(subtask, delegated_by=delegated_by)
181:             return Observation(
182:                 observation_id=f"obs_{result.trace_id}",
183:                 success=result.status == "completed",
184:                 payload=result.output,
185:                 error=result.error,
186:             )
187:         transport.register_agent(member.role_profile.role, _handler)
188:     roster_desc = build_team_roster([m.role_profile for m in members])
189:     return transport, roster_desc
190: def register_defaults() -> None:
191:     """注册所有内置默认实现到全局注册表。"""
192:     reg = get_global_registry()
193:     reg.register("observability", "console", ConsoleObservability)
194:     reg.register("observability", "jsonl_file", JSONLFileObservability)
195:     reg.register("state_store", "memory", InMemoryStateStore)
196:     reg.register("memory", "simple", SimpleMemorySystem)
197:     reg.register("event_bus", "simple", SimpleEventBus)
198:     reg.register("delegation_ledger", "default", DelegationLedger)
199:     strategy_reg = get_global_strategy_registry()
200:     strategy_reg.register("default", _build_brain)
201:     orch_reg = get_global_orchestration_registry()
202:     orch_reg.register("hierarchical", HierarchicalStrategy)
203:     orch_reg.register("sequential", SequentialStrategy)
204:     orch_reg.register("parallel", lambda: ParallelStrategy(synthesizer=ConcatSynthesizer()))
205:     orch_reg.register("graph", GraphStrategy)
206:     orch_reg.register(
207:         "debate",
208:         lambda: DebateStrategy(
209:             conflict_monitor=SimpleConflictMonitor(),
210:             task_coordinator=SimpleTaskCoordinator(),
211:             state_evaluator=SimpleStateEvaluator(),
212:         ),
213:     )
214:     orch_reg.register("handoff", HandoffStrategy)
215:     # CompletionPolicy 注册
216:     from lca.layer1_cognitive.brain.completion_policies.roster_coverage import (
217:         RosterCoveragePolicy,
218:     )
219:     reg.register("completion_policy", "roster_coverage", RosterCoveragePolicy)
220: register_defaults()
