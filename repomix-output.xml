11:         # 构建角色链信息
12:         role = span.attributes.get("agent_role", "")
13:         delegated_by = span.attributes.get("delegated_by", "")
14:         role_prefix = (
15:             f"[{delegated_by} → {role}] " if delegated_by else f"[{role}] " if role else ""
16:         )
17:         # 构建关键属性摘要
18:         key_attrs = {}
