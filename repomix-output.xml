 9: from lca.contracts.state import TypedState
10: @runtime_checkable
11: class ActionOperation(Protocol):
12:     """单一行动能力的操作接口（Strategy Pattern）。
13:     每种 action_type 对应一个独立实现，彼此零依赖、零共享可变状态。
14:     新增行动能力 = 新增一个 Operation + 一条注册，不修改任何既有代码路径。
15:     """
16:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation: ...
