  1: """GraphStrategy —— DAG 工作流引擎。
  2: L3 层职责：
  3:     将 ExecutionGraph 编译为拓扑排序执行计划，支持：
  4:     - 顺序边（DEFAULT）：前驱完成后触发后继
  5:     - 条件边（CONDITIONAL）：运行时求值 condition，命中则通行，否则级联跳过
  6:     - 并行边（PARALLEL）：多分支 asyncio.gather 并发执行
  7:     - 聚合节点（AGGREGATOR）：汇合多个前驱的输出
  8:     执行核心：BFS 队列驱动拓扑排序，入度归零即入队。
  9:     仅接受严格 DAG（allow_cycle=False）。
 10: """
 11: from __future__ import annotations
 12: import asyncio
 13: from collections import deque
 14: from typing import Any
 15: from lca.contracts.graph import EdgeType, ExecutionGraph, NodeType
 16: from lca.contracts.lifecycle import TaskStatus
 17: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy, StateStore
 18: from lca.contracts.result import Result
 19: from lca.contracts.state import Budget, TypedState
 20: from lca.layer3_agent.member_invoke import invoke_member
 21: from lca.layer3_agent.orchestration_strategies.graph.topology import (
 22:     cascade_skip,
 23:     compute_in_degree_and_out_edges,
 24:     enqueue_ready_targets,
 25: )
 26: _AGGREGATOR_TRACE_PREFIX = "graph-agg"
 27: _GRAPH_TRACE_ID = "graph"
 28: class GraphStrategy(OrchestrationStrategy):
 29:     """DAG 工作流引擎：拓扑排序 + fan-in/fan-out + 条件分支 + 并行分支。
 30:     构造时可选传入 ExecutionGraph 和 StateStore。
 31:     若未传入 graph，则从 OrchestrationContext 解析（当前要求构造时传入）。
 32:     """
 33:     def __init__(
 34:         self,
 35:         execution_graph: ExecutionGraph | None = None,
 36:         state_store: StateStore | None = None,
 37:     ) -> None:
 38:         self._graph = execution_graph
 39:         self._state_store = state_store
 40:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
 41:         graph = self._resolve_graph(context)
 42:         graph.validate()
 43:         if graph.allow_cycle:
 44:             raise ValueError("GraphStrategy 仅支持严格 DAG（allow_cycle=False）。")
 45:         member_map = {m.role_profile.role: m for m in context.members}
 46:         state = TypedState(trace_id=_GRAPH_TRACE_ID, task=objective, budget=Budget())
 47:         in_degree, out_edge_indices = compute_in_degree_and_out_edges(graph)
 48:         remaining: dict[str, int] = dict(in_degree)
 49:         executed: set[str] = set()
 50:         skipped: set[str] = set()
 51:         results: dict[str, Result] = {}
 52:         aggregator_ids: set[str] = set()
 53:         queue: deque[str] = deque(nid for nid, deg in remaining.items() if deg == 0)
 54:         while queue:
 55:             nid = queue.popleft()
 56:             if nid in executed or nid in skipped:
 57:                 continue
 58:             node = graph.nodes[nid]
 59:             if node.type == NodeType.AGGREGATOR:
 60:                 aggregator_ids.add(nid)
 61:             await self._execute_node(node, graph, context, member_map, objective, state, results)
 62:             executed.add(nid)
 63:             fixed_targets: list[str] = []
 64:             parallel_targets: list[str] = []
 65:             for edge_idx in out_edge_indices[nid]:
 66:                 edge = graph.edges[edge_idx]
 67:                 if edge.type == EdgeType.CONDITIONAL:
 68:                     if edge.condition is not None and edge.condition(state):
 69:                         fixed_targets.append(edge.target)
 70:                     else:
 71:                         cascade_skip(graph, edge.target, remaining, skipped, executed, queue)
 72:                 elif edge.type == EdgeType.PARALLEL:
 73:                     parallel_targets.append(edge.target)
 74:                 else:
 75:                     fixed_targets.append(edge.target)
 76:             if parallel_targets:
 77:                 await self._execute_parallel_branches(
 78:                     parallel_targets,
 79:                     graph,
 80:                     context,
 81:                     member_map,
 82:                     objective,
 83:                     state,
 84:                     results,
 85:                     remaining,
 86:                     executed,
 87:                     skipped,
 88:                     queue,
 89:                     aggregator_ids,
 90:                 )
 91:             else:
 92:                 enqueue_ready_targets(fixed_targets, remaining, executed, queue)
 93:         return self._finalize(graph, results, aggregator_ids)
 94:     def _resolve_graph(self, context: OrchestrationContext) -> ExecutionGraph:
 95:         if self._graph is not None:
 96:             return self._graph
 97:         raise ValueError("GraphStrategy 需要 ExecutionGraph：构造时传入 execution_graph")
 98:     async def _execute_node(
 99:         self,
100:         node: Any,
101:         graph: ExecutionGraph,
102:         context: OrchestrationContext,
103:         member_map: dict[str, Any],
104:         objective: str,
105:         state: TypedState,
106:         results: dict[str, Result],
107:     ) -> None:
108:         if node.type == NodeType.AGENT:
109:             role = node.config.get("role", "")
110:             member = member_map.get(role)
111:             if member:
112:                 results[node.id] = await invoke_member(context, member, objective)
113:                 if self._state_store:
114:                     await self._state_store.save(state)
115:         elif node.type == NodeType.AGGREGATOR:
116:             preds = [e.source for e in graph.incoming(node.id)]
117:             parts = [str(results[p].output) for p in preds if p in results and results[p].output]
118:             total_steps = sum(results[p].total_steps for p in preds if p in results)
119:             results[node.id] = Result(
120:                 trace_id=_AGGREGATOR_TRACE_PREFIX,
121:                 status=TaskStatus.COMPLETED,
122:                 final_state_ref="",
123:                 total_steps=total_steps or 1,
124:                 budget_used=Budget(used_steps=total_steps or 1),
125:                 output="\n".join(parts),
126:             )
127:     async def _execute_parallel_branches(
128:         self,
129:         targets: list[str],
130:         graph: ExecutionGraph,
131:         context: OrchestrationContext,
132:         member_map: dict[str, Any],
133:         objective: str,
134:         state: TypedState,
135:         results: dict[str, Result],
136:         remaining: dict[str, int],
137:         executed: set[str],
138:         skipped: set[str],
139:         queue: deque[str],
140:         aggregator_ids: set[str],
141:     ) -> None:
142:         async def _run_branch(target_nid: str) -> None:
143:             if target_nid in executed or target_nid in skipped:
144:                 return
145:             node = graph.nodes[target_nid]
146:             if node.type == NodeType.AGGREGATOR:
147:                 aggregator_ids.add(target_nid)
148:             await self._execute_node(node, graph, context, member_map, objective, state, results)
149:             executed.add(target_nid)
150:             sub_fixed: list[str] = []
151:             sub_parallel: list[str] = []
152:             for edge in graph.outgoing(target_nid):
153:                 if edge.type == EdgeType.PARALLEL:
154:                     sub_parallel.append(edge.target)
155:                 elif edge.type == EdgeType.CONDITIONAL:
156:                     if edge.condition is not None and edge.condition(state):
157:                         sub_fixed.append(edge.target)
158:                     else:
159:                         cascade_skip(graph, edge.target, remaining, skipped, executed, queue)
160:                 else:
161:                     sub_fixed.append(edge.target)
162:             if sub_parallel:
163:                 await self._execute_parallel_branches(
164:                     sub_parallel,
165:                     graph,
166:                     context,
167:                     member_map,
168:                     objective,
169:                     state,
170:                     results,
171:                     remaining,
172:                     executed,
173:                     skipped,
174:                     queue,
175:                     aggregator_ids,
176:                 )
177:             else:
178:                 for sub_target in sub_fixed:
179:                     remaining[sub_target] -= 1
180:                     if remaining[sub_target] <= 0 and sub_target not in executed:
181:                         await _run_branch(sub_target)
182:         await asyncio.gather(*[_run_branch(t) for t in targets])
183:         for target in targets:
184:             for edge in graph.outgoing(target):
185:                 next_nid = edge.target
186:                 remaining[next_nid] -= 1
187:                 if remaining[next_nid] <= 0 and next_nid not in executed:
188:                     queue.append(next_nid)
189:     @staticmethod
190:     def _finalize(
191:         graph: ExecutionGraph, results: dict[str, Result], aggregator_ids: set[str]
192:     ) -> Result:
193:         if not results:
194:             return Result.failed("Graph execution produced no results")
195:         total_steps = sum(r.total_steps for r in results.values())
196:         for agg_id in aggregator_ids:
197:             if agg_id in results and results[agg_id].output is not None:
198:                 out = results[agg_id]
199:                 out.total_steps = total_steps
200:                 return out
201:         agent_ids = [
202:             nid
203:             for nid, r in results.items()
204:             if nid in graph.nodes and graph.nodes[nid].type == NodeType.AGENT and r.output
205:         ]
206:         terminal: list[str] = []
207:         for nid in agent_ids:
208:             outs = [
209:                 e.target
210:                 for e in graph.outgoing(nid)
211:                 if e.target in results
212:                 and e.target in graph.nodes
213:                 and graph.nodes[e.target].type == NodeType.AGENT
214:             ]
215:             if not outs:
216:                 terminal.append(nid)
217:         chosen = terminal or agent_ids
218:         parts = [str(results[nid].output) for nid in chosen if results[nid].output]
219:         if not parts:
220:             last = next(iter(results.values()))
221:             last.total_steps = total_steps
222:             return last
223:         if len(parts) == 1:
224:             for nid in chosen:
225:                 if str(results[nid].output) == parts[0]:
226:                     r = results[nid]
227:                     r.total_steps = total_steps
228:                     return r
229:         return Result(
230:             trace_id=_GRAPH_TRACE_ID,
231:             status=TaskStatus.COMPLETED,
232:             final_state_ref="",
233:             total_steps=total_steps,
234:             budget_used=Budget(used_steps=total_steps),
235:             output="\n".join(parts),
236:         )
</file>

