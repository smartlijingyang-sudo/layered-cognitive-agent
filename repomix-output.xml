<file path="lca/layer3_agent/orchestration_strategies/debate.py">
 1: """DebateStrategy —— 多 Agent 辩论达成共识。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import uuid
 5: from lca.contracts.decision import StructuredDecision
 6: from lca.contracts.enums import ActionType
 7: from lca.contracts.protocols import (
 8:     ConflictMonitor,
 9:     OrchestrationContext,
10:     OrchestrationStrategy,
11:     StateEvaluator,
12:     TaskCoordinator,
13: )
14: from lca.contracts.result import Result
15: from lca.contracts.state import Budget, TypedState
16: from lca.layer3_agent.member_invoke import invoke_member
17: _DEFAULT_MAX_ROUNDS = 3
18: _DEFAULT_CONFIDENCE = 0.5
19: _ID_SUFFIX_LEN = 8  # hex digits from uuid4 for unique decision IDs (32 bits of randomness)
20: class DebateStrategy(OrchestrationStrategy):
21:     """多 Agent 辩论达成共识。
22:     每轮用 asyncio.gather 并行收集各 Agent 对当前 objective 的表态，
23:     轮间通过 ConflictMonitor.check 判断是否仍有分歧（无分歧则提前退出），
24:     最终由 StateEvaluator.score + TaskCoordinator.arbitrate 选出最优方案。
25:     复用 L1 MAP 五模块中的 ConflictMonitor / StateEvaluator / TaskCoordinator，
26:     验证"单 Agent 内部积木可直接复用为跨 Agent 编排能力"这一架构假设。
27:     """
28:     def __init__(
29:         self,
30:         conflict_monitor: ConflictMonitor | None = None,
31:         task_coordinator: TaskCoordinator | None = None,
32:         state_evaluator: StateEvaluator | None = None,
33:     ) -> None:
34:         self._conflict_monitor = conflict_monitor
35:         self._task_coordinator = task_coordinator
36:         self._state_evaluator = state_evaluator
37:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
38:         if not context.members:
39:             return Result.failed("No members in team")
40:         max_rounds = (
41:             context.config.max_rounds
42:             if context.config and context.config.max_rounds
43:             else _DEFAULT_MAX_ROUNDS
44:         )
45:         current_objective = objective
46:         all_round_results: list[list[Result]] = []
47:         total_steps = 0
48:         for _round in range(max_rounds):
49:             tasks = [
50:                 invoke_member(context, member, current_objective) for member in context.members
51:             ]
52:             round_results: list[Result] = await asyncio.gather(*tasks)
53:             total_steps += sum(r.total_steps for r in round_results)
54:             all_round_results.append(round_results)
55:             conflicts = await self._check_conflicts(objective, round_results)
56:             if not conflicts:
57:                 result = await self._arbitrate(objective, round_results)
58:                 result.total_steps = total_steps
59:                 return result
60:             proposals = "\n".join(
61:                 f"Agent {i}: {r.output or ''}" for i, r in enumerate(round_results)
62:             )
63:             current_objective = f"{objective}\n\nPrevious proposals:\n{proposals}"
64:         final_round = all_round_results[-1]
65:         result = await self._arbitrate(objective, final_round)
66:         result.total_steps = total_steps
67:         return result
68:     async def _check_conflicts(self, objective: str, results: list[Result]) -> list[str]:
69:         if self._conflict_monitor is None:
70:             return ["no_monitor"]
71:         state = TypedState(trace_id="debate", task=objective, budget=Budget())
72:         decisions = [_result_to_decision(r, i) for i, r in enumerate(results)]
73:         return await self._conflict_monitor.check(state, decisions)
74:     async def _arbitrate(self, objective: str, results: list[Result]) -> Result:
75:         if self._task_coordinator is None or self._state_evaluator is None:
76:             return results[0] if results else Result.failed("No results to arbitrate")
77:         state = TypedState(trace_id="debate", task=objective, budget=Budget())
78:         decisions = [_result_to_decision(r, i) for i, r in enumerate(results)]
79:         scores = [
80:             await self._state_evaluator.score(state, {"decision": d.rationale}) for d in decisions
81:         ]
82:         await self._task_coordinator.arbitrate(state, decisions, scores)
83:         best_idx = max(range(len(scores)), key=lambda i: scores[i])
84:         return results[best_idx]
85: def _result_to_decision(result: Result, index: int) -> StructuredDecision:
86:     return StructuredDecision(
87:         decision_id=f"debate_{index}_{uuid.uuid4().hex[:_ID_SUFFIX_LEN]}",
88:         action_type=ActionType.RESPOND,
89:         rationale=result.output or "",
90:         confidence=_DEFAULT_CONFIDENCE,
91:         response_text=result.output,
92:     )
</file>

<file path="lca/layer3_agent/orchestration_strategies/handoff.py">
 1: """HandoffStrategy —— 成员顺序传递，首个完成者胜出。
 2: L3 层职责：
 3:     类似 Sequential 但语义不同：成员依次尝试处理同一任务，
 4:     第一个成功完成的成员即返回结果（不传递输出给下一个）。
 5:     适用于"谁先做完算谁的"的竞争场景。
 6: """
 7: from __future__ import annotations
 8: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
 9: from lca.contracts.result import Result
10: from lca.layer3_agent.member_invoke import invoke_members_sequential
11: class HandoffStrategy(OrchestrationStrategy):
12:     """交接编排：成员依次尝试，首个完成者胜出（不传递输出）。"""
13:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
14:         return await invoke_members_sequential(
15:             context, objective, pass_output_as_next_task=False, stop_on_first_completed=True
16:         )
</file>

<file path="lca/layer3_agent/orchestration_strategies/parallel.py">
 1: """ParallelStrategy —— 成员并行执行，可选合成器汇总结果。
 2: L3 层职责：
 3:     所有成员同时收到同一 objective 并行执行（asyncio.gather），
 4:     执行完毕后：
 5:     - 若有 Synthesizer，由其汇总所有结果为最终输出
 6:     - 否则取最后一个成员的结果作为主输出
 7:     总 step 数为所有成员 step 之和。
 8: """
 9: from __future__ import annotations
10: import asyncio
11: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy, Synthesizer
12: from lca.contracts.result import Result
13: from lca.layer3_agent.member_invoke import invoke_member
14: class ParallelStrategy(OrchestrationStrategy):
15:     """并行编排：所有成员同时执行同一任务，可选 Synthesizer 汇总结果。"""
16:     def __init__(self, synthesizer: Synthesizer | None = None) -> None:
17:         self._synthesizer = synthesizer
18:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
19:         if not context.members:
20:             return Result.failed("No members in team")
21:         results = await asyncio.gather(
22:             *[invoke_member(context, m, objective) for m in context.members]
23:         )
24:         total_steps = sum(r.total_steps for r in results)
25:         if self._synthesizer is not None:
26:             synthesized = await self._synthesizer.synthesize(objective, list(results))
27:             synthesized.total_steps = total_steps
28:             return synthesized
29:         primary = results[-1]
30:         primary.total_steps = total_steps
31:         return primary
</file>

<file path="lca/layer3_agent/orchestration_strategies/sequential.py">
 1: """SequentialStrategy —— 成员顺序执行，输出传递给下一个成员。
 2: L3 层职责：
 3:     最简单的链式编排：A → B → C，每个成员的输出
 4:     作为下一个成员的输入任务。全部成员依次执行完毕后
 5:     返回最后一个成员的结果。
 6: """
 7: from __future__ import annotations
 8: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
 9: from lca.contracts.result import Result
10: from lca.layer3_agent.member_invoke import invoke_members_sequential
11: class SequentialStrategy(OrchestrationStrategy):
12:     """顺序链式编排：成员依次执行，输出传递给下一个成员。"""
13:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
14:         return await invoke_members_sequential(
15:             context, objective, pass_output_as_next_task=True, stop_on_first_completed=False
16:         )
</file>

