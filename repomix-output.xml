<file path="lca/layer0_infra/llm_adapter/factory.py">
 1: """LLM Adapter 工厂 —— 环境变量驱动的 LLM 选择 + .env 加载。
 2: 设计目标：
 3:   1. 任何 demo / 测试 / 用户代码只需一行 ``resolve_llm_adapter()`` 即可获得可用 LLM。
 4:   2. 有 ``LLM_API_KEY`` 环境变量 → 返回 ``OpenAICompatAdapter``（真实网络调用）。
 5:   3. 无 Key → 返回 ``MockLLMAdapter``（离线确定性，零成本）。
 6:   4. ``load_dotenv_if_present()`` 从 CWD 向上寻找最近的 ``.env`` 文件，
 7:      不再硬编码任何开发者本机路径。
 8: """
 9: from __future__ import annotations
10: import logging
11: import os
12: from pathlib import Path
13: from lca.contracts.protocols import LLMAdapter
14: logger = logging.getLogger(__name__)
15: def load_dotenv_if_present(path: str | None = None) -> None:
16:     """加载 .env 文件到环境变量。
17:     Args:
18:         path: 显式指定 .env 路径。为 None 时从当前工作目录向上寻找最近的 .env。
19:               找不到则静默跳过（不报错），保证在无 .env 的环境中也能正常运行。
20:     """
21:     if path is not None:
22:         _load_dotenv_file(Path(path))
23:         return
24:     # 从 CWD 向上寻找最近的 .env
25:     current = Path.cwd()
26:     for directory in [current, *current.parents]:
27:         candidate = directory / ".env"
28:         if candidate.is_file():
29:             _load_dotenv_file(candidate)
30:             return
31: def _load_dotenv_file(path: Path) -> None:
32:     """尝试用 python-dotenv 加载指定路径；若未安装则静默跳过。"""
33:     try:
34:         from dotenv import load_dotenv
35:         load_dotenv(path)
36:         logger.info("Loaded environment from %s", path)
37:     except ImportError:
38:         logger.debug("python-dotenv not installed; skipping %s", path)
39: def resolve_llm_adapter(
40:     *,
41:     api_key: str | None = None,
42:     base_url: str | None = None,
43:     model: str | None = None,
44: ) -> LLMAdapter:
45:     """根据环境变量解析 LLM Adapter 实例。
46:     优先级：显式参数 > 环境变量 > 降级到 Mock。
47:     Args:
48:         api_key: 显式 API Key（覆盖 ``LLM_API_KEY`` 环境变量）。
49:         base_url: 显式 Base URL（覆盖 ``LLM_BASE_URL`` 环境变量）。
50:         model: 显式模型名（覆盖 ``LLM_MODEL`` 环境变量）。
51:     Returns:
52:         ``OpenAICompatAdapter``（有 Key 时）或 ``MockLLMAdapter``（无 Key 时）。
53:     """
54:     resolved_key = api_key or os.getenv("LLM_API_KEY")
55:     if resolved_key:
56:         from lca.layer0_infra.llm_adapter.openai_compat import OpenAICompatAdapter
57:         return OpenAICompatAdapter(
58:             model=model,
59:             api_key=resolved_key,
60:             base_url=base_url,
61:         )
62:     from lca.layer0_infra.llm_adapter.mock_llm import MockLLMAdapter
63:     logger.info("No LLM_API_KEY found; falling back to MockLLMAdapter")
64:     return MockLLMAdapter()
</file>

<file path="lca/layer0_infra/observability/redaction.py">
 1: """密钥脱敏与文本安全处理。
 2: 跨切面基础设施：所有可观测性输出在落盘/打印前必须经过 sanitize。
 3: """
 4: from __future__ import annotations
 5: import re
 6: from typing import Any
 7: _MAX_PREVIEW_LEN: int = 200
 8: _SECRET_PATTERN: re.Pattern[str] = re.compile(
 9:     r"(sk-|api[_-]?key[_-]?|token[_-]?)[\w-]{8,}", re.IGNORECASE
10: )
11: def sanitize(text: str) -> str:
12:     """过滤疑似密钥字符串。"""
13:     return _SECRET_PATTERN.sub("[REDACTED]", text)
14: def truncate(text: str, max_len: int = _MAX_PREVIEW_LEN) -> str:
15:     """截断过长文本。"""
16:     return text if len(text) <= max_len else text[:max_len] + "..."
17: def safe_repr(value: Any) -> Any:
18:     """结构化日志安全表示：原语透传，复杂对象 fallback ``repr()``。"""
19:     if isinstance(value, (str, int, float, bool, type(None))):
20:         return value
21:     return repr(value)
</file>

<file path="lca/layer0_infra/observability/span_attributes.py">
 1: """从 hook kwargs 中提取 TraceSpan 属性。
 2: 将认知层 hook 的上下文信息（state、decision、error 等）
 3: 转换为扁平的属性字典，供可观测性后端消费。
 4: 所有文本值经过脱敏和截断处理。
 5: """
 6: from __future__ import annotations
 7: from typing import Any
 8: from lca.layer0_infra.observability.redaction import sanitize, truncate
 9: def extract_span_attributes(event_name: str, kwargs: dict[str, Any]) -> dict[str, Any]:
10:     """从 hook kwargs 中提取可观测属性，脱敏后放入 TraceSpan.attributes。"""
11:     attrs: dict[str, Any] = {"event": event_name}
12:     state = kwargs.get("state")
13:     if state is not None:
14:         if hasattr(state, "agent_role") and state.agent_role:
15:             attrs["agent_role"] = state.agent_role
16:         if hasattr(state, "delegated_by") and state.delegated_by:
17:             attrs["delegated_by"] = state.delegated_by
18:         if hasattr(state, "task") and state.task:
19:             attrs["task_preview"] = truncate(sanitize(str(state.task)))
20:     decision = kwargs.get("decision")
21:     if decision is not None:
22:         attrs["action_type"] = getattr(decision, "action_type", str(decision))
23:         attrs["confidence"] = getattr(decision, "confidence", None)
24:         if hasattr(decision, "response_text") and decision.response_text:
25:             attrs["response_preview"] = truncate(sanitize(str(decision.response_text)))
26:         if hasattr(decision, "tool_name") and decision.tool_name:
27:             attrs["tool_name"] = decision.tool_name
28:         delegate_to = getattr(decision, "delegate_to", None)
29:         if delegate_to is not None:
30:             target = getattr(delegate_to, "target_role", None) or getattr(
31:                 delegate_to, "target_agent_id", None
32:             )
33:             if target:
34:                 attrs["delegate_to"] = target
35:     error = kwargs.get("error")
36:     if error is not None:
37:         attrs["error_type"] = type(error).__name__
38:         attrs["error_message"] = truncate(str(error))
39:     observation = kwargs.get("observation")
40:     if observation is not None:
41:         attrs["observation_success"] = getattr(observation, "success", None)
42:     reflection = kwargs.get("reflection")
43:     if reflection is not None:
44:         attrs["reflection_preview"] = truncate(sanitize(str(reflection)))
45:     return attrs
