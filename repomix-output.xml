 1: """HierarchicalStrategy —— Supervisor 单向委派、汇总。"""
 2: from __future__ import annotations
 3: from typing import cast
 4: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
 5: from lca.contracts.result import Result
 6: from lca.contracts.team_progress import (
 7:     DelegationLedgerProtocol,
 8:     ledger_tracking_hook,
 9:     progress_injection_hook,
10: )
11: def _default_ledger_factory(roles: frozenset[str]) -> DelegationLedgerProtocol:
12:     """从全局注册表解析 DelegationLedger 并实例化。"""
13:     from lca.layer0_infra.registry import get_global_registry
14:     reg = get_global_registry()
15:     ledger_cls = reg.resolve("delegation_ledger", "default")
16:     if ledger_cls is None:
17:         raise ValueError("未注册 delegation_ledger 'default'，请在 register_defaults() 后使用")
18:     return ledger_cls(mandatory_roles=roles)  # type: ignore[no-any-return]
19: class HierarchicalStrategy(OrchestrationStrategy):
20:     """Supervisor 单向委派、汇总。
21:     自动装配 CompletionPolicy guardrail：
22:     1. 通过 ledger_factory 创建 DelegationLedger（所有成员角色 → pending）
23:     2. 用 GuardedTaskCoordinator 包装 supervisor 的 task_coordinator
24:     3. 注册 post_act 记账 hook + pre_think 进度注入 hook
25:     """
26:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
27:         if context.supervisor is None:
28:             raise ValueError("Hierarchical 模式需要 Supervisor")
29:         if context.transport is not None:
30:             context.supervisor.bind_team(context.transport, context.roster_desc)
31:         # ── 装配确定性收尾 guardrail ──
32:         mandatory_roles = frozenset(m.role_profile.role for m in context.members)
33:         factory = context.ledger_factory or _default_ledger_factory
34:         ledger = factory(mandatory_roles)
35:         runtime = context.supervisor.runtime
36:         runtime.configure(team_progress=ledger)
37:         # 解析 CompletionPolicy（默认 roster_coverage）
38:         policy_name = "roster_coverage"
39:         if context.config is not None:
40:             policy_name = context.config.completion_policy
41:         if policy_name != "none":
42:             from lca.layer0_infra.registry import get_global_registry
43:             from lca.layer1_cognitive.brain.guarded_coordinator import (
44:                 GuardedTaskCoordinator,
45:             )
46:             reg = get_global_registry()
47:             policy_factory = reg.resolve("completion_policy", policy_name)
48:             if policy_factory is None:
49:                 raise ValueError(
50:                     f"未注册的 completion_policy: {policy_name!r}，"
51:                     f"可用: {reg.list('completion_policy')}"
52:                 )
53:             policy = policy_factory()
54:             brain = runtime.brain
55:             if hasattr(brain, "task_coordinator"):
56:                 brain.task_coordinator = GuardedTaskCoordinator(brain.task_coordinator, policy)
57:             # 注册 ledger 记账 hook（post_act）和进度注入 hook（pre_think）
58:             runtime.hooks.register("post_act", ledger_tracking_hook)
59:             runtime.hooks.register("pre_think", progress_injection_hook)
60:         return cast("Result", await context.supervisor.execute(objective))
