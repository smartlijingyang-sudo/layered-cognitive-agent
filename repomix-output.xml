<file path="lca/layer0_infra/tool_protocol/calculator_tool.py">
 1: """安全求值四则运算表达式工具（AST 白名单，杜绝任意代码执行）。"""
 2: from __future__ import annotations
 3: import ast
 4: import operator
 5: import time
 6: import uuid
 7: from typing import Any, ClassVar
 8: from lca.contracts.decision import Observation
 9: from lca.contracts.protocols import Tool
10: from lca.contracts.result import ToolInputError
11: def _new_id(prefix: str) -> str:
12:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
13: class CalculatorTool(Tool):
14:     """实现 Tool 的示例工具。"""
15:     name = "calculator"
16:     is_idempotent = True
17:     default_timeout_s = 5
18:     _OPS: ClassVar[dict[type, Any]] = {
19:         ast.Add: operator.add,
20:         ast.Sub: operator.sub,
21:         ast.Mult: operator.mul,
22:         ast.Div: operator.truediv,
23:         ast.FloorDiv: operator.floordiv,
24:         ast.Mod: operator.mod,
25:         ast.Pow: operator.pow,
26:         ast.USub: operator.neg,
27:         ast.UAdd: operator.pos,
28:     }
29:     def validate(self, args: dict[str, Any]) -> str | None:
30:         expr = args.get("expression")
31:         if expr is None or (isinstance(expr, str) and not expr.strip()):
32:             return "表达式不能为空，请提供纯算术表达式，如 '26 * 1.5 + 3'"
33:         if not isinstance(expr, str):
34:             return f"表达式必须是字符串，实际类型: {type(expr).__name__}"
35:         return None
36:     async def execute(self, args: dict[str, Any]) -> Observation:
37:         start = time.monotonic()
38:         expr = args.get("expression", "")
39:         try:
40:             value = self._safe_eval(expr)
41:             latency_ms = int((time.monotonic() - start) * 1000)
42:             return Observation(
43:                 observation_id=_new_id("obs"),
44:                 success=True,
45:                 payload=value,
46:                 latency_ms=latency_ms,
47:             )
48:         except ToolInputError as e:
49:             latency_ms = int((time.monotonic() - start) * 1000)
50:             return Observation(
51:                 observation_id=_new_id("obs"),
52:                 success=False,
53:                 payload=None,
54:                 error=str(e),
55:                 latency_ms=latency_ms,
56:                 extra={"failure_kind": "validation"},
57:             )
58:         except Exception as e:
59:             latency_ms = int((time.monotonic() - start) * 1000)
60:             return Observation(
61:                 observation_id=_new_id("obs"),
62:                 success=False,
63:                 payload=None,
64:                 error=str(e),
65:                 latency_ms=latency_ms,
66:             )
67:     def _safe_eval(self, expr: str) -> float:
68:         try:
69:             tree = ast.parse(expr, mode="eval")
70:         except SyntaxError as e:
71:             raise ToolInputError(
72:                 f"表达式语法错误 '{expr}': {e}。请提供纯算术表达式，如 '26 * 1.5 + 3'"
73:             ) from e
74:         return self._eval_node(tree.body)
75:     def _eval_node(self, node: ast.AST) -> float:
76:         if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
77:             return float(node.value)
78:         if isinstance(node, ast.BinOp) and type(node.op) in self._OPS:
79:             return float(
80:                 self._OPS[type(node.op)](self._eval_node(node.left), self._eval_node(node.right))
81:             )
82:         if isinstance(node, ast.UnaryOp) and type(node.op) in self._OPS:
83:             return float(self._OPS[type(node.op)](self._eval_node(node.operand)))
84:         node_type = type(node).__name__
85:         supported = "+, -, *, /, //, %, ** 和一元 +/-"
86:         raise ValueError(
87:             f"不支持的运算 '{node_type}'。calculator 仅支持: {supported}。"
88:             f"问题片段: {ast.dump(node)}"
89:         )
</file>

<file path="lca/layer1_cognitive/body/safe_executor.py">
  1: """SafeExecutor —— 权限校验 -> 前置校验 -> 缓存命中 -> 重试装饰 -> 沙箱执行。"""
  2: from __future__ import annotations
  3: import asyncio
  4: import json
  5: import uuid
  6: from datetime import datetime, timezone
  7: from typing import Any
  8: from lca.contracts.decision import Observation
  9: from lca.contracts.observability import TraceSpan
 10: from lca.contracts.protocols import Observability, SafeExecutor, Tool
 11: from lca.contracts.result import ToolExecutionError
 12: from lca.contracts.role_team import CacheConfig, RetryPolicy, ToolPermissionManifest
 13: def _now() -> datetime:
 14:     return datetime.now(timezone.utc)
 15: def _new_id(prefix: str) -> str:
 16:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
 17: class SimpleSafeExecutor(SafeExecutor):
 18:     """权限校验 -> 前置校验 -> 缓存命中 -> 重试装饰 -> 沙箱执行。
 19:     重试语义由两个信号驱动，SafeExecutor 不猜测错误类型：
 20:     - ``tool.validate(args)``：前置校验，失败直接返回，不进入重试循环
 21:     - ``exception.retryable``：执行中异常，``False`` 则 fail-fast
 22:     """
 23:     def __init__(self, permission_manifest: ToolPermissionManifest, observability: Observability):
 24:         self.permission_manifest = permission_manifest
 25:         self.observability = observability
 26:         self._cache: dict[str, Observation] = {}
 27:     async def execute(
 28:         self,
 29:         tool: Tool,
 30:         args: dict[str, Any],
 31:         retry_policy: RetryPolicy,
 32:         cache_config: CacheConfig,
 33:     ) -> Observation:
 34:         if tool.name not in self.permission_manifest.allowed_tools:
 35:             raise ToolExecutionError(
 36:                 f"工具 {tool.name} 未在 ToolPermissionManifest.allowed_tools 中授权"
 37:             )
 38:         validation_error = self._validate_args(tool, args)
 39:         if validation_error is not None:
 40:             return Observation(
 41:                 observation_id=_new_id("obs"),
 42:                 success=False,
 43:                 payload=None,
 44:                 error=validation_error,
 45:                 extra={"failure_kind": "validation"},
 46:             )
 47:         cache_key = f"{tool.name}:{json.dumps(args, sort_keys=True, ensure_ascii=False)}"
 48:         if cache_config.enabled and cache_key in self._cache:
 49:             return self._cache[cache_key]
 50:         last_obs: Observation | None = None
 51:         last_error: str = ""
 52:         delay = retry_policy.backoff_base_s
 53:         for attempt in range(retry_policy.max_retries + 1):
 54:             span = TraceSpan(
 55:                 span_id=_new_id("span"),
 56:                 trace_id="",
 57:                 name=f"tool.{tool.name}",
 58:                 started_at=_now(),
 59:                 attributes={"args": args, "attempt": attempt},
 60:             )
 61:             try:
 62:                 obs = await tool.execute(args)
 63:             except ToolExecutionError as err:
 64:                 obs = Observation(
 65:                     observation_id=_new_id("obs"),
 66:                     success=False,
 67:                     payload=None,
 68:                     error=str(err),
 69:                     extra={"failure_kind": "execution"},
 70:                 )
 71:                 if not getattr(err, "retryable", True):
 72:                     span.ended_at = _now()
 73:                     span.status = "error"
 74:                     span.attributes["error"] = obs.error
 75:                     span.attributes["failure_kind"] = "execution"
 76:                     span.attributes["retryable"] = False
 77:                     self.observability.emit_span(span)
 78:                     return obs
 79:             except Exception as err:
 80:                 obs = Observation(
 81:                     observation_id=_new_id("obs"),
 82:                     success=False,
 83:                     payload=None,
 84:                     error=str(err),
 85:                     extra={"failure_kind": "transient"},
 86:                 )
 87:             span.ended_at = _now()
 88:             span.status = "ok" if obs.success else "error"
 89:             if not obs.success:
 90:                 span.attributes["error"] = obs.error
 91:                 span.attributes["failure_kind"] = obs.extra.get("failure_kind", "execution")
 92:             self.observability.emit_span(span)
 93:             if obs.success:
 94:                 if cache_config.enabled:
 95:                     self._cache[cache_key] = obs
 96:                 return obs
 97:             if obs.extra.get("failure_kind") == "validation":
 98:                 return obs
 99:             last_obs = obs
100:             last_error = obs.error or ""
101:             if attempt < retry_policy.max_retries:
102:                 await asyncio.sleep(delay)
103:                 delay *= retry_policy.backoff_multiplier
104:         detail = f"，最后错误: {last_error}" if last_error else ""
105:         raise ToolExecutionError(
106:             f"工具 {tool.name} 重试 {retry_policy.max_retries} 次后仍失败{detail}", last_obs
107:         )
108:     @staticmethod
109:     def _validate_args(tool: Tool, args: dict[str, Any]) -> str | None:
110:         """调用工具的可选 validate 钩子，未实现则跳过。"""
111:         validator: Any = getattr(tool, "validate", None)
112:         if validator is None:
113:             return None
114:         result: str | None = validator(args)
115:         return result
</file>

<file path="lca/layer1_cognitive/hook_registry.py">
 1: """SimpleHookRegistry —— 生命周期钩子管理。"""
 2: from __future__ import annotations
 3: import re
 4: import uuid
 5: from collections.abc import Callable
 6: from datetime import datetime, timezone
 7: from typing import Any
 8: from lca.contracts.observability import TraceSpan
 9: from lca.contracts.protocols import HookRegistry, Observability
10: from lca.contracts.state import TypedState
11: def _now() -> datetime:
12:     return datetime.now(timezone.utc)
13: def _new_id(prefix: str) -> str:
14:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
15: class SimpleHookRegistry(HookRegistry):
16:     """注册和触发生命周期钩子。"""
17:     def __init__(self, observability: Observability) -> None:
18:         self._hooks: dict[str, list[Callable]] = {}
19:         self.observability = observability
20:     def register(self, event_name: str, hook: Callable) -> None:
21:         self._hooks.setdefault(event_name, []).append(hook)
22:     async def trigger(self, event_name: str, state: TypedState, **kwargs: Any) -> Any:
23:         span = TraceSpan(
24:             span_id=_new_id("span"),
25:             trace_id=state.trace_id,
26:             name=f"hook.{event_name}",
27:             started_at=_now(),
28:             attributes=_extract_span_attributes(event_name, kwargs),
29:         )
30:         for hook in self._hooks.get(event_name, []):
31:             await hook(event_name, state, **kwargs)
32:         span.ended_at = _now()
33:         self.observability.emit_span(span)
34:         return None
35: async def default_logging_hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
36:     extra = {k: v for k, v in kwargs.items() if k != "state"}
37:     role_info = f"role={state.agent_role}" if state.agent_role else ""
38:     delegator_info = f"delegated_by={state.delegated_by}" if state.delegated_by else ""
39:     context_parts = [p for p in [role_info, delegator_info] if p]
40:     context_str = " ".join(context_parts)
41:     prefix = f"[{context_str}] " if context_str else ""
42:     print(f"  [Hook] {prefix}{event_name} @step={state.step} {extra if extra else ''}")
43: def _extract_span_attributes(event_name: str, kwargs: dict[str, Any]) -> dict[str, Any]:
44:     """从 hook kwargs 中提取可观测属性，脱敏后放入 TraceSpan.attributes。"""
45:     attrs: dict[str, Any] = {"event": event_name}
46:     # 从 state 中提取角色和委派信息
47:     state = kwargs.get("state")
48:     if state is not None:
49:         if hasattr(state, "agent_role") and state.agent_role:
50:             attrs["agent_role"] = state.agent_role
51:         if hasattr(state, "delegated_by") and state.delegated_by:
52:             attrs["delegated_by"] = state.delegated_by
53:         if hasattr(state, "task") and state.task:
54:             attrs["task_preview"] = _truncate(_sanitize(str(state.task)))
55:     # post_think: 记录决策摘要
56:     decision = kwargs.get("decision")
57:     if decision is not None:
58:         attrs["action_type"] = getattr(decision, "action_type", str(decision))
59:         attrs["confidence"] = getattr(decision, "confidence", None)
60:         if hasattr(decision, "response_text") and decision.response_text:
61:             attrs["response_preview"] = _truncate(_sanitize(str(decision.response_text)))
62:         if hasattr(decision, "tool_name") and decision.tool_name:
63:             attrs["tool_name"] = decision.tool_name
64:         # 委派目标
65:         delegate_to = getattr(decision, "delegate_to", None)
66:         if delegate_to is not None:
67:             target = getattr(delegate_to, "target_role", None) or getattr(
68:                 delegate_to, "target_agent_id", None
69:             )
70:             if target:
71:                 attrs["delegate_to"] = target
72:     # on_error: 记录错误信息
73:     error = kwargs.get("error")
74:     if error is not None:
75:         attrs["error_type"] = type(error).__name__
76:         attrs["error_message"] = _truncate(str(error))
77:     # observation / reflection
78:     observation = kwargs.get("observation")
79:     if observation is not None:
80:         attrs["observation_success"] = getattr(observation, "success", None)
81:     reflection = kwargs.get("reflection")
82:     if reflection is not None:
83:         attrs["reflection_preview"] = _truncate(_sanitize(str(reflection)))
84:     return attrs
85: _MAX_PREVIEW_LEN = 200
86: _SECRET_PATTERN = re.compile(r"(sk-|api[_-]?key[_-]?|token[_-]?)[\w-]{8,}", re.IGNORECASE)
87: def _truncate(text: str, max_len: int = _MAX_PREVIEW_LEN) -> str:
88:     """截断过长文本。"""
89:     if len(text) <= max_len:
90:         return text
91:     return text[:max_len] + "..."
92: def _sanitize(text: str) -> str:
93:     """过滤疑似密钥字符串。"""
94:     return _SECRET_PATTERN.sub("[REDACTED]", text)
</file>

