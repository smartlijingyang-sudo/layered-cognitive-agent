11:     get_global_registry,
12:     mark_defaults_registered,
13: )
14: from lca.layer0_infra.observability.console_observability import ConsoleObservability
15: from lca.layer0_infra.observability.jsonl_file_observability import JSONLFileObservability
16: from lca.layer0_infra.state_store.in_memory_store import InMemoryStateStore
17: from lca.layer1_cognitive.brain.completion_policies.roster_coverage import (
18:     RosterCoveragePolicy,
19: )
20: from lca.layer1_cognitive.brain.default_factory import SimpleBrainFactory
21: from lca.layer1_cognitive.brain.map_modules import (
22:     SimpleConflictMonitor,
23:     SimpleStateEvaluator,
