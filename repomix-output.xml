<file path="lca/layer2_runtime/outcome_policies/default_outcome_policy.py">
 1: """DefaultStepOutcomePolicy —— 默认单步结果判定策略。
 2: 封装原 _loop / _should_stop 中散落的全部终止判定逻辑：
 3: - respond 动作 → 提取 final_output + 判定是否停止
 4: - handoff 动作 → 直接停止
 5: - 降级成功（FALLBACK_DEGRADATION_KEY + success）→ 等价于 respond
 6: - reflection verdict == needs_correction → 即使 respond 也不停止
 7: - 预算耗尽 → 根据最后一步成功与否决定 completed / failed
 8: """
 9: from __future__ import annotations
10: from lca.contracts.decision import Observation, Reflection, StructuredDecision
11: from lca.contracts.protocols import StepOutcome, StepOutcomePolicy
12: from lca.contracts.state import TypedState
13: from lca.layer2_runtime.fallback_handler import FALLBACK_DEGRADATION_KEY
14: class DefaultStepOutcomePolicy(StepOutcomePolicy):
15:     """框架内置的默认终止判定策略。
16:     识别"降级为 respond"的业务语义——这是该策略的职责，
17:     不是 Loop 的职责。
18:     """
19:     def resolve(
20:         self,
21:         state: TypedState,
22:         decision: StructuredDecision | None,
23:         observation: Observation | None,
24:         reflection: Reflection | None,
25:     ) -> StepOutcome:
26:         if decision is None or reflection is None:
27:             return StepOutcome()
28:         is_degraded_success = self._is_degraded_success(observation)
29:         if decision.action_type == "handoff":
30:             return StepOutcome(should_stop=True, status="completed")
31:         if decision.action_type == "respond" or is_degraded_success:
32:             final_output = decision.response_text if decision.response_text else None
33:             if final_output is None and is_degraded_success and observation is not None:
34:                 payload = observation.payload
35:                 if isinstance(payload, str):
36:                     final_output = payload
37:             should_stop = reflection.verdict != "needs_correction"
38:             return StepOutcome(
39:                 should_stop=should_stop,
40:                 final_output=final_output,
41:                 status="completed" if should_stop else None,
42:             )
43:         return StepOutcome()
44:     @staticmethod
45:     def _is_degraded_success(observation: Observation | None) -> bool:
46:         """判断 observation 是否代表"降级成功"。"""
47:         if observation is None:
48:             return False
49:         return getattr(observation, "success", False) and FALLBACK_DEGRADATION_KEY in getattr(
50:             observation, "extra", {}
51:         )
52:     def resolve_budget_exceeded(
53:         self,
54:         observation: Observation | None,
55:         state: TypedState,
56:     ) -> StepOutcome:
57:         """预算耗尽时的特殊判定：最后一步成功则视为自然终止。"""
58:         last_ok = observation is not None and getattr(observation, "success", False)
59:         final_output: str | None = None
60:         if last_ok and "final_output" not in state.working_memory and observation is not None:
61:             payload = observation.payload
62:             if isinstance(payload, str):
63:                 final_output = payload
64:         return StepOutcome(
65:             should_stop=True,
66:             final_output=final_output,
67:             status="completed" if last_ok else "failed",
68:         )
</file>

