 38: from lca.layer1_cognitive.brain.map_modules import (
 39:     SimpleConflictMonitor,
 40:     SimpleStateEvaluator,
 41:     SimpleStatePredictor,
 42:     SimpleTaskCoordinator,
 43:     SimpleTaskDecomposer,
