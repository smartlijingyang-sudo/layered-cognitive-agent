159:     """编排策略的运行时上下文，由 TeamOrchestrator 构造并传给策略实例。"""
160:     members: list[Any] = field(default_factory=list)
161:     config: TeamConfig | None = None
162:     supervisor: Any | None = None
163:     transport: AgentTransport | None = None
164:     roster_desc: str = ""
165:     ledger_factory: Callable[[frozenset[str]], Any] | None = None
