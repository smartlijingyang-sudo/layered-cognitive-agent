<file path="lca/layer3_agent/orchestration_strategies/graph/strategy.py">
  1: """GraphStrategy —— 基于 DAG 的自定义工作流执行引擎。"""
  2: from __future__ import annotations
  3: import asyncio
  4: from collections import deque
  5: from typing import Any
  6: from lca.contracts.graph import ExecutionGraph
  7: from lca.contracts.protocols import (
  8:     OrchestrationContext,
  9:     OrchestrationStrategy,
 10:     StateStore,
 11: )
 12: from lca.contracts.result import Result
 13: from lca.contracts.state import Budget, TypedState
 14: from lca.layer3_agent.orchestration_strategies.graph.topology import (
 15:     cascade_skip,
 16:     compute_in_degree_and_out_edges,
 17:     enqueue_ready_targets,
 18: )
 19: class GraphStrategy(OrchestrationStrategy):
 20:     """基于 DAG 的自定义工作流执行引擎。
 21:     支持三种边类型：
 22:     - fixed: 固定流转
 23:     - conditional: 条件分支（condition 函数返回 bool 决定是否走该边）
 24:     - parallel: 并行扇出，asyncio.gather 并发执行所有目标，全部完成后汇聚
 25:     执行模型：基于入度（in-degree）的拓扑排序驱动。
 26:     每个节点等待所有前驱完成（或跳过）后才执行，天然支持 fan-in 汇聚。
 27:     条件边跳过时级联通知下游，避免 join 节点死等。
 28:     可选注入 StateStore 做 checkpoint（on_error 回滚预留，复用已有 StateSnapshot.reason）。
 29:     """
 30:     def __init__(
 31:         self,
 32:         execution_graph: ExecutionGraph | None = None,
 33:         state_store: StateStore | None = None,
 34:     ) -> None:
 35:         self._graph = execution_graph
 36:         self._state_store = state_store
 37:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
 38:         if self._graph is None:
 39:             raise ValueError("GraphStrategy 需要 ExecutionGraph，请在构造时传入 execution_graph")
 40:         self._graph.validate()
 41:         member_map = {m.role_profile.role: m for m in context.members}
 42:         state = TypedState(trace_id="graph", task=objective, budget=Budget())
 43:         in_degree, out_edge_indices = compute_in_degree_and_out_edges(self._graph)
 44:         remaining: dict[str, int] = dict(in_degree)
 45:         executed: set[str] = set()
 46:         skipped: set[str] = set()
 47:         results: dict[str, Result] = {}
 48:         last_result: Result | None = None
 49:         queue: deque[str] = deque(nid for nid, deg in remaining.items() if deg == 0)
 50:         while queue:
 51:             nid = queue.popleft()
 52:             if nid in executed or nid in skipped:
 53:                 continue
 54:             node = self._graph.nodes[nid]
 55:             if node.type == "agent":
 56:                 role = node.config.get("role", "")
 57:                 member = member_map.get(role)
 58:                 if member:
 59:                     result = await member.execute(objective)
 60:                     results[nid] = result
 61:                     last_result = result
 62:                     if self._state_store:
 63:                         await self._state_store.save(state)
 64:             executed.add(nid)
 65:             fixed_targets: list[str] = []
 66:             parallel_targets: list[str] = []
 67:             for edge_idx in out_edge_indices[nid]:
 68:                 edge = self._graph.edges[edge_idx]
 69:                 if edge.type == "conditional":
 70:                     if edge.condition is not None and edge.condition(state):
 71:                         fixed_targets.append(edge.target)
 72:                     else:
 73:                         cascade_skip(self._graph, edge.target, remaining, skipped, executed, queue)
 74:                 elif edge.type == "parallel":
 75:                     parallel_targets.append(edge.target)
 76:                 else:
 77:                     fixed_targets.append(edge.target)
 78:             if parallel_targets:
 79:                 await self._execute_parallel_branches(
 80:                     parallel_targets,
 81:                     member_map,
 82:                     objective,
 83:                     state,
 84:                     results,
 85:                     remaining,
 86:                     executed,
 87:                     skipped,
 88:                     queue,
 89:                 )
 90:             else:
 91:                 enqueue_ready_targets(fixed_targets, remaining, executed, queue)
 92:         if last_result is None:
 93:             return Result.failed("Graph execution produced no results")
 94:         last_result.total_steps = sum(r.total_steps for r in results.values())
 95:         return last_result
 96:     async def _execute_parallel_branches(
 97:         self,
 98:         targets: list[str],
 99:         member_map: dict[str, Any],
100:         objective: str,
101:         state: TypedState,
102:         results: dict[str, Result],
103:         remaining: dict[str, int],
104:         executed: set[str],
105:         skipped: set[str],
106:         queue: deque[str],
107:     ) -> None:
108:         """并行扇出：asyncio.gather 并发执行所有目标子图，全部完成后汇聚。"""
109:         async def _run_branch(target_nid: str) -> None:
110:             if target_nid in executed or target_nid in skipped:
111:                 return
112:             node = self._graph.nodes[target_nid]  # type: ignore[union-attr]
113:             if node.type == "agent":
114:                 role = node.config.get("role", "")
115:                 member = member_map.get(role)
116:                 if member:
117:                     results[target_nid] = await member.execute(objective)
118:             executed.add(target_nid)
119:             sub_fixed: list[str] = []
120:             sub_parallel: list[str] = []
121:             for edge in self._graph.outgoing(target_nid):  # type: ignore[union-attr]
122:                 if edge.type == "parallel":
123:                     sub_parallel.append(edge.target)
124:                 elif edge.type == "conditional":
125:                     if edge.condition is not None and edge.condition(state):
126:                         sub_fixed.append(edge.target)
127:                     else:
128:                         cascade_skip(
129:                             self._graph,  # type: ignore[arg-type]
130:                             edge.target,
131:                             remaining,
132:                             skipped,
133:                             executed,
134:                             queue,
135:                         )
136:                 else:
137:                     sub_fixed.append(edge.target)
138:             if sub_parallel:
139:                 await self._execute_parallel_branches(
140:                     sub_parallel,
141:                     member_map,
142:                     objective,
143:                     state,
144:                     results,
145:                     remaining,
146:                     executed,
147:                     skipped,
148:                     queue,
149:                 )
150:             else:
151:                 for sub_target in sub_fixed:
152:                     remaining[sub_target] -= 1
153:                     if remaining[sub_target] <= 0 and sub_target not in executed:
154:                         await _run_branch(sub_target)
155:         await asyncio.gather(*[_run_branch(t) for t in targets])
156:         for target in targets:
157:             for edge in self._graph.outgoing(target):  # type: ignore[union-attr]
158:                 next_nid = edge.target
159:                 remaining[next_nid] -= 1
160:                 if remaining[next_nid] <= 0 and next_nid not in executed:
161:                     queue.append(next_nid)
</file>

