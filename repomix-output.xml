 1: """GetWeatherTool —— 查询城市天气（内置假数据，无需外部网络）。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import time
 5: import uuid
 6: from typing import Any, ClassVar
 7: from lca.contracts.decision import Observation
 8: from lca.contracts.protocols import Tool
 9: def _new_id(prefix: str) -> str:
10:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
11: class GetWeatherTool(Tool):
12:     """实现 Tool 的天气查询工具。
13:     内置假数据，避免依赖外部网络，专注测试 tool 调度本身。
14:     """
15:     name = "get_weather"
16:     is_idempotent = True
17:     default_timeout_s = 5
18:     _FAKE_DB: ClassVar[dict[str, dict[str, Any]]] = {
19:         "tokyo": {"temp_c": 27, "condition": "cloudy"},
20:         "beijing": {"temp_c": 31, "condition": "sunny"},
21:         "san francisco": {"temp_c": 18, "condition": "foggy"},
22:         "new york": {"temp_c": 24, "condition": "clear"},
23:         "london": {"temp_c": 19, "condition": "rainy"},
24:     }
25:     _CITY_ALIASES: ClassVar[dict[str, str]] = {
26:         "东京": "tokyo",
27:         "東京": "tokyo",
28:         "北京": "beijing",
29:         "旧金山": "san francisco",
30:         "纽约": "new york",
31:         "伦敦": "london",
32:     }
33:     async def execute(self, args: dict[str, Any]) -> Observation:
34:         start = time.monotonic()
35:         raw_city = (
36:             str(args.get("city") or args.get("location") or args.get("name") or "").strip().lower()
37:         )
38:         city = self._CITY_ALIASES.get(raw_city, raw_city)
39:         if not city:
40:             latency_ms = int((time.monotonic() - start) * 1000)
41:             return Observation(
42:                 observation_id=_new_id("obs"),
43:                 success=False,
44:                 payload=None,
45:                 error="missing required arg: city",
46:                 latency_ms=latency_ms,
47:             )
48:         await asyncio.sleep(0.05)  # 模拟网络 IO
49:         data = self._FAKE_DB.get(city)
50:         if data is None:
51:             latency_ms = int((time.monotonic() - start) * 1000)
52:             return Observation(
53:                 observation_id=_new_id("obs"),
54:                 success=False,
55:                 payload=None,
56:                 error=f"unknown city: {city}",
57:                 latency_ms=latency_ms,
58:             )
59:         unit = str(args.get("unit", "celsius")).lower()
60:         temp_c = data["temp_c"]
61:         temp = temp_c if unit == "celsius" else temp_c * 9 / 5 + 32
62:         result = {
63:             "city": city,
64:             "temperature": round(temp, 1),
65:             "unit": unit,
66:             "condition": data["condition"],
67:         }
68:         latency_ms = int((time.monotonic() - start) * 1000)
69:         return Observation(
70:             observation_id=_new_id("obs"),
71:             success=True,
72:             payload=result,
73:             latency_ms=latency_ms,
74:         )
