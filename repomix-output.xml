 1: """第5.10节：运行结果与异常契约。"""
 2: from __future__ import annotations
 3: from dataclasses import dataclass, field
 4: from typing import Any, Literal
 5: from lca.contracts.state import Budget
 6: @dataclass
 7: class Result:
 8:     trace_id: str
 9:     status: Literal["completed", "failed", "paused", "waiting_human"]
10:     final_state_ref: str
11:     total_steps: int
12:     budget_used: Budget
13:     schema_version: str = "1.0"
14:     output: str | None = None
15:     lessons: list[str] = field(default_factory=list)
16:     trace_url: str | None = None
17:     error: str | None = None
18:     extra: dict[str, Any] = field(default_factory=dict)
19:     @classmethod
20:     def failed(cls, reason: str) -> Result:
21:         """构造失败 Result 的工厂方法，消除重复的构造代码块。"""
22:         return cls(
23:             trace_id="",
24:             status="failed",
25:             final_state_ref="",
26:             total_steps=0,
27:             budget_used=None,  # type: ignore[arg-type]
28:             error=reason,
29:         )
30: class ApprovalPendingError(Exception):
31:     def __init__(self, approval_request: Any):
32:         self.approval_request = approval_request
33:         super().__init__("waiting for human approval")
34: class BudgetExceededError(Exception):
35:     pass
36: class ToolExecutionError(Exception):
37:     """工具执行失败基类。
38:     ``retryable`` 信号供 SafeExecutor 决定是否重试：
39:     - ``True``（默认）：瞬时性错误，指数退避重试可能恢复
40:     - ``False``：确定性错误，重试不会改变结果，应 fail-fast
41:     """
42:     retryable: bool = True
43:     def __init__(self, message: str, last_observation: Any | None = None):
44:         self.last_observation = last_observation
45:         super().__init__(message)
46: class ToolInputError(ToolExecutionError):
47:     """工具输入校验失败——确定性错误，重试无意义。
48:     典型场景：必填参数缺失、类型错误、表达式语法非法。
49:     SafeExecutor 遇到此异常应立即返回失败 Observation，不进入退避循环。
50:     """
51:     retryable = False
