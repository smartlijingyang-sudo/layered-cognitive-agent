<file path="lca/layer3_agent/orchestration_strategies/parallel.py">
 1: """ParallelStrategy —— scatter-gather 并行执行 + Synthesizer 聚合。"""
 2: from __future__ import annotations
 3: import asyncio
 4: from lca.contracts.protocols import (
 5:     OrchestrationContext,
 6:     OrchestrationStrategy,
 7:     Synthesizer,
 8: )
 9: from lca.contracts.result import Result
10: class ParallelStrategy(OrchestrationStrategy):
11:     """scatter-gather 并行：同一任务分发给所有成员并发执行，通过 Synthesizer 聚合结果。
12:     本质是 GraphStrategy 的特例（"所有节点入边相同、无依赖"），
13:     用 asyncio.gather 实现并发调度。
14:     fan-in 阶段由可插拔的 Synthesizer 完成：
15:     - ConcatSynthesizer（默认）：简单拼接所有候选输出
16:     - LLMSynthesizer：调用 LLM 做 Layer-2 提炼（MoA 核心）
17:     - BestOfSynthesizer：复用 TaskCoordinator.arbitrate 选优
18:     """
19:     def __init__(self, synthesizer: Synthesizer | None = None) -> None:
20:         self._synthesizer = synthesizer
21:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
22:         if not context.members:
23:             return Result.failed("No members in team")
24:         tasks = [member.execute(objective) for member in context.members]
25:         results: list[Result] = await asyncio.gather(*tasks)
26:         total_steps = sum(r.total_steps for r in results)
27:         if self._synthesizer is not None:
28:             synthesized = await self._synthesizer.synthesize(objective, results)
29:             synthesized.total_steps = total_steps
30:             return synthesized
31:         primary = results[-1]
32:         primary.total_steps = total_steps
33:         return primary
</file>

<file path="lca/layer3_agent/orchestration_strategies/sequential.py">
 1: """SequentialStrategy —— 任务像流水线一样在成员间顺序传递。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import OrchestrationContext, OrchestrationStrategy
 4: from lca.contracts.result import Result
 5: class SequentialStrategy(OrchestrationStrategy):
 6:     """任务像流水线一样在成员间顺序传递。"""
 7:     async def run(self, context: OrchestrationContext, objective: str) -> Result:
 8:         current_task = objective
 9:         last_result: Result | None = None
10:         total_steps = 0
11:         for member in context.members:
12:             last_result = await member.execute(current_task)
13:             total_steps += last_result.total_steps
14:             if last_result.output:
15:                 current_task = last_result.output
16:         if last_result is None:
17:             return Result.failed("No members in team")
18:         last_result.total_steps = total_steps
19:         return last_result
</file>

