<file path="lca/layer0_infra/llm_adapter/openai_compat.py">
 1: """通用 OpenAI 兼容 LLM 适配器。
 2: 支持所有 OpenAI chat/completions 兼容 API：
 3:   - OpenAI (api.openai.com)
 4:   - DashScope / 通义千问 (dashscope.aliyuncs.com/compatible-mode)
 5:   - Ollama, vLLM, LiteLLM 等
 6: 只需配置环境变量即可切换，代码无需改动：
 7:   LLM_API_KEY   API Key
 8:   LLM_BASE_URL  基地址（默认 https://api.openai.com/v1）
 9:   LLM_MODEL     模型名（默认 gpt-4.1）
10: 依赖: pip install "openai>=1.40"
11: """
12: from __future__ import annotations
13: import os
14: from collections.abc import AsyncIterator
15: from typing import Any
16: from lca.contracts.protocols import LLMAdapter
17: class OpenAICompatAdapter(LLMAdapter):
18:     """实现 LLMAdapter 协议。走 client.chat.completions.create()。"""
19:     name = "openai-compat"
20:     _client: Any
21:     def __init__(
22:         self,
23:         model: str | None = None,
24:         *,
25:         api_key: str | None = None,
26:         base_url: str | None = None,
27:     ) -> None:
28:         from openai import AsyncOpenAI
29:         self._model = model or os.getenv("LLM_MODEL", "gpt-4.1")
30:         self._client = AsyncOpenAI(
31:             api_key=api_key or os.getenv("LLM_API_KEY", ""),
32:             base_url=base_url or os.getenv("LLM_BASE_URL", "https://api.openai.com/v1"),
33:         )
34:     async def complete(self, prompt: str, **kwargs: Any) -> str:
35:         response = await self._client.chat.completions.create(
36:             model=kwargs.pop("model", self._model),
37:             messages=[{"role": "user", "content": prompt}],
38:             temperature=kwargs.pop("temperature", 0.7),
39:             max_tokens=kwargs.pop("max_tokens", 2048),
40:             **kwargs,
41:         )
42:         return response.choices[0].message.content or ""
43:     async def stream(self, prompt: str, **kwargs: Any) -> AsyncIterator[str]:
44:         raise NotImplementedError("流式输出暂未实现")
45:         yield ""  # pragma: no cover
</file>

<file path="lca/layer0_infra/transport/agent_transport.py">
 1: """Agent 传输层 —— 进程内传输实现（对齐 A2A 异步任务模型）。"""
 2: from __future__ import annotations
 3: import asyncio
 4: import uuid
 5: from collections.abc import Awaitable, Callable
 6: from typing import Any
 7: from lca.contracts.decision import Observation
 8: from lca.contracts.protocols import AgentTransport
 9: AgentHandler = Callable[[str], Awaitable[Observation]]
10: def _new_id(prefix: str) -> str:
11:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
12: def _fail_obsation(error: str) -> Observation:
13:     return Observation(
14:         observation_id=_new_id("obs"),
15:         success=False,
16:         payload=None,
17:         error=error,
18:     )
19: class InternalTransport(AgentTransport):
20:     """进程内 Agent 间通信传输实现。
21:     维护一个 ``agent_directory``（key → async handler），``send_task`` 通过
22:     ``asyncio.create_task`` 异步调度 handler，调用方随后用 ``poll_status`` /
23:     ``receive_result`` 轮询结果 —— 与 Google A2A 的 AgentCard 注册表 + 异步
24:     任务轮询模型一致。
25:     """
26:     protocol_name: str = "internal"
27:     def __init__(
28:         self,
29:         agent_directory: dict[str, AgentHandler] | None = None,
30:     ) -> None:
31:         self._directory: dict[str, AgentHandler] = dict(agent_directory or {})
32:         self._results: dict[str, Observation] = {}
33:         self._statuses: dict[str, str] = {}
34:         self._bg_tasks: dict[str, asyncio.Task[Observation]] = {}
35:     # -- 注册 -----------------------------------------------------------
36:     def register_agent(self, key: str, handler: AgentHandler) -> None:
37:         """将一个 async handler 注册到 directory，key 通常为 agent_id 或 role。"""
38:         self._directory[key] = handler
39:     # -- 内部 -----------------------------------------------------------
40:     def _resolve_handler(self, agent_card: Any) -> AgentHandler | None:
41:         if isinstance(agent_card, str):
42:             return self._directory.get(agent_card)
43:         if hasattr(agent_card, "agent_id"):
44:             handler = self._directory.get(agent_card.agent_id)
45:             if handler is not None:
46:                 return handler
47:         if hasattr(agent_card, "role"):
48:             return self._directory.get(agent_card.role)
49:         return None
50:     # -- AgentTransport 协议 --------------------------------------------
51:     async def send_task(self, agent_card: Any, subtask: str, context_refs: list[str]) -> str:
52:         task_id = _new_id("task")
53:         handler = self._resolve_handler(agent_card)
54:         if handler is None:
55:             self._statuses[task_id] = "failed"
56:             self._results[task_id] = _fail_obsation("agent not found in directory")
57:             return task_id
58:         async def _run() -> Observation:
59:             try:
60:                 return await handler(subtask)
61:             except Exception as exc:
62:                 return _fail_obsation(str(exc))
63:         self._statuses[task_id] = "working"
64:         bg = asyncio.create_task(_run(), name=f"transport-{task_id}")
65:         self._bg_tasks[task_id] = bg
66:         def _on_done(task: asyncio.Task[Observation]) -> None:
67:             self._results[task_id] = task.result()
68:             self._statuses[task_id] = "completed"
69:         bg.add_done_callback(_on_done)
70:         return task_id
71:     async def poll_status(self, task_id: str) -> str:
72:         return self._statuses.get(task_id, "working")
73:     async def receive_result(self, task_id: str) -> Observation:
74:         return self._results.get(task_id, _fail_obsation("task not found"))
</file>

<file path="lca/layer1_cognitive/brain/modular_brain.py">
 1: """ModularBrain —— 实现 BrainStrategy 协议，串联 MAP 五模块 + Reasoner + Critic + DecisionParser。"""
 2: from __future__ import annotations
 3: from lca.contracts.decision import Observation, Reflection, StructuredDecision
 4: from lca.contracts.protocols import (
 5:     BrainStrategy,
 6:     ConflictMonitor,
 7:     Critic,
 8:     DecisionParser,
 9:     Reasoner,
10:     SkillRouter,
11:     StateEvaluator,
12:     StatePredictor,
13:     TaskCoordinator,
14:     TaskDecomposer,
15: )
16: from lca.contracts.state import TypedState
17: class ModularBrain(BrainStrategy):
18:     """
19:     think() 内部串联:
20:     Reasoner -> TaskDecomposer -> StatePredictor -> StateEvaluator -> ConflictMonitor -> TaskCoordinator -> DecisionParser
21:     reflect() 内部调用 Critic。
22:     """
23:     def __init__(
24:         self,
25:         reasoner: Reasoner,
26:         decision_parser: DecisionParser,
27:         critic: Critic,
28:         task_decomposer: TaskDecomposer,
29:         state_predictor: StatePredictor,
30:         state_evaluator: StateEvaluator,
31:         conflict_monitor: ConflictMonitor,
32:         task_coordinator: TaskCoordinator,
33:         skill_router: SkillRouter | None = None,
34:     ):
35:         self.reasoner = reasoner
36:         self.decision_parser = decision_parser
37:         self.critic = critic
38:         self.task_decomposer = task_decomposer
39:         self.state_predictor = state_predictor
40:         self.state_evaluator = state_evaluator
41:         self.conflict_monitor = conflict_monitor
42:         self.task_coordinator = task_coordinator
43:         self.skill_router = skill_router
44:     async def think(self, state: TypedState) -> StructuredDecision:
45:         if self.skill_router is not None:
46:             template_name = await self.skill_router.route(state)
47:             state.working_memory["active_template"] = template_name
48:         _subtasks = await self.task_decomposer.decompose(state)
49:         raw_candidates = await self.reasoner.generate_candidates(state, n=1)
50:         candidates = [self.decision_parser.parse(rc, state) for rc in raw_candidates]
51:         predicted = [await self.state_predictor.predict(state, c.rationale) for c in candidates]
52:         scores = [await self.state_evaluator.score(state, p) for p in predicted]
53:         conflicts = await self.conflict_monitor.check(state, candidates)
54:         if conflicts:
55:             print(f"  [ConflictMonitor] 检测到冲突: {conflicts}")
56:         return await self.task_coordinator.arbitrate(state, candidates, scores)
57:     async def reflect(self, state: TypedState, observation: Observation) -> Reflection:
58:         return await self.critic.critique(state, observation)
59:     def set_team_roster(self, roster_desc: str) -> None:
60:         if hasattr(self.reasoner, "set_team_roster"):
61:             self.reasoner.set_team_roster(roster_desc)
62:         elif hasattr(self.reasoner, "team_roster"):
63:             self.reasoner.team_roster = roster_desc
</file>

<file path="lca/layer1_cognitive/memory/simple_memory.py">
 1: """四类记忆的最小实现：内存列表存储 + 简单相关性检索 + 可选团队共享。"""
 2: from __future__ import annotations
 3: import uuid
 4: from typing import Any
 5: from lca.contracts.decision import Observation, Reflection
 6: from lca.contracts.memory import MemoryRecord
 7: from lca.contracts.protocols import MemorySystem, SharedMemoryStore
 8: from lca.contracts.state import TypedState
 9: def _new_id(prefix: str) -> str:
10:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
11: class SimpleMemorySystem(MemorySystem):
12:     """Working / Semantic / Episodic / Procedural 四层记忆。
13:     可选绑定 SharedMemoryStore：对声明共享的层（semantic/procedural），
14:     读写直接走共享 store，实现跨 Agent 记忆共享；未声明共享的层保持私有。
15:     """
16:     def __init__(self) -> None:
17:         self._shared_store: SharedMemoryStore | None = None
18:         self._private_layers: dict[str, list[MemoryRecord]] = {
19:             "working": [],
20:             "semantic": [],
21:             "episodic": [],
22:             "procedural": [],
23:         }
24:     def bind_shared_store(self, store: SharedMemoryStore) -> None:
25:         """绑定团队共享记忆存储。共享层的数据读写委托给 store。"""
26:         self._shared_store = store
27:     def _get_layer_records(self, layer: str) -> list[MemoryRecord]:
28:         if self._shared_store is not None and self._shared_store.is_shared(layer):
29:             return self._shared_store.get_records(layer)
30:         return self._private_layers[layer]
31:     def _append_record(self, layer: str, record: MemoryRecord) -> None:
32:         if self._shared_store is not None and self._shared_store.is_shared(layer):
33:             self._shared_store.add_record(layer, record)
34:         else:
35:             self._private_layers[layer].append(record)
36:     async def perceive_and_retrieve(self, state: TypedState) -> TypedState:
37:         records: list[MemoryRecord] = []
38:         for layer_name in self._private_layers:
39:             records.extend(self._get_layer_records(layer_name))
40:         state.retrieved_context = records
41:         return state
42:     async def update_multi_level(
43:         self, state: TypedState, observation: Observation, reflection: Reflection
44:     ) -> None:
45:         if observation.payload is not None and observation.success:
46:             # 追加到 working memory 而非覆盖，确保多步委派历史对 agent 可见
47:             self._private_layers["working"].append(
48:                 MemoryRecord(
49:                     record_id=_new_id("mem"),
50:                     content=f"TOOL_RESULT: {observation.payload}",
51:                     memory_type="working",
52:                     importance=0.9,
53:                     source_trace_id=state.trace_id,
54:                 )
55:             )
56:             # 防止 working memory 无限增长：保留最近 20 条
57:             max_working = 20
58:             if len(self._private_layers["working"]) > max_working:
59:                 self._private_layers["working"] = self._private_layers["working"][-max_working:]
60:         self._append_record(
61:             "episodic",
62:             MemoryRecord(
63:                 record_id=_new_id("mem"),
64:                 content=f"step={state.step} success={observation.success} verdict={reflection.verdict}",
65:                 memory_type="episodic",
66:                 importance=0.5,
67:                 source_trace_id=state.trace_id,
68:             ),
69:         )
70:         await self.compress()
71:     async def compress(self) -> None:
72:         max_episodic = 50
73:         episodic = self._get_layer_records("episodic")
74:         if len(episodic) > max_episodic:
75:             if self._shared_store is not None and self._shared_store.is_shared("episodic"):
76:                 pass  # episodic 不应被共享，防御性跳过
77:             else:
78:                 self._private_layers["episodic"] = episodic[-max_episodic:]
79:     def write_shared_record(self, layer: str, record: MemoryRecord) -> None:
80:         """显式向共享层写入记录（供外部策略/编排代码使用）。"""
81:         if self._shared_store is None or not self._shared_store.is_shared(layer):
82:             raise KeyError(f"层 {layer!r} 未配置为共享")
83:         self._shared_store.add_record(layer, record)
84:     def get_private_layer_snapshot(self) -> dict[str, Any]:
85:         """返回私有层的当前状态快照，用于测试和调试。"""
86:         return {k: list(v) for k, v in self._private_layers.items()}
</file>

<file path="AGENTS.md">
  1: # AGENTS.md — LCA Framework
  2: 
  3: ## 架构约束（最容易被无意破坏，务必遵守）
  4: 五层严格单向依赖：contracts → layer0_infra → layer1_cognitive → layer2_runtime → layer3_agent，
  5: layer4_app 是组合根，可以依赖所有下层，但下层不能反向 import layer4_app。
  6: 这个约束由 import-linter 强制执行，见 pyproject.toml 中 [[tool.importlinter.contracts]]。
  7: 
  8: ## 环境与依赖
  9: - 包管理器统一用 uv，不要直接用 pip 改环境
 10: - 安装依赖：uv sync --all-groups
 11: - 新增依赖：uv add --group <lint|typecheck|test|security> <package名>
 12: 
 13: ## 每次改完代码，必须依次跑完（顺序不能乱）
 14: 1. uv run ruff check --fix .
 15: 2. uv run ruff format .
 16: 3. uv run lint-imports        # 检查五层架构契约，最容易被跳过但最重要
 17: 4. uv run mypy lca
 18: 5. uv run pytest
 19: 
 20: ## 代码风格
 21: - 公共函数/类必须有类型标注
 22: - lca/contracts 下的模型使用 stdlib dataclass（见 ADR-0012），保持字段名和方法签名不变
 23: - 禁止硬编码 API Key / Token，一律用环境变量，通过 pydantic-settings 注入配置
 24: 
 25: ## 代码设计约束（AI Coding 必须遵守）
 26: 
 27: ### 结构规模
 28: - 单个方法不超过 200 行（不含空行和注释），超过则拆分为子方法或提取到独立模块
 29: - 单个文件不超过 1500 行，超过则按职责拆分到同包下的新文件
 30: - 按模块/职责划分目录，每个包只暴露 `__init__.py` 中显式导出的公共接口
 31: 
 32: ### 内聚与耦合
 33: - 高内聚：一个类/模块只做一件事，相关数据和行为放在一起
 34: - 低耦合：模块间通过 Protocol / 接口通信，禁止直接依赖具体实现
 35: - 可复用：公共逻辑提取为工具函数或基类，禁止跨模块复制粘贴
 36: 
 37: ### 禁止魔数与硬编码
 38: - 禁止裸数字/字符串字面量出现在业务逻辑中，必须用命名常量（`MAX_RETRIES = 3`）或枚举
 39: - 配置项走 pydantic-settings / 环境变量，不要 `if env == "prod"` 硬编码
 40: - 禁止 if/else 链做类型/状态判断——用枚举、标签字段、注册表或策略模式替代：
 41:   ```python
 42:   # BAD
 43:   if provider == "openai":
 44:       ...
 45:   elif provider == "anthropic":
 46:       ...
 47: 
 48:   # GOOD — 注册表 + 策略
 49:   _registry: dict[str, type[LLMAdapter]] = {}
 50: 
 51: 
 52:   def get_adapter(provider: str) -> LLMAdapter:
 53:       return _registry[provider]()
 54:   ```
 55: 
 56: ### 设计模式优先
 57: - 多种实现 → 策略模式（`Protocol` + 注册表）
 58: - 跨 provider 适配 → 适配器模式（统一接口包装差异）
 59: - 复杂构建 → Builder / Factory
 60: - 事件通知 → 观察者 / 发布-订阅
 61: - 处理链 → Chain-of-Responsibility（如 middleware、handler pipeline）
 62: - 优先用声明式/数据驱动分发，少用命令式分支
 63: 
 64: ### 接口解耦
 65: - 层间依赖只通过 contracts 层的 Protocol / BaseModel 传递
 66: - 同层模块间不直接 import，通过依赖注入（构造函数参数）获取协作方
 67: - 新增外部集成（LLM provider、向量库、消息队列等）必须走适配器，不允许业务代码直接调用第三方 SDK
 68: 
 69: ### AI Coding 额外约束
 70: - 生成的代码必须可测试：纯函数优先，副作用隔离到边界，便于单元测试
 71: - 不生成 TODO / FIXME 占位——要么实现，要么不写
 72: - 不在生成代码中引入 `# type: ignore` 除非有注释说明原因
 73: - 错误处理用显式的自定义异常类，不用裸 `except Exception`
 74: - 日志用 structlog 结构化输出，不用 `print`
 75: - 异步代码中不在热路径做同步阻塞调用，需要时显式标注并说明原因
 76: 
 77: ## 真实 LLM 端到端测试
 78: 
 79: 默认 `pytest` 不跑需要 API Key 的集成测试。如需验证真实 LLM 链路：
 80: 
 81: ```bash
 82: # 1. 配置环境变量（或放 .env 文件在项目根目录或上级目录）
 83: export LLM_API_KEY="sk-..."
 84: export LLM_BASE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  # 可选
 85: export LLM_MODEL="qwen-plus"  # 可选，默认 gpt-4.1
 86: 
 87: # 2. 安装可选依赖
 88: uv sync --all-groups
 89: 
 90: # 3. 跑真实 LLM 测试
 91: uv run pytest -m real_llm -v
 92: ```
 93: 
 94: 真实 LLM 测试的断言策略：验证结构化事件（`status == "completed"`、`total_steps >= N`），
 95: 不验证具体文案（真实模型措辞不可预测）。
 96: 
 97: ## 如何新增团队场景
 98: 
 99: 在 `tests/fixtures/team_scenarios/` 下新增 YAML 文件，结构参考 `ecommerce_launch.yaml`：
100: 
101: ```yaml
102: roles:
103:   - key: my_role
104:     role: 角色名
105:     goal: 角色目标
106:     backstory: 角色背景
107:     tools: [calculator]  # 可选，目前支持 calculator
108: 
109: teams:
110:   my_team:
111:     process: hierarchical  # hierarchical / sequential / parallel / handoff
112:     supervisor: supervisor_role  # hierarchical 模式必须
113:     members: [role1, role2]
114: 
115: cases:
116:   my_case:
117:     team: my_team
118:     objective: "测试任务描述"
119:     assertions:
120:       status: completed
121:       min_steps: 4
122: ```
123: 
124: 然后在测试里用 `tests/support/scenario_loader.py` 加载：
125: 
126: ```python
127: from tests.support.scenario_loader import build_team, load_scenario
128: 
129: spec = load_scenario("tests/fixtures/team_scenarios/my_scenario.yaml")
130: team = build_team(spec, "my_team", llm)
131: result = await team.run("任务描述")
132: ```
133: 
134: ## Prompt 模板迭代
135: 
136: Prompt 模板存放在 `lca/layer1_cognitive/brain/prompts/*.md`，不触碰 Python 代码即可迭代。
137: 用 `load_builtin_prompt("react_prompt")` 加载，占位符用 `{role}` / `{goal}` / `{task}` 等。
138: 
139: ## 可观测性
140: 
141: 默认 `ConsoleObservability` 打印到 stdout。切换为 JSONL 文件落盘：
142: 
143: ```python
144: agent = Agent(..., observability="jsonl_file")
145: # 输出到 traces/lca_trace.jsonl，每行一个 JSON，可用 jq 过滤
146: ```
147: 
148: ## 禁止事项
149: - 不要在 --no-verify 情况下绕过 pre-commit 提交
150: - 不要让 contracts / layer0~3 import layer4_app
</file>

<file path="docs/adr/README.md">
 1: # Architecture Decision Records
 2: 
 3: | ADR | 标题 | 核心决定 |
 4: |---|---|---|
 5: | [0001](0001-five-layer-separation.md) | 五层单向依赖分层 | contracts → L0 → L1 → L2 → L3 → L4，import-linter 自动守卫 |
 6: | [0002](0002-cognitive-loop.md) | 认知闭环 | perceive→think→act→observe→reflect→update，Loop <25 行 |
 7: | [0003](0003-map-five-module-brain.md) | MAP 五模块 Brain | TaskDecomposer/StatePredictor/StateEvaluator/ConflictMonitor/TaskCoordinator |
 8: | [0004](0004-protocol-first-pluggability.md) | Protocol-First 可插拔 | 22+ Protocol，第三方实现接口即可接入 |
 9: | [0005](0005-composition-root-l4.md) | L4 组合根 | defaults.py 唯一引用所有具体类的组装点 |
10: | [0006](0006-multi-agent-orchestration.md) | 多智能体编排 | hierarchical/sequential/graph/debate 可切换 |
11: | [0007](0007-interop-mcp-a2a.md) | 原生互操作协议 | L0 内置 MCP/A2A 适配，协议本身可插拔 |
12: | [0008](0008-framework-positioning.md) | 框架定位 | 认知可解释性 + 生产级工程能力，同时优先 |
13: | [0009](0009-code-quality-toolchain.md) | 代码质量工具链 | ruff + mypy + pytest + import-linter + pre-commit + CI |
14: | [0010](0010-component-protocol-exemption.md) | 组件协议豁免规则 | L0-L3 默认必须声明 Protocol，仅 DI 基础设施和 L4 门面豁免 |
15: | [0011](0011-simple-prefix-convention.md) | Simple 前缀命名约定 | `Simple<Protocol>` = 最小可行参考实现，docstring 须声明能力边界 |
16: | [0012](0012-pydantic-migration-assessment.md) | 维持 dataclass 不迁移 Pydantic | contracts 层纯数据容器，mypy 静态检查已足够，运行时验证冗余 |
17: | [0013](0013-real-llm-e2e-and-scenario-config.md) | 真实 LLM E2E 与场景配置 | `pytest -m real_llm` 独立标记，YAML 驱动团队场景 |
18: | [0014](0014-error-classification-and-retry-semantics.md) | 错误分类与重试语义 | 工具错误分类 + 结构化重试策略 |
19: | [0015](0015-contracts-no-behavior-classes.md) | contracts/ 不含行为类 | 具体实现必须放实现层，contracts/ 仅保留 Protocol + dataclass |
20: 
21: ## 维护规则
22: - 推翻已有决定时，新建一篇标记 `Supersedes: ADR-XXXX`，不改旧文件
23: - 这类文档的价值在于记录某一时刻的判断，不在于时刻反映最新状态
</file>

