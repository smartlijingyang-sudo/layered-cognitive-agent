<file path="lca/contracts/ids.py">
 1: """契约层纯工具：稳定 id / 时间戳生成。
 2: 提供全局唯一的 trace-id / span-id 生成和 UTC 时间戳。
 3: 被 contracts 各模块及上层广泛引用，不得引入业务依赖。
 4: """
 5: from __future__ import annotations
 6: import uuid
 7: from datetime import datetime, timezone
 8: # uuid4 hex 截取长度：12 位 hex = 48 bit 随机性，碰撞概率极低且 id 简短
 9: _ID_SUFFIX_LEN: int = 12
10: def utc_now() -> datetime:
11:     """返回当前 UTC 时间（带 timezone）。"""
12:     return datetime.now(timezone.utc)
13: def new_id(prefix: str) -> str:
14:     """生成 ``{prefix}_{hex12}`` 格式的唯一 id。"""
15:     return f"{prefix}_{uuid.uuid4().hex[:_ID_SUFFIX_LEN]}"
</file>

