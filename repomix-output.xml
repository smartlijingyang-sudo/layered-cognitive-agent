<file path="lca/layer1_cognitive/brain/completion_policies/roster_coverage.py">
 1: """RosterCoveragePolicy —— 基于角色覆盖率的确定性收尾策略。
 2: 纯规则判断，不调用 LLM，零额外延迟、零不确定性。
 3: 当 LLM 候选 respond 但尚有必需角色未被咨询时，强制改写为 delegate。
 4: """
 5: from __future__ import annotations
 6: import uuid
 7: from lca.contracts.decision import DelegationSpec, StructuredDecision
 8: from lca.contracts.enums import ActionType
 9: from lca.contracts.protocols import CompletionPolicy
10: from lca.contracts.state import TypedState
11: def _infer_subtask(task: str, role: str) -> str:
12:     """从任务描述和目标角色推断子任务文本。"""
13:     return f"请从 {role} 的视角，针对以下任务提供你的专业意见：{task}"
14: class RosterCoveragePolicy(CompletionPolicy):
15:     """确保所有必需角色都被咨询后才允许 respond。
16:     判定逻辑：
17:     - 候选 action_type == "respond" 且 ledger 未全覆盖 → 改写为 delegate
18:     - 其它情况 → 原样放行
19:     """
20:     async def enforce(
21:         self,
22:         state: TypedState,
23:         decision: StructuredDecision,
24:     ) -> StructuredDecision:
25:         ledger = state.team_progress
26:         if ledger is None:
27:             return decision
28:         if decision.action_type == ActionType.RESPOND and not ledger.is_covered():
29:             pending = ledger.pending_roles()
30:             next_role = pending[0]
31:             return StructuredDecision(
32:                 decision_id=f"dec_{uuid.uuid4().hex[:12]}",
33:                 action_type=ActionType.DELEGATE,
34:                 delegate_to=DelegationSpec(
35:                     target_role=next_role,
36:                     subtask=_infer_subtask(state.task, next_role),
37:                 ),
38:                 rationale="[框架强制] 尚有必需角色未咨询，禁止提前收尾",
39:                 confidence=1.0,
40:             )
41:         return decision
</file>

