<file path="lca/layer1_cognitive/brain/skill_router.py">
 1: """SkillRouter 默认实现 —— 运行时动态选择 Prompt 模板。"""
 2: from __future__ import annotations
 3: from lca.contracts.protocols import SkillRouter
 4: from lca.contracts.state import TypedState
 5: class KeywordSkillRouter(SkillRouter):
 6:     """基于关键词匹配的零成本路由。
 7:     按优先级遍历规则，第一个命中的关键词决定返回哪个 template_name。
 8:     无命中时返回 default_template。
 9:     """
10:     def __init__(
11:         self,
12:         rules: dict[str, list[str]],
13:         default_template: str = "react_prompt",
14:     ) -> None:
15:         """
16:         Args:
17:             rules: template_name → 关键词列表。
18:                    例: {"research_prompt": ["研究", "调研", "search"],
19:                         "writing_prompt": ["写", "撰写", "draft"]}
20:             default_template: 无命中时的默认模板。
21:         """
22:         self._rules = rules
23:         self._default = default_template
24:     async def route(self, state: TypedState) -> str:
25:         task_lower = state.task.lower()
26:         for template_name, keywords in self._rules.items():
27:             if any(kw.lower() in task_lower for kw in keywords):
28:                 return template_name
29:         return self._default
30: class StaticSkillRouter(SkillRouter):
31:     """始终返回固定模板，用于测试或不需要动态切换的场景。"""
32:     def __init__(self, template_name: str) -> None:
33:         self._template = template_name
34:     async def route(self, state: TypedState) -> str:
35:         return self._template
</file>

<file path="lca/layer1_cognitive/memory/shared_memory_tool.py">
 1: """SharedMemoryTool —— 把 SharedMemoryStore 包装成普通 Tool。
 2: 设计意图（ADR-0016）：
 3: 团队成员在单体循环内通过 Body → use_tool → ToolRegistry 访问共享存储，
 4: 与调用 calculator 等工具无区别。不改 Body / Runtime / AgentEntrypoint 协议。
 5: ops:
 6:   - read:  读取 layer 全部记录（payload=list[str content]）
 7:   - write: 向 layer 追加一条 MemoryRecord
 8:   - list:  返回 layer 记录条数与内容摘要
 9: """
10: from __future__ import annotations
11: from typing import Any, Literal
12: from lca.contracts.budget import DEFAULT_TOOL_TIMEOUT_S
13: from lca.contracts.decision import Observation
14: from lca.contracts.enums import SharedMemoryOp
15: from lca.contracts.ids import new_id
16: from lca.contracts.memory import MemoryRecord
17: from lca.contracts.protocols import SharedMemoryStore, Tool
18: _VALID_OPS = frozenset(SharedMemoryOp)
19: _VALID_MEMORY_TYPES: frozenset[str] = frozenset({"working", "semantic", "episodic", "procedural"})
20: _DEFAULT_IMPORTANCE = 0.8
21: class SharedMemoryTool(Tool):
22:     """绑定 team_id + SharedMemoryStore 的工具实现。
23:     支持三种操作（SharedMemoryOp）：
24:     - read:  读取 layer 全部记录
25:     - write: 向 layer 追加一条 MemoryRecord
26:     - list:  返回 layer 记录条数与内容摘要
27:     """
28:     name: str = "shared_memory"
29:     is_idempotent: bool = False
30:     default_timeout_s: int = DEFAULT_TOOL_TIMEOUT_S
31:     def __init__(
32:         self,
33:         store: SharedMemoryStore,
34:         team_id: str,
35:         *,
36:         default_layer: str = "semantic",
37:         source_trace_id: str = "",
38:     ) -> None:
39:         self._store = store
40:         self._team_id = team_id
41:         self._default_layer = default_layer
42:         self._source_trace_id = source_trace_id
43:     def validate(self, args: dict[str, Any]) -> str | None:
44:         op = args.get("op")
45:         if op not in _VALID_OPS:
46:             return f"shared_memory.op 必须是 {sorted(_VALID_OPS)} 之一，收到: {op!r}"
47:         layer = str(args.get("layer", self._default_layer))
48:         if layer not in _VALID_MEMORY_TYPES:
49:             return f"layer 必须是 {_VALID_MEMORY_TYPES} 之一，收到: {layer!r}"
50:         if not self._store.is_shared(layer):
51:             return f"层 {layer!r} 未配置为共享（team_id={self._team_id}）"
52:         if op == SharedMemoryOp.WRITE and not args.get("content"):
53:             return "write 操作需要 content 字段"
54:         return None
55:     async def execute(self, args: dict[str, Any]) -> Observation:
56:         err = self.validate(args)
57:         if err is not None:
58:             return Observation(
59:                 observation_id=new_id("obs"),
60:                 success=False,
61:                 payload=None,
62:                 error=err,
63:             )
64:         op = str(args["op"])
65:         layer = str(args.get("layer", self._default_layer))
66:         if op == SharedMemoryOp.READ:
67:             records = self._store.get_records(layer)
68:             return Observation(
69:                 observation_id=new_id("obs"),
70:                 success=True,
71:                 payload=[r.content for r in records],
72:                 extra={"team_id": self._team_id, "layer": layer, "op": op},
73:             )
74:         if op == SharedMemoryOp.LIST:
75:             records = self._store.get_records(layer)
76:             return Observation(
77:                 observation_id=new_id("obs"),
78:                 success=True,
79:                 payload={"count": len(records), "contents": [r.content for r in records]},
80:                 extra={"team_id": self._team_id, "layer": layer, "op": op},
81:             )
82:         # write — layer 已在 validate 中校验属于 _VALID_MEMORY_TYPES
83:         content = str(args["content"])
84:         # layer was validated against _VALID_MEMORY_TYPES above, so this cast is safe
85:         memory_type: Literal["working", "semantic", "episodic", "procedural"] = layer  # type: ignore[assignment]
86:         record = MemoryRecord(
87:             record_id=new_id("mem"),
88:             content=content,
89:             memory_type=memory_type,
90:             importance=float(args.get("importance", _DEFAULT_IMPORTANCE)),
91:             source_trace_id=self._source_trace_id or self._team_id,
92:         )
93:         self._store.add_record(layer, record)
94:         return Observation(
95:             observation_id=new_id("obs"),
96:             success=True,
97:             payload={"written": content, "record_id": record.record_id},
98:             extra={"team_id": self._team_id, "layer": layer, "op": SharedMemoryOp.WRITE.value},
99:         )
</file>

<file path="lca/layer1_cognitive/team_progress/progress_hooks.py">
 1: """团队进度相关生命周期 hooks（从 contracts 迁出，ADR-0015 收口）。"""
 2: from __future__ import annotations
 3: from typing import Any
 4: from lca.contracts.enums import ActionType, RoleStatus
 5: from lca.contracts.state import TypedState
 6: async def ledger_tracking_hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
 7:     """post_act hook：委派完成后自动记账。
 8:     仅在 state.team_progress 存在时生效（hierarchical supervisor）。
 9:     """
10:     decision = kwargs.get("decision")
11:     observation = kwargs.get("observation")
12:     ledger = getattr(state, "team_progress", None)
13:     if decision is None or ledger is None:
14:         return
15:     if decision.action_type == ActionType.DELEGATE and decision.delegate_to is not None:
16:         role = decision.delegate_to.target_role
17:         if role and role in ledger.mandatory_roles:
18:             new_status = (
19:                 RoleStatus.DONE if getattr(observation, "success", False) else RoleStatus.FAILED
20:             )
21:             state.team_progress = ledger.mark(role, new_status)
22: async def progress_injection_hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
23:     """pre_think hook：将团队进度文本写入 TypedState.team_progress_text。"""
24:     ledger = getattr(state, "team_progress", None)
25:     if ledger is None:
26:         return
27:     pending = ledger.pending_roles()
28:     text = f"尚未咨询的角色: {', '.join(pending)}" if pending else "所有必需角色均已咨询完毕"
29:     state.team_progress_text = text
