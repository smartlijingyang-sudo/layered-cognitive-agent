<file path="lca/layer0_infra/transport/a2a_transport.py">
  1: """A2ATransport —— Google A2A 协议传输实现。
  2: 通过 HTTP 调用远程 A2A Agent 端点，实现跨框架 Agent 互操作。
  3: 依赖 httpx（已加入项目依赖）。
  4: A2A 协议核心流程：
  5: 1. 解析 AgentCard 获取端点 URL
  6: 2. send_task: POST 到 /tasks/send 创建异步任务
  7: 3. poll_status: GET /tasks/{task_id} 查询状态
  8: 4. receive_result: 从任务结果中提取 Observation
  9: """
 10: from __future__ import annotations
 11: import uuid
 12: from typing import Any
 13: import httpx
 14: from lca.contracts.decision import Observation
 15: from lca.contracts.protocols import AgentTransport
 16: def _new_id(prefix: str) -> str:
 17:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
 18: class A2ATransport(AgentTransport):
 19:     """Google A2A 协议传输实现。
 20:     通过 HTTP 与远程 A2A Agent 通信。AgentCard 可以是：
 21:     - 字符串：直接作为 endpoint URL
 22:     - 包含 url/endpoint 属性的对象：提取 URL
 23:     """
 24:     protocol_name: str = "a2a"
 25:     def __init__(
 26:         self,
 27:         timeout_s: float = 30.0,
 28:         default_endpoint: str | None = None,
 29:     ) -> None:
 30:         self._timeout = timeout_s
 31:         self._default_endpoint = default_endpoint
 32:         self._task_endpoints: dict[str, str] = {}
 33:         self._client: httpx.AsyncClient | None = None
 34:     async def _get_client(self) -> httpx.AsyncClient:
 35:         if self._client is None:
 36:             self._client = httpx.AsyncClient(timeout=self._timeout)
 37:         return self._client
 38:     def _resolve_endpoint(self, agent_card: Any) -> str:
 39:         if isinstance(agent_card, str):
 40:             return agent_card
 41:         if hasattr(agent_card, "url"):
 42:             return str(agent_card.url)
 43:         if hasattr(agent_card, "endpoint"):
 44:             return str(agent_card.endpoint)
 45:         if self._default_endpoint:
 46:             return self._default_endpoint
 47:         raise ValueError(f"无法从 AgentCard 解析 A2A 端点 URL: {agent_card!r}")
 48:     async def send_task(self, agent_card: Any, subtask: str, context_refs: list[str]) -> str:
 49:         endpoint = self._resolve_endpoint(agent_card)
 50:         task_id = _new_id("a2a_task")
 51:         self._task_endpoints[task_id] = endpoint
 52:         client = await self._get_client()
 53:         payload: dict[str, Any] = {
 54:             "task_id": task_id,
 55:             "message": {
 56:                 "role": "user",
 57:                 "parts": [{"kind": "text", "text": subtask}],
 58:             },
 59:         }
 60:         if context_refs:
 61:             parts = payload["message"]["parts"]
 62:             parts.extend({"kind": "reference", "ref": ref} for ref in context_refs)
 63:         try:
 64:             response = await client.post(f"{endpoint}/tasks/send", json=payload)
 65:             response.raise_for_status()
 66:         except httpx.HTTPError as exc:
 67:             self._task_endpoints[task_id] = f"error:{exc}"
 68:         return task_id
 69:     async def poll_status(self, task_id: str) -> str:
 70:         endpoint_info = self._task_endpoints.get(task_id, "")
 71:         if endpoint_info.startswith("error:"):
 72:             return "failed"
 73:         client = await self._get_client()
 74:         try:
 75:             response = await client.get(f"{endpoint_info}/tasks/{task_id}")
 76:             response.raise_for_status()
 77:             data = response.json()
 78:             status = data.get("status", {}).get("state", "working")
 79:             return str(status)
 80:         except httpx.HTTPError:
 81:             return "working"
 82:     async def receive_result(self, task_id: str) -> Observation:
 83:         endpoint_info = self._task_endpoints.get(task_id, "")
 84:         if endpoint_info.startswith("error:"):
 85:             return Observation(
 86:                 observation_id=_new_id("obs"),
 87:                 success=False,
 88:                 payload=None,
 89:                 error=endpoint_info[6:],
 90:             )
 91:         client = await self._get_client()
 92:         try:
 93:             response = await client.get(f"{endpoint_info}/tasks/{task_id}")
 94:             response.raise_for_status()
 95:             data = response.json()
 96:             status = data.get("status", {})
 97:             if status.get("state") != "completed":
 98:                 return Observation(
 99:                     observation_id=_new_id("obs"),
100:                     success=False,
101:                     payload=None,
102:                     error=f"Task not completed: state={status.get('state')}",
103:                 )
104:             artifacts = data.get("artifacts", [])
105:             output_parts: list[str] = []
106:             for artifact in artifacts:
107:                 for part in artifact.get("parts", []):
108:                     if part.get("kind") == "text":
109:                         output_parts.append(part.get("text", ""))
110:             return Observation(
111:                 observation_id=_new_id("obs"),
112:                 success=True,
113:                 payload="\n".join(output_parts) if output_parts else None,
114:                 extra={"a2a_task_id": task_id, "raw_response": data},
115:             )
116:         except httpx.HTTPError as exc:
117:             return Observation(
118:                 observation_id=_new_id("obs"),
119:                 success=False,
120:                 payload=None,
121:                 error=f"A2A receive_result failed: {exc}",
122:             )
123:     async def close(self) -> None:
124:         if self._client is not None:
125:             await self._client.aclose()
126:             self._client = None
</file>

<file path="lca/layer0_infra/transport/mcp_transport.py">
  1: """MCPTransport —— Model Context Protocol 传输实现。
  2: 通过 MCP client SDK 与远程 MCP Server 通信，实现跨框架 Agent 互操作。
  3: MCP 主要用于工具调用场景，此处将 Agent 任务映射为 MCP 工具调用。
  4: 依赖 mcp Python SDK（可选依赖，未安装时给出明确报错）。
  5: """
  6: from __future__ import annotations
  7: import contextlib
  8: import uuid
  9: from typing import Any
 10: from lca.contracts.decision import Observation
 11: from lca.contracts.protocols import AgentTransport
 12: def _new_id(prefix: str) -> str:
 13:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
 14: _MCP_SDK_MISSING_MSG = "MCP Python SDK 未安装。请运行: pip install mcp 或 uv add mcp"
 15: class MCPTransport(AgentTransport):
 16:     """MCP 协议传输实现。
 17:     将 Agent 任务映射为 MCP 工具调用。agent_card 可以是：
 18:     - 字符串：作为 MCP server URL 或 server name
 19:     - 包含 server_url/tool_name 属性的对象
 20:     注意：MCP SDK 是可选依赖，未安装时 send_task 会抛出明确错误。
 21:     """
 22:     protocol_name: str = "mcp"
 23:     def __init__(
 24:         self,
 25:         default_server_url: str | None = None,
 26:         default_tool_name: str = "execute_task",
 27:     ) -> None:
 28:         self._default_server_url = default_server_url
 29:         self._default_tool_name = default_tool_name
 30:         self._task_results: dict[str, Observation] = {}
 31:         self._task_statuses: dict[str, str] = {}
 32:         self._sessions: dict[str, Any] = {}
 33:     def _resolve_config(self, agent_card: Any) -> tuple[str, str]:
 34:         """从 agent_card 解析 server_url 和 tool_name。"""
 35:         if isinstance(agent_card, str):
 36:             return agent_card, self._default_tool_name
 37:         server_url = (
 38:             getattr(agent_card, "server_url", None)
 39:             or getattr(agent_card, "url", None)
 40:             or self._default_server_url
 41:         )
 42:         tool_name = getattr(agent_card, "tool_name", self._default_tool_name)
 43:         if server_url is None:
 44:             raise ValueError(f"无法从 AgentCard 解析 MCP server URL: {agent_card!r}")
 45:         return str(server_url), str(tool_name)
 46:     async def _get_mcp_session(self, server_url: str) -> Any:
 47:         """获取或创建 MCP client session。"""
 48:         if server_url in self._sessions:
 49:             return self._sessions[server_url]
 50:         try:
 51:             from mcp import ClientSession  # type: ignore[import-not-found]
 52:             from mcp.client.streamable_http import (  # type: ignore[import-not-found]
 53:                 streamablehttp_client,
 54:             )
 55:         except ImportError as exc:
 56:             raise NotImplementedError(_MCP_SDK_MISSING_MSG) from exc
 57:         read_stream, write_stream, _ = await streamablehttp_client(server_url).__aenter__()
 58:         session = ClientSession(read_stream, write_stream)
 59:         await session.__aenter__()
 60:         await session.initialize()
 61:         self._sessions[server_url] = session
 62:         return session
 63:     async def send_task(self, agent_card: Any, subtask: str, context_refs: list[str]) -> str:
 64:         task_id = _new_id("mcp_task")
 65:         server_url, tool_name = self._resolve_config(agent_card)
 66:         try:
 67:             session = await self._get_mcp_session(server_url)
 68:             arguments: dict[str, Any] = {"task": subtask}
 69:             if context_refs:
 70:                 arguments["context_refs"] = context_refs
 71:             result = await session.call_tool(tool_name, arguments=arguments)
 72:             output_text = ""
 73:             for content in result.content:
 74:                 if hasattr(content, "text"):
 75:                     output_text += content.text
 76:             is_error = getattr(result, "isError", False)
 77:             self._task_results[task_id] = Observation(
 78:                 observation_id=_new_id("obs"),
 79:                 success=not is_error,
 80:                 payload=output_text or None,
 81:                 error=output_text if is_error else None,
 82:                 extra={"mcp_tool": tool_name, "mcp_server": server_url},
 83:             )
 84:             self._task_statuses[task_id] = "completed"
 85:         except NotImplementedError:
 86:             raise
 87:         except Exception as exc:
 88:             self._task_results[task_id] = Observation(
 89:                 observation_id=_new_id("obs"),
 90:                 success=False,
 91:                 payload=None,
 92:                 error=f"MCP send_task failed: {exc}",
 93:             )
 94:             self._task_statuses[task_id] = "failed"
 95:         return task_id
 96:     async def poll_status(self, task_id: str) -> str:
 97:         return self._task_statuses.get(task_id, "completed")
 98:     async def receive_result(self, task_id: str) -> Observation:
 99:         return self._task_results.get(
100:             task_id,
101:             Observation(
102:                 observation_id=_new_id("obs"),
103:                 success=False,
104:                 payload=None,
105:                 error=f"MCP task not found: {task_id}",
106:             ),
107:         )
108:     async def close(self) -> None:
109:         for session in self._sessions.values():
110:             with contextlib.suppress(Exception):
111:                 await session.__aexit__(None, None, None)
112:         self._sessions.clear()
