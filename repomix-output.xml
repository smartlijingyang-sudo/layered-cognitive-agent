 18: from lca.contracts.result import ToolExecutionError
 19: from lca.contracts.role_team import CacheConfig, RetryPolicy
 20: from lca.contracts.semantic_keys import OBS_HANDOFF, OBS_TASK_ID
 21: from lca.contracts.state import TypedState
 22: _POLL_INTERVAL_S = 0.05
 23: _DEFAULT_DELEGATE_TIMEOUT_S = 30.0
 24: class RespondOperation(ActionOperation):
 25:     """处理 respond 动作：直接返回文本响应。"""
 26:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 27:         return Observation(
 28:             observation_id=new_id("obs"),
 29:             success=True,
 30:             payload=decision.response_text,
 31:         )
 32: class UseToolOperation(ActionOperation):
 33:     """处理 use_tool 动作：查找工具 → 权限校验 → 执行。"""
 34:     def __init__(self, tool_registry: ToolRegistry, safe_executor: SafeExecutor) -> None:
 35:         self._tool_registry = tool_registry
 36:         self._safe_executor = safe_executor
 37:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 38:         if not decision.tool_calls:
 39:             raise ToolExecutionError("use_tool 需要至少一个 tool_call")
 40:         tc = decision.tool_calls[0]
 41:         tool = self._tool_registry.get(tc.tool_name)
 42:         if tool is None:
 43:             raise ToolExecutionError(f"未注册工具: {tc.tool_name}")
 44:         return await self._safe_executor.execute(tool, tc.arguments, RetryPolicy(), CacheConfig())
 45: class DelegateOperation(ActionOperation):
 46:     """处理 delegate 动作：阻塞式委派，等待目标 Agent 返回结果。"""
 47:     def __init__(self, transport_registry: TransportRegistryProtocol) -> None:
 48:         self._transport_registry = transport_registry
 49:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 50:         transport, task_id = await self._send_to_transport(decision, state)
 51:         timeout_s = (
 52:             (spec.deadline.timestamp() - asyncio.get_running_loop().time())
 53:             if (spec := decision.delegate_to) and spec.deadline
 54:             else _DEFAULT_DELEGATE_TIMEOUT_S
 55:         )
 56:         observation = await self._wait_for_result(transport, task_id, timeout_s)
 57:         observation.extra[OBS_TASK_ID] = task_id
 58:         return observation
 59:     async def _wait_for_result(
 60:         self,
 61:         transport: AgentTransport,
 62:         task_id: str,
 63:         timeout_s: float,
 64:     ) -> Observation:
 65:         wait = getattr(transport, "wait_result", None)
 66:         if wait is not None:
 67:             try:
 68:                 result: Observation = await wait(task_id, timeout_s)
 69:                 return result
 70:             except TimeoutError:
 71:                 return Observation(
 72:                     observation_id=new_id("obs"),
 73:                     success=False,
 74:                     payload=None,
 75:                     error=f"delegate 超时: task_id={task_id}",
 76:                     extra={OBS_TASK_ID: task_id},
 77:                 )
 78:         # 回退：跨进程 / 旧 transport 轮询
 79:         elapsed = 0.0
 80:         while (await transport.poll_status(task_id)) != TaskStatus.WORKING:
 81:             if elapsed >= timeout_s:
 82:                 return Observation(
 83:                     observation_id=new_id("obs"),
 84:                     success=False,
 85:                     payload=None,
 86:                     error=f"delegate 超时: task_id={task_id}",
 87:                     extra={OBS_TASK_ID: task_id},
 88:                 )
 89:             await asyncio.sleep(_POLL_INTERVAL_S)
 90:             elapsed += _POLL_INTERVAL_S
 91:         return await transport.receive_result(task_id)
 92:     async def _send_to_transport(
 93:         self, decision: StructuredDecision, state: TypedState
 94:     ) -> tuple[AgentTransport, str]:
 95:         spec = decision.delegate_to
 96:         if spec is None:
 97:             raise ToolExecutionError(f"{decision.action_type} 动作缺少 delegate_to 规格")
 98:         transport = self._transport_registry.resolve(spec.protocol)
 99:         agent_card = spec.target_agent_card or spec.target_agent_id or spec.target_role
100:         if agent_card is None:
101:             raise ToolExecutionError("delegate 动作缺少目标（agent_card / agent_id / role 均为空）")
102:         with delegator_scope(state.agent_role):
103:             task_id = await transport.send_task(agent_card, spec.subtask, spec.context_refs)
104:         return transport, task_id
105: class HandoffOperation(ActionOperation):
106:     """处理 handoff 动作：非阻塞控制权移交，发完即返回。"""
107:     def __init__(self, transport_registry: TransportRegistryProtocol) -> None:
108:         self._transport_registry = transport_registry
109:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
110:         spec = decision.delegate_to
111:         if spec is None:
112:             raise ToolExecutionError("handoff 动作缺少 delegate_to 规格")
113:         transport = self._transport_registry.resolve(spec.protocol)
114:         agent_card = spec.target_agent_card or spec.target_agent_id or spec.target_role
115:         if agent_card is None:
116:             raise ToolExecutionError("handoff 动作缺少目标（agent_card / agent_id / role 均为空）")
117:         with delegator_scope(state.agent_role):
118:             task_id = await transport.send_task(agent_card, spec.subtask, spec.context_refs)
119:         return Observation(
120:             observation_id=new_id("obs"),
121:             success=True,
122:             payload=f"handoff to {spec.target_role or spec.target_agent_id}",
123:             extra={OBS_TASK_ID: task_id, OBS_HANDOFF: True},
124:         )
</file>

<file path="lca/layer1_cognitive/body/safe_executor.py">
  1: """SafeExecutor —— 权限校验 -> 前置校验 -> 缓存命中 -> 重试装饰 -> 沙箱执行。"""
  2: from __future__ import annotations
  3: import asyncio
  4: import json
  5: from typing import Any
  6: import structlog
  7: from lca.contracts.decision import Observation
  8: from lca.contracts.enums import SpanStatus
  9: from lca.contracts.ids import new_id, utc_now
 10: from lca.contracts.observability import TraceSpan
 11: from lca.contracts.protocols import Observability, SafeExecutor, Tool
 12: from lca.contracts.result import ToolExecutionError
 13: from lca.contracts.role_team import CacheConfig, RetryPolicy, ToolPermissionManifest
 14: from lca.contracts.semantic_keys import (
 15:     FAILURE_KIND,
 16:     FAILURE_KIND_EXECUTION,
 17:     FAILURE_KIND_TRANSIENT,
 18:     FAILURE_KIND_VALIDATION,
 19: )
 20: _log = structlog.get_logger("lca.safe_executor")
 21: class SimpleSafeExecutor(SafeExecutor):
 22:     """权限校验 -> 前置校验 -> 缓存命中 -> 重试装饰 -> 沙箱执行。
 23:     重试语义由两个信号驱动，SafeExecutor 不猜测错误类型：
 24:     - ``tool.validate(args)``：前置校验，失败直接返回，不进入重试循环
 25:     - ``exception.retryable``：执行中异常，``False`` 则 fail-fast
 26:     """
 27:     def __init__(self, permission_manifest: ToolPermissionManifest, observability: Observability):
 28:         self.permission_manifest = permission_manifest
 29:         self.observability = observability
 30:         self._cache: dict[str, Observation] = {}
 31:     async def execute(
 32:         self,
 33:         tool: Tool,
 34:         args: dict[str, Any],
 35:         retry_policy: RetryPolicy,
 36:         cache_config: CacheConfig,
 37:     ) -> Observation:
 38:         if tool.name not in self.permission_manifest.allowed_tools:
 39:             raise ToolExecutionError(
 40:                 f"工具 {tool.name} 未在 ToolPermissionManifest.allowed_tools 中授权"
 41:             )
 42:         validation_error = self._validate_args(tool, args)
 43:         if validation_error is not None:
 44:             return Observation(
 45:                 observation_id=new_id("obs"),
 46:                 success=False,
 47:                 payload=None,
 48:                 error=validation_error,
 49:                 extra={FAILURE_KIND: FAILURE_KIND_VALIDATION},
 50:             )
 51:         cache_key = f"{tool.name}:{json.dumps(args, sort_keys=True, ensure_ascii=False)}"
 52:         if cache_config.enabled and cache_key in self._cache:
 53:             return self._cache[cache_key]
 54:         last_obs: Observation | None = None
 55:         last_error: str = ""
 56:         delay = retry_policy.backoff_base_s
 57:         for attempt in range(retry_policy.max_retries + 1):
 58:             span = TraceSpan(
 59:                 span_id=new_id("span"),
 60:                 trace_id="",
 61:                 name=f"tool.{tool.name}",
 62:                 started_at=utc_now(),
 63:                 attributes={"args": args, "attempt": attempt},
 64:             )
 65:             try:
 66:                 obs = await tool.execute(args)
 67:             except ToolExecutionError as err:
 68:                 obs = Observation(
 69:                     observation_id=new_id("obs"),
 70:                     success=False,
 71:                     payload=None,
 72:                     error=str(err),
 73:                     extra={FAILURE_KIND: FAILURE_KIND_EXECUTION},
 74:                 )
 75:                 if not getattr(err, "retryable", True):
 76:                     span.ended_at = utc_now()
 77:                     span.status = SpanStatus.ERROR
 78:                     span.attributes["error"] = obs.error
 79:                     span.attributes[FAILURE_KIND] = FAILURE_KIND_EXECUTION
 80:                     span.attributes["retryable"] = False
 81:                     self.observability.emit_span(span)
 82:                     return obs
 83:             except Exception as err:
 84:                 _log.warning(
 85:                     "tool_execution_error",
 86:                     tool=tool.name,
 87:                     error_type=type(err).__name__,
 88:                     error=str(err),
 89:                     attempt=attempt,
 90:                 )
 91:                 obs = Observation(
 92:                     observation_id=new_id("obs"),
 93:                     success=False,
 94:                     payload=None,
 95:                     error=str(err),
 96:                     extra={FAILURE_KIND: FAILURE_KIND_TRANSIENT},
 97:                 )
 98:             span.ended_at = utc_now()
 99:             span.status = SpanStatus.OK if obs.success else SpanStatus.ERROR
100:             if not obs.success:
101:                 span.attributes["error"] = obs.error
102:                 span.attributes[FAILURE_KIND] = obs.extra.get(FAILURE_KIND, FAILURE_KIND_EXECUTION)
103:             self.observability.emit_span(span)
104:             if obs.success:
105:                 if cache_config.enabled:
106:                     self._cache[cache_key] = obs
107:                 return obs
108:             if obs.extra.get(FAILURE_KIND) == FAILURE_KIND_VALIDATION:
109:                 return obs
110:             last_obs = obs
111:             last_error = obs.error or ""
112:             if attempt < retry_policy.max_retries:
113:                 await asyncio.sleep(delay)
114:                 delay *= retry_policy.backoff_multiplier
115:         detail = f"，最后错误: {last_error}" if last_error else ""
116:         raise ToolExecutionError(
117:             f"工具 {tool.name} 重试 {retry_policy.max_retries} 次后仍失败{detail}", last_obs
118:         )
119:     @staticmethod
120:     def _validate_args(tool: Tool, args: dict[str, Any]) -> str | None:
121:         """调用工具的可选 validate 钩子，未实现则跳过。"""
122:         validator: Any = getattr(tool, "validate", None)
123:         if validator is None:
124:             return None
125:         result: str | None = validator(args)
126:         return result
</file>

<file path="lca/layer1_cognitive/memory/simple_memory.py">
 1: """四类记忆的最小实现：内存列表存储 + 简单相关性检索 + 可选团队共享。"""
 2: from __future__ import annotations
 3: from typing import Any
 4: from lca.contracts.decision import Observation, Reflection
 5: from lca.contracts.ids import new_id
 6: from lca.contracts.memory import MemoryRecord
 7: from lca.contracts.protocols import MemorySystem, SharedMemoryStore
 8: from lca.contracts.state import TypedState
 9: _DEFAULT_MAX_WORKING = 20
10: _DEFAULT_MAX_EPISODIC = 50
11: class SimpleMemorySystem(MemorySystem):
12:     """Working / Semantic / Episodic / Procedural 四层记忆。
13:     可选绑定 SharedMemoryStore：对声明共享的层（semantic/procedural），
14:     读写直接走共享 store，实现跨 Agent 记忆共享；未声明共享的层保持私有。
15:     """
16:     def __init__(self) -> None:
17:         self._shared_store: SharedMemoryStore | None = None
18:         self._private_layers: dict[str, list[MemoryRecord]] = {
19:             "working": [],
20:             "semantic": [],
21:             "episodic": [],
22:             "procedural": [],
23:         }
24:     def bind_shared_store(self, store: SharedMemoryStore) -> None:
25:         """绑定团队共享记忆存储。共享层的数据读写委托给 store。"""
26:         self._shared_store = store
27:     def _get_layer_records(self, layer: str) -> list[MemoryRecord]:
28:         if self._shared_store is not None and self._shared_store.is_shared(layer):
29:             return self._shared_store.get_records(layer)
30:         return self._private_layers[layer]
31:     def _append_record(self, layer: str, record: MemoryRecord) -> None:
32:         if self._shared_store is not None and self._shared_store.is_shared(layer):
33:             self._shared_store.add_record(layer, record)
34:         else:
35:             self._private_layers[layer].append(record)
36:     async def perceive(self, state: TypedState) -> TypedState:
37:         records: list[MemoryRecord] = []
38:         for layer_name in self._private_layers:
39:             records.extend(self._get_layer_records(layer_name))
40:         state.retrieved_context = records
41:         return state
42:     async def update(
43:         self, state: TypedState, observation: Observation, reflection: Reflection
44:     ) -> None:
45:         if observation.payload is not None and observation.success:
46:             # 追加到 working memory 而非覆盖，确保多步委派历史对 agent 可见
47:             self._private_layers["working"].append(
48:                 MemoryRecord(
49:                     record_id=new_id("mem"),
50:                     content=f"TOOL_RESULT: {observation.payload}",
51:                     memory_type="working",
52:                     importance=0.9,
53:                     source_trace_id=state.trace_id,
54:                 )
55:             )
56:             # 防止 working memory 无限增长
57:             if len(self._private_layers["working"]) > _DEFAULT_MAX_WORKING:
58:                 self._private_layers["working"] = self._private_layers["working"][
59:                     -_DEFAULT_MAX_WORKING:
60:                 ]
61:         self._append_record(
62:             "episodic",
63:             MemoryRecord(
64:                 record_id=new_id("mem"),
65:                 content=f"step={state.step} success={observation.success} verdict={reflection.verdict}",
66:                 memory_type="episodic",
67:                 importance=0.5,
68:                 source_trace_id=state.trace_id,
69:             ),
70:         )
71:         await self.compress()
72:     async def compress(self) -> None:
73:         episodic = self._get_layer_records("episodic")
74:         if len(episodic) > _DEFAULT_MAX_EPISODIC:
75:             if self._shared_store is not None and self._shared_store.is_shared("episodic"):
76:                 pass  # episodic 不应被共享，防御性跳过
77:             else:
78:                 self._private_layers["episodic"] = episodic[-_DEFAULT_MAX_EPISODIC:]
79:     def write_shared_record(self, layer: str, record: MemoryRecord) -> None:
80:         """显式向共享层写入记录（供外部策略/编排代码使用）。"""
81:         if self._shared_store is None or not self._shared_store.is_shared(layer):
82:             raise KeyError(f"层 {layer!r} 未配置为共享")
83:         self._shared_store.add_record(layer, record)
84:     def get_private_layer_snapshot(self) -> dict[str, Any]:
85:         """返回私有层的当前状态快照，用于测试和调试。"""
86:         return {k: list(v) for k, v in self._private_layers.items()}
</file>

<file path="lca/layer1_cognitive/hook_registry.py">
 1: """SimpleHookRegistry —— 生命周期钩子注册与触发。"""
 2: from __future__ import annotations
 3: from collections.abc import Callable
 4: from datetime import datetime, timezone
 5: from typing import Any
 6: import structlog
 7: from lca.contracts.ids import new_id
 8: from lca.contracts.observability import TraceSpan
 9: from lca.contracts.protocols import HookRegistry, Observability
10: from lca.contracts.state import TypedState
11: from lca.layer0_infra.observability.redaction import safe_repr
12: from lca.layer0_infra.observability.span_attributes import extract_span_attributes
13: _log = structlog.get_logger("lca.hook_registry")
14: def _now() -> datetime:
15:     return datetime.now(timezone.utc)
16: class SimpleHookRegistry(HookRegistry):
17:     """注册和触发生命周期钩子。"""
18:     def __init__(self, observability: Observability) -> None:
19:         self._hooks: dict[str, list[Callable]] = {}
20:         self.observability = observability
21:     def register(self, event_name: str, hook: Callable) -> None:
22:         self._hooks.setdefault(event_name, []).append(hook)
23:     async def trigger(self, event_name: str, state: TypedState, **kwargs: Any) -> Any:
24:         span = TraceSpan(
25:             span_id=new_id("span"),
26:             trace_id=state.trace_id,
27:             name=f"hook.{event_name}",
28:             started_at=_now(),
29:             attributes=extract_span_attributes(event_name, kwargs),
30:         )
31:         for hook in self._hooks.get(event_name, []):
32:             await hook(event_name, state, **kwargs)
33:         span.ended_at = _now()
34:         self.observability.emit_span(span)
35:         return None
36: async def default_logging_hook(event_name: str, state: TypedState, **kwargs: Any) -> None:
37:     extra = {k: v for k, v in kwargs.items() if k != "state"}
38:     role_info = f"role={state.agent_role}" if state.agent_role else ""
39:     delegator_info = f"delegated_by={state.delegated_by}" if state.delegated_by else ""
40:     context_parts = [p for p in [role_info, delegator_info] if p]
41:     context_str = " ".join(context_parts)
42:     safe_extra = {k: safe_repr(v) for k, v in extra.items()} if extra else None
43:     _log.info(
44:         "hook_triggered",
45:         hook_event=event_name,
46:         step=state.step,
47:         context=context_str or None,
48:         hook_extra=safe_extra,
49:     )
</file>

<file path="pyproject.toml">
  1: [project]
  2: name = "lca-framework"
  3: version = "0.1.0"
  4: description = "Layered Cognitive Agent Framework"
  5: requires-python = ">=3.10"
  6: dependencies = [
  7:     "httpx>=0.28.1",
  8:     "structlog>=26.1.0",
  9: ]
 10: 
 11: [tool.importlinter]
 12: root_package = "lca"
 13: 
 14: # ── 契约 1: L0→L1→L2→L3 + contracts 严格单向分层 ──
 15: # 每层只能 import 直接下方一层；contracts 是最底层
 16: [[tool.importlinter.contracts]]
 17: name = "严格分层: contracts → L0 → L1 → L2 → L3"
 18: type = "layers"
 19: layers = [
 20:     "lca.layer3_agent",
 21:     "lca.layer2_runtime",
 22:     "lca.layer1_cognitive",
 23:     "lca.layer0_infra",
 24:     "lca.contracts",
 25: ]
 26: 
 27: # ── 契约 2: L4 作为组合根，可依赖所有下层 ──
 28: # 但下层不得反向依赖 L4（用 forbidden 约束）
 29: [[tool.importlinter.contracts]]
 30: name = "L4 组合根: 下层禁止反向依赖"
 31: type = "forbidden"
 32: source_modules = [
 33:     "lca.contracts",
 34:     "lca.layer0_infra",
 35:     "lca.layer1_cognitive",
 36:     "lca.layer2_runtime",
 37:     "lca.layer3_agent",
 38: ]
 39: forbidden_modules = ["lca.layer4_app"]
 40: 
 41: # ── 契约 3: contracts 是纯数据契约层，不得 import 任何实现细节 ──
 42: [[tool.importlinter.contracts]]
 43: name = "contracts 纯净性: 不得依赖任何具体实现"
 44: type = "forbidden"
 45: source_modules = ["lca.contracts"]
 46: forbidden_modules = [
 47:     "lca.layer0_infra",
 48:     "lca.layer1_cognitive",
 49:     "lca.layer2_runtime",
 50:     "lca.layer3_agent",
 51:     "lca.layer4_app",
 52: ]
 53: 
 54: [dependency-groups]
 55: dev = [
 56:     { include-group = "lint" },
 57:     { include-group = "typecheck" },
 58:     { include-group = "test" },
 59:     { include-group = "security" },
 60: ]
 61: lint = [
 62:     "ruff>=0.16.0",
 63: ]
 64: typecheck = [
 65:     "mypy>=1.13",
 66:     "pydantic>=2.9",
 67: ]
 68: test = [
 69:     "pytest>=8.3",
 70:     "pytest-asyncio>=0.24",
 71:     "pytest-cov>=6.0",
 72:     "pyyaml>=6.0",
 73: ]
 74: security = [
 75:     "import-linter>=2.1",
 76:     "pip-audit>=2.7",
 77:     "detect-secrets>=1.5",
 78:     "vulture>=2.13",
 79:     "interrogate>=1.7",
 80: ]
 81: llm-openai = [
 82:     "openai>=1.40",
 83:     "python-dotenv>=1.0",
 84: ]
 85: 
 86: [tool.ruff]
 87: target-version = "py310"
 88: line-length = 100
 89: 
 90: [tool.ruff.lint]
 91: select = [
 92:     "E",
 93:     "W",
 94:     "F",
 95:     "I",
 96:     "UP",
 97:     "B",
 98:     "C4",
 99:     "SIM",
100:     "ASYNC",
101:     "S",
102:     "N",
103:     "RUF",
104:     "TCH",
105: ]
106: ignore = [
107:     "E501",
108:     "RUF001",  # 中文全角标点（字符串）
109:     "RUF002",  # 中文全角标点（docstring）
110:     "RUF003",  # 中文全角标点（注释）
111:     "TC001",   # 运行时 import 与 TYPE_CHECKING 混用，首版暂不强制
112:     "TC003",   # 同上
113: ]
114: 
115: [tool.ruff.lint.per-file-ignores]
116: "tests/*" = ["S101"]
117: "lca/contracts/protocols/**/*.py" = ["ARG002"]
118: "lca/contracts/mechanisms.py" = ["ARG002"]
119: "lca/contracts/action.py" = ["ARG002"]
120: 
121: [tool.ruff.format]
122: quote-style = "double"
123: 
124: [tool.mypy]
125: python_version = "3.10"
126: warn_unused_ignores = true
127: warn_redundant_casts = true
128: warn_return_any = true
129: disallow_untyped_defs = true
130: check_untyped_defs = true
131: # contracts 层使用 stdlib dataclass，不迁移到 Pydantic（ADR-0012）
132: 
133: [[tool.mypy.overrides]]
134: module = "tests.*"
135: disallow_untyped_defs = false
136: 
137: [[tool.mypy.overrides]]
