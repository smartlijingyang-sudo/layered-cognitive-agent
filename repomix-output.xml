<file path="lca/layer1_cognitive/brain/synthesizer.py">
 1: """Synthesizer 默认实现 —— MoA 聚合层。"""
 2: from __future__ import annotations
 3: from lca.contracts.lifecycle import TaskStatus
 4: from lca.contracts.protocols import Synthesizer
 5: from lca.contracts.result import Result
 6: from lca.contracts.state import Budget
 7: class ConcatSynthesizer(Synthesizer):
 8:     """简单拼接聚合：将所有候选结果的 output 用分隔符连接。
 9:     最基础的 Synthesizer 实现，用于打底和测试。
10:     进阶实现（LLMSynthesizer）将调用 LLM 做 Layer-2 提炼。
11:     """
12:     def __init__(self, separator: str = "\n\n---\n\n") -> None:
13:         self._separator = separator
14:     async def synthesize(self, objective: str, candidates: list[Result]) -> Result:
15:         if not candidates:
16:             return Result.failed("No candidates to synthesize")
17:         outputs: list[str] = []
18:         total_steps = 0
19:         aggregated_budget = Budget()
20:         all_lessons: list[str] = []
21:         any_completed = False
22:         for i, candidate in enumerate(candidates):
23:             if candidate.output:
24:                 outputs.append(f"[Candidate {i + 1}]\n{candidate.output}")
25:             total_steps += candidate.total_steps
26:             if candidate.budget_used is not None:
27:                 aggregated_budget.used_tokens += candidate.budget_used.used_tokens
28:                 aggregated_budget.used_cost_usd += candidate.budget_used.used_cost_usd
29:                 aggregated_budget.used_steps += candidate.budget_used.used_steps
30:             all_lessons.extend(candidate.lessons)
31:             if candidate.status == TaskStatus.COMPLETED:
32:                 any_completed = True
33:         synthesized_output = self._separator.join(outputs) if outputs else None
34:         return Result(
35:             trace_id=candidates[0].trace_id,
36:             status=TaskStatus.COMPLETED if any_completed else TaskStatus.FAILED,
37:             final_state_ref="",
38:             total_steps=total_steps,
39:             budget_used=aggregated_budget,
40:             output=synthesized_output,
41:             lessons=all_lessons,
42:             extra={"synthesis_method": "concat", "candidate_count": len(candidates)},
43:         )
</file>

<file path="lca/layer3_agent/orchestration_registry.py">
 1: """OrchestrationStrategyRegistry —— 按 process 名称注册和解析编排策略。
 2: L3 层职责：
 3:     注册表模式（Registry Pattern）的实现。
 4:     将编排策略名称（如 "hierarchical"、"sequential"）映射到
 5:     OrchestrationStrategy 实例，消除 TeamOrchestrator 中的 if/elif 分发。
 6:     工厂签名 ``() -> OrchestrationStrategy``，resolve 时自动调用工厂。
 7: """
 8: from __future__ import annotations
 9: from collections.abc import Callable
10: from lca.contracts.protocols import OrchestrationStrategy
11: from lca.layer0_infra.component_registry import NamedRegistry
12: OrchestrationFactory = Callable[[], OrchestrationStrategy]
13: _global_orchestration_registry: OrchestrationStrategyRegistry | None = None
14: class OrchestrationStrategyRegistry(NamedRegistry[OrchestrationFactory]):
15:     """按名称注册和查找 OrchestrationStrategy 工厂。
16:     工厂签名: ``() -> OrchestrationStrategy``
17:     策略实例在 ``run()`` 时通过 OrchestrationContext 获取运行时数据。
18:     ``resolve()`` 有意覆盖基类签名：基类返回工厂（``OrchestrationFactory``），
19:     本类调用工厂后返回策略实例（``OrchestrationStrategy``），
20:     这是注册表模式的常见变体——注册的是工厂，消费方拿到的是产品。
21:     """
22:     _REGISTRY_KIND = "编排策略"
23:     def resolve(self, name: str) -> OrchestrationStrategy:  # type: ignore[override]
24:         # 有意将返回类型从 OrchestrationFactory 变为 OrchestrationStrategy 实例：
25:         # 注册表存工厂，resolve 调用工厂返回产品，消费方无需知道工厂细节。
26:         factory = super().resolve(name)
27:         return factory()
28:     def list_strategies(self) -> list[str]:
29:         return self.list()
30:     def has(self, name: str) -> bool:
31:         return name in self
32: def get_global_orchestration_registry() -> OrchestrationStrategyRegistry:
33:     """返回全局单例编排策略注册表。"""
34:     global _global_orchestration_registry
35:     if _global_orchestration_registry is None:
36:         _global_orchestration_registry = OrchestrationStrategyRegistry()
37:     return _global_orchestration_registry
</file>

<file path="docs/glossary.md">
 1: # 术语表
 2: 
 3: | 术语 | 定义 |
 4: |---|---|
 5: | **L0–L4** | 框架五层：基础设施层 / 认知组件层 / 认知运行时层 / Agent 抽象层 / 应用编排层 |
 6: | **MAP** | ModularBrain 内五模块协作：TaskDecomposer → StatePredictor → StateEvaluator → ConflictMonitor → TaskCoordinator |
 7: | **认知闭环** | perceive → think → act → observe → reflect → update，框架核心循环 |
 8: | **StructuredDecision** | Brain 输出的强类型决策对象，含 action_type / tool_call / delegate_to / rationale |
 9: | **TypedState** | 贯穿运行时的强类型状态对象，携带 Budget、Checkpoint、记忆上下文 |
10: | **BrainStrategy** | 可插拔推理策略协议（ReAct / Plan-Execute / ToT 等），注册到 StrategyRegistry |
11: | **CognitiveRuntime** | L2 核心循环实现，驱动 perceive→think→act→reflect 每一步并触发 Hook |
12: | **Body** | L1 执行器组件，封装 ToolRegistry + SafeExecutor，对外暴露 act() |
13: | **SafeExecutor** | Body 内工具执行器，依次做权限校验 → 缓存命中 → 重试退避 → 沙箱执行 |
14: | **ToolPermissionManifest** | 每个角色声明的允许工具子集与调用频次上限 |
15: | **RetryPolicy / CacheConfig** | 工具执行的重试退避策略与缓存配置 |
16: | **AgentTransport** | 跨 Agent 通信协议适配器接口，内置 internal / a2a / mcp 三种实现 |
17: | **LLMAdapter** | L0 多厂商 LLM 统一调用接口，屏蔽 API 差异（含 Anthropic / OpenAI / Mock 实现） |
18: | **AgentCard** | Agent 对外发布的能力名片（角色、工具、协议、端点），用于 A2A 发现与委派 |
19: | **TaskStatus** | 任务生命周期状态机：submitted → working → input-required / completed / failed / canceled |
20: | **DelegationSpec** | 委派契约，含目标角色/Agent、子任务描述、协议选择（internal / a2a / mcp） |
21: | **ApprovalPendingError** | pre_act Hook 判定高风险操作时抛出，Runtime 挂起等待人工审批后 resume |
22: | **MemoryLayer** | 单一记忆层协议（Working / Semantic / Episodic / Procedural / KnowledgeGraph） |
23: | **MemoryRecord / SkillRecord / KGTriple** | 记忆存储契约：通用记录 / 程序性技能记录 / 知识图谱三元组 |
24: | **HookRegistry** | 生命周期钩子注册表，支持 pre/post_perceive/think/act/reflect 及 on_start/error/complete |
25: | **EventBus / Event** | 异步事件广播机制，驱动跨组件松耦合通信与可观测性埋点 |
26: | **Observability / TraceSpan** | 可观测性接口与最小追踪单元，默认 Console 实现，可选 JSONL 文件落盘 |
27: | **PromptManager** | Prompt 模板集中管理与版本化渲染 |
28: | **Reasoner / Critic** | Brain 内候选思路生成器（调 LLM）与事后自省纠偏器 |
29: | **Reflection / Observation** | 反思结果（on_track / needs_correction / blocked）与工具执行观测结果 |
30: | **Result** | Runtime 最终输出契约，含 status / output / lessons / budget_used / trace |
31: | **RoleProfile / TeamConfig** | 角色设定契约（role/goal/backstory/tool 权限）与团队编排契约（process 类型/共享记忆层） |
32: | **SimpleAgent** | L3 单 Agent 运行时封装，``AgentEntrypoint`` 的默认实现（原 ``BaseAgent``）；持有 Runtime + RoleProfile + 预算字段 |
33: | **Agent** | L4 开发者门面：薄包装 ``assemble_base_agent``，对外暴露 ``run(task)`` |
34: | **MultiAgentTeam** | L4 团队门面：组合多个 ``Agent`` 成员，委托 ``assemble_team`` 构建 ``TeamOrchestrator`` |
35: | **TeamOrchestrator / Supervisor** | 团队编排器（hierarchical/sequential/graph/debate）与单向上委派汇总角色 |
36: | **TeamEntrypoint / TeamMessage** | 团队级运行时与跨 Agent 消息契约 |
37: | **Budget** | 多维度预算控制对象（token / cost / steps / wall_clock），超限触发 BudgetExceededError |
38: | **SkillRouter** | 技能路由协议，按 trigger_pattern 匹配任务并召回对应 SkillRecord |
39: | **Synthesizer** | 将多步结果合成为最终输出的组件 |
40: | **ExecutionGraph / GraphNode / GraphEdge** | 图编排策略的节点/边定义，支持条件分支与循环 |
41: | **OrchestrationContext** | 编排过程中传递的上下文对象 |
42: | **CoALA** | 语言智能体记忆分类参考框架：工作记忆 / 语义记忆 / 情景记忆 / 程序性记忆 |
43: | **ActionOperation** | 单一 action_type 的可插拔操作协议（原 ActionHandler），Strategy 模式落地 |
44: | **FallbackPolicy** | 未知 action_type 的降级策略协议（原 FallbackHandler） |
45: | **NamedRegistryProtocol** | 按名称注册/解析实体的通用注册表协议 |
46: | **Turn** | 单步认知闭环记录：decision + observation + reflection |
47: | **TeamAssignment** | 团队级分工单元，与单体内部计划项语义分离 |
48: | **SharedMemoryTool** | 将 SharedMemoryStore 包装为普通 Tool，成员经 use_tool 访问共享层 |
49: | **StepOutcome / StepOutcomePolicy** | 单步结果判定信号与策略，Loop 只消费 should_stop / final_output |
50: | **ComponentRegistry** | L0 按 (category, name) 注册组件实现的 DI 注册表 |
51: | **Respond / UseTool / Delegate / Handoff** | 内置 action_type 及对应 ActionOperation 实现 |
52: | **Operation** | 行动能力实现的命名后缀（替代 Handler），表示无状态策略对象 |
</file>

