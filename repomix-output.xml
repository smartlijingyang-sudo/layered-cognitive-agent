<file path="lca/contracts/state.py">
 1: """第5.2节：State 与预算控制契约。"""
 2: from __future__ import annotations
 3: from dataclasses import dataclass, field
 4: from datetime import datetime, timezone
 5: from typing import Any
 6: from lca.contracts.enums import SnapshotReason
 7: from lca.contracts.ids import new_id
 8: from lca.contracts.lifecycle import TaskStatus
 9: from lca.contracts.team_progress import DelegationLedgerProtocol
10: from lca.contracts.types import Turn
11: def _now() -> datetime:
12:     return datetime.now(timezone.utc)
13: @dataclass
14: class Budget:
15:     """资源预算：步数 / token / 费用 / 墙钟四维约束。"""
16:     max_tokens: int | None = None
17:     max_cost_usd: float | None = None
18:     max_steps: int | None = None
19:     max_wall_clock_seconds: int | None = None
20:     used_tokens: int = 0
21:     used_cost_usd: float = 0.0
22:     used_steps: int = 0
23:     started_at: datetime = field(default_factory=_now)
24:     extra: dict[str, Any] = field(default_factory=dict)
25:     def exceeded(self) -> bool:
26:         """判定预算是否已超限（步数或墙钟）。"""
27:         if self.max_steps is not None and self.used_steps > self.max_steps:
28:             return True
29:         if self.max_wall_clock_seconds is not None:
30:             elapsed = (_now() - self.started_at).total_seconds()
31:             if elapsed > self.max_wall_clock_seconds:
32:                 return True
33:         return False
34: @dataclass
35: class StateSnapshot:
36:     """状态快照引用：用于 checkpoint / resume。"""
37:     snapshot_id: str
38:     step: int
39:     state_ref: str
40:     reason: SnapshotReason = SnapshotReason.PERIODIC
41:     created_at: datetime = field(default_factory=_now)
42: @dataclass
43: class TypedState:
44:     """Agent 单步认知循环的完整状态容器。"""
45:     trace_id: str
46:     task: str
47:     budget: Budget
48:     schema_version: str = "1.0"
49:     working_memory: dict[str, Any] = field(default_factory=dict)
50:     retrieved_context: list[Any] = field(default_factory=list)
51:     step: int = 0
52:     checkpoints: list[StateSnapshot] = field(default_factory=list)
53:     status: TaskStatus = TaskStatus.WORKING
54:     extra: dict[str, Any] = field(default_factory=dict)
55:     agent_role: str = ""
56:     delegated_by: str = ""
57:     team_progress: DelegationLedgerProtocol | None = None
58:     # 认知闭环历史：每步 Turn(decision, observation, reflection)
59:     history: list[Turn] = field(default_factory=list)
60:     # ── 框架运行槽位（一等字段，禁止再走 working_memory 裸字符串）──
61:     final_output: Any | None = None
62:     last_error: str | None = None
63:     active_template: str | None = None
64:     team_progress_text: str | None = None
65:     def snapshot(self, reason: SnapshotReason = SnapshotReason.PERIODIC) -> StateSnapshot:
66:         """创建并追加一条状态快照，返回引用。"""
67:         snap = StateSnapshot(
68:             snapshot_id=new_id("snap"),
69:             step=self.step,
70:             state_ref=f"mem://{self.trace_id}/{self.step}",
71:             reason=reason,
72:         )
73:         self.checkpoints.append(snap)
74:         return snap
</file>

<file path="lca/layer3_agent/team_orchestrator.py">
  1: """TeamOrchestrator —— 管理团队的组织形态与通信信道。
  2: L3 层职责：
  3:     作为团队级组合根，TeamOrchestrator 负责：
  4:     1. 通过 OrchestrationStrategyRegistry 解析编排策略（注册表模式，无 if/elif）
  5:     2. 注入共享记忆双路径（SharedStoreBindable + SharedMemoryTool）
  6:     3. 绑定 Supervisor 的 transport / roster 能力
  7:     所有策略分发委托给 OrchestrationStrategy 实现，L3 不含业务逻辑。
  8: """
  9: from __future__ import annotations
 10: from lca.contracts.protocols import (
 11:     AgentTransport,
 12:     OrchestrationContext,
 13:     OrchestrationStrategy,
 14:     SharedMemoryStore,
 15:     TeamEntrypoint,
 16:     ToolRegistry,
 17: )
 18: from lca.contracts.protocols.capabilities import (
 19:     ExposesComponents,
 20:     RosterAware,
 21:     SharedStoreBindable,
 22:     TransportBindable,
 23: )
 24: from lca.contracts.result import Result
 25: from lca.contracts.role_team import TeamConfig
 26: from lca.layer1_cognitive.memory.shared_memory_tool import SharedMemoryTool
 27: from lca.layer1_cognitive.memory.team_shared_memory import TeamSharedMemoryStore
 28: from lca.layer3_agent.orchestration_registry import get_global_orchestration_registry
 29: from lca.layer3_agent.simple_agent import SimpleAgent
 30: class TeamOrchestrator(TeamEntrypoint):
 31:     """
 32:     支持多种组织形态（hierarchical / sequential / parallel / graph / debate），
 33:     通过 OrchestrationStrategyRegistry 解析策略，不再 if/elif 硬编码。
 34:     共享记忆注入双路径（ADR-0016）：
 35:     1. SharedStoreBindable 协议绑定 —— MemorySystem 层级共享（CoALA）
 36:     2. SharedMemoryTool 注入成员 ToolRegistry —— 单体循环内经 use_tool 访问
 37:     """
 38:     def __init__(
 39:         self,
 40:         members: list[SimpleAgent],
 41:         config: TeamConfig,
 42:         supervisor: SimpleAgent | None = None,
 43:         transport: AgentTransport | None = None,
 44:         roster_desc: str = "",
 45:         strategy: OrchestrationStrategy | None = None,
 46:         team_id: str = "",
 47:     ) -> None:
 48:         self.members = members
 49:         self.config = config
 50:         self.supervisor = supervisor
 51:         self.transport = transport
 52:         self.roster_desc = roster_desc
 53:         self.team_id = team_id or f"team-{config.process}"
 54:         if strategy is not None:
 55:             self._strategy = strategy
 56:         else:
 57:             registry = get_global_orchestration_registry()
 58:             self._strategy = registry.resolve(config.process)
 59:         self._shared_store: SharedMemoryStore | None = None
 60:         if config.shared_memory_layers:
 61:             self._shared_store = TeamSharedMemoryStore(config.shared_memory_layers)
 62:             self._inject_shared_memory()
 63:         self._context = OrchestrationContext(
 64:             members=members,
 65:             config=config,
 66:             supervisor=supervisor,
 67:             transport=transport,
 68:             roster_desc=roster_desc,
 69:             team_id=self.team_id,
 70:             shared_memory=self._shared_store,
 71:         )
 72:         if supervisor is not None and transport is not None:
 73:             self._bind_supervisor_capabilities(supervisor, transport, roster_desc)
 74:     def _inject_shared_memory(self) -> None:
 75:         """将共享记忆 store + SharedMemoryTool 分发给每个成员。"""
 76:         if self._shared_store is None:
 77:             return
 78:         for member in self.members:
 79:             if isinstance(member.runtime, ExposesComponents):
 80:                 memory = member.runtime.memory
 81:                 if isinstance(memory, SharedStoreBindable):
 82:                     memory.bind_shared_store(self._shared_store)
 83:             self._register_shared_memory_tool(member)
 84:     @staticmethod
 85:     def _bind_supervisor_capabilities(
 86:         supervisor: SimpleAgent, transport: AgentTransport, roster_desc: str
 87:     ) -> None:
 88:         """在组合根完成 Supervisor 的 transport / roster 绑定。"""
 89:         if not isinstance(supervisor.runtime, ExposesComponents):
 90:             return
 91:         body = supervisor.runtime.body
 92:         if isinstance(body, TransportBindable):
 93:             body.bind_transport(transport)
 94:         brain = supervisor.runtime.brain
 95:         if isinstance(brain, RosterAware):
 96:             brain.set_team_roster(roster_desc)
 97:     def _register_shared_memory_tool(self, member: SimpleAgent) -> None:
 98:         """若成员 Body 暴露 tool_registry，注册绑定同一 store 的 SharedMemoryTool。"""
 99:         store = self._shared_store
100:         if store is None:
101:             return
102:         if not isinstance(member.runtime, ExposesComponents):
103:             return
104:         body = member.runtime.body
105:         registry: ToolRegistry | None = getattr(body, "tool_registry", None)
106:         if registry is None:
107:             return
108:         tool = SharedMemoryTool(store, team_id=self.team_id)
109:         registry.register(tool)
110:     async def run(
111:         self,
112:         objective: str | object,
113:         ctx: object | None = None,
114:     ) -> Result:
115:         """按 TeamConfig.process 类型选择组织形态执行：dispatch 语义由 strategy 承担。"""
116:         del ctx  # InvocationContext 预留
117:         from lca.contracts.message import AgentMessage, agent_message_as_text
118:         text = (
119:             agent_message_as_text(objective)
120:             if isinstance(objective, AgentMessage)
121:             else str(objective)
122:         )
123:         return await self._strategy.run(self._context, text)
</file>

<file path="lca/layer1_cognitive/body/simple_body.py">
 1: """SimpleBody —— 通过 ActionRegistry 分发行动。"""
 2: from __future__ import annotations
 3: from lca.contracts.action import ActionRegistryProtocol
 4: from lca.contracts.decision import Observation, StructuredDecision
 5: from lca.contracts.protocols import (
 6:     AgentTransport,
 7:     Body,
 8:     SafeExecutor,
 9:     ToolRegistry,
10:     TransportRegistryProtocol,
11: )
12: from lca.contracts.result import UnregisteredActionError
13: from lca.contracts.state import TypedState
14: from lca.layer0_infra.transport.transport_registry import TransportRegistry
15: from lca.layer1_cognitive.body.action_catalog import build_default_action_registry
16: from lca.layer1_cognitive.body.action_registry import ActionRegistry
17: class SimpleBody(Body):
18:     """Default ``Body`` implementation — dispatches actions via ``ActionRegistry``.
19:     Resolves the ``action_type`` from a ``StructuredDecision`` through the
20:     action registry and delegates execution to the registered
21:     ``ActionOperation``.  Supports flexible construction: callers may inject
22:     a pre-built ``ActionRegistry``, or provide ``ToolRegistry`` +
23:     ``SafeExecutor`` and let the body build the registry automatically.
24:     """
25:     def __init__(
26:         self,
27:         tool_registry: ToolRegistry | None = None,
28:         safe_executor: SafeExecutor | None = None,
29:         transport_registry: TransportRegistryProtocol | None = None,
30:         transport: AgentTransport | None = None,
31:         action_registry: ActionRegistryProtocol | None = None,
32:     ) -> None:
33:         if transport_registry is not None:
34:             self.transport_registry = transport_registry
35:         elif transport is not None:
36:             registry = TransportRegistry()
37:             registry.register(transport)
38:             self.transport_registry = registry
39:         else:
40:             self.transport_registry = TransportRegistry()
41:         if action_registry is not None:
42:             self.action_registry = action_registry
43:         elif tool_registry is not None and safe_executor is not None:
44:             self.action_registry = build_default_action_registry(
45:                 tool_registry, safe_executor, self.transport_registry
46:             )
47:         else:
48:             self.action_registry = ActionRegistry()
49:         self.tool_registry = tool_registry
50:         self.safe_executor = safe_executor
51:     def bind_transport(self, transport: AgentTransport) -> None:
52:         self.transport_registry.register(transport)
53:     async def act(self, decision: StructuredDecision, state: TypedState) -> Observation:
54:         handler = self.action_registry.get(decision.action_type)
55:         if handler is None:
56:             raise UnregisteredActionError(decision.action_type)
57:         result: Observation = await handler.execute(decision, state)
58:         return result
</file>

<file path="lca/layer4_app/api.py">
  1: """Developer-facing API surface.
  2: Import ``Agent`` and ``MultiAgentTeam`` from here (or from the package
  3: root ``lca``).  These are thin wrappers around the composition root
  4: (``assembly``) that handle default registration and provide a clean,
  5: minimal constructor signature.
  6: Example::
  7:     from lca import Agent, MultiAgentTeam
  8:     from lca.contracts.enums import TeamProcess
  9:     researcher = Agent(role="Researcher", goal="Find info", backstory="...",
 10:                        tools=[search_tool], llm=my_llm)
 11:     team = MultiAgentTeam(members=[researcher, writer], process=TeamProcess.SEQUENTIAL)
 12:     result = await team.run("Write a blog post about AI")
 13: """
 14: from __future__ import annotations
 15: from lca.contracts.budget import DEFAULT_MAX_STEPS, DEFAULT_MAX_WALL_CLOCK_SECONDS
 16: from lca.contracts.enums import TeamProcess
 17: from lca.contracts.protocols import (
 18:     BrainStrategy,
 19:     LLMAdapter,
 20:     MemorySystem,
 21:     Observability,
 22:     OrchestrationStrategy,
 23:     StateStore,
 24:     TeamEntrypoint,
 25:     Tool,
 26: )
 27: from lca.contracts.result import Result
 28: from lca.layer4_app.assembly import assemble_base_agent, assemble_team
 29: from lca.layer4_app.defaults import ensure_defaults
 30: class Agent:
 31:     """A single cognitive agent with role, goal, tools, and an LLM.
 32:     Construct with a role description, a list of tools, and an LLM adapter.
 33:     Call ``await agent.run(task)`` to execute a task through the cognitive
 34:     runtime loop.
 35:     Parameters
 36:     ----------
 37:     role:
 38:         Short role label (e.g. ``"Researcher"``).
 39:     goal:
 40:         What this agent is trying to achieve.
 41:     backstory:
 42:         Narrative context that shapes the agent's behaviour.
 43:     tools:
 44:         Tools available to this agent.
 45:     llm:
 46:         The LLM adapter used for reasoning.
 47:     max_steps:
 48:         Maximum reasoning steps per ``run()`` call.
 49:     max_wall_clock_seconds:
 50:         Hard wall-clock timeout; ``None`` for no limit.
 51:     memory:
 52:         ``"simple"`` (default) or a ``MemorySystem`` instance.
 53:     observability:
 54:         ``"console"`` (default), ``"jsonl_file"``, or an ``Observability`` instance.
 55:     state_store:
 56:         ``"memory"`` (default) or a ``StateStore`` instance.
 57:     brain_strategy:
 58:         ``"default"`` or a registered strategy name / ``BrainStrategy`` instance.
 59:     """
 60:     def __init__(
 61:         self,
 62:         role: str,
 63:         goal: str,
 64:         backstory: str,
 65:         tools: list[Tool],
 66:         llm: LLMAdapter,
 67:         max_steps: int = DEFAULT_MAX_STEPS,
 68:         max_wall_clock_seconds: int | None = DEFAULT_MAX_WALL_CLOCK_SECONDS,
 69:         memory: str | MemorySystem = "simple",
 70:         observability: str | Observability = "console",
 71:         state_store: str | StateStore = "memory",
 72:         brain_strategy: str | BrainStrategy = "default",
 73:     ) -> None:
 74:         ensure_defaults()
 75:         self._base_agent = assemble_base_agent(
 76:             role=role,
 77:             goal=goal,
 78:             backstory=backstory,
 79:             tools=tools,
 80:             llm=llm,
 81:             max_steps=max_steps,
 82:             max_wall_clock_seconds=max_wall_clock_seconds,
 83:             memory=memory,
 84:             observability=observability,
 85:             state_store=state_store,
 86:             brain_strategy=brain_strategy,
 87:         )
 88:     async def run(self, task: str) -> Result:
 89:         """Execute *task* and return the result."""
 90:         return await self._base_agent.execute(task)
 91: class MultiAgentTeam:
 92:     """A team of agents coordinated by a shared orchestration process.
 93:     Parameters
 94:     ----------
 95:     members:
 96:         The agents participating in this team.
 97:     process:
 98:         Orchestration pattern (hierarchical, sequential, parallel, etc.).
 99:     supervisor:
100:         Optional supervisor agent (required for ``HIERARCHICAL`` process).
101:     max_rounds:
102:         Maximum coordination rounds; ``None`` for unlimited.
103:     shared_memory_layers:
104:         Memory layers shared across team members.
105:     graph_definition_ref:
106:         Reference to a graph definition (for ``GRAPH`` process).
107:     strategy:
108:         Optional custom ``OrchestrationStrategy`` override.
109:     """
110:     def __init__(
111:         self,
112:         members: list[Agent],
113:         process: TeamProcess = TeamProcess.HIERARCHICAL,
114:         supervisor: Agent | None = None,
115:         max_rounds: int | None = None,
116:         shared_memory_layers: list[str] | None = None,
117:         graph_definition_ref: str | None = None,
118:         strategy: OrchestrationStrategy | None = None,
119:     ) -> None:
120:         ensure_defaults()
121:         base_members = [m._base_agent for m in members]
122:         base_supervisor = supervisor._base_agent if supervisor else None
123:         self._orchestrator: TeamEntrypoint = assemble_team(
124:             members=base_members,
125:             process=process,
126:             supervisor=base_supervisor,
127:             max_rounds=max_rounds,
128:             shared_memory_layers=shared_memory_layers,
129:             graph_definition_ref=graph_definition_ref,
130:             strategy=strategy,
131:         )
132:     async def run(self, objective: str) -> Result:
133:         """Run the team on *objective* and return the aggregated result."""
134:         return await self._orchestrator.run(objective)
</file>

<file path="lca/layer2_runtime/runtime_loop.py">
  1: """CognitiveRuntime —— 核心认知循环（ADR-0002）。
  2: Loop 只做编排：perceive → think → act → reflect → record → checkpoint → judge。
  3: 终止判定完全委托给 LoopJudge，业务逻辑零泄漏。
  4: L2 层职责：
  5:     将 Brain（认知）、Body（执行）、Memory（记忆）三大能力
  6:     串联为可中断、可恢复、可观测的闭环。所有横切关注点
  7:     （hook、checkpoint、error handling）在此层统一处理。
  8: """
  9: from __future__ import annotations
 10: import logging
 11: from lca.contracts.budget import DEFAULT_MAX_STEPS, create_budget
 12: from lca.contracts.enums import SnapshotReason
 13: from lca.contracts.ids import new_id
 14: from lca.contracts.lifecycle import TaskStatus
 15: from lca.contracts.loop_judge import LoopJudge, TerminationReason
 16: from lca.contracts.mechanisms import HookRegistry
 17: from lca.contracts.protocols import (
 18:     Body,
 19:     BrainStrategy,
 20:     CompletionPolicy,
 21:     MemorySystem,
 22:     Runtime,
 23:     StateStore,
 24:     SupportsCompletionGuard,
 25: )
 26: from lca.contracts.result import ApprovalPendingError, BudgetExceededError, Result
 27: from lca.contracts.state import StateSnapshot, TypedState
 28: from lca.contracts.team_progress import DelegationLedgerProtocol
 29: from lca.contracts.types import Turn
 30: _logger = logging.getLogger(__name__)
 31: class CognitiveRuntime(Runtime):
 32:     """核心认知循环实现（ADR-0002）。
 33:     将 Brain（认知）、Body（执行）、Memory（记忆）串联为
 34:     perceive → think → act → reflect 闭环。
 35:     终止判定完全委托给 LoopJudge，本类不含业务逻辑。
 36:     """
 37:     def __init__(
 38:         self,
 39:         brain: BrainStrategy,
 40:         body: Body,
 41:         memory: MemorySystem,
 42:         hooks: HookRegistry,
 43:         state_store: StateStore,
 44:         judge: LoopJudge,
 45:     ) -> None:
 46:         self.brain = brain
 47:         self.body = body
 48:         self.memory = memory
 49:         self.hooks = hooks
 50:         self.state_store = state_store
 51:         self.judge = judge
 52:     async def run(
 53:         self,
 54:         task: str,
 55:         max_steps: int = DEFAULT_MAX_STEPS,
 56:         max_wall_clock_seconds: int | None = None,
 57:         team_progress: DelegationLedgerProtocol | None = None,
 58:         **context: str,
 59:     ) -> Result:
 60:         state = TypedState(
 61:             trace_id=new_id("trace"),
 62:             task=task,
 63:             budget=create_budget(
 64:                 max_steps=max_steps, max_wall_clock_seconds=max_wall_clock_seconds
 65:             ),
 66:             agent_role=context.get("agent_role", ""),
 67:             delegated_by=context.get("delegated_by", ""),
 68:             team_progress=team_progress,
 69:         )
 70:         await self.hooks.trigger("on_start", state)
 71:         return await self._loop(state, max_steps)
 72:     async def resume(
 73:         self,
 74:         snapshot: StateSnapshot,
 75:         input: object | None = None,
 76:         max_steps: int = DEFAULT_MAX_STEPS,
 77:     ) -> Result:
 78:         state = await self.state_store.load(snapshot.state_ref)
 79:         state.status = TaskStatus.WORKING
 80:         if input is not None:
 81:             state.working_memory["resume_input"] = input
 82:         return await self._loop(state, max_steps)
 83:     async def _loop(self, state: TypedState, max_steps: int) -> Result:
 84:         """执行 perceive → think → act → reflect 认知主循环。
 85:         循环流程：
 86:             1. perceive — 感知环境、检索记忆
 87:             2. think    — 结构化决策
 88:             3. act      — 执行动作（工具调用 / 回复 / 委派）
 89:             4. reflect  — 反思结果、判定质量
 90:             5. record   — 追加 Turn 到历史、更新多层记忆
 91:             6. checkpoint — 持久化状态快照
 92:             7. judge    — 委托 LoopJudge 决定是否终止
 93:         """
 94:         decision = observation = reflection = None
 95:         for step in range(state.step, max_steps):
 96:             state.step = step
 97:             state.budget.used_steps = step
 98:             try:
 99:                 # ── Phase 1: Perceive ──
100:                 await self.hooks.trigger("pre_perceive", state)
101:                 state = await self.memory.perceive(state)
102:                 # ── Phase 2: Think ──
103:                 await self.hooks.trigger("pre_think", state)
104:                 decision = await self.brain.think(state)
105:                 await self.hooks.trigger("post_think", state, decision=decision)
106:                 # ── Phase 3: Act ──
107:                 await self.hooks.trigger("pre_act", state, decision=decision)
108:                 observation = await self.body.act(decision, state)
109:                 await self.hooks.trigger(
110:                     "post_act", state, decision=decision, observation=observation
111:                 )
112:                 # ── Phase 4: Reflect ──
113:                 await self.hooks.trigger("pre_reflect", state, observation=observation)
114:                 reflection = await self.brain.reflect(state, observation)
115:                 await self.hooks.trigger("post_reflect", state, reflection=reflection)
116:                 # ── Phase 5: Record ──
117:                 state.history.append(
118:                     Turn(decision=decision, observation=observation, reflection=reflection)
119:                 )
120:                 await self.memory.update(state, observation, reflection)
121:             except ApprovalPendingError:
122:                 # 人工审批中断：保存快照后暂停循环
123:                 await self._checkpoint(state, reason=SnapshotReason.PRE_APPROVAL)
124:                 state.status = TaskStatus.INPUT_REQUIRED
125:                 await self.hooks.trigger("on_pause", state)
126:                 return self._summarize(state)
127:             except Exception as err:
128:                 # 信任边界处的兜底捕获（L2 是 Agent 最外层循环）：
129:                 # 任何未预料的异常都不能向上传播导致进程崩溃，
130:                 # 而是标记 FAILED、持久化快照、通知 hook 后安全退出。
131:                 _logger.exception(
132:                     "CognitiveRuntime._loop: unexpected error at step %d",
133:                     step,
134:                     exc_info=err,
135:                 )
136:                 await self.hooks.trigger("on_error", state, error=err)
137:                 state.status = TaskStatus.FAILED
138:                 await self._checkpoint(state, reason=SnapshotReason.ON_ERROR)
139:                 state.last_error = str(err)
140:                 break
141:             # ── Phase 6: Checkpoint ──
142:             await self._checkpoint(state)
143:             # ── Phase 7: Judge ──
144:             signal = self.judge.judge(state, decision, observation, reflection)
145:             if signal.should_stop:
146:                 if signal.reason == TerminationReason.BUDGET_EXCEEDED:
147:                     await self.hooks.trigger("on_error", state, error=BudgetExceededError())
148:                 if signal.status is not None:
149:                     state.status = signal.status
150:                 break
151:         await self.hooks.trigger("on_complete", state)
152:         return self._summarize(state)
153:     async def _checkpoint(
154:         self, state: TypedState, reason: SnapshotReason = SnapshotReason.PERIODIC
155:     ) -> StateSnapshot:
156:         snap = state.snapshot(reason=reason)
157:         ref = await self.state_store.save(state)
158:         snap.state_ref = ref
159:         return snap
160:     def _summarize(self, state: TypedState) -> Result:
161:         final_ref = f"mem://{state.trace_id}/{state.step}"
162:         status = TaskStatus.COMPLETED if state.status == TaskStatus.WORKING else state.status
163:         return Result(
164:             trace_id=state.trace_id,
165:             status=status,
166:             output=state.final_output
167:             if isinstance(state.final_output, str) or state.final_output is None
168:             else str(state.final_output),
169:             final_state_ref=final_ref,
170:             total_steps=state.step + 1,
171:             budget_used=state.budget,
172:             error=state.last_error,
173:         )
174:     def install_completion_guard(self, policy: CompletionPolicy) -> None:
175:         """委托 Brain 自管内部评估管线，安装确定性收尾 guardrail。
176:         通过结构化 isinstance 探测能力，而非 hasattr 字符串猜测：
177:         不支持时必须显式报错，避免调用方以为 guardrail 已生效、
178:         实际却被静默跳过。
179:         """
180:         if not isinstance(self.brain, SupportsCompletionGuard):
181:             raise TypeError(
182:                 f"{type(self.brain).__name__} 未实现 SupportsCompletionGuard，"
183:                 "无法安装 completion guard"
184:             )
185:         self.brain.install_completion_guard(policy)
</file>

<file path="lca/layer4_app/defaults.py">
 1: """Built-in default registrations for the LCA framework.
 2: Idempotent — ``ensure_defaults()`` is safe to call multiple times; it only
