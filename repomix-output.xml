<file path="lca/contracts/mechanisms.py">
 1: """跨层机制契约 —— 不产生业务认知语义，只负责挂载 / 触发 / 查找。
 2: 边界判定（三者 vs 业务协议）：
 3: - EventBus / Hook / HookRegistry：观察与横切副作用，不改变决策语义
 4: - NamedRegistryProtocol / TransportRegistryProtocol：按名解析实现，无业务规则
 5: - 业务协议（Brain / Body / Memory / Runtime / Team…）→ 放 protocols/
 6: protocols/ 包内不应再定义 Registry / EventBus / Hook 类。
 7: """
 8: from __future__ import annotations
 9: from collections.abc import Awaitable, Callable
10: from typing import Any, Protocol, runtime_checkable
11: from lca.contracts.state import TypedState
12: @runtime_checkable
13: class EventBus(Protocol):
14:     """事件总线：发布 / 订阅异步事件。"""
15:     def emit(self, event_name: str, payload: dict[str, Any], trace_id: str) -> None: ...
16:     def subscribe(
17:         self, event_name: str, handler: Callable[[dict[str, Any]], Awaitable[None]]
18:     ) -> None: ...
19: @runtime_checkable
20: class Hook(Protocol):
21:     """生命周期钩子：接收事件名 + 当前状态，执行横切副作用。"""
22:     async def __call__(self, event_name: str, state: TypedState, **kwargs: Any) -> None: ...
23: @runtime_checkable
24: class HookRegistry(Protocol):
25:     """钩子注册表：按事件名注册和触发 Hook。"""
26:     def register(self, event_name: str, hook: Hook) -> None: ...
27:     async def trigger(self, event_name: str, state: TypedState, **kwargs: Any) -> None: ...
28: @runtime_checkable
29: class NamedRegistryProtocol(Protocol):
30:     """按名称注册和解析实体的通用注册表接口。
31:     具体实现（如 NamedRegistry）在 layer0 提供，
32:     消费方依赖此 Protocol 进行跨层解耦。
33:     """
34:     def register(self, name: str, impl: Any) -> None: ...
35:     def resolve(self, name: str) -> Any: ...
36:     def list(self) -> list[str]: ...
37:     def __contains__(self, name: str) -> bool: ...
