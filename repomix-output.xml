<file path="lca/contracts/loop_judge.py">
 1: """LoopJudge 协议 —— 循环终止的唯一裁判。
 2: 将原先散落在 _loop 方法内的 budget 检查、outcome 判定、状态转换
 3: 收敛为一个内聚的 Protocol。Loop 只消费 TerminationSignal，
 4: 不参与终止推导。
 5: """
 6: from __future__ import annotations
 7: from dataclasses import dataclass
 8: from enum import Enum
 9: from typing import Protocol, runtime_checkable
10: from lca.contracts.decision import Observation, Reflection, StructuredDecision
11: from lca.contracts.lifecycle import TaskStatus
12: from lca.contracts.state import TypedState
13: class TerminationReason(Enum):
14:     """循环终止原因。"""
15:     CONTINUE = "continue"
16:     BUDGET_EXCEEDED = "budget_exceeded"
17:     TASK_COMPLETED = "task_completed"
18:     ERROR = "error"
19: @dataclass(frozen=True)
20: class TerminationSignal:
21:     """LoopJudge 对单步的裁决 —— Loop 唯一需要的终止信号。"""
22:     should_stop: bool = False
23:     reason: TerminationReason = TerminationReason.CONTINUE
24:     final_output: str | None = None
25:     status: TaskStatus | None = None
26: @runtime_checkable
27: class LoopJudge(Protocol):
28:     """循环终止裁判：每步结束后被调用，返回是否终止及原因。"""
29:     def judge(
30:         self,
31:         state: TypedState,
32:         decision: StructuredDecision | None,
33:         observation: Observation | None,
34:         reflection: Reflection | None,
35:     ) -> TerminationSignal: ...
</file>

