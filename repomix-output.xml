<file path="lca/contracts/graph.py">
  1: """ExecutionGraph —— DAG 编排契约。
  2: 定义图执行的数据结构：GraphNode、GraphEdge、ExecutionGraph。
  3: 提供拓扑校验（防环检测）和拓扑排序能力。
  4: GraphStrategy 基于此数据结构执行工作流。
  5: """
  6: from __future__ import annotations
  7: from collections import deque
  8: from collections.abc import Callable
  9: from dataclasses import dataclass, field
 10: from enum import Enum
 11: from typing import Any
 12: from lca.contracts.state import TypedState
 13: class NodeType(str, Enum):
 14:     """DAG 节点类型。"""
 15:     ENTRY = "entry"
 16:     EXIT = "exit"
 17:     AGENT = "agent"
 18:     ROUTER = "router"
 19:     AGGREGATOR = "aggregator"
 20: class EdgeType(str, Enum):
 21:     """DAG 边类型。"""
 22:     FIXED = "fixed"
 23:     CONDITIONAL = "conditional"
 24:     PARALLEL = "parallel"
 25: ConditionFn = Callable[[TypedState], bool]
 26: class GraphValidationError(Exception):
 27:     """图拓扑校验失败。"""
 28: @dataclass
 29: class GraphNode:
 30:     """图中的单个节点：id + 类型 + 配置字典。"""
 31:     id: str
 32:     type: NodeType
 33:     config: dict[str, Any] = field(default_factory=dict)
 34: @dataclass
 35: class GraphEdge:
 36:     """节点间的有向边：source → target + 类型 + 可选条件函数。"""
 37:     source: str
 38:     target: str
 39:     type: EdgeType = EdgeType.FIXED
 40:     condition: ConditionFn | None = None
 41: @dataclass
 42: class ExecutionGraph:
 43:     """有向图工作流定义。
 44:     提供节点/边管理、拓扑校验（防环检测）、拓扑排序。
 45:     默认 allow_cycle=False，除非显式标记为 True。
 46:     """
 47:     nodes: dict[str, GraphNode] = field(default_factory=dict)
 48:     edges: list[GraphEdge] = field(default_factory=list)
 49:     allow_cycle: bool = False
 50:     def add_node(self, node: GraphNode) -> None:
 51:         self.nodes[node.id] = node
 52:     def add_edge(self, edge: GraphEdge) -> None:
 53:         self.edges.append(edge)
 54:     def outgoing(self, node_id: str) -> list[GraphEdge]:
 55:         return [e for e in self.edges if e.source == node_id]
 56:     def incoming(self, node_id: str) -> list[GraphEdge]:
 57:         return [e for e in self.edges if e.target == node_id]
 58:     def validate(self) -> None:
 59:         """校验图拓扑完整性。
 60:         检查项：
 61:         1. 必须有 entry 和 exit 节点
 62:         2. 所有边的 source/target 必须引用已注册的节点
 63:         3. 防环检测（除非 allow_cycle=True）
 64:         """
 65:         if not any(n.type == NodeType.ENTRY for n in self.nodes.values()):
 66:             raise GraphValidationError("图必须有至少一个 entry 节点")
 67:         if not any(n.type == NodeType.EXIT for n in self.nodes.values()):
 68:             raise GraphValidationError("图必须有至少一个 exit 节点")
 69:         for edge in self.edges:
 70:             if edge.source not in self.nodes:
 71:                 raise GraphValidationError(f"边的 source 节点不存在: {edge.source!r}")
 72:             if edge.target not in self.nodes:
 73:                 raise GraphValidationError(f"边的 target 节点不存在: {edge.target!r}")
 74:         if not self.allow_cycle:
 75:             self._check_acyclic()
 76:     def _check_acyclic(self) -> None:
 77:         """Kahn 算法防环检测。"""
 78:         in_degree: dict[str, int] = dict.fromkeys(self.nodes, 0)
 79:         for edge in self.edges:
 80:             in_degree[edge.target] += 1
 81:         queue = deque(nid for nid, deg in in_degree.items() if deg == 0)
 82:         visited_count = 0
 83:         while queue:
 84:             nid = queue.popleft()
 85:             visited_count += 1
 86:             for edge in self.edges:
 87:                 if edge.source == nid:
 88:                     in_degree[edge.target] -= 1
 89:                     if in_degree[edge.target] == 0:
 90:                         queue.append(edge.target)
 91:         if visited_count != len(self.nodes):
 92:             raise GraphValidationError("图包含环，但 allow_cycle=False")
 93:     def topological_order(self) -> list[str]:
 94:         """Kahn 算法拓扑排序。若图有环则返回的列表长度 < 节点数。"""
 95:         in_degree: dict[str, int] = dict.fromkeys(self.nodes, 0)
 96:         for edge in self.edges:
 97:             in_degree[edge.target] += 1
 98:         queue = deque(nid for nid, deg in in_degree.items() if deg == 0)
 99:         result: list[str] = []
100:         while queue:
101:             nid = queue.popleft()
102:             result.append(nid)
103:             for edge in self.edges:
104:                 if edge.source == nid:
105:                     in_degree[edge.target] -= 1
106:                     if in_degree[edge.target] == 0:
107:                         queue.append(edge.target)
108:         return result
</file>

<file path="lca/contracts/message.py">
 1: """Agent 消息模型 —— 多模态 Part 组合，文本为默认形态。"""
 2: from __future__ import annotations
 3: from dataclasses import dataclass
 4: from typing import Any
 5: from lca.contracts.enums import MessageKind, MessageRole
 6: @dataclass
 7: class TextPart:
 8:     """A plain-text content part within an ``AgentMessage``."""
 9:     text: str
10:     kind: MessageKind = MessageKind.TEXT
11: @dataclass
12: class DataPart:
13:     """A structured data (JSON-compatible) part within an ``AgentMessage``."""
14:     data: dict[str, Any]
15:     kind: MessageKind = MessageKind.DATA
16: @dataclass
17: class FileRefPart:
18:     """A file reference part (URI + optional MIME type) within an ``AgentMessage``."""
19:     uri: str
20:     mime_type: str | None = None
21:     kind: MessageKind = MessageKind.FILE
22: Part = TextPart | DataPart | FileRefPart
23: @dataclass
24: class AgentMessage:
25:     """Multi-modal message composed of one or more ``Part`` items.
26:     Supports text, structured data, and file references in a single message,
27:     following the A2A / multi-modal message convention.
28:     """
29:     parts: list[Part]
30:     role: MessageRole = MessageRole.USER
31: def agent_message_text(s: str) -> AgentMessage:
32:     """构造纯文本 AgentMessage（模块级工厂，符合 ADR-0015）。"""
33:     return AgentMessage(parts=[TextPart(text=s)])
34: def agent_message_as_text(msg: AgentMessage) -> str:
35:     """提取 AgentMessage 中的全部文本 Part。"""
36:     return "\n".join(p.text for p in msg.parts if isinstance(p, TextPart))
