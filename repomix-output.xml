<file path="lca/layer1_cognitive/event_bus.py">
 1: """SimpleEventBus —— 异步事件广播。"""
 2: from __future__ import annotations
 3: import asyncio
 4: from collections.abc import Awaitable, Callable
 5: from typing import Any
 6: from lca.contracts.protocols import EventBus
 7: class SimpleEventBus(EventBus):
 8:     """基于字典的简单事件总线。"""
 9:     def __init__(self) -> None:
10:         self._subs: dict[str, list[Callable[[Any], Awaitable[None]]]] = {}
11:         self._tasks: set[asyncio.Task[None]] = set()
12:     def emit(self, event_name: str, payload: Any, trace_id: str) -> None:
13:         event_payload = {
14:             "event_name": event_name,
15:             "payload": payload,
16:             "trace_id": trace_id,
17:         }
18:         for handler in self._subs.get(event_name, []):
19:             task = asyncio.create_task(self._invoke(handler, event_payload))
20:             self._tasks.add(task)
21:             task.add_done_callback(self._tasks.discard)
22:     async def _invoke(
23:         self, handler: Callable[[Any], Awaitable[None]], payload: dict[str, Any]
24:     ) -> None:
25:         await handler(payload)
26:     def subscribe(self, event_name: str, handler: Callable[[Any], Awaitable[None]]) -> None:
27:         self._subs.setdefault(event_name, []).append(handler)
</file>

