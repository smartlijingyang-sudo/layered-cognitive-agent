<file path="lca/contracts/protocols/capabilities.py">
 1: """可选能力协议（ADR-0017）。
 2: 把组件的可选绑定能力（transport / roster / shared_memory）
 3: 收敛成具名、runtime_checkable 的 Protocol，
 4: 使能力契约可被 mypy 校验、可被 grep 发现。
 5: 由组装层（TeamOrchestrator / Supervisor）通过 isinstance 检查直接调用，
 6: 不再经过 Runtime.configure() 间接分发。
 7: """
 8: from __future__ import annotations
 9: from typing import Protocol, runtime_checkable
10: from lca.contracts.mechanisms import HookRegistry
11: from lca.contracts.protocols.infra import AgentTransport
12: @runtime_checkable
13: class TransportBindable(Protocol):
14:     """Body 若支持委派/handoff，需实现此协议以接收 Transport。"""
15:     def bind_transport(self, transport: AgentTransport) -> None: ...
16: @runtime_checkable
17: class RosterAware(Protocol):
18:     """Brain 若需要感知队友花名册（hierarchical 编排），实现此协议。"""
19:     def set_team_roster(self, roster_desc: str) -> None: ...
20: @runtime_checkable
21: class SharedStoreBindable(Protocol):
