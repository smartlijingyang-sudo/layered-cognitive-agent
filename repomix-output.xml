<file path="lca/layer0_infra/transport/transport_registry.py">
 1: """TransportRegistry —— 按 protocol_name 路由 AgentTransport 实现。"""
 2: from __future__ import annotations
 3: from typing import Any
 4: from lca.contracts.decision import Observation
 5: from lca.contracts.protocols import AgentTransport
 6: from lca.layer0_infra.registry import NamedRegistry, RegistryKeyError
 7: class TransportNotFoundError(RegistryKeyError):
 8:     """TransportRegistry 中找不到指定 protocol 的传输实现。"""
 9:     def __init__(self, protocol: str, available: list[str]) -> None:
10:         self.protocol = protocol
11:         super().__init__(protocol, "传输协议", available)
12: class TransportRegistry(NamedRegistry[AgentTransport]):
13:     """按 protocol_name 注册和解析 AgentTransport 实现。
14:     注册时校验 key 与实现自报的 protocol_name 一致，
15:     杜绝"注册表写的是 a2a，塞进去的其实是别的实现"这种手滑。
16:     """
17:     _REGISTRY_KIND = "传输协议"
18:     def register(self, transport: AgentTransport) -> None:  # type: ignore[override]
19:         """注册一个 AgentTransport，key 取自 transport.protocol_name。"""
20:         self._entries[transport.protocol_name] = transport
21:     def register_as(self, protocol_name: str, transport: AgentTransport) -> None:
22:         """显式指定 key 注册，校验 key 与 transport.protocol_name 一致。"""
23:         if transport.protocol_name != protocol_name:
24:             raise ValueError(
25:                 f"protocol_name 不匹配: 注册 key={protocol_name!r}, "
26:                 f"但 transport 自报 protocol_name={transport.protocol_name!r}"
27:             )
28:         self._entries[protocol_name] = transport
29:     def resolve(self, protocol: str) -> AgentTransport:
30:         """按 protocol 名解析传输实现，找不到抛 TransportNotFoundError。"""
31:         try:
32:             return super().resolve(protocol)
33:         except RegistryKeyError as exc:
34:             raise TransportNotFoundError(exc.key, exc.available) from None
35:     def list_protocols(self) -> list[str]:
36:         return self.list()
37: class UnimplementedTransport(AgentTransport):
38:     """占位传输实现，所有方法抛 NotImplementedError。
39:     用于在 TransportRegistry 中注册尚未实现的协议（如 a2a/mcp），
40:     使得路由能到达这里并给出明确报错，而不是静默降级。
41:     """
42:     def __init__(self, protocol_name: str, tracking_issue: str = "") -> None:
43:         self.protocol_name = protocol_name
44:         self._tracking_issue = tracking_issue
45:     @property
46:     def _error_message(self) -> str:
47:         msg = f"协议 {self.protocol_name!r} 的传输实现尚未完成"
48:         if self._tracking_issue:
49:             msg += f" (tracked in {self._tracking_issue})"
50:         return msg
51:     async def send_task(self, agent_card: Any, subtask: str, context_refs: list[str]) -> str:
52:         raise NotImplementedError(self._error_message)
53:     async def poll_status(self, task_id: str) -> str:
54:         raise NotImplementedError(self._error_message)
55:     async def receive_result(self, task_id: str) -> Observation:
56:         raise NotImplementedError(self._error_message)
</file>

<file path="lca/layer1_cognitive/body/action_handlers.py">
  1: """内置 ActionHandler 实现 —— 从 SimpleBody 提取的独立策略类。
  2: L3 执行调度层：每种 action_type 对应一个独立 Handler，
  3: 彼此零依赖、零共享可变状态。新增行动能力 = 新增一个 Handler + 一条注册。
  4: """
  5: from __future__ import annotations
  6: import asyncio
  7: import uuid
  8: from lca.contracts.action import ActionHandler, ActionRegistry
  9: from lca.contracts.decision import Observation, StructuredDecision
 10: from lca.contracts.protocols import (
 11:     AgentTransport,
 12:     SafeExecutor,
 13:     ToolRegistry,
 14:     TransportRegistryProtocol,
 15: )
 16: from lca.contracts.result import ToolExecutionError
 17: from lca.contracts.role_team import CacheConfig, RetryPolicy
 18: from lca.contracts.state import TypedState, _current_delegator
 19: _POLL_INTERVAL_S = 0.05
 20: _DEFAULT_DELEGATE_TIMEOUT_S = 30.0
 21: def _new_id(prefix: str) -> str:
 22:     return f"{prefix}_{uuid.uuid4().hex[:12]}"
 23: class RespondHandler(ActionHandler):
 24:     """处理 respond 动作：直接返回文本响应。"""
 25:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 26:         return Observation(
 27:             observation_id=_new_id("obs"),
 28:             success=True,
 29:             payload=decision.response_text,
 30:         )
 31: class UseToolHandler(ActionHandler):
 32:     """处理 use_tool 动作：查找工具 → 权限校验 → 执行。"""
 33:     def __init__(self, tool_registry: ToolRegistry, safe_executor: SafeExecutor) -> None:
 34:         self._tool_registry = tool_registry
 35:         self._safe_executor = safe_executor
 36:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 37:         if not decision.tool_calls:
 38:             raise ToolExecutionError("use_tool 需要至少一个 tool_call")
 39:         tc = decision.tool_calls[0]
 40:         tool = self._tool_registry.get(tc.tool_name)
 41:         if tool is None:
 42:             raise ToolExecutionError(f"未注册工具: {tc.tool_name}")
 43:         return await self._safe_executor.execute(tool, tc.arguments, RetryPolicy(), CacheConfig())
 44: class DelegateHandler(ActionHandler):
 45:     """处理 delegate 动作：阻塞式委派，等待目标 Agent 返回结果。"""
 46:     def __init__(self, transport_registry: TransportRegistryProtocol) -> None:
 47:         self._transport_registry = transport_registry
 48:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 49:         transport, task_id = await self._send_to_transport(decision, state)
 50:         timeout_s = (
 51:             (spec.deadline.timestamp() - asyncio.get_event_loop().time())
 52:             if (spec := decision.delegate_to) and spec.deadline
 53:             else _DEFAULT_DELEGATE_TIMEOUT_S
 54:         )
 55:         elapsed = 0.0
 56:         while (await transport.poll_status(task_id)) == "working":
 57:             if elapsed >= timeout_s:
 58:                 return Observation(
 59:                     observation_id=_new_id("obs"),
 60:                     success=False,
 61:                     payload=None,
 62:                     error=f"delegate 超时: task_id={task_id}",
 63:                     extra={"task_id": task_id},
 64:                 )
 65:             await asyncio.sleep(_POLL_INTERVAL_S)
 66:             elapsed += _POLL_INTERVAL_S
 67:         observation = await transport.receive_result(task_id)
 68:         observation.extra["task_id"] = task_id
 69:         return observation
 70:     async def _send_to_transport(
 71:         self, decision: StructuredDecision, state: TypedState
 72:     ) -> tuple[AgentTransport, str]:
 73:         spec = decision.delegate_to
 74:         if spec is None:
 75:             raise ToolExecutionError(f"{decision.action_type} 动作缺少 delegate_to 规格")
 76:         transport = self._transport_registry.resolve(spec.protocol)
 77:         agent_card = spec.target_agent_card or spec.target_agent_id or spec.target_role
 78:         _current_delegator.set(state.agent_role)
 79:         task_id = await transport.send_task(agent_card, spec.subtask, spec.context_refs)
 80:         return transport, task_id
 81: class HandoffHandler(ActionHandler):
 82:     """处理 handoff 动作：非阻塞控制权移交，发完即返回。"""
 83:     def __init__(self, transport_registry: TransportRegistryProtocol) -> None:
 84:         self._transport_registry = transport_registry
 85:     async def execute(self, decision: StructuredDecision, state: TypedState) -> Observation:
 86:         spec = decision.delegate_to
 87:         if spec is None:
 88:             raise ToolExecutionError("handoff 动作缺少 delegate_to 规格")
 89:         transport = self._transport_registry.resolve(spec.protocol)
 90:         agent_card = spec.target_agent_card or spec.target_agent_id or spec.target_role
 91:         _current_delegator.set(state.agent_role)
 92:         task_id = await transport.send_task(agent_card, spec.subtask, spec.context_refs)
 93:         return Observation(
 94:             observation_id=_new_id("obs"),
 95:             success=True,
 96:             payload=f"handoff to {spec.target_role or spec.target_agent_id}",
 97:             extra={"task_id": task_id, "handoff": True},
 98:         )
 99: def build_default_action_registry(
100:     tool_registry: ToolRegistry,
101:     safe_executor: SafeExecutor,
102:     transport_registry: TransportRegistryProtocol,
103: ) -> ActionRegistry:
104:     """构建包含所有内置 ActionHandler 的默认注册表。"""
105:     registry = ActionRegistry()
106:     registry.register("respond", RespondHandler())
107:     registry.register("use_tool", UseToolHandler(tool_registry, safe_executor))
108:     registry.register("delegate", DelegateHandler(transport_registry))
109:     registry.register("handoff", HandoffHandler(transport_registry))
110:     return registry
</file>

