 5: from lca.contracts.protocols import BrainStrategy, LLMAdapter
 6: from lca.contracts.role_team import RoleProfile
 7: from lca.layer1_cognitive.body.action_catalog import format_allowed_actions_desc
 8: from lca.layer1_cognitive.brain.candidate_evaluation_pipeline import (
 9:     SimpleCandidateEvaluationPipeline,
