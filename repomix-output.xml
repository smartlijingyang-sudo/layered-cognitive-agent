168:     """编排策略接口：每种 process 模式对应一个实现。"""
169:     async def run(self, context: OrchestrationContext, objective: str) -> Result: ...
170: @runtime_checkable
171: class CompletionPolicy(Protocol):
172:     """确定性收尾策略：校验候选决策是否可被采纳。
173:     与 TaskCoordinator 平级，但职责不同：
174:     TaskCoordinator 在多候选间仲裁，CompletionPolicy 对仲裁结果做 guardrail。
175:     """
176:     async def enforce(
177:         self,
178:         state: TypedState,
179:         decision: StructuredDecision,
180:     ) -> StructuredDecision: ...
181: @runtime_checkable
182: class Synthesizer(Protocol):
183:     """MoA 聚合器：将多个并行候选结果合成为一个最终结果。
184:     用于 ParallelStrategy 的 fan-in 阶段。不同实现对应不同聚合策略：
185:     - ConcatSynthesizer: 简单拼接所有候选输出
186:     - LLMSynthesizer: 调用 LLM 做 Layer-2 提炼（MoA 核心）
187:     - BestOfSynthesizer: 复用 TaskCoordinator.arbitrate 选优
188:     """
189:     async def synthesize(self, objective: str, candidates: list[Result]) -> Result: ...
190: @runtime_checkable
191: class RegistryProtocol(Protocol):
192:     """按名称注册和解析实体的通用注册表接口。
193:     具体实现（如 NamedRegistry）提供泛型基类继承，
194:     消费方依赖此 Protocol 进行跨层解耦。
195:     """
196:     def register(self, name: str, impl: Any) -> None: ...
197:     def resolve(self, name: str) -> Any: ...
198:     def list(self) -> list[str]: ...
199:     def __contains__(self, name: str) -> bool: ...
200: @runtime_checkable
201: class TransportRegistryProtocol(Protocol):
202:     """传输注册表接口：按 protocol_name 路由 AgentTransport 实现。
203:     具体实现（如 TransportRegistry）在 layer0 提供，
204:     layer1 Body 和 ActionHandler 依赖此 Protocol 进行解耦。
205:     """
206:     def register(self, transport: AgentTransport) -> None: ...
207:     def resolve(self, protocol_name: str) -> AgentTransport: ...
208:     def list_protocols(self) -> list[str]: ...
209: @dataclass
210: class StepOutcome:
211:     """单步结果判定——Loop 唯一需要的"是否继续 + 如何收尾"信号。
212:     由 StepOutcomePolicy 产出，Loop 只消费结果，不参与推导。
213:     """
214:     should_stop: bool = False
215:     final_output: str | None = None
216:     status: str | None = None
217: @runtime_checkable
218: class StepOutcomePolicy(Protocol):
219:     """单步结果判定策略：决定 Loop 是否继续、最终输出和状态。
220:     取代散落在 _loop / _should_stop 中的判断逻辑，
221:     将"降级成功"、"respond 完成"、"handoff 结束"等业务判定
222:     封装到可替换的策略实现中。
223:     """
224:     def resolve(
225:         self,
226:         state: TypedState,
227:         decision: StructuredDecision | None,
228:         observation: Observation | None,
229:         reflection: Reflection | None,
230:     ) -> StepOutcome: ...
231:     def resolve_budget_exceeded(
232:         self,
233:         observation: Observation | None,
234:         state: TypedState,
235:     ) -> StepOutcome: ...
236: @runtime_checkable
237: class FallbackHandler(Protocol):
238:     """未知 action_type 的降级处理器接口。
239:     由 Body 装饰器（FallbackDecoratedBody）在捕获到
240:     ToolExecutionError("未注册的 action_type") 时调用，
241:     将降级语义从 Loop / Runtime 层下沉到 Body 层。
242:     """
243:     async def handle(
244:         self,
245:         decision: StructuredDecision,
246:         state: TypedState,
247:         action_registry: ActionRegistryProtocol | None = None,
248:     ) -> Observation: ...
