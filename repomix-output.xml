<file path="lca/layer2_runtime/runtime_loop.py">
  1: """CognitiveRuntime —— 核心认知循环（~25行 Loop，ADR-0002）。
  2: Loop 本体只负责六步骨架串联 + 循环控制，
  3: 所有业务判定（降级、输出提取、终止条件）通过 StepOutcomePolicy 注入，
  4: 所有可观测事件通过 Hook 发布，Loop 不直接持有 EventBus。
  5: """
  6: from __future__ import annotations
  7: import uuid
  8: from typing import Any
  9: from lca.contracts.budget import create_budget
 10: from lca.contracts.decision import Observation, Reflection, StructuredDecision
 11: from lca.contracts.protocols import (
 12:     Body,
 13:     BrainStrategy,
 14:     HookRegistry,
 15:     MemorySystem,
 16:     Runtime,
 17:     StateStore,
 18:     StepOutcome,
 19:     StepOutcomePolicy,
 20: )
 21: from lca.contracts.result import (
 22:     ApprovalPendingError,
 23:     BudgetExceededError,
 24:     Result,
 25: )
 26: from lca.contracts.state import StateSnapshot, TypedState
 27: def _new_id(prefix: str) -> str:
 28:     return f"{prefix}-{uuid.uuid4().hex[:12]}"
 29: class CognitiveRuntime(Runtime):
 30:     """
 31:     核心 Loop: perceive -> think -> act -> observe -> reflect -> update
 32:     所有 Prompt 模板、压缩策略、Strategy 切换、错误恢复、人工审批
 33:     全部通过 Hook 与 Strategy 注册进来，Loop 本体保持稳定不变。
 34:     """
 35:     def __init__(
 36:         self,
 37:         brain: BrainStrategy,
 38:         body: Body,
 39:         memory: MemorySystem,
 40:         hooks: HookRegistry,
 41:         state_store: StateStore,
 42:         outcome_policy: StepOutcomePolicy | None = None,
 43:     ):
 44:         self.brain = brain
 45:         self.body = body
 46:         self.memory = memory
 47:         self.hooks = hooks
 48:         self.state_store = state_store
 49:         self.outcome_policy = outcome_policy or _DefaultOutcomePolicy()
 50:         self._team_progress: Any = None
 51:     def configure(self, **capabilities: Any) -> None:
 52:         if "transport" in capabilities and hasattr(self.body, "bind_transport"):
 53:             self.body.bind_transport(capabilities["transport"])
 54:         if "team_roster" in capabilities and hasattr(self.brain, "set_team_roster"):
 55:             self.brain.set_team_roster(capabilities["team_roster"])
 56:         if "shared_memory" in capabilities and hasattr(self.memory, "bind_shared_store"):
 57:             self.memory.bind_shared_store(capabilities["shared_memory"])
 58:         if "team_progress" in capabilities:
 59:             self._team_progress = capabilities["team_progress"]
 60:     async def run(
 61:         self,
 62:         task: str,
 63:         max_steps: int = 10,
 64:         max_wall_clock_seconds: int | None = None,
 65:         **context: str,
 66:     ) -> Result:
 67:         state = TypedState(
 68:             trace_id=_new_id("trace"),
 69:             task=task,
 70:             budget=create_budget(
 71:                 max_steps=max_steps,
 72:                 max_wall_clock_seconds=max_wall_clock_seconds,
 73:             ),
 74:             agent_role=context.get("agent_role", ""),
 75:             delegated_by=context.get("delegated_by", ""),
 76:             team_progress=self._team_progress,
 77:         )
 78:         await self.hooks.trigger("on_start", state)
 79:         return await self._loop(state, max_steps)
 80:     async def resume(self, snapshot: StateSnapshot, max_steps: int = 10) -> Result:
 81:         """从任意 Checkpoint 恢复——挂起等待人工审批/暂停的任务由此续跑。"""
 82:         state = await self.state_store.load(snapshot.state_ref)
 83:         state.status = "running"
 84:         return await self._loop(state, max_steps)
 85:     async def _loop(self, state: TypedState, max_steps: int) -> Result:
 86:         decision: StructuredDecision | None = None
 87:         observation: Observation | None = None
 88:         reflection: Reflection | None = None
 89:         for step in range(state.step, max_steps):
 90:             state.step = step
 91:             state.budget.used_steps = step
 92:             try:
 93:                 await self.hooks.trigger("pre_perceive", state)
 94:                 state = await self.memory.perceive_and_retrieve(state)
 95:                 await self.hooks.trigger("pre_think", state)
 96:                 decision = await self.brain.think(state)
 97:                 await self.hooks.trigger("post_think", state, decision=decision)
 98:                 await self.hooks.trigger("pre_act", state, decision=decision)
 99:                 observation = await self.body.act(decision, state)
100:                 await self.hooks.trigger(
101:                     "post_act", state, decision=decision, observation=observation
102:                 )
103:                 await self.hooks.trigger("pre_reflect", state, observation=observation)
104:                 reflection = await self.brain.reflect(state, observation)
105:                 await self.hooks.trigger("post_reflect", state, reflection=reflection)
106:                 await self.memory.update_multi_level(state, observation, reflection)
107:             except ApprovalPendingError:
108:                 self._checkpoint(state, reason="pre_approval")
109:                 state.status = "waiting_human"
110:                 await self.hooks.trigger("on_pause", state)
111:                 return self._summarize(state)
112:             except Exception as err:
113:                 await self.hooks.trigger("on_error", state, error=err)
114:                 state.status = "failed"
115:                 self._checkpoint(state, reason="on_error")
116:                 state.extra["error"] = str(err)
117:                 break
118:             self._checkpoint(state)
119:             outcome = self.outcome_policy.resolve(state, decision, observation, reflection)
120:             if outcome.final_output is not None:
121:                 state.working_memory["final_output"] = outcome.final_output
122:             if state.budget.exceeded():
123:                 await self.hooks.trigger("on_error", state, error=BudgetExceededError())
124:                 budget_outcome = self.outcome_policy.resolve_budget_exceeded(observation, state)
125:                 if budget_outcome.final_output is not None:
126:                     state.working_memory["final_output"] = budget_outcome.final_output
127:                 state.status = budget_outcome.status or state.status  # type: ignore[assignment]
128:                 break
129:             if outcome.should_stop:
130:                 state.status = outcome.status or "completed"  # type: ignore[assignment]
131:                 break
132:         await self.hooks.trigger("on_complete", state)
133:         return self._summarize(state)
134:     def _checkpoint(self, state: TypedState, reason: str = "periodic") -> None:
135:         state.checkpoints.append(state.snapshot(reason=reason))
136:     def _summarize(self, state: TypedState) -> Result:
137:         final_ref = f"mem://{state.trace_id}/{state.step}"
138:         status = "completed" if state.status == "running" else state.status
139:         return Result(
140:             trace_id=state.trace_id,
141:             status=status,
142:             output=state.working_memory.get("final_output"),
143:             final_state_ref=final_ref,
144:             total_steps=state.step + 1,
145:             budget_used=state.budget,
146:             error=state.extra.get("error"),
147:         )
148: class _DefaultOutcomePolicy(StepOutcomePolicy):
149:     """最小内置 OutcomePolicy——无终止条件，仅用于 Loop 在无外部注入时的兜底。
150:     实际部署时应使用 layer2_runtime.outcome_policies.DefaultStepOutcomePolicy，
151:     它包含 respond/handoff/降级 等完整业务判定。
152:     """
153:     def resolve(
154:         self,
155:         state: TypedState,
156:         decision: StructuredDecision | None,
157:         observation: Observation | None,
158:         reflection: Reflection | None,
159:     ) -> StepOutcome:
160:         return StepOutcome()
161:     def resolve_budget_exceeded(
162:         self,
163:         observation: Observation | None,
164:         state: TypedState,
165:     ) -> StepOutcome:
166:         last_ok = observation is not None and getattr(observation, "success", False)
167:         return StepOutcome(should_stop=True, status="completed" if last_ok else "failed")
</file>

<file path="lca/layer1_cognitive/body/simple_body.py">
 1: """SimpleBody —— L1 Body 实现，通过 ActionRegistry 分发行动。"""
 2: from __future__ import annotations
 3: from lca.contracts.action import ActionRegistry, ActionRegistryProtocol
 4: from lca.contracts.decision import Observation, StructuredDecision
 5: from lca.contracts.protocols import (
 6:     AgentTransport,
 7:     Body,
 8:     SafeExecutor,
 9:     ToolRegistry,
10:     TransportRegistryProtocol,
11: )
12: from lca.contracts.result import ToolExecutionError
13: from lca.contracts.state import TypedState
14: from lca.layer0_infra.transport.transport_registry import TransportRegistry
15: from lca.layer1_cognitive.body.action_handlers import build_default_action_registry
16: class SimpleBody(Body):
17:     """通过 ActionRegistry 路由 action_type 到对应 Handler。
18:     新增行动能力只需注册新 Handler 到 ActionRegistry，
19:     SimpleBody 本身不感知具体 action_type 集合。
20:     """
21:     def __init__(
22:         self,
23:         tool_registry: ToolRegistry | None = None,
24:         safe_executor: SafeExecutor | None = None,
25:         transport_registry: TransportRegistryProtocol | None = None,
26:         transport: AgentTransport | None = None,
27:         action_registry: ActionRegistryProtocol | None = None,
28:     ):
29:         # 解析 transport_registry
30:         if transport_registry is not None:
31:             self.transport_registry = transport_registry
32:         elif transport is not None:
33:             registry = TransportRegistry()
34:             registry.register(transport)
35:             self.transport_registry = registry
36:         else:
37:             self.transport_registry = TransportRegistry()
38:         # 解析 action_registry：优先使用显式传入的；否则从依赖构建默认注册表
39:         if action_registry is not None:
40:             self.action_registry = action_registry
41:         elif tool_registry is not None and safe_executor is not None:
42:             self.action_registry = build_default_action_registry(
43:                 tool_registry, safe_executor, self.transport_registry
44:             )
45:         else:
46:             self.action_registry = ActionRegistry()
47:         # 保留引用供外部访问（向后兼容）
48:         self.tool_registry = tool_registry
49:         self.safe_executor = safe_executor
50:     def bind_transport(self, transport: AgentTransport) -> None:
51:         self.transport_registry.register(transport)
52:     async def act(self, decision: StructuredDecision, state: TypedState) -> Observation:
53:         handler = self.action_registry.resolve(decision.action_type)
54:         if handler is None:
55:             raise ToolExecutionError(f"未注册的 action_type: {decision.action_type}")
56:         result: Observation = await handler.execute(decision, state)
57:         return result
