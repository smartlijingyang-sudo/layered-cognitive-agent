<file path="lca/layer0_infra/llm_adapter/openai_compat.py">
 1: """通用 OpenAI 兼容 LLM 适配器。
 2: 支持所有 OpenAI chat/completions 兼容 API：
 3:   - OpenAI (api.openai.com)
 4:   - DashScope / 通义千问 (dashscope.aliyuncs.com/compatible-mode)
 5:   - Ollama, vLLM, LiteLLM 等
 6: 只需配置环境变量即可切换，代码无需改动：
 7:   LLM_API_KEY   API Key
 8:   LLM_BASE_URL  基地址（默认 https://api.openai.com/v1）
 9:   LLM_MODEL     模型名（默认 gpt-4.1）
10: 依赖: pip install "openai>=1.40"
11: """
12: from __future__ import annotations
13: import os
14: from collections.abc import AsyncIterator
15: from typing import Any
16: from lca.contracts.protocols import LLMAdapter
17: _DEFAULT_TEMPERATURE = 0.7
18: _DEFAULT_MAX_TOKENS = 2048
19: class OpenAICompatAdapter(LLMAdapter):
20:     """实现 LLMAdapter 协议。走 client.chat.completions.create()。"""
21:     name = "openai-compat"
22:     _client: Any
23:     def __init__(
24:         self,
25:         model: str | None = None,
26:         *,
27:         api_key: str | None = None,
28:         base_url: str | None = None,
29:     ) -> None:
30:         from openai import AsyncOpenAI
31:         self._model = model or os.getenv("LLM_MODEL", "gpt-4.1")
32:         self._client = AsyncOpenAI(
33:             api_key=api_key or os.getenv("LLM_API_KEY", ""),
34:             base_url=base_url or os.getenv("LLM_BASE_URL", "https://api.openai.com/v1"),
35:         )
36:     async def complete(self, prompt: str, **kwargs: Any) -> str:
37:         response = await self._client.chat.completions.create(
38:             model=kwargs.pop("model", self._model),
39:             messages=[{"role": "user", "content": prompt}],
40:             temperature=kwargs.pop("temperature", _DEFAULT_TEMPERATURE),
41:             max_tokens=kwargs.pop("max_tokens", _DEFAULT_MAX_TOKENS),
42:             **kwargs,
43:         )
44:         return response.choices[0].message.content or ""
45:     async def stream(self, prompt: str, **kwargs: Any) -> AsyncIterator[str]:
46:         raise NotImplementedError("流式输出暂未实现")
47:         yield ""  # pragma: no cover
</file>

<file path="lca/layer0_infra/transport/transport_registry.py">
 1: """TransportRegistry —— 按 protocol_name 路由 AgentTransport 实现。"""
 2: from __future__ import annotations
 3: from lca.contracts.decision import AgentCard, Observation
 4: from lca.contracts.protocols import AgentTransport
 5: from lca.layer0_infra.component_registry import NamedRegistry, RegistryKeyError
 6: class TransportNotFoundError(RegistryKeyError):
 7:     """TransportRegistry 中找不到指定 protocol 的传输实现。"""
 8:     def __init__(self, protocol: str, available: list[str]) -> None:
 9:         self.protocol = protocol
10:         super().__init__(protocol, "传输协议", available)
11: class TransportRegistry(NamedRegistry[AgentTransport]):
12:     """按 protocol_name 注册和解析 AgentTransport 实现。
13:     注册时校验 key 与实现自报的 protocol_name 一致，
14:     杜绝"注册表写的是 a2a，塞进去的其实是别的实现"这种手滑。
15:     """
16:     _REGISTRY_KIND = "传输协议"
17:     # 收窄参数：接受 AgentTransport 而非基类的 (name, impl) 对
18:     def register(self, transport: AgentTransport) -> None:  # type: ignore[override]
19:         """注册一个 AgentTransport，key 取自 transport.protocol_name。"""
20:         self._entries[transport.protocol_name] = transport
21:     def register_as(self, protocol_name: str, transport: AgentTransport) -> None:
22:         """显式指定 key 注册，校验 key 与 transport.protocol_name 一致。"""
23:         if transport.protocol_name != protocol_name:
24:             raise ValueError(
25:                 f"protocol_name 不匹配: 注册 key={protocol_name!r}, "
26:                 f"但 transport 自报 protocol_name={transport.protocol_name!r}"
27:             )
28:         self._entries[protocol_name] = transport
29:     def resolve(self, protocol: str) -> AgentTransport:
30:         """按 protocol 名解析传输实现，找不到抛 TransportNotFoundError。"""
31:         try:
32:             return super().resolve(protocol)
33:         except RegistryKeyError as exc:
34:             raise TransportNotFoundError(exc.key, exc.available) from None
35:     def list_protocols(self) -> list[str]:
36:         return self.list()
37: class UnimplementedTransport(AgentTransport):
38:     """占位传输实现，所有方法抛 NotImplementedError。
39:     用于在 TransportRegistry 中注册尚未实现的协议（如 a2a/mcp），
40:     使得路由能到达这里并给出明确报错，而不是静默降级。
41:     """
42:     def __init__(self, protocol_name: str, tracking_issue: str = "") -> None:
43:         self.protocol_name = protocol_name
44:         self._tracking_issue = tracking_issue
45:     @property
46:     def _error_message(self) -> str:
47:         msg = f"协议 {self.protocol_name!r} 的传输实现尚未完成"
48:         if self._tracking_issue:
49:             msg += f" (tracked in {self._tracking_issue})"
50:         return msg
51:     async def send_task(
52:         self, agent_card: AgentCard | str, subtask: str, context_refs: list[str]
53:     ) -> str:
54:         raise NotImplementedError(self._error_message)
55:     async def poll_status(self, task_id: str) -> str:
56:         raise NotImplementedError(self._error_message)
57:     async def receive_result(self, task_id: str) -> Observation:
58:         raise NotImplementedError(self._error_message)
59:     async def wait_result(self, task_id: str, timeout_s: float | None = None) -> Observation:
60:         raise NotImplementedError(self._error_message)
</file>

<file path="lca/layer1_cognitive/brain/critic.py">
 1: """Critic —— 事后自省与纠偏。"""
 2: from __future__ import annotations
 3: from typing import Any
 4: from lca.contracts.decision import Observation, Reflection
 5: from lca.contracts.enums import ReflectionVerdict
 6: from lca.contracts.ids import new_id
 7: from lca.contracts.protocols import Critic
 8: from lca.contracts.semantic_keys import (
 9:     FAILURE_KIND,
10:     FAILURE_KIND_EXECUTION,
11:     FAILURE_KIND_TRANSIENT,
12:     FAILURE_KIND_VALIDATION,
13: )
14: from lca.contracts.state import TypedState
15: _FAILURE_KIND_HINT: dict[str, str] = {
16:     FAILURE_KIND_VALIDATION: "参数不合法，请重复同一动作，须修正参数后重新调用",
17:     FAILURE_KIND_EXECUTION: "工具执行失败",
18:     FAILURE_KIND_TRANSIENT: "瞬时性错误，可重试",
19: }
20: class SimpleCritic(Critic):
21:     """基于执行结果生成反思。"""
22:     async def critique(self, state: TypedState, observation: Observation) -> Reflection:
23:         if observation.success:
24:             return Reflection(
25:                 reflection_id=new_id("refl"),
26:                 verdict=ReflectionVerdict.ON_TRACK,
27:                 lesson=f"步骤{state.step}成功完成" if observation.payload is not None else None,
28:             )
29:         failure_kind = self._extract_failure_kind(observation)
30:         hint = _FAILURE_KIND_HINT.get(failure_kind, "步骤失败")
31:         lesson = f"步骤{state.step}失败({hint}): {observation.error}"
32:         return Reflection(
33:             reflection_id=new_id("refl"),
34:             verdict=ReflectionVerdict.NEEDS_CORRECTION,
35:             lesson=lesson,
36:             extra={FAILURE_KIND: failure_kind},
37:         )
38:     @staticmethod
39:     def _extract_failure_kind(observation: Observation) -> str:
40:         kind: Any = observation.extra.get(FAILURE_KIND)
41:         if isinstance(kind, str) and kind in _FAILURE_KIND_HINT:
42:             return kind
43:         return FAILURE_KIND_EXECUTION
</file>

