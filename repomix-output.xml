<file path="lca/layer1_cognitive/brain/completion_policies/roster_coverage.py">
 1: """RosterCoveragePolicy —— 基于角色覆盖率的确定性收尾策略。
 2: 纯规则判断，不调用 LLM，零额外延迟、零不确定性。
 3: 当 LLM 候选 respond 但尚有必需角色未被咨询时，强制改写为 delegate。
 4: """
 5: from __future__ import annotations
 6: import uuid
 7: from lca.contracts.decision import DelegationSpec, StructuredDecision
 8: from lca.contracts.protocols import CompletionPolicy
 9: from lca.contracts.state import TypedState
10: def _infer_subtask(task: str, role: str) -> str:
11:     """从任务描述和目标角色推断子任务文本。"""
12:     return f"请从 {role} 的视角，针对以下任务提供你的专业意见：{task}"
13: class RosterCoveragePolicy(CompletionPolicy):
14:     """确保所有必需角色都被咨询后才允许 respond。
15:     判定逻辑：
16:     - 候选 action_type == "respond" 且 ledger 未全覆盖 → 改写为 delegate
17:     - 其它情况 → 原样放行
18:     """
19:     async def enforce(
20:         self,
21:         state: TypedState,
22:         decision: StructuredDecision,
23:     ) -> StructuredDecision:
24:         ledger = state.team_progress
25:         if ledger is None:
26:             return decision
27:         if decision.action_type == "respond" and not ledger.is_covered():
28:             pending = ledger.pending_roles()
29:             next_role = pending[0]
30:             return StructuredDecision(
31:                 decision_id=f"dec_{uuid.uuid4().hex[:12]}",
32:                 action_type="delegate",
33:                 delegate_to=DelegationSpec(
34:                     target_role=next_role,
35:                     subtask=_infer_subtask(state.task, next_role),
36:                 ),
37:                 rationale="[框架强制] 尚有必需角色未咨询，禁止提前收尾",
38:                 confidence=1.0,
39:             )
40:         return decision
</file>

