 1: """Load built-in prompt templates from the prompts/ package directory."""
 2: from __future__ import annotations
 3: import importlib.resources
 4: def load_builtin_prompt(name: str) -> str:
 5:     """Load a built-in prompt template by name.
 6:     Args:
 7:         name: Template filename without extension (e.g. ``"react_prompt"``).
 8:     Returns:
 9:         The template text as a string.
10:     Raises:
11:         FileNotFoundError: If the named template does not exist.
12:     """
13:     try:
14:         return (
15:             importlib.resources.files("lca.layer1_cognitive.brain.prompts")
16:             .joinpath(f"{name}.md")
17:             .read_text(encoding="utf-8")
18:         )
19:     except (FileNotFoundError, TypeError) as exc:
20:         available = [
21:             p.name
22:             for p in importlib.resources.files("lca.layer1_cognitive.brain.prompts").iterdir()
23:             if p.name.endswith(".md")
24:         ]
25:         msg = f"Built-in prompt template {name!r} not found. Available templates: {available}"
26:         raise FileNotFoundError(msg) from exc
