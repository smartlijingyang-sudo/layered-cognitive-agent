<file path="lca/layer0_infra/observability/console_observability.py">
 1: """控制台可观测性实现 —— 把每个跨层调用输出为结构化 TraceSpan。"""
 2: from __future__ import annotations
 3: import structlog
 4: from lca.contracts.observability import TraceSpan
 5: from lca.contracts.protocols import Observability
 6: _log = structlog.get_logger("lca.console")
 7: class ConsoleObservability(Observability):
 8:     """默认可观测实现：结构化 TraceSpan 输出到控制台。"""
 9:     def emit_span(self, span: TraceSpan) -> None:
10:         dur = None
11:         if span.ended_at:
12:             dur = int((span.ended_at - span.started_at).total_seconds() * 1000)
13:         # 构建角色链信息
14:         role = span.attributes.get("agent_role", "")
15:         delegated_by = span.attributes.get("delegated_by", "")
16:         role_prefix = (
17:             f"[{delegated_by} → {role}] " if delegated_by else f"[{role}] " if role else ""
18:         )
19:         # 构建关键属性摘要
20:         key_attrs = {}
21:         for k in ("action_type", "delegate_to", "tool_name", "task_preview"):
22:             v = span.attributes.get(k)
23:             if v is not None:
24:                 key_attrs[k] = v
25:         attrs_str = str(key_attrs) if key_attrs else str(span.attributes)
26:         _log.info(
27:             "trace_span",
28:             span_name=span.name,
29:             role_prefix=role_prefix,
30:             status=span.status,
31:             dur_ms=dur,
32:             attrs=attrs_str,
33:         )
</file>

<file path="lca/layer0_infra/tools/calculator_tool.py">
 1: """安全求值四则运算表达式工具（AST 白名单，杜绝任意代码执行）。"""
 2: from __future__ import annotations
 3: import ast
 4: import operator
 5: import time
 6: from typing import Any, ClassVar
 7: from lca.contracts.budget import DEFAULT_TOOL_TIMEOUT_S
 8: from lca.contracts.decision import Observation
 9: from lca.contracts.ids import new_id
10: from lca.contracts.protocols import Tool
11: from lca.contracts.result import ToolInputError
12: from lca.contracts.semantic_keys import FAILURE_KIND, FAILURE_KIND_VALIDATION
13: class CalculatorTool(Tool):
14:     """实现 Tool 的示例工具。"""
15:     name = "calculator"
16:     is_idempotent = True
17:     default_timeout_s = DEFAULT_TOOL_TIMEOUT_S
18:     _OPS: ClassVar[dict[type, Any]] = {
19:         ast.Add: operator.add,
20:         ast.Sub: operator.sub,
21:         ast.Mult: operator.mul,
22:         ast.Div: operator.truediv,
23:         ast.FloorDiv: operator.floordiv,
24:         ast.Mod: operator.mod,
25:         ast.Pow: operator.pow,
26:         ast.USub: operator.neg,
27:         ast.UAdd: operator.pos,
28:     }
29:     def validate(self, args: dict[str, Any]) -> str | None:
30:         expr = args.get("expression")
31:         if expr is None or (isinstance(expr, str) and not expr.strip()):
32:             return "表达式不能为空，请提供纯算术表达式，如 '26 * 1.5 + 3'"
33:         if not isinstance(expr, str):
34:             return f"表达式必须是字符串，实际类型: {type(expr).__name__}"
35:         return None
36:     async def execute(self, args: dict[str, Any]) -> Observation:
37:         start = time.monotonic()
38:         expr = args.get("expression", "")
39:         try:
40:             value = self._safe_eval(expr)
41:             latency_ms = int((time.monotonic() - start) * 1000)
42:             return Observation(
43:                 observation_id=new_id("obs"),
44:                 success=True,
45:                 payload=value,
46:                 latency_ms=latency_ms,
47:             )
48:         except ToolInputError as e:
49:             latency_ms = int((time.monotonic() - start) * 1000)
50:             return Observation(
51:                 observation_id=new_id("obs"),
52:                 success=False,
53:                 payload=None,
54:                 error=str(e),
55:                 latency_ms=latency_ms,
56:                 extra={FAILURE_KIND: FAILURE_KIND_VALIDATION},
57:             )
58:         except (ValueError, OverflowError, ZeroDivisionError) as e:
59:             latency_ms = int((time.monotonic() - start) * 1000)
60:             return Observation(
61:                 observation_id=new_id("obs"),
62:                 success=False,
63:                 payload=None,
64:                 error=str(e),
65:                 latency_ms=latency_ms,
66:             )
67:     def _safe_eval(self, expr: str) -> float:
68:         try:
69:             tree = ast.parse(expr, mode="eval")
70:         except SyntaxError as e:
71:             raise ToolInputError(
72:                 f"表达式语法错误 '{expr}': {e}。请提供纯算术表达式，如 '26 * 1.5 + 3'"
73:             ) from e
74:         return self._eval_node(tree.body)
75:     def _eval_node(self, node: ast.AST) -> float:
76:         if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
77:             return float(node.value)
78:         if isinstance(node, ast.BinOp) and type(node.op) in self._OPS:
79:             return float(
80:                 self._OPS[type(node.op)](self._eval_node(node.left), self._eval_node(node.right))
81:             )
82:         if isinstance(node, ast.UnaryOp) and type(node.op) in self._OPS:
83:             return float(self._OPS[type(node.op)](self._eval_node(node.operand)))
84:         node_type = type(node).__name__
85:         supported = "+, -, *, /, //, %, ** 和一元 +/-"
86:         raise ValueError(
87:             f"不支持的运算 '{node_type}'。calculator 仅支持: {supported}。"
88:             f"问题片段: {ast.dump(node)}"
89:         )
</file>

<file path="lca/layer1_cognitive/body/action_catalog.py">
  1: """ActionCatalog —— action_type 的单一事实源。"""
  2: from __future__ import annotations
  3: from collections.abc import Sequence
  4: from dataclasses import dataclass
  5: from lca.contracts.action import ActionOperation
  6: from lca.contracts.enums import ActionType
  7: from lca.contracts.protocols import SafeExecutor, ToolRegistry, TransportRegistryProtocol
  8: from lca.layer1_cognitive.body.action_handlers import (
  9:     DelegateOperation,
 10:     HandoffOperation,
 11:     RespondOperation,
 12:     UseToolOperation,
 13: )
 14: from lca.layer1_cognitive.body.action_registry import ActionRegistry
 15: @dataclass(frozen=True)
 16: class ActionSpec:
 17:     """Declarative specification of a built-in action type.
 18:     Defines the canonical name, human-readable description, accepted aliases,
 19:     and whether the action is directly executable (vs. a control signal like
 20:     ``stop`` or ``ask_human``).
 21:     """
 22:     name: str
 23:     description: str
 24:     aliases: tuple[str, ...] = ()
 25:     executable: bool = True
 26: BUILTIN_ACTION_SPECS: tuple[ActionSpec, ...] = (
 27:     ActionSpec(
 28:         name=ActionType.RESPOND,
 29:         description="respond — 直接回复用户（需附带 response_text）",
 30:         aliases=("response", "answer", "reply"),
 31:     ),
 32:     ActionSpec(
 33:         name=ActionType.USE_TOOL,
 34:         description="use_tool — 调用工具（需附带 tool_name / arguments）",
 35:         aliases=("tool_call", "call_tool"),
 36:     ),
 37:     ActionSpec(
 38:         name=ActionType.DELEGATE,
 39:         description="delegate — 将子任务委派给队友（需附带 target_role / subtask）",
 40:         aliases=("delegation",),
 41:     ),
 42:     ActionSpec(
 43:         name=ActionType.HANDOFF,
 44:         description="handoff — 非阻塞移交控制权给其他 Agent",
 45:         aliases=("hand_off",),
 46:     ),
 47:     ActionSpec(name=ActionType.STOP, description="stop — 任务已完成", aliases=(), executable=False),
 48:     ActionSpec(
 49:         name=ActionType.ASK_HUMAN,
 50:         description="ask_human — 请求人工介入",
 51:         aliases=("hitl",),
 52:         executable=False,
 53:     ),
 54: )
 55: def build_action_alias_map(specs: Sequence[ActionSpec] = BUILTIN_ACTION_SPECS) -> dict[str, str]:
 56:     mapping: dict[str, str] = {}
 57:     for spec in specs:
 58:         mapping[spec.name] = spec.name
 59:         for alias in spec.aliases:
 60:             mapping[alias] = spec.name
 61:     return mapping
 62: def format_allowed_actions_desc(
 63:     allowed_names: Sequence[str],
 64:     specs: Sequence[ActionSpec] = BUILTIN_ACTION_SPECS,
 65: ) -> str:
 66:     by_name = {s.name: s for s in specs}
 67:     lines: list[str] = []
 68:     for i, name in enumerate(allowed_names):
 69:         spec = by_name.get(name)
 70:         desc = spec.description if spec is not None else f"{name} — (自定义)"
 71:         lines.append(f"{i + 1}. {desc}")
 72:     return "\n".join(lines)
 73: def _operation_for(
 74:     name: str,
 75:     tool_registry: ToolRegistry,
 76:     safe_executor: SafeExecutor,
 77:     transport_registry: TransportRegistryProtocol,
 78: ) -> ActionOperation | None:
 79:     if name == ActionType.RESPOND:
 80:         return RespondOperation()
 81:     if name == ActionType.USE_TOOL:
 82:         return UseToolOperation(tool_registry, safe_executor)
 83:     if name == ActionType.DELEGATE:
 84:         return DelegateOperation(transport_registry)
 85:     if name == ActionType.HANDOFF:
 86:         return HandoffOperation(transport_registry)
 87:     return None
 88: def build_default_action_registry(
 89:     tool_registry: ToolRegistry,
 90:     safe_executor: SafeExecutor,
 91:     transport_registry: TransportRegistryProtocol,
 92: ) -> ActionRegistry:
 93:     registry = ActionRegistry()
 94:     for spec in BUILTIN_ACTION_SPECS:
 95:         if not spec.executable:
 96:             continue
 97:         op = _operation_for(spec.name, tool_registry, safe_executor, transport_registry)
 98:         if op is None:
 99:             continue
100:         registry.register(spec.name, op)
101:         for alias in spec.aliases:
102:             registry.register_alias(alias, spec.name)
103:     return registry
</file>

<file path="lca/layer1_cognitive/body/action_registry.py">
 1: """ActionRegistry —— ActionOperation 的默认注册表实现（ADR-0015/0016）。
 2: 从 contracts 迁出：contracts 只保留 Protocol，具体路由表属于 L1 embodiment。
 3: """
 4: from __future__ import annotations
 5: from lca.contracts.action import ActionOperation, ActionRegistryProtocol
 6: from lca.layer0_infra.component_registry import NamedRegistry
 7: class ActionRegistry(NamedRegistry[ActionOperation], ActionRegistryProtocol):
 8:     """Action 能力注册表 —— 开闭原则的标准落地。
 9:     无状态纯路由，不承载业务逻辑、不承载降级逻辑。
10:     降级属于韧性层职责，由 FallbackActionPolicy 独立处理。
11:     """
12:     _REGISTRY_KIND = "action_type"
13:     def __init__(self) -> None:
14:         NamedRegistry.__init__(self)
15:         self._aliases: dict[str, str] = {}
16:     def register(self, action_type: str, handler: ActionOperation) -> None:
17:         """注册一个 ActionOperation 到指定 action_type。"""
18:         self._entries[action_type] = handler
19:         self._aliases[action_type] = action_type
20:     def get(self, action_type: str) -> ActionOperation | None:
21:         return self._entries.get(action_type)
22:     def register_alias(self, alias: str, canonical: str) -> None:
23:         """注册别名映射：alias → canonical action_type。"""
24:         self._aliases[alias] = canonical
25:     def allowed_action_types(self) -> list[str]:
26:         """返回所有已注册的 action_type 集合 —— Prompt / Schema / 测试的唯一事实来源。"""
27:         return sorted(self._entries.keys())
28:     def is_registered(self, action_type: str) -> bool:
29:         """判断 action_type 是否已注册。"""
30:         return action_type in self._entries
31:     def normalize_alias(self, name: str) -> str:
32:         """将 LLM 输出的别名归一化为规范 action_type；未识别则原样返回。"""
33:         return self._aliases.get(name, name)
</file>

