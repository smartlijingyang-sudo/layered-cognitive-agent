# syntax=docker/dockerfile:1
# Onlyboxes terminalExec runtime — LCA + LobeHub cloud-sandbox baseline.
#
# Aligns with LobeHub native: terminalExec is the sole execution channel; this
# image must carry the same Python data/doc stack as deploy/onlyboxes/requirements-python.txt.
#
# Build:
#   ./deploy/onlyboxes/build-terminal-image.sh
# Worker env:
#   WORKER_TERMINAL_EXEC_DOCKER_IMAGE=onlyboxes-terminal-local:lca
FROM coolfan1024/onlyboxes-runtime:default

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

USER root

# CJK fonts for reportlab / matplotlib Chinese PDF & plots.
# Agent must NOT curl fonts at runtime — terminalExec image is the sole channel.
COPY requirements-python.txt /tmp/requirements-python.txt
COPY matplotlibrc /etc/matplotlibrc
ENV MATPLOTLIBRC=/etc/matplotlibrc

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    (sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null \
        || sed -i 's|deb.debian.org|mirrors.tuna.tsinghua.edu.cn|g' /etc/apt/sources.list 2>/dev/null \
        || true) \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        fontconfig \
        fonts-wqy-zenhei \
        fonts-noto-cjk \
    && fc-cache -f \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --no-cache-dir -r /tmp/requirements-python.txt \
    && rm -f /tmp/requirements-python.txt \
    && python3 -c "import reportlab,pandas,numpy,openpyxl; print('terminal-runtime ok')" \
    && test -f /usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc \
        -o -f /usr/share/fonts/truetype/wqy/wqy-zenhei.ttc \
    && echo 'cjk-font: ok'

WORKDIR /workspace
