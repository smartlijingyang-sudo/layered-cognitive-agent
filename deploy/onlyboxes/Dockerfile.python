# syntax=docker/dockerfile:1
# Onlyboxes pythonExec worker image — data/analysis baseline for LCA run_sandbox_code.
# Build: ./deploy/onlyboxes/build-python-image.sh
# Tag expected by systemd worker: onlyboxes-python-local:3.11
FROM python:3.11-slim

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_SYSTEM_PYTHON=1

# Runtime libs for matplotlib / pillow; CJK fonts for Chinese plot labels.
# Without a CJK face, matplotlib warns: Glyph N missing from font(s) DejaVu Sans.
# Cache mount avoids re-downloading .debs when this layer is invalidated.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        libfreetype6 \
        libpng16-16t64 \
        libjpeg62-turbo \
        fontconfig \
        fonts-wqy-zenhei \
        fonts-noto-cjk \
        pandoc \
        ffmpeg \
        curl \
        wget \
        unzip \
        jq \
    && fc-cache -f

COPY requirements-python.txt /tmp/requirements-python.txt
COPY matplotlibrc /etc/matplotlibrc

ENV MATPLOTLIBRC=/etc/matplotlibrc

# pip install uv (small wheel, no cache needed)
RUN pip install --no-cache-dir "uv>=0.6"

# Cache mount: uv reuses downloaded wheels across builds — biggest speedup.
# Without --no-cache, uv stores wheels in its cache dir (mounted), not the layer.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv pip install --system \
        -r /tmp/requirements-python.txt \
    && rm -f /tmp/requirements-python.txt \
    && python -c "import pandas,numpy,openpyxl,matplotlib,PIL,scipy,requests,seaborn,tabulate,xlsxwriter,docx,reportlab,fpdf,pypdf,sklearn,plotly,cv2,xlrd,yaml,toml,dotenv,markitdown,fastapi,uvicorn,pydantic,aiofiles,anyio,pytest; print('ok', pandas.__version__)" \
    && python -c "from matplotlib import font_manager as fm; names={f.name for f in fm.fontManager.ttflist}; assert any('WenQuanYi' in n or 'Noto Sans CJK' in n for n in names), sorted(n for n in names if 'DejaVu' not in n)[:20]; print('cjk-font: ok')"

WORKDIR /workspace
CMD ["python3"]
