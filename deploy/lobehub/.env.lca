# LobeHub v2.2.13 + LCA gateway 本地开发环境
# 复制到 lobehub-ui/.env（start_lobehub_stack.sh 会自动复制）

# ── LCA gateway（所有 provider 统一走 LCA 后端）──
NEXT_PUBLIC_LCA_TOKEN=lca-local
OPENAI_API_KEY=lca-local
OPENAI_PROXY_URL=http://127.0.0.1:8765/v1
ENABLED_OPENAI=1

# ── 标题等小请求仍走 OpenAI 兼容面；聊天选择器只暴露 solo/team/auto ──
QWEN_API_KEY=lca-local
QWEN_PROXY_URL=http://127.0.0.1:8765/v1
ENABLED_QWEN=0
DEFAULT_AGENT_CONFIG=model=solo;provider=openai;chatConfig.searchMode=off

# ── 数据库（lobe-postgres @ host:25432，与 LCA 独立副本共存时可复用）──
DATABASE_URL=postgresql://postgres:lobe_local_pg@localhost:25432/lobechat
DATABASE_DRIVER=node
LOBE_DB_NAME=lobechat
POSTGRES_PASSWORD=lobe_local_pg

# ── S3（lobe-minio @ host:19000）──
S3_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY_ID=lobe
S3_SECRET_ACCESS_KEY=lobe_secret
S3_BUCKET=lobe
S3_ENABLE_PATH_STYLE=1
S3_SET_ACL=0
RUSTFS_ACCESS_KEY=lobe
RUSTFS_SECRET_KEY=lobe_secret
RUSTFS_LOBE_BUCKET=lobe

# ── Redis（lobehub-ui/docker-compose/dev redis @ 6379）──
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=lobechat
REDIS_TLS=0
LLM_VISION_IMAGE_USE_BASE64=1

# ── 开发（局域网访问时改 LOBE_LAN_IP 或 VITE_DEV_HOST）──
APP_URL=http://10.36.6.252:3010
VITE_DEV_HOST=10.36.6.252
# 浏览器下载产物用的网关公开基址（勿用 0.0.0.0；与 VITE_DEV_HOST 对齐）
# start_lobehub_stack / lca gateway 会读 GATEWAY_PUBLIC_URL 或本文件的 VITE_DEV_HOST
# LCA_GATEWAY_PUBLIC_URL=http://10.36.6.252:8765
SSRF_ALLOW_PRIVATE_IP_ADDRESS=1
KEY_VAULTS_SECRET=<generate-with-openssl-rand-base64-32>

# ── 本机 host sidecar（Presence + Console，无登录）──
# start_lobehub_stack.sh 会启动 `python -m host`，连上后右下角可开终端
LCA_HOST_TOKEN=lca-local-host
LCA_HOST_DEVICE_ID=local-host
# Host runtime SSOT: lca.layer0_infra.sandbox.host_settings.HostRuntimeSettings
# 未设 ROOT 时物理目录 = /home/${LCA_HOST_USER}
LCA_HOST_USER=sandbox-user
# LCA_HOST_ROOT=

# ── 本地开发：无登录 / 无 session（LCA 补丁 LocalDevAuth + 服务端 mock user）──
# 前端：不调用 /api/auth/get-session（见 layout/AuthProvider/LocalDevAuth）
# 后端：trpc / webapi 以 MOCK_DEV_USER_ID 身份处理请求（仅 NODE_ENV=development）
ENABLE_MOCK_DEV_USER=1
NEXT_PUBLIC_ENABLE_MOCK_DEV_USER=1
MOCK_DEV_USER_ID=local-dev-user
NEXT_PUBLIC_MOCK_DEV_USER_ID=local-dev-user
# 不要设置 AUTH_SECRET — 避免启用 Better Auth 登录面

# ── 云端沙箱（Onlyboxes，替代 market 默认值）──
SANDBOX_PROVIDER=onlyboxes
ONLYBOXES_BASE_URL=http://127.0.0.1:8089
ONLYBOXES_JIT_SIGNING_KEY=dev-onlyboxes-jit-key-change-me-in-production

# ── LCA LobeHub bridge：聊天附件 ingest（MinIO presigned URL → LCA FileStore）──
LCA_LOBEHUB_INGEST_URL_ALLOWLIST=localhost,127.0.0.1,lobe-minio,10.36.6.252
LCA_LOBEHUB_INGEST_ALLOW_PRIVATE_IP=1
LCA_LOBEHUB_INGEST_CACHE_PATH=traces/lobehub_ingest_cache.json

# ── Upstash QStash（queue / task scheduler / Upstash Workflow 触发时必需）──
# 本地开发若不使用 AGENT_RUNTIME_MODE=queue 或 workflow 路径，可整段留空。
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="<your-qstash-token>"
QSTASH_CURRENT_SIGNING_KEY="<your-qstash-current-signing-key>"
QSTASH_NEXT_SIGNING_KEY="<your-qstash-next-signing-key>"
