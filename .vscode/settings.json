{
  // Interpreter: point at the venv folder so Windows (.venv/Scripts) and
  // Unix (.venv/bin) both resolve. Editor typecheck is off (Pylance via
  // [tool.pyright]=off; mypy extension via ignorePatterns). CLI: lca-ops typecheck.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.languageServer": "Pylance",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": [
    "${workspaceFolder}",
    "${workspaceFolder}/vendor/cordis/src",
    "${workspaceFolder}/vendor/cosmokit/src",
    "${workspaceFolder}/vendor/schemastery/src"
  ],
  "python.analysis.typeCheckingMode": "off",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/site-packages",
    "**/vendor",
    "**/tests",
    "**/lobehub-ui"
  ],
  "basedpyright.disableLanguageServices": true,
  "basedpyright.disableOrganizeImports": true,
  "basedpyright.analysis.typeCheckingMode": "off",
  "basedpyright.analysis.diagnosticMode": "openFilesOnly",
  // ms-python.mypy-type-checker has no "enabled" flag; ignorePatterns is the kill switch.
  // Keep CLI mypy via `lca-ops typecheck`. Uninstall the extension if Problems still fill.
  "mypy-type-checker.ignorePatterns": ["**"],
  "mypy-type-checker.preferDaemon": false,
  "mypy-type-checker.showNotifications": "off",
  "mypy-type-checker.severity": {
    "error": "Hint",
    "note": "Hint"
  },
  "mypy.enabled": false,
  "python.linting.enabled": false,
  "python.linting.mypyEnabled": false,
  "ruff.lint.enable": false,
  "eslint.enable": false,
  "javascript.validate.enable": false,
  "typescript.validate.enable": false,
  "problems.decorations.enabled": false,
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.ruff": "explicit",
    "source.organizeImports.ruff": "explicit"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "editor.rulers": [100]
}
