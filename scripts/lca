#!/usr/bin/env bash
# LCA 统一 CLI — 智能启动/重启/统计/管理
#
# 用法:
#   lca up          智能启动（仅重启有变更的组件）
#   lca down        停止所有服务
#   lca restart     强制全量重启
#   lca status      查看服务状态
#   lca stats       项目统计（代码量/测试/覆盖率）
#   lca sync        同步 LobeHub 源码 + 打补丁
#   lca logs [svc]  查看日志（gateway/lobehub）
#   lca patch       仅重新应用 LobeHub 补丁
#   lca gateway     仅启动/重启 gateway
#   lca infra       仅启动基础设施（docker compose）
#
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE_DIR="${ROOT}/.lca-state"
LOBE_DIR="${ROOT}/lobehub-ui"
RUN_DIR="${ROOT}/.lobehub-stack"
GATEWAY_PORT="${GATEWAY_PORT:-8765}"
LOBE_DEV_PORT="${LOBE_DEV_PORT:-3010}"
LOBEHUB_RELEASE="${LOBEHUB_RELEASE:-v2.2.13}"
GATEWAY_PID="${RUN_DIR}/gateway.pid"
GATEWAY_LOG="${RUN_DIR}/gateway.log"
LOBE_DEV_PID="${RUN_DIR}/lobehub-dev.pid"
LOBE_ENV="${ROOT}/deploy/lobehub/.env.lca"
NEXT_DEV_LOCK="${LOBE_DIR}/.next/dev/lock"

mkdir -p "${STATE_DIR}" "${RUN_DIR}"

# ── 输出 ──────────────────────────────────────────────────────────────
_c() { printf '\033[%sm%s\033[0m' "$1" "$2"; }
_green() { _c 32 "$1"; }
_yellow() { _c 33 "$1"; }
_red() { _c 31 "$1"; }
_cyan() { _c 36 "$1"; }
_bold() { _c 1 "$1"; }

log()  { printf '%s %s\n' "$(_cyan '[lca]')" "$*"; }
ok()   { printf '%s %s\n' "$(_green '✓')" "$*"; }
warn() { printf '%s %s\n' "$(_yellow '⚠')" "$*"; }
err()  { printf '%s %s\n' "$(_red '✗')" "$*" >&2; }
skip() { printf '%s %s\n' "$(_yellow '·')" "$*"; }

# ── 进程管理 ──────────────────────────────────────────────────────────
_kill_tree() {
  local pid="$1" sig="${2:-TERM}"
  [[ -z "${pid}" || ! "${pid}" =~ ^[0-9]+$ ]] && return 0
  kill -0 "${pid}" 2>/dev/null || return 0
  local child
  for child in $(pgrep -P "${pid}" 2>/dev/null || true); do
    _kill_tree "${child}" "${sig}"
  done
  kill "-${sig}" "${pid}" 2>/dev/null || true
}

_free_port() {
  local port="$1"
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${port}/tcp" >/dev/null 2>&1 || true
  fi
}

_pid_alive() {
  [[ -f "$1" ]] && kill -0 "$(cat "$1" 2>/dev/null)" 2>/dev/null
}

_http_ready() {
  curl -sf --max-time 2 "$1" >/dev/null 2>&1
}

# ── 变更检测 ──────────────────────────────────────────────────────────
_newest_mtime() {
  find "$@" -name '*.py' -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1
}

_hash_dir() {
  find "$@" -name '*.py' -o -name '*.md' -o -name '*.json' 2>/dev/null \
    | sort | xargs cat 2>/dev/null | md5sum | cut -d' ' -f1
}

_gateway_changed() {
  local stamp="${STATE_DIR}/gateway.ts"
  local current
  current="$(_newest_mtime "${ROOT}/gateway" "${ROOT}/lca")"
  [[ -z "${current}" ]] && return 1
  if [[ -f "${stamp}" ]]; then
    local saved
    saved="$(cat "${stamp}")"
    [[ "${current}" != "${saved}" ]]
  else
    true
  fi
}

_patch_changed() {
  local stamp="${STATE_DIR}/patch.hash"
  local current
  current="$(_hash_dir "${ROOT}/deploy/lobehub")"
  [[ -z "${current}" ]] && return 1
  if [[ -f "${stamp}" ]]; then
    local saved
    saved="$(cat "${stamp}")"
    [[ "${current}" != "${saved}" ]]
  else
    true
  fi
}

_lobehub_running() {
  _http_ready "http://127.0.0.1:${LOBE_DEV_PORT}/"
}

_gateway_running() {
  _http_ready "http://127.0.0.1:${GATEWAY_PORT}/health"
}

_save_gateway_stamp() {
  _newest_mtime "${ROOT}/gateway" "${ROOT}/lca" > "${STATE_DIR}/gateway.ts"
}

_save_patch_stamp() {
  _hash_dir "${ROOT}/deploy/lobehub" > "${STATE_DIR}/patch.hash"
}

# ── LobeHub dev 进程收集 ────────────────────────────────────────────
_collect_lobehub_pids() {
  local -a pids=()
  local pid lock_pid port_pid

  if [[ -f "${LOBE_DEV_PID}" ]]; then
    pid="$(tr -d '[:space:]' <"${LOBE_DEV_PID}" 2>/dev/null || true)"
    [[ -n "${pid}" ]] && pids+=("${pid}")
  fi

  if [[ -f "${NEXT_DEV_LOCK}" ]]; then
    lock_pid="$(python3 - "${NEXT_DEV_LOCK}" <<'PY' 2>/dev/null || true
import json, sys
from pathlib import Path
try:
    pid = json.loads(Path(sys.argv[1]).read_text()).get("pid")
    if isinstance(pid, int): print(pid)
except Exception: pass
PY
    )"
    [[ -n "${lock_pid}" ]] && pids+=("${lock_pid}")
  fi

  if command -v ss >/dev/null 2>&1; then
    port_pid="$(ss -tlnp 2>/dev/null | awk -v p=":${LOBE_DEV_PORT}" '$0~p{if(match($0,/pid=([0-9]+)/,m)){print m[1];exit}}')"
    [[ -n "${port_pid}" ]] && pids+=("${port_pid}")
  fi

  while IFS= read -r pid; do
    [[ -n "${pid}" ]] && pids+=("${pid}")
  done < <(pgrep -f "${LOBE_DIR}/.*devStartupSequence" 2>/dev/null || true)

  while IFS= read -r pid; do
    [[ -n "${pid}" ]] && pids+=("${pid}")
  done < <(pgrep -f "${LOBE_DIR}/.*next dev -p ${LOBE_DEV_PORT}" 2>/dev/null || true)

  local seen="" deduped=""
  for pid in "${pids[@]}"; do
    [[ " ${seen} " == *" ${pid} "* ]] && continue
    seen="${seen} ${pid}"; deduped="${deduped} ${pid}"
  done
  printf '%s\n' ${deduped}
}

# ── 基础设施 ──────────────────────────────────────────────────────────
_infra_port_open() {
  python3 - "$1" "$2" <<'PY' 2>/dev/null
import socket, sys
with socket.create_connection((sys.argv[1], int(sys.argv[2])), timeout=1.5): pass
PY
}

_infra_targets() {
  local env_file="${LOBE_DIR}/.env"
  [[ -f "${env_file}" ]] || env_file="${LOBE_ENV}"
  [[ -f "${env_file}" ]] || return 0
  python3 - "${env_file}" <<'PY'
import sys
from pathlib import Path
from urllib.parse import urlparse
env = {}
for line in Path(sys.argv[1]).read_text().splitlines():
    line = line.strip()
    if not line or line.startswith("#") or "=" not in line: continue
    k, v = line.split("=", 1)
    env[k.strip()] = v.strip().strip('"').strip("'")
checks = []
for key, default_port in [("DATABASE_URL", 5432), ("REDIS_URL", 6379)]:
    url = env.get(key)
    if url:
        p = urlparse(url)
        checks.append((key.split("_")[0].lower(), p.hostname or "127.0.0.1", p.port or default_port))
s3 = env.get("S3_ENDPOINT")
if s3:
    p = urlparse(s3)
    if p.hostname: checks.append(("s3", p.hostname, p.port or (443 if p.scheme == "https" else 80)))
for name, host, port in checks:
    print(f"{name}\t{host}\t{port}")
PY
}

_infra_ready() {
  local any=0
  while IFS=$'\t' read -r name host port; do
    [[ -z "${name}" ]] && continue; any=1
    _infra_port_open "${host}" "${port}" || return 1
  done < <(_infra_targets)
  [[ "${any}" -eq 1 ]]
}

cmd_infra() {
  if [[ "${LOBE_SKIP_INFRA:-0}" == "1" ]]; then
    skip "跳过基础设施 (LOBE_SKIP_INFRA=1)"; return 0
  fi
  if [[ "${LOBE_FORCE_INFRA:-0}" != "1" ]] && _infra_ready; then
    ok "基础设施已就绪 (postgres/redis/s3 端口可达)"; return 0
  fi
  local compose="${LOBE_DIR}/docker-compose/dev/docker-compose.yml"
  if [[ ! -f "${compose}" ]] || ! command -v docker >/dev/null 2>&1; then
    if _infra_ready; then ok "基础设施可用 (无 compose 但端口可达)"; return 0; fi
    warn "跳过 docker infra (无 compose 或未安装 docker)"; return 0
  fi
  log "启动基础设施 (postgres + redis + rustfs)…"
  (cd "${LOBE_DIR}/docker-compose/dev" && [[ ! -f .env ]] && cp .env.example .env 2>/dev/null; docker compose up -d postgresql redis rustfs rustfs-init 2>&1 || docker compose up -d 2>&1) || true
  if _infra_ready; then ok "基础设施就绪"; else warn "基础设施未完全就绪，继续启动"; fi
}

# ── Gateway ───────────────────────────────────────────────────────────
_stop_gateway() {
  if [[ -f "${GATEWAY_PID}" ]]; then
    local pid; pid="$(cat "${GATEWAY_PID}")"
    _kill_tree "${pid}" TERM
    rm -f "${GATEWAY_PID}"
  fi
  _free_port "${GATEWAY_PORT}"
}

cmd_gateway() {
  local force="${1:-0}"
  if _pid_alive "${GATEWAY_PID}"; then
    if [[ "${force}" == "1" ]] || _gateway_changed; then
      log "gateway 代码已更新，重启…"
      _stop_gateway
    else
      ok "gateway 已在运行 (pid $(cat "${GATEWAY_PID}"))"; return 0
    fi
  fi
  log "启动 LCA Gateway :${GATEWAY_PORT}"
  (cd "${ROOT}" && exec uv run python scripts/serve_observability.py --host 0.0.0.0 --port "${GATEWAY_PORT}") >>"${GATEWAY_LOG}" 2>&1 &
  echo $! >"${GATEWAY_PID}"
  local i
  for i in $(seq 1 40); do
    if _http_ready "http://127.0.0.1:${GATEWAY_PORT}/health"; then
      ok "gateway 就绪: http://127.0.0.1:${GATEWAY_PORT}"
      _save_gateway_stamp; return 0
    fi
    sleep 0.25
  done
  err "gateway 启动超时，查看 ${GATEWAY_LOG}"; return 1
}

# ── LobeHub ───────────────────────────────────────────────────────────
_stop_lobehub() {
  local -a targets=()
  while IFS= read -r pid; do
    [[ -n "${pid}" ]] && targets+=("${pid}")
  done < <(_collect_lobehub_pids)
  if [[ ${#targets[@]} -eq 0 ]]; then
    rm -f "${LOBE_DEV_PID}" "${NEXT_DEV_LOCK}" 2>/dev/null; return 0
  fi
  log "停止 LobeHub dev (pids: ${targets[*]})"
  for pid in "${targets[@]}"; do _kill_tree "${pid}" TERM; done
  local waited=0
  while [[ ${waited} -lt 20 ]]; do
    local still=0
    for pid in "${targets[@]}"; do kill -0 "${pid}" 2>/dev/null && still=1; done
    [[ ${still} -eq 0 ]] && break
    sleep 0.5; waited=$((waited + 1))
  done
  for pid in "${targets[@]}"; do _kill_tree "${pid}" KILL; done
  rm -f "${LOBE_DEV_PID}" "${NEXT_DEV_LOCK}" 2>/dev/null
  _free_port "${LOBE_DEV_PORT}"
}

_ensure_lobehub_ui() {
  if [[ ! -f "${LOBE_DIR}/package.json" ]] || ! grep -q '"version": "2.2.13"' "${LOBE_DIR}/package.json" 2>/dev/null; then
    log "同步 LobeHub ${LOBEHUB_RELEASE}…"
    LOBEHUB_RELEASE="${LOBEHUB_RELEASE}" "${ROOT}/scripts/sync_lobehub_ui.sh"
  fi
}

_ensure_lobehub_env() {
  if [[ ! -f "${LOBE_DIR}/.env" ]] && [[ -f "${LOBE_ENV}" ]]; then
    cp "${LOBE_ENV}" "${LOBE_DIR}/.env"
  fi
  local lobe_env="${LOBE_DIR}/.env"
  [[ -f "${lobe_env}" ]] || return 0
  local gw="http://127.0.0.1:${GATEWAY_PORT}/v1"
  _set_env() {
    if grep -q "^${1}=" "${lobe_env}" 2>/dev/null; then
      sed -i "s|^${1}=.*|${1}=${2}|" "${lobe_env}"
    else
      printf '%s=%s\n' "$1" "$2" >>"${lobe_env}"
    fi
  }
  _set_env "OPENAI_PROXY_URL" "${gw}"
  _set_env "OPENAI_API_KEY" "lca-local"
  _set_env "QWEN_PROXY_URL" "${gw}"
  _set_env "QWEN_API_KEY" "lca-local"
  _set_env "ENABLED_QWEN" "1"
  _set_env "DEFAULT_AGENT_CONFIG" "model=solo;provider=openai;chatConfig.searchMode=off"
  if [[ -f "${LOBE_ENV}" ]]; then
    while IFS= read -r line; do
      [[ "${line}" =~ ^[[:space:]]*# || "${line}" =~ ^[[:space:]]*$ || "${line}" != *"="* ]] && continue
      local key="${line%%=*}"
      grep -q "^${key}=" "${lobe_env}" 2>/dev/null || printf '%s\n' "${line}" >>"${lobe_env}"
    done < <(grep -E '^(QWEN_|DEFAULT_AGENT_CONFIG=|OPENAI_)' "${LOBE_ENV}" || true)
  fi
}

_apply_patches() {
  [[ -f "${LOBE_DIR}/package.json" ]] || return 0
  python3 "${ROOT}/deploy/lobehub/patch_lobehub.py"
}

cmd_patch() {
  log "应用 LobeHub 补丁…"
  _ensure_lobehub_ui
  _apply_patches
  _save_patch_stamp
  ok "补丁已应用"
}

cmd_sync() {
  log "同步 LobeHub ${LOBEHUB_RELEASE} + 打补丁…"
  LOBEHUB_RELEASE="${LOBEHUB_RELEASE}" "${ROOT}/scripts/sync_lobehub_ui.sh"
  _save_patch_stamp
  ok "同步完成"
}

# ── 核心命令 ──────────────────────────────────────────────────────────
cmd_up() {
  local gw_action="skip" lobe_action="skip"
  local gw_reason="" lobe_reason=""

  if ! _gateway_running; then
    gw_action="start"; gw_reason="未运行"
  elif _gateway_changed; then
    gw_action="restart"; gw_reason="Python 代码有变更"
  else
    gw_reason="无变更，复用"
  fi

  if ! _lobehub_running; then
    lobe_action="start"; lobe_reason="未运行"
  elif _patch_changed; then
    lobe_action="restart"; lobe_reason="补丁配置有变更"
  else
    lobe_reason="无变更，复用"
  fi

  printf '\n%s\n' "$(_bold '── LCA Stack 智能启动 ──')"
  printf '  gateway:  %s (%s)\n' "$([ "${gw_action}" = "skip" ] && _green "${gw_reason}" || _yellow "${gw_action}: ${gw_reason}")" ""
  printf '  lobehub:  %s\n' "$([ "${lobe_action}" = "skip" ] && _green "${lobe_reason}" || _yellow "${lobe_action}: ${lobe_reason}")"
  printf '\n'

  cmd_infra

  case "${gw_action}" in
    start)   cmd_gateway 0 ;;
    restart) cmd_gateway 1 ;;
    skip)    ok "gateway 复用 (pid $(cat "${GATEWAY_PID}" 2>/dev/null || echo '?'))" ;;
  esac

  case "${lobe_action}" in
    start | restart)
      _ensure_lobehub_ui
      _ensure_lobehub_env
      if [[ "${lobe_action}" = "restart" ]] || _patch_changed; then
        _apply_patches
        _save_patch_stamp
      fi
      [[ -d "${LOBE_DIR}/node_modules" ]] || (cd "${LOBE_DIR}" && bun install)
      [[ "${lobe_action}" = "restart" ]] && _stop_lobehub
      export OPENAI_PROXY_URL="http://127.0.0.1:${GATEWAY_PORT}/v1"
      export OPENAI_API_KEY="lca-local"
      export ENABLED_OPENAI=1
      export PORT="${LOBE_DEV_PORT}"
      log "启动 LobeHub dev :${LOBE_DEV_PORT}"
      (cd "${LOBE_DIR}" && bun run dev) &
      echo $! >"${LOBE_DEV_PID}"
      ;;
    skip)
      ok "lobehub 复用 (port ${LOBE_DEV_PORT})"
      ;;
  esac

  _print_urls
}

cmd_restart() {
  log "强制全量重启…"
  _stop_lobehub
  _stop_gateway
  _free_port "${GATEWAY_PORT}"
  _free_port "${LOBE_DEV_PORT}"
  cmd_infra
  cmd_gateway 1
  _ensure_lobehub_ui
  _ensure_lobehub_env
  _apply_patches
  _save_patch_stamp
  [[ -d "${LOBE_DIR}/node_modules" ]] || (cd "${LOBE_DIR}" && bun install)
  export OPENAI_PROXY_URL="http://127.0.0.1:${GATEWAY_PORT}/v1"
  export OPENAI_API_KEY="lca-local"
  export ENABLED_OPENAI=1
  export PORT="${LOBE_DEV_PORT}"
  log "启动 LobeHub dev :${LOBE_DEV_PORT}"
  (cd "${LOBE_DIR}" && bun run dev) &
  echo $! >"${LOBE_DEV_PID}"
  _print_urls
}

cmd_down() {
  log "停止所有服务…"
  _stop_lobehub
  _stop_gateway
  ok "已停止"
}

cmd_status() {
  printf '\n%s\n' "$(_bold '── LCA Stack 状态 ──')"
  if _pid_alive "${GATEWAY_PID}"; then
    printf '  gateway:  %s (pid %s, port %s)\n' "$(_green '运行中')" "$(cat "${GATEWAY_PID}")" "${GATEWAY_PORT}"
  elif _gateway_running; then
    printf '  gateway:  %s (port %s, pid 未知)\n' "$(_green '运行中')" "${GATEWAY_PORT}"
  else
    printf '  gateway:  %s\n' "$(_red '未运行')"
  fi
  if _lobehub_running; then
    local pids
    pids="$(_collect_lobehub_pids | tr '\n' ' ')"
    printf '  lobehub:  %s (port %s, pids:%s)\n' "$(_green '运行中')" "${LOBE_DEV_PORT}" "${pids:- unknown}"
  else
    printf '  lobehub:  %s\n' "$(_red '未运行')"
  fi
  if [[ -f "${LOBE_DIR}/package.json" ]]; then
    printf '  version:  %s\n' "$(grep '"version"' "${LOBE_DIR}/package.json" | head -1 | sed 's/.*: *"//;s/".*//')"
  else
    printf '  lobehub:  %s\n' "$(_yellow '未同步')"
  fi
  if _infra_ready 2>/dev/null; then
    printf '  infra:    %s\n' "$(_green '就绪')"
  else
    printf '  infra:    %s\n' "$(_yellow '未就绪/未配置')"
  fi
  printf '\n'
}

_print_urls() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  printf '\n%s\n' "$(_bold '── 访问地址 ──')"
  printf '  LobeHub:  %s\n' "$(_cyan "http://127.0.0.1:${LOBE_DEV_PORT}")"
  printf '  Gateway:  %s\n' "http://127.0.0.1:${GATEWAY_PORT}/health"
  [[ -n "${ip}" ]] && printf '  局域网:   %s\n' "$(_cyan "http://${ip}:${LOBE_DEV_PORT}")"
  printf '  停止:     %s\n' "lca down"
  printf '\n'
}

cmd_logs() {
  local svc="${1:-gateway}"
  case "${svc}" in
    gateway) tail -f "${GATEWAY_LOG}" ;;
    lobehub) [[ -f "${RUN_DIR}/lobehub-dev.log" ]] && tail -f "${RUN_DIR}/lobehub-dev.log" || warn "lobehub 日志暂无（前台运行输出到终端）" ;;
    *) err "未知服务: ${svc} (可选: gateway, lobehub)"; exit 2 ;;
  esac
}

# ── 统计 ──────────────────────────────────────────────────────────────
cmd_stats() {
  "${ROOT}/scripts/stats.sh"
}

# ── 帮助 ──────────────────────────────────────────────────────────────
usage() {
  cat <<EOF

$(_bold 'LCA — 统一 CLI')

$(_cyan '用法:') lca <command> [args]

$(_bold '服务管理')
  up              智能启动（检测变更，仅重启需要的组件）
  down            停止所有服务
  restart         强制全量重启
  status          查看服务状态
  gateway         仅启动/重启 gateway
  patch           仅重新应用 LobeHub 补丁
  sync            同步 LobeHub 源码 + 打补丁
  infra           启动基础设施 (docker compose)
  logs [svc]      查看日志 (gateway|lobehub)

$(_bold '开发工具')
  stats           项目统计（代码量/测试/架构）
  lint            运行完整 lint 流水线
  test            运行测试

$(_bold '环境变量')
  GATEWAY_PORT    网关端口 (默认 8765)
  LOBE_DEV_PORT   LobeHub dev 端口 (默认 3010)
  LOBEHUB_RELEASE LobeHub 版本 (默认 v2.2.13)
  LOBE_SKIP_INFRA  设为 1 跳过 docker compose
  LOBE_REUSE_DEV  设为 1 复用已有 LobeHub dev

EOF
}

# ── 入口 ──────────────────────────────────────────────────────────────
cmd="${1:-help}"
shift || true

case "${cmd}" in
  up)       cmd_up ;;
  down)     cmd_down ;;
  restart)  cmd_restart ;;
  status)   cmd_status ;;
  gateway)  cmd_gateway "${1:-0}" ;;
  patch)    cmd_patch ;;
  sync)     cmd_sync ;;
  infra)    cmd_infra ;;
  logs)     cmd_logs "${1:-gateway}" ;;
  stats)    cmd_stats ;;
  lint)
    log "运行完整 lint 流水线…"
    (cd "${ROOT}" && uv run ruff check --fix . && uv run ruff format . && uv run lint-imports && uv run mypy lca)
    ;;
  test)
    (cd "${ROOT}" && uv run pytest "${@}")
    ;;
  -h|--help|help) usage ;;
  *) err "未知命令: ${cmd}"; usage >&2; exit 2 ;;
esac
