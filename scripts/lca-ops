#!/usr/bin/env bash
# LCA Platform Orchestrator — unified service management.
#
# This is the single entry point for managing the LCA development platform:
# - Infrastructure (postgres, redis, s3)
# - LobeHub (Next.js frontend)
# - Daemon (sandbox-user CLI connect)
# - Onlyboxes (worker runtime)
#
# ADR-0119 决定 4:lca-ops 不再管 LCA 进程 — LCA 进程入口是
#   ``uv run python -m lca_kernel serve --profile X --host H --port P``
# SIGTERM 由 K6 ``lca_kernel.lifecycle`` 守护。详情看 docs/adr/0119-*.
#
# Usage:
#     lca-ops dev              # Start full dev environment
#     lca-ops restart          # Restart all services
#     lca-ops stop             # Stop all services
#     lca-ops status           # Show status
#     lca-ops heal             # Auto-recover unhealthy services
#     lca-ops lobehub start    # Manage LobeHub
#     lca-ops infra start      # Manage infrastructure
#     lca-ops daemon start     # Manage daemon
#
# Use --json for agent-friendly JSON output.

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

if command -v uv >/dev/null 2>&1; then
  exec uv run python3 -m lca.infrastructure.cli.cli "$@"
fi
exec python3 -m lca.infrastructure.cli.cli "$@"
