#!/usr/bin/env bash
# scripts/lca-companion — User-Machine Local Companion CLI (ADR-0246 M3)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT}"

export PYTHONPATH="vendor/cordis/src:vendor/cosmokit/src:vendor/schemastery/src:.${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m lca.infrastructure.computer.companion.cli "$@"
