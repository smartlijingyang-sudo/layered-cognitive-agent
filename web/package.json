{
  "name": "lca-observability-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "lint:layers": "depcruise src --config .dependency-cruiser.cjs",
    "generate:contracts": "cd .. && uv run python scripts/generate_journal_contracts.py",
    "generate:catalog": "cd .. && uv run python scripts/generate_ui_catalog.py",
    "generate": "npm run generate:contracts && npm run generate:catalog"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "idb-keyval": "^6.3.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.29.0",
    "mermaid": "^11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "dependency-cruiser": "^16.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
